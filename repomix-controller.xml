530:             const is_downloading = downloading_path === full_path
531:             const IconComp       = getFileIcon(entry.name)
532: 
533:             return (
534:                 <div
535:                     key={full_path}
536:                     className="file-tab__row file-tab__row--file"
537:                     style={{ paddingLeft: 12 + depth * DEPTH_PX }}
538:                 >
539:                     <IconComp size={14} className="file-tab__icon file-tab__icon--file" />
540:                     <span className="file-tab__name">{entry.name}</span>
541:                     <span className="file-tab__size">{formatSize(entry.size)}</span>
