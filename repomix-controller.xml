736: // Upload one chunk of a file to the sandbox.
737: // chunk_info = { transfer_id, data_base64, total_size, chunk_index, total_chunks }
738: // transfer_id groups every chunk of ONE file upload — the Agent uses it to
739: // stitch chunks back into a single stream. Must be the SAME string for every
740: // chunk of one file (generate once per file, e.g. via crypto.randomUUID()).
741: export function buildFsPut(filePath, chunk_info, targetAgents)
742: {
743:     assertSafePath(filePath, 'fs_put path')
744:     if (chunk_info == null || typeof chunk_info !== 'object')
745:     {
746:         throw new Error('Protocol: fs_put chunk_info must be an object')
747:     }
748:     assertNonEmptyString(chunk_info.transfer_id, 'chunk_info.transfer_id')
749:     assertNonNegativeInt(chunk_info.total_size,   'chunk_info.total_size')
750:     assertNonNegativeInt(chunk_info.chunk_index,  'chunk_info.chunk_index')
751:     assertPositiveInt   (chunk_info.total_chunks, 'chunk_info.total_chunks')
752:     if (chunk_info.chunk_index >= chunk_info.total_chunks)
753:     {
754:         throw new Error('Protocol: chunk_info.chunk_index must be < total_chunks')
755:     }
756:     assertNonEmptyString(chunk_info.data_base64,  'chunk_info.data_base64')
757:     return buildRequest(MODULE.FS_PUT,
758:     {
759:         path         : filePath,
760:         transfer_id  : chunk_info.transfer_id,
761:         total_size   : chunk_info.total_size,
762:         chunk_index  : chunk_info.chunk_index,
763:         total_chunks : chunk_info.total_chunks,
764:         data_base64  : chunk_info.data_base64,
765:     },
766:     targetAgents)
767: }
