469:                 onMouseMove   ={handleCaptureMouseMove}
470:                 onMouseDown   ={handleCaptureMouseDown}
471:                 onMouseUp     ={handleCaptureMouseUp}
472:                 onContextMenu ={handleCaptureContextMenu}
473:                 onKeyDown     ={handleCaptureKeyDown}
474:                 onKeyUp       ={handleCaptureKeyUp}
475:             >
476:                 {!agent.online
