<file path="controller/src/components/FrameCanvas.jsx">
  1: // FrameCanvas.jsx — shared primitive that draws one JPEG binary frame onto a <canvas>.
  2: //
  3: // Placed directly under src/components/ (not in livescreen/) because both the
  4: // live-screen views (GridView, FocusView, ScreenTab) and WebcamTab import it.
  5: //
  6: // MEMORY MANAGEMENT (important — read before modifying):
  7: //
  8: // Each JPEG ArrayBuffer is decoded into an ImageBitmap via createImageBitmap().
  9: // ImageBitmap holds GPU-backed pixel data that is NOT garbage-collected
 10: // automatically — we MUST call bitmap.close() to release that memory.
 11: //
 12: // Lifecycle:
 13: //   1. New frame_buffer arrives → create Blob → createImageBitmap()
 14: //   2. Draw the bitmap onto the canvas with drawImage()
 15: //   3. Immediately call bitmap.close() to free GPU memory
 16: //   4. On unmount or before processing the next frame, close any bitmap
 17: //      that might still be pending from an in-flight decode
 18: //
 19: // The "cancelled" flag prevents a stale decode callback from drawing
 20: // onto a canvas that already shows a newer frame or has been unmounted.
 21: 
 22: import frameEventBus from '../services/FrameEventBus'
 23: 
 24: // Props:
 25: //   agent_id     — (Mới) ID của agent để subscribe EventBus
 26: //   frame_buffer — (Legacy) Dữ liệu ảnh JPEG cứng (cho screenshot tĩnh).
 27: //   module       — "screen" | "webcam"
 28: //   label        — caption ngắn gọn
 29: //   width        — chiều rộng CSS
 30: //   height       — chiều cao CSS
 31: function FrameCanvas({ agent_id, frame_buffer, frame_meta = null, module = 'screen', label, width = '100%', height = '100%', onFrameRendered })
 32: {
 33:     const canvas_ref = useRef(null)
 34: 
 35:     useEffect(function ()
 36:     {
 37:         let is_drawing = false
 38:         // Khai báo mảng queue cục bộ cho từng instance của FrameCanvas
 39:         let frame_queue = [] 
 40:         let animation_frame_id = null
 41:         let current_bitmap_ref = null
 42:         let last_rendered_seq = -1
 43: 
 44:         const processFrame = (buffer, meta) => {
 45:             if (!buffer || !canvas_ref.current) return
 46: 
 47:             if (meta && meta.seq <= last_rendered_seq) return;
 48: 
 49:             if (is_drawing) {
 50:                 if (frame_queue.length >= 4) {
 51:                     frame_queue.shift();
 52:                 }
 53:                 frame_queue.push({ buffer, meta })
 54:                 return
 55:             }
 56: 
 57:             is_drawing = true
 58:             const blob = new Blob([buffer], { type: 'image/jpeg' })
 59: 
 60:             createImageBitmap(blob).then(function (bitmap) {
 61:                 current_bitmap_ref = bitmap
 62: 
 63:                 // Vẽ đồng bộ với tần số quét của màn hình
 64:                 animation_frame_id = requestAnimationFrame(() => {
 65:                     const cvs = canvas_ref.current
 66:                     if (!cvs) { bitmap.close(); is_drawing = false; processNext(); return }
 67: 
 68:                     const ctx = cvs.getContext('2d')
 69: 
 70:                     const has_meta   = meta && typeof meta === 'object'
 71:                     const is_delta   = has_meta && meta.is_keyframe === false
 72:                     const draw_x     = is_delta ? (meta.x | 0) : 0
 73:                     const draw_y     = is_delta ? (meta.y | 0) : 0
 74: 
 75:                     if (is_delta && cvs.width > 0 && cvs.height > 0) {
 76:                         ctx.drawImage(bitmap, draw_x, draw_y)
 77:                     } else {
 78:                         const full_w = has_meta ? (meta.w | 0) || bitmap.width  : bitmap.width
 79:                         const full_h = has_meta ? (meta.h | 0) || bitmap.height : bitmap.height
 80:                         
 81:                         // Chỉ cập nhật cvs.width / cvs.height khi thực sự thay đổi kích thước stream
 82:                         if (cvs.width !== full_w || cvs.height !== full_h) {
 83:                             cvs.width  = full_w
 84:                             cvs.height = full_h
 85:                         }
 86:                         ctx.drawImage(bitmap, 0, 0)
 87:                     }
 88: 
 89:                     if (meta) {
 90:                         last_rendered_seq = Math.max(last_rendered_seq, meta.seq);
 91:                     }
 92:                     if (onFrameRendered) {
 93:                         onFrameRendered(meta)
 94:                     }
 95: 
 96:                     // Giải phóng bộ nhớ GPU ngay lập tức
 97:                     bitmap.close()
 98:                     current_bitmap_ref = null
 99:                     is_drawing = false
100:                     
101:                     // Xử lý frame mới nhất bị kẹt lại (nếu có)
102:                     processNext()
103:                 })
104:             }).catch(function (err) {
105:                 console.warn('[FrameCanvas] failed to decode frame:', err)
106:                 is_drawing = false
107:                 processNext()
108:             })
109:         }
110: 
111:         const processNext = () => {
112:             while (frame_queue.length > 0) {
113:                 const next = frame_queue.shift()
114:                 if (next.meta && next.meta.seq <= last_rendered_seq) continue;
115:                 processFrame(next.buffer, next.meta)
116:                 break;
117:             }
118:         }
119: 
120:         // Đăng ký EventBus
121:         let unsubscribe = null
122:         if (agent_id) {
123:             unsubscribe = frameEventBus.on(agent_id, module, (buffer, meta) => {
124:                 processFrame(buffer, meta)
125:             })
126:         }
127: 
128:         // Hỗ trợ Fallback Legacy (chụp ảnh 1 lần truyền trực tiếp bằng props)
129:         if (frame_buffer) {
130:             processFrame(frame_buffer, frame_meta)
131:         }
132: 
133:         // Gotcha 2: Cleanup (Gỡ Event Listener) để chống Memory Leak
134:         return function ()
135:         {
136:             if (unsubscribe) unsubscribe()
137:             if (animation_frame_id) cancelAnimationFrame(animation_frame_id)
138:             if (current_bitmap_ref) {
139:                 current_bitmap_ref.close()
140:                 current_bitmap_ref = null
141:             }
142:         }
143:     }, [agent_id, module, frame_buffer, frame_meta])
144: 
145:     const aria_label = label ? `${label} frame` : 'Live frame'
146: 
147:     // When no label is passed, we render the canvas alone — GridView and ScreenTab
148:     // already show their own status badges around it. When a label is passed
149:     // (WebcamTab), we wrap in a positioned container and add a corner badge.
150:     if (!label)
151:     {
152:         return (
153:             <canvas
154:                 ref={canvas_ref}
155:                 data-module={module}
156:                 style={{ width, height, display: 'block', objectFit: 'contain' }}
157:                 aria-label={aria_label}
158:             />
159:         )
160:     }
161: 
162:     return (
163:         <div className="frame-canvas" style={{ position: 'relative', width, height }}>
164:             <canvas
165:                 ref={canvas_ref}
166:                 data-module={module}
167:                 style={{ width: '100%', height: '100%', display: 'block', objectFit: 'contain' }}
168:                 aria-label={aria_label}
169:             />
170:             <span className="frame-canvas__badge" aria-hidden="true">
171:                 <span className="frame-canvas__badge-dot" />
172:                 {label}
173:             </span>
174:         </div>
175:     )
176: }
177: 
178: export default FrameCanvas
</file>

