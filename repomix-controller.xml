 212: // ─── Utility helpers ──────────────────────────────────────────────────────────
 213: 
 214: function randomFloat(min, max)
 215: {
 216:     return parseFloat((Math.random() * (max - min) + min).toFixed(1))
 217: }
 218: 
 219: function randomInt(min, max)
 220: {
 221:     return Math.floor(Math.random() * (max - min + 1)) + min
 222: }
 223: 
 224: function randomDelay()
 225: {
 226:     return randomInt(REPLY_MIN_MS, REPLY_MAX_MS)
 227: }
 228: 
 229: // Clamp a percentage into [0, 100] — used to keep the fake CPU sample bounded.
 230: function clampPercent(v)
 231: {
 232:     return Math.max(0, Math.min(100, parseFloat(v.toFixed(1))))
 233: }
 234: 
 235: // Clamp any value into an arbitrary [min, max] range with one-decimal rounding.
 236: function clampRange(v, min, max)
 237: {
 238:     return Math.max(min, Math.min(max, parseFloat(v.toFixed(1))))
 239: }
