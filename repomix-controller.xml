  87: // Agents that will refuse to grant consent for sensitive modules.
  88: // When keylog_start / webcam_start targets one of these, MockSocket replies
  89: // with keylog_denied / webcam_denied instead of the started confirmation.
  90: // Used to test the "consent denied" flow and the transparency indicator.
  91: const DENIED_AGENTS = new Set(["agent-06"])
  92: 
  93: // OS families used to pick the right app/process pool for each agent.
  94: function getOsFamily(agent_id)
  95: {
  96:     const agent = FAKE_AGENTS.find((a) => a.id === agent_id)
  97:     if (!agent) return 'windows'
  98:     if (agent.os.startsWith('Ubuntu') || agent.os.startsWith('Linux')) return 'linux'
  99:     if (agent.os.startsWith('macOS'))                                  return 'macos'
 100:     return 'windows'
