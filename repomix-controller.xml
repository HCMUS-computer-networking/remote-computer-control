  1: // PowerTab/index.jsx — power actions for one focused agent.
  2: //
  3: // Four buttons:
  4: //   - Lock     → sent IMMEDIATELY (no countdown — locking is not disruptive).
  5: //   - Restart  → 10-second countdown modal with a Cancel button.
  6: //   - Shutdown → 10-second countdown modal with a Cancel button.
  7: //   - Sleep    → 10-second countdown modal with a Cancel button.
  8: //
  9: // Countdown modal:
 10: //   - Reusable — one <CountdownModal> handles all three destructive actions.
 11: //     The parent just passes the action code + a human label.
 12: //   - If the countdown reaches 0, we send `power` with that action.
 13: //   - If the operator clicks Cancel, we do NOT send anything to the Agent
 14: //     (nothing was sent to start with — the countdown lives entirely on the
 15: //     Controller side, per docs/protocol/power.json). We only surface a
 16: //     local "cancelled" toast so the operator sees the action was aborted.
 17: //
 18: // All commands go through useAgentSocket — never touch the socket directly.
 19: 
 20: import { useState, useEffect, useRef } from 'react'
 21: import { Lock, RotateCcw, Power, Moon, X, WifiOff } from 'lucide-react'
 22: import useAgentSocket     from '../../../hooks/UseAgentSocket'
 23: import useUiStore         from '../../../store/UiStore'
 24: import usePermissionStore from '../../../store/PermissionStore'
 25: import { useGuardedSend, usePendingConsent } from '../../PermissionGate'
 26: import { buildPower, POWER_ACTION, FEATURE } from '../../../services/Protocol'
 27: 
 28: const COUNTDOWN_SECONDS = 10   // matches spec — 10 s window to abort
 29: 
 30: // ── Reusable countdown modal ───────────────────────────────────────────────
 31: //
 32: // Props:
 33: //   action    — POWER_ACTION.* code, forwarded verbatim into buildPower().
 34: //   label     — human-readable verb shown in the modal title ("Restart", ...).
 35: //   agent     — the target agent object (used only for display).
 36: //   onConfirm — called with the action code when countdown reaches 0.
 37: //   onCancel  — called when the user clicks Cancel (or hits Esc).
 38: function CountdownModal({ action, label, agent, onConfirm, onCancel })
 39: {
 40:     const [remaining, setRemaining] = useState(COUNTDOWN_SECONDS)
 41: 
 42:     // Hold the latest onConfirm / onCancel in refs so the countdown effect
 43:     // does NOT need them in its deps. Reason: parents that re-render often
 44:     // (e.g. TopBar reacting to live frames) would otherwise recreate these
 45:     // callbacks each render → the effect would tear down and rebuild the
 46:     // interval every tick → the countdown would freeze at its start value.
 47:     const on_confirm_ref = useRef(onConfirm)
 48:     const on_cancel_ref  = useRef(onCancel)
 49:     useEffect(function ()
 50:     {
 51:         on_confirm_ref.current = onConfirm
 52:         on_cancel_ref.current  = onCancel
 53:     })
 54: 
 55:     // Cancelled flag guards the microtask below: if the modal unmounted
 56:     // between the "prev <= 1" branch and the microtask firing, we must not
 57:     // still call onConfirm (which would send a shutdown after user cancel).
 58:     useEffect(function ()
 59:     {
 60:         let cancelled = false
 61: 
 62:         const timer_id = setInterval(function ()
 63:         {
 64:             setRemaining(function (prev)
 65:             {
 66:                 if (prev <= 1)
 67:                 {
 68:                     clearInterval(timer_id)
 69:                     Promise.resolve().then(function ()
 70:                     {
 71:                         if (!cancelled) on_confirm_ref.current(action)
 72:                     })
 73:                     return 0
 74:                 }
 75:                 return prev - 1
 76:             })
 77:         }, 1000)
 78: 
 79:         function onKey(e) { if (e.key === 'Escape') on_cancel_ref.current() }
 80:         window.addEventListener('keydown', onKey)
 81: 
 82:         return function ()
 83:         {
 84:             cancelled = true
 85:             clearInterval(timer_id)
 86:             window.removeEventListener('keydown', onKey)
 87:         }
 88:     }, [action])   // only reset when the action itself changes
 89: 
 90:     return (
 91:         <div
 92:             className="power-modal__overlay"
 93:             role="dialog"
 94:             aria-modal="true"
 95:             aria-labelledby="power-modal-title"
 96:             onClick={onCancel}   // click outside to cancel
 97:         >
 98:             <div
 99:                 className="power-modal__card"
100:                 onClick={function (e) { e.stopPropagation() }}
101:             >
102:                 <div id="power-modal-title" className="power-modal__title">
103:                     Confirm {label}
104:                 </div>
105: 
106:                 <div className="power-modal__msg">
107:                     About to <strong>{label.toLowerCase()}</strong> agent <strong>{agent.name}</strong>.
108:                     Click Cancel to abort.
109:                 </div>
110: 
111:                 {/* Large visible countdown so the operator cannot miss it.
112:                     Turns danger-red in the final 3 seconds. */}
113:                 <div className={`power-modal__count${remaining <= 3 ? ' power-modal__count--urgent' : ''}`}>
114:                     {remaining}s
115:                 </div>
116: 
117:                 <div className="power-modal__actions">
118:                     <button
119:                         className="screen-tab__btn screen-tab__btn--secondary"
120:                         onClick={onCancel}
121:                         autoFocus   // focus Cancel by default — safer to abort than to confirm
122:                     >
123:                         <X size={14} strokeWidth={2} />
124:                         Hủy
125:                     </button>
126:                 </div>
127:             </div>
128:         </div>
129:     )
130: }
131: 
132: // ── Main tab ───────────────────────────────────────────────────────────────
133: 
134: function PowerTab({ agent })
135: {
136:     const { sendCommand } = useAgentSocket()
137:     const addToast        = useUiStore((s) => s.addToast)
138:     const guardedSend     = useGuardedSend()
139:     const is_pending      = usePendingConsent()
140: 
141:     // When set, a countdown modal is showing for this action.
142:     // null means no modal is open.
143:     const [pending, setPending] = useState(null)   // { action, label } | null
144:     
145:     useEffect(function () {
146:         if (agent && !agent.online) {
147:             setPending(null)
148:         }
149:     }, [agent?.online])
150: 
151:     // Lock is immediate — no countdown, no modal.
152:     function handleLock()
153:     {
154:         guardedSend(function ()
155:         {
156:             sendCommand(buildPower(POWER_ACTION.LOCK, [agent.id]))
157:             addToast(`Lock sent to ${agent.name}`, 'info')
158:         })
159:     }
160: 
161:     // Restart / Shutdown / Sleep all open the same modal — reuse.
162:     // Consent is requested BEFORE the countdown starts, so the operator does
163:     // not stare at a 10-second timer only to discover the Agent refused.
164:     function askConfirm(action, label)
165:     {
166:         guardedSend(function () { setPending({ action, label }) })
167:     }
168: 
169:     // Called by the modal when its countdown expires.
170:     // Consent was secured when the modal opened (askConfirm → guardedSend),
171:     // but the operator may have revoked it during the 10 s window via the
172:     // Disconnect button. Re-check now so a destructive power action is never
173:     // sent silently after consent was withdrawn.
174:     function handleConfirm(action)
175:     {
176:         const status = usePermissionStore.getState().permissions[agent.id]?.[FEATURE.POWER] ?? 'idle'
177:         if (status !== 'granted')
178:         {
179:             addToast('Quyền Power đã bị thu hồi — hủy lệnh.', 'error')
180:             setPending(null)
181:             return
182:         }
183:         sendCommand(buildPower(action, [agent.id]))
184:         setPending(null)
185:     }
186: 
187:     // Called by the modal on Cancel / Esc / click-outside.
188:     // We do NOT send anything — the countdown lived entirely on the
189:     // Controller side, so nothing needs to be retracted on the Agent.
190:     function handleCancel()
191:     {
192:         if (pending)
193:         {
194:             addToast(`${pending.label} cancelled`, 'info')
195:         }
196:         setPending(null)
197:     }
198: 
199:     return (
200:         <div className="screen-tab">
201:             {/* ── Toolbar ────────────────────────────────────── */}
202:             <div className="screen-tab__toolbar">
203:                 <span className="screen-tab__title">
204:                     Power — {agent.name}
205:                 </span>
206:             </div>
207: 
208:             {/* Offline note — power actions cannot reach an unreachable agent. */}
209:             {!agent.online && (
210:                 <div className="module-offline">
211:                     <WifiOff size={40} strokeWidth={1.25} />
212:                     <span>Agent is offline — power actions are unavailable</span>
213:                 </div>
214:             )}
215: 
216:             {/* ── Action grid ────────────────────────────────── */}
217:             <div className="power-tab__grid">
218:                 <button
219:                     className="screen-tab__btn screen-tab__btn--secondary power-tab__btn"
220:                     onClick={handleLock}
221:                     disabled={!agent.online || is_pending}
222:                     title="Lock the Agent screen immediately"
223:                 >
224:                     <Lock size={16} strokeWidth={2} />
225:                     Lock (ngay lập tức)
226:                 </button>
227: 
228:                 <button
229:                     className="screen-tab__btn screen-tab__btn--primary power-tab__btn"
230:                     onClick={function () { askConfirm(POWER_ACTION.RESTART, 'Restart') }}
231:                     disabled={!agent.online || is_pending}
232:                     title="Restart the Agent machine after a 10-second countdown"
233:                 >
234:                     <RotateCcw size={16} strokeWidth={2} />
235:                     Restart (10s)
236:                 </button>
237: 
238:                 <button
239:                     className="screen-tab__btn screen-tab__btn--danger power-tab__btn"
240:                     onClick={function () { askConfirm(POWER_ACTION.SHUTDOWN, 'Shutdown') }}
241:                     disabled={!agent.online || is_pending}
242:                     title="Shut down the Agent machine after a 10-second countdown"
243:                 >
244:                     <Power size={16} strokeWidth={2} />
245:                     Shutdown (10s)
246:                 </button>
247: 
248:                 <button
249:                     className="screen-tab__btn screen-tab__btn--secondary power-tab__btn"
250:                     onClick={function () { askConfirm(POWER_ACTION.SLEEP, 'Sleep') }}
251:                     disabled={!agent.online || is_pending}
252:                     title="Put the Agent machine to sleep after a 10-second countdown"
253:                 >
254:                     <Moon size={16} strokeWidth={2} />
255:                     Sleep (10s)
256:                 </button>
257:             </div>
258: 
259:             {/* Countdown modal — one instance drives all three delayed actions. */}
260:             {pending && (
261:                 <CountdownModal
262:                     action={pending.action}
263:                     label={pending.label}
264:                     agent={agent}
265:                     onConfirm={handleConfirm}
266:                     onCancel={handleCancel}
267:                 />
268:             )}
269:         </div>
270:     )
271: }
272: 
273: export default PowerTab
</file>

<file path="controller/src/components/modules/ScreenTab/index.jsx">
  1: // ScreenTab/index.jsx — screenshot + live stream panel for one focused agent.
  2: //
  3: // STREAM LIFECYCLE:
  4: //   - "Chụp 1 lần" sends a single screenshot request (module:"screenshot").
  5: //     The Agent replies with one frame_meta + binary pair.
  6: //   - "Bắt đầu stream" starts a 24 fps continuous stream for the focused agent.
  7: //     Frames arrive as repeating frame_meta + binary pairs and are rendered
  8: //     by FrameCanvas in real time.
  9: //   - "Dừng stream" stops the stream explicitly.
 10: //   - On UNMOUNT (user switches tab or leaves focus), the cleanup function
 11: //     stops the stream automatically to prevent leaked intervals and wasted
 12: //     bandwidth. This is critical — without it, MockSocket (or the real
 13: //     Gateway) would keep sending frames to an agent that nobody is watching.
 14: //
 15: // The component reads the latest frame from ModuleStore.data[agent_id].screen.
 16: // It never touches the socket directly — all commands go via useAgentSocket.
 17: 
 18: import { useState, useEffect, useRef } from 'react'
 19: import { Camera, Play, Square, WifiOff, MousePointer2 } from 'lucide-react'
 20: import useModuleStore                   from '../../../store/ModuleStore'
 21: import useUiStore                       from '../../../store/UiStore'
 22: import usePermissionStore               from '../../../store/PermissionStore'
 23: import useAgentSocket                   from '../../../hooks/UseAgentSocket'
 24: import { useGuardedSend, usePendingConsent } from '../../PermissionGate'
 25: import
 26: {
 27:     buildScreenshot,
 28:     buildStreamStart,
 29:     buildStreamStop,
 30:     buildInputMouseMove,
 31:     buildInputMouseClick,
 32:     buildInputKey,
 33:     FEATURE,
 34: }
 35: from '../../../services/Protocol'
 36: import FrameCanvas from '../../FrameCanvas'
 37: 
 38: // Throttle mouse_move to ~33 fps. The Agent handler is fire-and-forget so
 39: // the socket can survive higher rates, but there is no visual benefit past
 40: // the stream's own frame rate and we want to leave headroom for JPEGs.
 41: const MOUSE_MOVE_MIN_INTERVAL_MS = 30
 42: 
 43: // Translate a browser KeyboardEvent to a Windows Virtual-Key code. Covers
 44: // the subset a remote-control operator actually needs (letters, digits,
 45: // arrows, common editing/function keys). Returns null for unmapped keys
 46: // so the caller can fall back to input_type for printable characters.
 47: function keyEventToVk(evt)
 48: {
 49:     const k = evt.key
 50:     if (k.length === 1)
 51:     {
 52:         const upper = k.toUpperCase()
 53:         const code  = upper.charCodeAt(0)
 54:         if (code >= 0x30 && code <= 0x39) return code                        // '0'..'9' → VK_0..VK_9
 55:         if (code >= 0x41 && code <= 0x5A) return code                        // 'A'..'Z' → VK_A..VK_Z
 56:         return null                                                          // punctuation → prefer input_type
 57:     }
 58:     switch (k)
 59:     {
 60:         case 'Backspace' : return 0x08
 61:         case 'Tab'       : return 0x09
 62:         case 'Enter'     : return 0x0D
 63:         case 'Shift'     : return 0x10
 64:         case 'Control'   : return 0x11
 65:         case 'Alt'       : return 0x12
 66:         case 'Escape'    : return 0x1B
 67:         case 'Space'     : return 0x20
 68:         case 'PageUp'    : return 0x21
 69:         case 'PageDown'  : return 0x22
 70:         case 'End'       : return 0x23
 71:         case 'Home'      : return 0x24
 72:         case 'ArrowLeft' : return 0x25
 73:         case 'ArrowUp'   : return 0x26
 74:         case 'ArrowRight': return 0x27
 75:         case 'ArrowDown' : return 0x28
 76:         case 'Insert'    : return 0x2D
 77:         case 'Delete'    : return 0x2E
 78:         case 'F1' : return 0x70
 79:         case 'F2' : return 0x71
 80:         case 'F3' : return 0x72
 81:         case 'F4' : return 0x73
 82:         case 'F5' : return 0x74
 83:         case 'F6' : return 0x75
 84:         case 'F7' : return 0x76
 85:         case 'F8' : return 0x77
 86:         case 'F9' : return 0x78
 87:         case 'F10': return 0x79
 88:         case 'F11': return 0x7A
 89:         case 'F12': return 0x7B
 90:         default   : return null
 91:     }
 92: }
 93: 
 94: function mouseButtonName(button_index)
 95: {
 96:     if (button_index === 1) return 'middle'
 97:     if (button_index === 2) return 'right'
 98:     return 'left'
 99: }
100: 
101: const FOCUS_FPS     = 24   // full frame rate for focused agent
102: const FOCUS_QUALITY = 70   // JPEG quality (0–100)
103: 
104: // Allowed ranges (matched to Protocol.js buildStreamStart guard).
105: const FPS_MIN     = 1
106: const FPS_MAX     = 60
107: const QUALITY_MIN = 1
108: const QUALITY_MAX = 100
109: 
110: // Parse a form input string as a positive integer inside [min, max].
111: // Returns { value, error } — value is the parsed number when valid, else NaN.
112: function parseIntInRange(raw, min, max, field_label)
113: {
114:     const trimmed = String(raw).trim()
115:     if (trimmed === '') return { value: NaN, error: `${field_label} is required` }
116:     if (!/^\d+$/.test(trimmed)) return { value: NaN, error: `${field_label} must be an integer` }
117:     const n = parseInt(trimmed, 10)
118:     if (n < min || n > max) return { value: NaN, error: `${field_label} must be in [${min}, ${max}]` }
119:     return { value: n, error: '' }
120: }
121: 
122: function ScreenTab({ agent })
123: {
124:     const { sendCommand, requestPermission, revokePermission, stopModule } = useAgentSocket()
125:     const addToast          = useUiStore((s) => s.addToast)
126:     const guardedSend       = useGuardedSend()
127:     const is_pending        = usePendingConsent()
128:     const [streaming, setStreaming] = useState(false)
129: 
130:     // Remote Input state — subscribed from stores so the toolbar reflects the
131:     // real consent status (Agent may deny or revoke asynchronously).
132:     const input_status = usePermissionStore((s) => s.permissions[agent.id]?.[FEATURE.INPUT] ?? 'idle')
133:     const input_active = useModuleStore((s) => s.data[agent.id]?.input_active ?? false)
134:     // "Điều khiển" is enabled only when the Agent has confirmed input_started
135:     // (Controller received permission_result+input_started). Until then the
136:     // capture div ignores events, so a laggy grant cannot leak clicks.
137:     const input_ready  = input_status === 'granted' && input_active
138: 
139:     // ── Stream settings form ─────────────────────────────────────────
140:     const [fps_input,     setFpsInput]     = useState(String(FOCUS_FPS))
141:     const [quality_input, setQualityInput] = useState(String(FOCUS_QUALITY))
142:     const fps_parsed     = parseIntInRange(fps_input,     FPS_MIN,     FPS_MAX,     'FPS')
143:     const quality_parsed = parseIntInRange(quality_input, QUALITY_MIN, QUALITY_MAX, 'Quality')
144:     const form_valid     = !fps_parsed.error && !quality_parsed.error
145: 
146:     // Lấy frame_meta để hiển thị thông số độ phân giải (frame_buffer được gửi qua EventBus)
147:     const frame_meta   = useModuleStore((s) => s.data[agent.id]?.screen?.meta  ?? null)
148: 
149:     // Track the agent_id we started streaming for, so cleanup stops the right one.
150:     // Using a ref because the cleanup function must read the LATEST value,
151:     // not the value captured at render time.
152:     const streaming_agent_ref = useRef(null)
153: 
154:     // Stop the stream for the previously-focused agent when the component
155:     // unmounts OR when the focused agent changes (agent.id in deps).
156:     // Without this, switching agents in focus mode would leave the old
157:     // agent's stream running — orphaned frames with nobody watching.
158:     useEffect(function ()
159:     {
160:         return function ()
161:         {
162:             if (streaming_agent_ref.current)
163:             {
164:                 sendCommand(buildStreamStop([streaming_agent_ref.current]))
165:                 streaming_agent_ref.current = null
166:                 setStreaming(false)
167:             }
168:         }
169:     }, [agent.id])
170: 
171:     function handleScreenshot()
172:     {
173:         guardedSend(function () { sendCommand(buildScreenshot([agent.id])) })
174:     }
175: 
176:     function handleStartStream()
177:     {
178:         if (!form_valid) return
179:         guardedSend(function ()
180:         {
181:             try
182:             {
183:                 sendCommand(buildStreamStart(fps_parsed.value, quality_parsed.value, [agent.id]))
184:                 streaming_agent_ref.current = agent.id
185:                 setStreaming(true)
186:             }
187:             catch (err)
188:             {
189:                 addToast(err.message ?? 'Invalid stream settings', 'error')
190:             }
191:         })
192:     }
193: 
194:     function handleStopStream()
195:     {
196:         sendCommand(buildStreamStop([agent.id]))
197:         streaming_agent_ref.current = null
198:         setStreaming(false)
199:     }
200: 
201:     // ── Remote Input capture ──────────────────────────────────────────────
202:     // canvas_wrap_ref points to the <div> that hosts <FrameCanvas>. We read
203:     // the <canvas>'s intrinsic width/height (= Agent screen resolution, set
204:     // by the last keyframe) to remap browser-space pixels into Agent-space.
205:     const canvas_wrap_ref  = useRef(null)
206:     const last_move_ref    = useRef(0)                                                                  // timestamp of the last mouse_move actually sent
207: 
208:     function handleToggleInput()
209:     {
210:         if (input_status === 'granted')
211:         {
212:             // Revoke also clears input_active via the store and tells the
213:             // Agent to hide its blue "K" overlay.
214:             revokePermission(FEATURE.INPUT, agent.id)
215:             stopModule(FEATURE.INPUT, agent.id)
216:             return
217:         }
218:         requestPermission(FEATURE.INPUT, agent.id)
219:     }
220: 
221:     // Cleanup: if operator leaves the tab or switches agent while Remote
222:     // Input is granted, revoke the grant so the Agent's overlay does not
223:     // linger and stray clicks cannot be sent after the tab unmounts.
224:     useEffect(function ()
225:     {
226:         return function ()
227:         {
228:             const current = usePermissionStore.getState().permissions[agent.id]?.[FEATURE.INPUT]
229:             if (current === 'granted' || current === 'requesting')
230:             {
231:                 revokePermission(FEATURE.INPUT, agent.id)
232:                 stopModule(FEATURE.INPUT, agent.id)
233:             }
234:         }
235:     }, [agent.id, revokePermission, stopModule])
236: 
237:     // Focus the capture wrapper the moment Remote Input becomes usable so
238:     // the operator can start typing without an extra click. Losing focus on
239:     // toggle-off is intentional — we don't want a stale focus target to
240:     // keep swallowing browser shortcuts once capture is disabled.
241:     useEffect(function ()
242:     {
243:         if (input_ready && canvas_wrap_ref.current)
244:         {
245:             canvas_wrap_ref.current.focus()
246:         }
247:     }, [input_ready])
248: 
249:     // Map an event's client coords to Agent-screen pixel coords. Returns
250:     // null when the canvas has not yet received a keyframe (no intrinsic
251:     // resolution) — the caller must drop the event in that case.
252:     function toAgentCoords(evt)
253:     {
254:         const wrap = canvas_wrap_ref.current
255:         if (!wrap) return null
256:         const cvs = wrap.querySelector('canvas')
257:         if (!cvs || cvs.width === 0 || cvs.height === 0) return null
258:         const rect = cvs.getBoundingClientRect()
259:         if (rect.width === 0 || rect.height === 0) return null
260:         const x = Math.round(((evt.clientX - rect.left) / rect.width)  * cvs.width)
261:         const y = Math.round(((evt.clientY - rect.top)  / rect.height) * cvs.height)
262:         // Clamp so a rounding overshoot at the right/bottom edge does not
263:         // ship coordinates outside the Agent's actual screen.
264:         const cx = Math.max(0, Math.min(cvs.width  - 1, x))
265:         const cy = Math.max(0, Math.min(cvs.height - 1, y))
266:         return { x: cx, y: cy }
267:     }
268: 
269:     function handleCaptureMouseMove(evt)
270:     {
271:         if (!input_ready) return
272:         const now = performance.now()
273:         if (now - last_move_ref.current < MOUSE_MOVE_MIN_INTERVAL_MS) return
274:         const pt = toAgentCoords(evt)
275:         if (!pt) return
276:         last_move_ref.current = now
277:         try { sendCommand(buildInputMouseMove(pt.x, pt.y, [agent.id])) }
278:         catch (err) { console.warn('[ScreenTab] mouse_move build failed:', err) }
279:     }
280: 
281:     function handleCaptureMouseDown(evt)
282:     {
283:         if (!input_ready) return
284:         // Move first so the click lands where the operator sees the cursor,
285:         // even if the throttle just skipped the last move event.
286:         const pt = toAgentCoords(evt)
287:         if (pt)
288:         {
289:             try { sendCommand(buildInputMouseMove(pt.x, pt.y, [agent.id])) } catch { /* ignore */ }
290:         }
291:         try { sendCommand(buildInputMouseClick(mouseButtonName(evt.button), 'down', [agent.id])) }
292:         catch (err) { console.warn('[ScreenTab] mouse_down build failed:', err) }
293:         evt.preventDefault()                                                                            // stop native focus / drag-select on the wrapper
294:     }
295: 
296:     function handleCaptureMouseUp(evt)
297:     {
298:         if (!input_ready) return
299:         try { sendCommand(buildInputMouseClick(mouseButtonName(evt.button), 'up', [agent.id])) }
300:         catch (err) { console.warn('[ScreenTab] mouse_up build failed:', err) }
301:         evt.preventDefault()
302:     }
303: 
304:     function handleCaptureContextMenu(evt)
305:     {
306:         // Right-click must not open the browser context menu when we are
307:         // forwarding it as an Agent right-click.
308:         if (input_ready) evt.preventDefault()
309:     }
310: 
311:     function handleCaptureKeyDown(evt)
312:     {
313:         if (!input_ready) return
314:         const vk = keyEventToVk(evt)
315:         if (vk === null) return                                                                         // unmapped printable — printable input needs input_type UI
316:         try { sendCommand(buildInputKey(vk, 'down', [agent.id])) }
317:         catch (err) { console.warn('[ScreenTab] key_down build failed:', err) }
318:         evt.preventDefault()                                                                            // swallow browser shortcuts (Tab, arrows, F5, etc.) while capturing
319:     }
320: 
321:     function handleCaptureKeyUp(evt)
322:     {
323:         if (!input_ready) return
324:         const vk = keyEventToVk(evt)
325:         if (vk === null) return
326:         try { sendCommand(buildInputKey(vk, 'up', [agent.id])) }
327:         catch (err) { console.warn('[ScreenTab] key_up build failed:', err) }
328:         evt.preventDefault()
329:     }
330: 
331:     // Build a human-readable resolution string from frame_meta
332:     const resolution_text = frame_meta
333:         ? `${frame_meta.w}×${frame_meta.h}  ·  seq #${frame_meta.seq}`
334:         : 'No frame yet'
335: 
336:     return (
337:         <div className="screen-tab">
338:             {/* ── Toolbar ────────────────────────────────────── */}
339:             <div className="screen-tab__toolbar">
340:                 <span className="screen-tab__title">
341:                     Screen — {agent.name}
342:                 </span>
343: 
344:                 <div className="screen-tab__actions">
345:                     {/* single screenshot button */}
346:                     <button
347:                         className="screen-tab__btn screen-tab__btn--secondary"
348:                         onClick={handleScreenshot}
349:                         disabled={streaming || !agent.online || is_pending}
350:                         title={is_pending ? 'Đang xin quyền...' : 'Capture a single screenshot'}
351:                     >
352:                         <Camera size={14} strokeWidth={2} />
353:                         Chụp 1 lần
354:                     </button>
355: 
356:                     {/* stream toggle */}
357:                     {streaming
358:                         ? (
359:                             <button
360:                                 className="screen-tab__btn screen-tab__btn--danger"
361:                                 onClick={handleStopStream}
362:                                 title="Stop the live stream"
363:                             >
364:                                 <Square size={14} strokeWidth={2} />
365:                                 Dừng stream
366:                             </button>
367:                         )
368:                         : (
369:                             <button
370:                                 className="screen-tab__btn screen-tab__btn--primary"
371:                                 onClick={handleStartStream}
372:                                 disabled={!agent.online || !form_valid || is_pending}
373:                                 title={is_pending
374:                                     ? 'Đang xin quyền...'
375:                                     : form_valid
376:                                         ? `Start ${fps_parsed.value} fps live stream`
377:                                         : 'Fix the settings error first'}
378:                             >
379:                                 <Play size={14} strokeWidth={2} />
380:                                 Bắt đầu stream
381:                             </button>
382:                         )
383:                     }
384: 
385:                     {/* Remote Input toggle — asks feature="input" (distinct   */}
386:                     {/* from screen). The Agent shows a blue "K" overlay while */}
387:                     {/* granted; leaving the tab auto-revokes.                 */}
388:                     <button
389:                         className={`screen-tab__btn ${input_ready ? 'screen-tab__btn--danger' : 'screen-tab__btn--secondary'}`}
390:                         onClick={handleToggleInput}
391:                         disabled={!agent.online || !streaming || input_status === 'requesting'}
392:                         title={!streaming
393:                             ? 'Bắt đầu stream trước khi điều khiển'
394:                             : input_status === 'requesting'
395:                                 ? 'Đang xin quyền điều khiển...'
396:                                 : input_ready
397:                                     ? 'Ngừng điều khiển từ xa'
398:                                     : 'Xin quyền điều khiển chuột/bàn phím'}
399:                     >
400:                         <MousePointer2 size={14} strokeWidth={2} />
401:                         {input_ready ? 'Đang điều khiển' : 'Điều khiển'}
402:                     </button>
403:                 </div>
404:             </div>
405: 
406:             {/* ── Stream settings (fps + quality) ─────────────── */}
407:             <form
