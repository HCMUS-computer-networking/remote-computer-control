  1: // Socket.js — real WebSocket wrapper that talks to the Gateway.
  2: //
  3: // This class has the SAME API shape as MockSocket.js on purpose:
  4: //   onOpen / onMessage / onBinary / onClose / onError   (callback registration)
  5: //   connect() / close() / send(message)                 (lifecycle + TX)
  6: // Because of that, swapping mock ↔ real only changes ONE import in
  7: // src/services/index.js — no component or hook code needs to change.
  8: //
  9: // FRAME PROTOCOL — screen/webcam frames arrive as two messages in order:
 10: //   1) a text message  = JSON "frame_meta"  → delivered to onMessage
 11: //   2) a binary message = raw JPEG bytes     → delivered to onBinary
 12: // We set binaryType = "arraybuffer" so binary frames arrive as ArrayBuffer,
 13: // exactly like MockSocket hands them to onBinary.
 14: //
 15: // RECONNECT — if the connection drops (not a clean close() by us), we retry
 16: // with a simple exponential backoff and keep ConnectionStore.status in sync.
 17: 
 18: import useConnectionStore from '../store/ConnectionStore'
 19: import useUiStore         from '../store/UiStore'
 20: import { logout, refreshAccessToken } from './AuthService'
 21: 
 22: // ─── Config ───────────────────────────────────────────────────────────────────
 23: 
 24: // Gateway address comes from the Vite env; falls back to localhost for dev.
 25: // Set VITE_GATEWAY_URL in a .env file to point at the real Gateway.
 26: const DEFAULT_GATEWAY_URL = import.meta.env.VITE_GATEWAY_URL ?? 'ws://localhost:8080'
 27: 
 28: // ─── Reconnect backoff ────────────────────────────────────────────────────────
 29: 
 30: const RECONNECT_BASE_MS = 500;     // first retry waits this long
 31: const RECONNECT_MAX_MS  = 8000;    // cap so we never wait too long between tries
 32: 
 33: // ─── Socket class ───────────────────────────────────────────────────────────────
 34: 
 35: class Socket
 36: {
 37:     // url is optional; when omitted we use the env/default gateway address.
 38:     constructor(url)
 39:     {
 40:         this._url            = url ?? DEFAULT_GATEWAY_URL;
 41: 
 42:         this._on_message     = null;    // fired for every incoming JSON message
 43:         this._on_binary      = null;    // fired for incoming binary (ArrayBuffer) data
 44:         this._on_open        = null;    // fired each time the connection opens
 45:         this._on_close       = null;    // fired when the connection closes
 46:         this._on_error       = null;    // fired on socket error
 47: 
 48:         this._ws             = null;    // the underlying WebSocket instance
 49:         this._closed_by_user = false;   // true after close() so we do NOT reconnect
 50:         this._retry_count    = 0;       // how many reconnect attempts so far
 51:         this._reconnect_timer = null;   // saved so close() can cancel a pending retry
 52:         this._opened_once    = false;   // true after the current WS reached onopen
 53:         this._auth_fail_count = 0;      // consecutive closes that never opened while a JWT was set
 54:     }
 55: 
 56:     // Threshold: after this many consecutive failed opens with a JWT present,
 57:     // assume the JWT is expired/invalid (Gateway responds 401 at upgrade, which
 58:     // the browser surfaces as onclose code 1006 — indistinguishable from network
 59:     // errors, so we rely on repeated failures instead of a specific code).
 60:     static AUTH_FAIL_THRESHOLD = 2;
 61: 
 62:     // ── Callback registration (mirror the MockSocket API) ──────────────────
 63: 
 64:     onOpen(callback)    { this._on_open    = callback; }
 65:     onMessage(callback) { this._on_message = callback; }
 66:     onBinary(callback)  { this._on_binary  = callback; }
 67:     onClose(callback)   { this._on_close   = callback; }
 68:     onError(callback)   { this._on_error   = callback; }
 69: 
 70:     // ── Lifecycle ──────────────────────────────────────────────────────────
 71: 
 72:     // Open the WebSocket. Safe to call once; reconnect is handled internally.
 73:     connect()
 74:     {
 75:         this._closed_by_user = false;
 76:         this._openSocket();
 77:     }
 78: 
 79:     // Force-close the current underlying WebSocket without setting the
 80:     // "user closed" flag, then reconnect. Used after a successful token
 81:     // refresh so the next handshake carries the fresh JWT in the URL.
 82:     reopen()
 83:     {
 84:         // Cancel any pending backoff so we open immediately.
 85:         if (this._reconnect_timer)
 86:         {
 87:             clearTimeout(this._reconnect_timer);
 88:             this._reconnect_timer = null;
 89:         }
 90:         if (this._ws)
 91:         {
 92:             // Detach handlers so the close event does NOT trigger auto-reconnect;
 93:             // we open the new socket ourselves right after.
 94:             this._ws.onopen    = null;
 95:             this._ws.onmessage = null;
 96:             this._ws.onclose   = null;
 97:             this._ws.onerror   = null;
 98:             try { this._ws.close(); } catch (e) { /* ignore */ }
 99:             this._ws = null;
100:         }
101:         this._retry_count      = 0;
102:         this._auth_fail_count  = 0;
103:         this._opened_once      = false;
104:         this._closed_by_user   = false;
105:         this._openSocket();
106:     }
107: 
108:     // Close the connection for good and stop any pending reconnect attempts.
109:     close()
110:     {
111:         this._closed_by_user = true;
112: 
113:         // Cancel a scheduled reconnect if we are waiting between retries.
114:         if (this._reconnect_timer)
115:         {
116:             clearTimeout(this._reconnect_timer);
117:             this._reconnect_timer = null;
118:         }
119: 
120:         if (this._ws)
121:         {
122:             // Detach handlers first so the close event does not trigger reconnect.
123:             this._ws.onopen    = null;
124:             this._ws.onmessage = null;
125:             this._ws.onclose   = null;
126:             this._ws.onerror   = null;
127:             this._ws.close();
128:             this._ws = null;
129:         }
130:     }
131: 
132:     // ── Send (entry point for outgoing commands) ───────────────────────────
133: 
134:     // Send a JSON string to the Gateway (same contract as MockSocket.send).
135:     send(message)
136:     {
137:         if (!this._ws || this._ws.readyState !== WebSocket.OPEN)
138:         {
139:             console.warn('[Socket] send() called while socket is not open');
140:             return;
141:         }
142:         this._ws.send(message);
143:     }
144: 
145:     // ── Private: build the final /controller endpoint URL ──────────────────
146: 
147:     // Prefer the JWT auth_token from ConnectionStore. Before login there is no
148:     // token yet, so we fall back to the pre-JWT CONTROLLER_KEY from the env.
149:     _buildEndpoint()
150:     {
151:         const auth_token = useConnectionStore.getState().auth_token;
152: 
153:         if (auth_token)
154:         {
155:             return `${this._url}/controller?token=${auth_token}`;
156:         }
157: 
158:         const controller_key = import.meta.env.VITE_CONTROLLER_KEY ?? '';
159:         return `${this._url}/controller?key=${controller_key}`;
160:     }
161: 
162:     // ── Private: open + wire up one WebSocket ──────────────────────────────
163: 
164:     _openSocket()
165:     {
166:         // Tell the store we are trying to connect (covers the reconnect gap too).
167:         useConnectionStore.getState().setStatus('connecting');
168: 
169:         let ws;
170:         try
171:         {
172:             ws = new WebSocket(this._buildEndpoint());
173:         }
174:         catch (err)
175:         {
176:             // Bad URL or blocked scheme — report and schedule a retry.
177:             console.error('[Socket] failed to create WebSocket:', err);
178:             this._scheduleReconnect();
179:             return;
180:         }
181: 
182:         // Receive image/video frames as ArrayBuffer, not Blob.
183:         ws.binaryType = 'arraybuffer';
184:         this._ws      = ws;
185: 
186:         ws.onopen = () =>
187:         {
188:             this._retry_count      = 0;   // reset backoff on success
189:             this._opened_once      = true;
190:             this._auth_fail_count  = 0;   // handshake succeeded → JWT is good
191:             useConnectionStore.getState().setStatus('open');
192:             if (this._on_open) this._on_open();
193:         };
194: 
195:         ws.onmessage = (event) =>
196:         {
197:             // Distinguish JSON (string) from binary frame (ArrayBuffer),
198:             // exactly like MockSocket splits onMessage vs onBinary.
199:             if (typeof event.data === 'string')
200:             {
201:                 let parsed;
202:                 try
203:                 {
204:                     parsed = JSON.parse(event.data);
205:                 }
206:                 catch (err)
207:                 {
208:                     console.warn('[Socket] received non-JSON text message:', event.data, err);
209:                     return;
210:                 }
211:                 if (this._on_message) this._on_message(parsed);
212:             }
213:             else
214:             {
215:                 // Binary path: raw JPEG bytes that pair with the last frame_meta.
216:                 if (this._on_binary) this._on_binary(event.data);
217:             }
218:         };
219: 
220:         ws.onerror = (event) =>
221:         {
222:             console.warn('[Socket] socket error:', event);
223:             if (this._on_error) this._on_error(event);
224:         };
225: 
226:         ws.onclose = () =>
227:         {
228:             const never_opened = !this._opened_once;
229:             this._ws           = null;
230:             this._opened_once  = false;      // reset for the next attempt
231:             useConnectionStore.getState().setStatus('closed');
232:             if (this._on_close) this._on_close();
233: 
234:             // JWT expired detection: Gateway rejects at HTTP upgrade with 401,
235:             // browser reports onclose without ever calling onopen. Count these
236:             // consecutive failed opens while an auth_token is set; past the
237:             // threshold, force logout so the operator lands on LoginScreen.
238:             const has_token = !!useConnectionStore.getState().auth_token;
239:             if (never_opened && has_token && !this._closed_by_user)
240:             {
241:                 this._auth_fail_count++;
242:                 if (this._auth_fail_count >= Socket.AUTH_FAIL_THRESHOLD)
243:                 {
244:                     // Try one refresh (HttpOnly refresh cookie is what the
245:                     // server needs — the browser sends it automatically). Only
246:                     // give up and log out if the refresh itself fails.
247:                     this._closed_by_user = true;   // pause the reconnect loop while we refresh
248:                     refreshAccessToken().then((result) =>
249:                     {
250:                         if (result.ok)
251:                         {
252:                             this._auth_fail_count = 0;
253:                             this._closed_by_user  = false;
254:                             this._openSocket();    // handshake with the new JWT
255:                         }
256:                         else
257:                         {
258:                             useUiStore.getState().addToast(
259:                                 'Phiên đăng nhập đã hết hạn. Vui lòng đăng nhập lại.',
260:                                 'error'
261:                             );
262:                             logout();               // clears auth_token → LoginScreen
263:                         }
264:                     });
265:                     return;
266:                 }
267:             }
268: 
269:             // Auto-reconnect unless WE closed it on purpose.
270:             if (!this._closed_by_user)
271:             {
272:                 this._scheduleReconnect();
273:             }
274:         };
275:     }
276: 
277:     // ── Private: exponential backoff reconnect ─────────────────────────────
278: 
279:     _scheduleReconnect()
280:     {
281:         if (this._closed_by_user) return;
282: 
283:         // Backoff: base * 2^retries, capped. e.g. 500, 1000, 2000, ... up to 8000 ms.
284:         const delay = Math.min(RECONNECT_BASE_MS * 2 ** this._retry_count, RECONNECT_MAX_MS);
285:         this._retry_count++;
286: 
287:         console.info(`[Socket] reconnecting in ${delay} ms (attempt ${this._retry_count})`);
288: 
289:         this._reconnect_timer = setTimeout(() =>
290:         {
291:             this._reconnect_timer = null;
292:             if (!this._closed_by_user) this._openSocket();
293:         }, delay);
294:     }
295: }
296: 
297: export default Socket;
</file>

<file path="controller/src/store/E2EEStore.js">
  1: import { create } from 'zustand'
  2: 
  3: // Simple Native IndexedDB Wrapper
  4: const DB_NAME = 'RemoteControl_E2EE'
  5: const STORE_NAME = 'agent_pins'
  6: 
  7: const getDB = () => {
  8:     return new Promise((resolve, reject) => {
  9:         const request = window.indexedDB.open(DB_NAME, 1)
 10:         request.onupgradeneeded = (event) => {
 11:             const db = event.target.result
 12:             if (!db.objectStoreNames.contains(STORE_NAME)) {
 13:                 db.createObjectStore(STORE_NAME, { keyPath: 'agentId' })
 14:             }
 15:         }
 16:         request.onsuccess = () => resolve(request.result)
 17:         request.onerror = () => reject(request.error)
 18:     })
 19: }
 20: 
 21: const idbGet = async (key) => {
 22:     const db = await getDB()
 23:     return new Promise((resolve, reject) => {
 24:         const tx = db.transaction(STORE_NAME, 'readonly')
 25:         const store = tx.objectStore(STORE_NAME)
 26:         const request = store.get(key)
 27:         request.onsuccess = () => resolve(request.result?.data)
 28:         request.onerror = () => reject(request.error)
 29:     })
 30: }
 31: 
 32: const idbSet = async (key, data) => {
 33:     const db = await getDB()
 34:     return new Promise((resolve, reject) => {
 35:         const tx = db.transaction(STORE_NAME, 'readwrite')
 36:         const store = tx.objectStore(STORE_NAME)
 37:         const request = store.put({ agentId: key, data })
 38:         request.onsuccess = () => resolve()
 39:         request.onerror = () => reject(request.error)
 40:     })
 41: }
 42: 
 43: // Master Password Crypto (PBKDF2 + AES-GCM)
 44: const getMasterKey = async (password) => {
 45:     const enc = new TextEncoder()
 46:     const keyMaterial = await window.crypto.subtle.importKey(
 47:         'raw', enc.encode(password), { name: 'PBKDF2' }, false, ['deriveKey']
 48:     )
 49:     return await window.crypto.subtle.deriveKey(
 50:         {
 51:             name: 'PBKDF2',
 52:             salt: enc.encode('RemoteControl_Salt_V1'),
 53:             iterations: 600000,
 54:             hash: 'SHA-256'
 55:         },
 56:         keyMaterial,
 57:         { name: 'AES-GCM', length: 256 },
 58:         false,
 59:         ['encrypt', 'decrypt']
 60:     )
 61: }
 62: 
 63: const arrayBufferToBase64 = (buffer) => {
 64:     let binary = ''
 65:     const bytes = new Uint8Array(buffer)
 66:     for (let i = 0; i < bytes.byteLength; i++) {
 67:         binary += String.fromCharCode(bytes[i])
 68:     }
 69:     return window.btoa(binary)
 70: }
 71: 
 72: const base64ToArrayBuffer = (base64) => {
 73:     const binary = window.atob(base64)
 74:     const bytes = new Uint8Array(binary.length)
 75:     for (let i = 0; i < binary.length; i++) {
 76:         bytes[i] = binary.charCodeAt(i)
 77:     }
 78:     return bytes.buffer
 79: }
 80: 
 81: const encryptData = async (key, plainText) => {
 82:     const iv = window.crypto.getRandomValues(new Uint8Array(12))
 83:     const enc = new TextEncoder()
 84:     const cipherBuffer = await window.crypto.subtle.encrypt(
 85:         { name: 'AES-GCM', iv }, key, enc.encode(plainText)
 86:     )
 87:     
 88:     // Combine IV and Ciphertext for storage
 89:     const combined = new Uint8Array(12 + cipherBuffer.byteLength)
 90:     combined.set(iv, 0)
 91:     combined.set(new Uint8Array(cipherBuffer), 12)
 92:     return arrayBufferToBase64(combined.buffer)
 93: }
 94: 
 95: const decryptData = async (key, base64Data) => {
 96:     const combined = new Uint8Array(base64ToArrayBuffer(base64Data))
 97:     const iv = combined.slice(0, 12)
 98:     const data = combined.slice(12)
 99:     const plainBuffer = await window.crypto.subtle.decrypt(
100:         { name: 'AES-GCM', iv }, key, data
101:     )
102:     return new TextDecoder().decode(plainBuffer)
103: }
104: 
105: // Zustand Store
106: const useE2EEStore = create((set, get) => ({
107:     isUnlocked: false,
108:     masterKey: null, // CryptoKey instance
109:     
110:     // Per-agent sessions
111:     // Structure: { [agentId]: { state: 'uninitialized' | 'handshaking' | 'ready', sessionKey: CryptoKey, udpKeyBuffer: ArrayBuffer, udpEpoch: number, udpFrameIdOffset: number, udpLastSeq: number, sendSeq: number, recvSeq: number } }
112:     sessions: {},
113: 
114:     setSessionState: (agentId, state, sessionKeys = null) => {
115:         set((prev) => ({
116:             sessions: {
117:                 ...prev.sessions,
118:                 [agentId]: {
119:                     ...prev.sessions[agentId],
120:                     state,
121:                     sessionKey: sessionKeys ? sessionKeys.tcpKey : prev.sessions[agentId]?.sessionKey,
122:                     udpKeyBuffer: sessionKeys ? sessionKeys.udpKeyBuffer : prev.sessions[agentId]?.udpKeyBuffer,
123:                     udpEpoch: state === 'handshaking' ? 0 : (prev.sessions[agentId]?.udpEpoch ?? 0),
124:                     udpFrameIdOffset: state === 'handshaking' ? 0 : (prev.sessions[agentId]?.udpFrameIdOffset ?? 0),
125:                     udpLastSeq: state === 'handshaking' ? 0 : (prev.sessions[agentId]?.udpLastSeq ?? 0),
126:                     sendSeq: state === 'handshaking' ? 0 : (prev.sessions[agentId]?.sendSeq ?? 0),
127:                     recvSeq: state === 'handshaking' ? -1 : (prev.sessions[agentId]?.recvSeq ?? -1)
128:                 }
129:             }
130:         }))
131:     },
132: 
133:     resetSession: (agentId) => {
134:         set((prev) => {
135:             const nextSessions = { ...prev.sessions };
136:             delete nextSessions[agentId];
137:             return { sessions: nextSessions };
138:         })
139:     },
140: 
141:     getSendSeqAndIncrement: (agentId) => {
142:         const session = get().sessions[agentId]
143:         if (!session || session.state !== 'ready') return null
144:         
145:         const seq = session.sendSeq
146:         set((prev) => ({
147:             sessions: {
148:                 ...prev.sessions,
149:                 [agentId]: { ...prev.sessions[agentId], sendSeq: seq + 1 }
150:             }
151:         }))
152:         return seq
153:     },
154: 
155:     checkAndUpdateRecvSeq: (agentId, seq) => {
156:         const session = get().sessions[agentId]
157:         if (!session || session.state !== 'ready') return false
158: 
159:         if (session.recvSeq === -1) {
160:             set((prev) => ({
161:                 sessions: {
162:                     ...prev.sessions,
163:                     [agentId]: { ...prev.sessions[agentId], recvSeq: seq }
164:                 }
165:             }))
166:             return true;
167:         }
168: 
169:         // Sliding window of 5
170:         const WINDOW_SIZE = 5
171:         if (seq <= session.recvSeq - WINDOW_SIZE) return false // Too old
172:         
173:         // Update max recv sequence
174:         set((prev) => ({
175:             sessions: {
176:                 ...prev.sessions,
177:                 [agentId]: { ...prev.sessions[agentId], recvSeq: Math.max(session.recvSeq, seq) }
178:             }
179:         }))
180:         return true
181:     },
182: 
183:     updateUdpRatchet: (agentId, newKeyBuffer, newEpoch) => {
184:         set((prev) => ({
185:             sessions: {
186:                 ...prev.sessions,
187:                 [agentId]: {
188:                     ...prev.sessions[agentId],
189:                     udpKeyBuffer: newKeyBuffer,
190:                     udpEpoch: newEpoch
191:                 }
192:             }
193:         }))
194:     },
195: 
196:     updateUdpSeq: (agentId, seq) => {
197:         const session = get().sessions[agentId];
198:         if (!session || session.state !== 'ready') return 0;
199:         
200:         let offset = session.udpFrameIdOffset || 0;
201:         let lastSeq = session.udpLastSeq || 0;
202:         
203:         // Wraparound detection for 16-bit sequence
204:         if (seq < lastSeq && (lastSeq - seq > 30000)) {
205:             offset += 65536;
206:         }
207:         
208:         set((prev) => ({
209:             sessions: {
210:                 ...prev.sessions,
211:                 [agentId]: {
212:                     ...prev.sessions[agentId],
213:                     udpFrameIdOffset: offset,
214:                     udpLastSeq: seq
215:                 }
216:             }
217:         }));
218:         return offset + seq;
219:     },
220: 
221:     getSessionKey: (agentId) => {
222:         const session = get().sessions[agentId]
223:         return session?.state === 'ready' ? session.sessionKey : null
224:     },
225: 
226:     unlock: async (password) => {
227:         try {
228:             const key = await getMasterKey(password)
229:             // To verify if password is correct, we could check a test encryption,
230:             // but for TOFU (Trust On First Use) or simple design, we just store it.
231:             // If decrypt fails later, we know it's wrong.
232:             set({ isUnlocked: true, masterKey: key })
233:             return true
234:         } catch (e) {
235:             console.error('Failed to unlock E2EE', e)
236:             return false
237:         }
238:     },
239: 
240:     lock: () => {
241:         set({ isUnlocked: false, masterKey: null })
242:     },
243: 
244:     saveAgentPin: async (agentId, pin) => {
245:         const { masterKey, isUnlocked } = get()
246:         if (!isUnlocked) throw new Error("E2EE Store is locked")
247:         
248:         const encryptedPin = await encryptData(masterKey, pin)
249:         await idbSet(agentId, encryptedPin)
250:     },
251: 
252:     getAgentPin: async (agentId) => {
253:         const { masterKey, isUnlocked } = get()
254:         if (!isUnlocked) throw new Error("E2EE Store is locked")
255: 
256:         const encryptedPin = await idbGet(agentId)
257:         if (!encryptedPin) return null // No PIN saved yet
258:         
259:         try {
260:             return await decryptData(masterKey, encryptedPin)
261:         } catch (e) {
262:             console.error("Failed to decrypt PIN, maybe wrong master password?", e)
263:             return null // Decryption failed
264:         }
265:     }
266: }))
