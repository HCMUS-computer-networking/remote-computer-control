  66: // ─── Static fake data ─────────────────────────────────────────────────────────
  67: 
  68: // 7 fake agents covering many test cases:
  69: //   agent-01 : plain Windows online, idle          — baseline
  70: //   agent-02 : Windows online, currently in-session — session badge + red indicator
  71: //   agent-03 : Windows offline                      — offline UI + no focus
  72: //   agent-04 : Windows online, short app list       — different app content
  73: //   agent-05 : Ubuntu Linux online                  — Linux OS, different apps/procs
  74: //   agent-06 : Windows online, DENIES consent       — keylog/webcam denied flow
  75: //   agent-07 : macOS offline                        — non-Windows offline agent
  76: const FAKE_AGENTS =
  77: [
  78:     { id: "agent-01", name: "PC-Lab-01",      os: "Windows 11",  ip: "192.168.1.101", online: true,  in_session: false },
  79:     { id: "agent-02", name: "PC-Lab-02",      os: "Windows 11",  ip: "192.168.1.102", online: true,  in_session: true  },
  80:     { id: "agent-03", name: "PC-Lab-03",      os: "Windows 10",  ip: "192.168.1.103", online: false, in_session: false },
  81:     { id: "agent-04", name: "PC-Lab-04",      os: "Windows 11",  ip: "192.168.1.104", online: true,  in_session: false },
  82:     { id: "agent-05", name: "DEV-Ubuntu-01",  os: "Ubuntu 22.04",ip: "192.168.1.105", online: true,  in_session: false },
  83:     { id: "agent-06", name: "PC-Lab-06",      os: "Windows 10",  ip: "192.168.1.106", online: true,  in_session: true  },
  84:     { id: "agent-07", name: "MacBook-Lab-01", os: "macOS 14",    ip: "192.168.1.107", online: false, in_session: false },
  85: ]
