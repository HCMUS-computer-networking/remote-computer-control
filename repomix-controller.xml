   1: // UseAgentSocket.js — sole glue layer between the socket service and Zustand stores.
   2: //
   3: // Components must NEVER import MockSocket or Socket directly; they use this hook.
   4: // Swapping MockSocket for the real Socket only requires changing the one import below.
   5: //
   6: // SINGLETON PATTERN — ref-counted so multiple components can call useAgentSocket()
   7: // without opening extra WebSocket connections.
   8: // The socket is created when the first caller mounts (refcount 0 → 1) and closed
   9: // when the last caller unmounts (refcount 1 → 0, i.e. the whole app tears down).
  10: //
  11: // TARGETING — the hook returns three send helpers:
  12: //   sendCommand(json)     — raw: sends the JSON string as-is (for list_agents, power, etc.)
  13: //   sendToFocused(json)   — auto-injects [focused_agent_id] into target_agents
  14: //                           before sending. Used by module tabs in FocusView.
  15: //   sendToSelected(json)  — auto-injects selected_agent_ids into target_agents
  16: //                           before sending. Used for batch commands.
  17: //
  18: // BINARY FRAME DISPATCH — screen/webcam JPEG frames arrive as two consecutive
  19: // messages: a JSON frame_meta followed by a raw ArrayBuffer. We hold the most
  20: // recent frame_meta in _pending_meta. When a binary message arrives we pair it
  21: // with _pending_meta and push the complete frame into ModuleStore.
  22: //
  23: // RX DISPATCH — every incoming message is routed by its "type" field to the
  24: // correct Zustand store action. See the dispatchMessage() function at the bottom
  25: // for the full routing table.
  26: 
  27: import { useEffect } from 'react'
  28: 
  29: import AgentSocket                       from '../services'   // mock or real, chosen by VITE_USE_MOCK in services/index.js
  30: import { buildListAgents, buildPolicyUpdate, buildPermissionRequest, buildPermissionRevoke, buildStopModule, normalizeIncoming, MSG_TYPE, MODULE, FEATURE } from '../services/Protocol'
  31: import { refreshAccessToken, logout }    from '../services/AuthService'
  32: import useE2EEStore                      from '../store/E2EEStore'
  33: import { generateECDHKeyPair, exportPublicKeyToSPKI, signHMAC, importPublicKeyFromSPKI, verifyHMAC, deriveSessionKey, stepRatchetKey, encryptAESGCM, decryptAESGCM, generateIV, arrayBufferToBase64, base64ToArrayBuffer } from '../utils/crypto'
  34: 
  35: // Modules that only make sense against ONE agent at a time (the operator is
  36: // watching a single feed). sendCommand routes these to focused_agent_id even
  37: // when a multi-select set is present, so a Live-Screen click never floods
  38: // every selected agent with a stream request.
  39: const FRAME_FOCUS_MODULES = new Set([
  40:     MODULE.SCREENSHOT,
  41:     MODULE.SCREEN_STREAM,
  42:     MODULE.SCREEN_STREAM_STOP,
  43:     MODULE.WEBCAM_START,
  44:     MODULE.WEBCAM_STOP,
  45: ])
  46: 
  47: // Map every module command name to the FEATURE it needs consent for. Plan B
  48: // only sends a module command to an agent that already granted this feature.
  49: // "power" messages are mapped separately (they use a top-level "power" type,
  50: // not a "module" field) — see featureForMessage below.
  51: const MODULE_FEATURE = {
  52:     [MODULE.APP_LIST]           : FEATURE.APPLICATION,
  53:     [MODULE.APP_START]          : FEATURE.APPLICATION,
  54:     [MODULE.APP_STOP]           : FEATURE.APPLICATION,
  55:     [MODULE.PROC_LIST]          : FEATURE.PROCESS,
  56:     [MODULE.PROC_KILL]          : FEATURE.PROCESS,
  57:     [MODULE.SCREENSHOT]         : FEATURE.SCREEN,
  58:     [MODULE.SCREEN_STREAM]      : FEATURE.SCREEN,
  59:     [MODULE.SCREEN_STREAM_STOP] : FEATURE.SCREEN,
  60:     [MODULE.KEYLOG_START]       : FEATURE.KEYLOG,
  61:     [MODULE.KEYLOG_STOP]        : FEATURE.KEYLOG,
  62:     [MODULE.FS_LIST]            : FEATURE.FILE,
  63:     [MODULE.FS_GET]             : FEATURE.FILE,
  64:     [MODULE.FS_PUT]             : FEATURE.FILE,
  65:     [MODULE.WEBCAM_START]       : FEATURE.WEBCAM,
  66:     [MODULE.WEBCAM_STOP]        : FEATURE.WEBCAM,
  67:     // Remote Input — 4 commands share ONE feature "input" (not "screen") so                       //
  68:     // the operator must obtain a dedicated consent grant before driving the                       //
  69:     // Agent's mouse or keyboard.                                                                  //
  70:     'input_mouse_move'          : FEATURE.INPUT,
  71:     'input_mouse_click'         : FEATURE.INPUT,
  72:     'input_key'                 : FEATURE.INPUT,
  73:     'input_type'                : FEATURE.INPUT,
  74: }
  75: 
  76: // Return the FEATURE a message needs consent for, or null when it needs none
  77: // (e.g. list_agents). Power uses its own top-level type; every request maps by
  78: // its module field.
  79: function featureForMessage(msg)
  80: {
  81:     if (msg.type === MSG_TYPE.POWER)   return FEATURE.POWER
  82:     if (msg.type === MSG_TYPE.REQUEST) return MODULE_FEATURE[msg.module] ?? null
  83:     return null
  84: }
  85: import useConnectionStore                from '../store/ConnectionStore'
  86: import useAgentStore                     from '../store/AgentStore'
  87: import useModuleStore                    from '../store/ModuleStore'
  88: import useUiStore                        from '../store/UiStore'
  89: import usePolicyStore                    from '../store/PolicyStore'
  90: import usePermissionStore                from '../store/PermissionStore'
  91: 
  92: // ── Singleton state (module-level, shared across all hook invocations) ────────
  93: 
  94: let _socket           = null   // the one shared socket instance
  95: let _refcount         = 0      // how many mounted components hold a reference
  96: let _pending_meta     = null   // last frame_meta awaiting its binary companion
  97: let _pending_fs_chunks = new Map()   // fs_get_result (binary mode) awaiting bytes, keyed by transfer_id — Map preserves insertion order for FIFO pairing when multiple downloads run in parallel
  98: const _pendingE2EEKeys = new Map()   // agent_id -> privateKey (temporary during handshake)
  99: 
 100: // ── E2EE Handshake Init ───────────────────────────────────────────────────────
 101: async function initE2EE(agent_id, socket) {
 102:     const e2eeStore = useE2EEStore.getState()
 103:     if (!e2eeStore.isUnlocked) return
 104:     let pin = await e2eeStore.getAgentPin(agent_id)
 105:     if (!pin) {
 106:         console.info(`[E2EE] No custom PIN saved for agent ${agent_id}. Using default-pin-12345.`)
 107:         pin = "default-pin-12345"
 108:     }
 109: 
 110:     try {
 111:         e2eeStore.setSessionState(agent_id, 'handshaking')
 112:         const keyPair = await generateECDHKeyPair()
 113:         const pubKeyBase64 = await exportPublicKeyToSPKI(keyPair.publicKey)
 114:         const signatureBase64 = await signHMAC(pubKeyBase64, pin)
 115: 
 116:         _pendingE2EEKeys.set(agent_id, keyPair.privateKey)
 117: 
 118:         const initMsg = {
 119:             type: MSG_TYPE.E2EE_INIT,
 120:             target_agents: [agent_id],
 121:             publicKey: pubKeyBase64,
 122:             signature: signatureBase64
 123:         }
 124:         if (socket) socket.send(JSON.stringify(initMsg))
 125:     } catch (err) {
 126:         console.error(`[E2EE] Handshake init failed for ${agent_id}`, err)
 127:     }
 128: }
 129: 
 130: async function handleE2EEPayload(msg) {
 131:     const sessionKey = useE2EEStore.getState().getSessionKey(msg.agent_id)
 132:     if (!sessionKey) {
 133:         console.error(`[E2EE] Received payload from ${msg.agent_id} but no session key!`)
 134:         return null
 135:     }
 136:     
 137:     if (!useE2EEStore.getState().checkAndUpdateRecvSeq(msg.agent_id, msg.seq)) {
 138:         console.error(`[E2EE] Sequence attack / drift from ${msg.agent_id}, seq: ${msg.seq}`)
 139:         return null
 140:     }
 141: 
 142:     try {
 143:         const combined = new Uint8Array(base64ToArrayBuffer(msg.data))
 144:         const iv = combined.slice(0, 12)
 145:         const dataToDecrypt = combined.slice(12)
 146:         const decryptedBuffer = await decryptAESGCM(sessionKey, dataToDecrypt, iv)
 147:         const jsonStr = new TextDecoder().decode(decryptedBuffer)
 148:         
 149:         return normalizeIncoming(JSON.parse(jsonStr))
 150:     } catch (e) {
 151:         console.error(`[E2EE] Decryption failed for ${msg.agent_id}`, e)
 152:         return null
 153:     }
 154: }
 155: 
 156: // ─────────────────────────────────────────────────────────────────────────────
 157: 
 158: export default function useAgentSocket()
 159: {
 160:     // Read store actions directly via getState() instead of hook selectors.
 161:     // Actions are stable function refs that never change, so we do not need
 162:     // to subscribe to the stores here — we only call the actions inside
 163:     // socket callbacks which run outside the React render cycle anyway.
 164:     // This also keeps the hook count constant (only 1 useEffect below),
 165:     // which avoids HMR hook-order mismatches during development.
 166:     const setStatus        = useConnectionStore.getState().setStatus
 167:     const setAgents        = useAgentStore.getState().setAgents
 168:     const setAgentStatus   = useAgentStore.getState().setAgentStatus
 169:     const setModuleData    = useModuleStore.getState().setModuleData
 170:     const appendKeylog     = useModuleStore.getState().appendKeylog
 171:     const appendSysInfo    = useModuleStore.getState().appendSysInfo
 172:     const setKeylogActive   = useModuleStore.getState().setKeylogActive
 173:     const setWebcamActive   = useModuleStore.getState().setWebcamActive
 174:     const setScreenStreamActive = useModuleStore.getState().setScreenStreamActive
 175:     const setInputActive        = useModuleStore.getState().setInputActive
 176:     const setFsEntries      = useModuleStore.getState().setFsEntries
 177:     const appendFileDownloadChunk = useModuleStore.getState().appendFileDownloadChunk
 178:     const setFilePutAck     = useModuleStore.getState().setFilePutAck
 179:     const setPolicyResult   = usePolicyStore.getState().setPolicyResult
 180:     const setPermissionResult = usePermissionStore.getState().setPermissionResult
 181:     const addToast          = useUiStore.getState().addToast
 182: 
 183:     const isUnlocked        = useE2EEStore((s) => s.isUnlocked)
 184: 
 185:     // Automatically trigger handshake when user unlocks the Master Password
 186:     useEffect(() => {
 187:         if (isUnlocked && _socket) {
 188:             const currentAgents = useAgentStore.getState().agents;
 189:             currentAgents.forEach(a => {
 190:                 if (a.online) {
 191:                     const session = useE2EEStore.getState().sessions[a.id];
 192:                     if (!session || session.state === 'uninitialized') {
 193:                         initE2EE(a.id, _socket);
 194:                     }
 195:                 }
 196:             });
 197:         }
 198:     }, [isUnlocked]);
 199: 
 200:     // ── Lifecycle: create / destroy the shared socket ─────────────────────
 201:     useEffect(function ()
 202:     {
 203:         _refcount++
 204: 
 205:         // First caller creates the socket; later callers just bump the count.
 206:         if (_socket === null)
 207:         {
 208:             const socket = new AgentSocket()
 209:             _socket      = socket
 210: 
 211:             socket.onOpen(function ()
 212:             {
 213:                 setStatus('open')
 214:                 socket.send(buildListAgents())   // request agent list right away
 215: 
 216:                 // Push the security policy (app_whitelist + sandbox_path) to every
 217:                 // agent on connect. Empty target_agents = all agents. The Agent
 218:                 // overrides its local config in RAM and replies policy_update_result.
 219:                 const policy = usePolicyStore.getState()
 220:                 socket.send(buildPolicyUpdate(policy.app_whitelist, policy.sandbox_path, []))
 221:             })
 222: 
 223:             socket.onMessage(function (raw_msg)
 224:             {
 225:                 // Normalize the real Gateway/Agent JSON into our canonical shape
 226:                 // first, so dispatchMessage + stores stay unchanged. Mock messages
 227:                 // are already canonical and pass through untouched.
 228:                 const msg = normalizeIncoming(raw_msg)
 229: 
 230:                 if (msg.type === MSG_TYPE.E2EE_PAYLOAD) {
 231:                     handleE2EEPayload(msg).then(decryptedMsg => {
 232:                         if (decryptedMsg) {
 233:                             dispatchMessage(decryptedMsg, { setStatus, setAgents, setAgentStatus, setModuleData, appendKeylog, appendSysInfo, setKeylogActive, setWebcamActive, setScreenStreamActive, setInputActive, setFsEntries, appendFileDownloadChunk,setFilePutAck, setPolicyResult, setPermissionResult, addToast })
 234:                         }
 235:                     })
 236:                     return
 237:                 }
 238: 
 239:                 dispatchMessage(msg, { setStatus, setAgents, setAgentStatus, setModuleData, appendKeylog, appendSysInfo, setKeylogActive, setWebcamActive, setScreenStreamActive, setInputActive, setFsEntries, appendFileDownloadChunk,setFilePutAck, setPolicyResult, setPermissionResult, addToast })
 240:             })
 241: 
 242:             // Binary callback — pair incoming ArrayBuffer with the pending frame_meta.
 243:             // This runs immediately after the frame_meta JSON callback above,
 244:             // so _pending_meta is guaranteed to be the matching header.
 245:             socket.onBinary(async function (buffer)
 246:             {
 247:                 // File-transfer binary chunk takes priority: fs_get_result is
 248:                 // request-driven and always paired 1:1 with the next binary,
 249:                 // whereas frame_meta belongs to a continuous stream.
 250:                 if (_pending_fs_chunks.size > 0)
 251:                 {
 252:                     // FIFO pairing: pop the OLDEST pending meta
 253:                     const first_key = _pending_fs_chunks.keys().next().value
 254:                     const meta      = _pending_fs_chunks.get(first_key)
 255:                     _pending_fs_chunks.delete(first_key)
 256:                     appendFileDownloadChunk(meta.agent_id,
 257:                     {
 258:                         transfer_id  : meta.transfer_id,
 259:                         chunk_index  : meta.chunk_index,
 260:                         total_chunks : meta.total_chunks,
 261:                         path         : meta.path,
 262:                         total_size   : meta.total_size,
 263:                         bytes        : new Uint8Array(buffer),
 264:                     })
 265:                     return
 266:                 }
 267: 
 268:                 if (!_pending_meta)
 269:                 {
 270:                     console.warn('[useAgentSocket] binary arrived without pending frame_meta / fs_chunks — dropped')
 271:                     return
 272:                 }
 273: 
 274:                 const meta      = _pending_meta
 275:                 _pending_meta   = null            // consume the pending meta
 276: 
 277:                 // Sanity check
 278:                 if (meta.len != null && meta.len !== buffer.byteLength)
 279:                 {
 280:                     console.warn(
 281:                         `[useAgentSocket] frame length mismatch for ${meta.agent_id}/${meta.module}: ` +
 282:                         `meta.len=${meta.len} but buffer=${buffer.byteLength} bytes — possible mis-pairing`
 283:                     )
 284:                 }
 285: 
 286:                 // Route to the correct module slot (screen or webcam)
 287:                 const module_key = meta.module    // "screen" or "webcam"
 288:                 
 289:                 // E2EE Decryption for UDP Stream
 290:                 const session = useE2EEStore.getState().sessions[meta.agent_id];
 291:                 if (session && session.state === 'ready') {
 292:                     try {
 293:                         const combined = new Uint8Array(buffer);
 294:                         const iv = combined.slice(0, 12);
 295:                         const dataToDecrypt = combined.slice(12);
 296: 
 297:                         // AAD = FrameId (2 bytes) + TimestampMs (8 bytes)
 298:                         const aad = new ArrayBuffer(10);
 299:                         const view = new DataView(aad);
 300:                         view.setUint16(0, meta.seq, true);
 301:                         view.setBigUint64(2, BigInt(meta.timestamp_ms), true);
 302:                         
 303:                         // SYMMETRIC RATCHET LOGIC
 304:                         let absoluteSeq = useE2EEStore.getState().updateUdpSeq(meta.agent_id, meta.seq);
 305:                         let pktEpoch = Math.floor(absoluteSeq / 100);
 306:                         let currentUdpEpoch = session.udpEpoch;
 307:                         let udpKeyBuffer = session.udpKeyBuffer;
 308:                         
 309:                         if (pktEpoch > currentUdpEpoch) {
 310:                             while (currentUdpEpoch < pktEpoch) {
 311:                                 udpKeyBuffer = await stepRatchetKey(udpKeyBuffer);
 312:                                 currentUdpEpoch++;
 313:                             }
 314:                             useE2EEStore.getState().updateUdpRatchet(meta.agent_id, udpKeyBuffer, currentUdpEpoch);
 315:                         }
 316:                         
 317:                         // Import udpKeyBuffer to CryptoKey
 318:                         const udpKey = await window.crypto.subtle.importKey('raw', udpKeyBuffer, 'AES-GCM', false, ['decrypt']);
 319: 
 320:                         const decryptedBuffer = await decryptAESGCM(udpKey, dataToDecrypt, iv, new Uint8Array(aad));
 321:                         
 322:                         // Bắn event trực tiếp thay vì lưu vào React State (Gotcha 1)
 323:                         import('../services/FrameEventBus').then(({ default: frameEventBus }) => {
 324:                             frameEventBus.emit(meta.agent_id, module_key, decryptedBuffer, meta);
 325:                         });
 326:                         // Vẫn lưu meta vào store (không lưu frame) để UI hiển thị thông số độ phân giải nếu cần
 327:                         setModuleData(meta.agent_id, module_key, { meta });
 328:                     } catch (e) {
 329:                         console.error(`[E2EE] Bỏ qua UDP packet từ ${meta.agent_id} do lỗi giải mã AES-GCM (sai Key hoặc AAD):`, e);
 330:                     }
 331:                 } else {
 332:                     console.warn(`[E2EE] Drop UDP packet from ${meta.agent_id} (Session not ready)`);
 333:                 }
 334:             })
 335: 
 336:             // Drop any half-received frame_meta so the next reconnect's first
 337:             // binary cannot pair with a stale header from a prior session.
 338:             // Also reset every LIVE / CAM ON / KEYLOG indicator — the socket                       //
 339:             // being down means no stream can possibly still be running.                            //
 340:             socket.onClose(function () { _pending_meta = null; _pending_fs_chunks.clear(); useModuleStore.getState().clearAllLiveFlags(); setStatus('closed') })
 341:             socket.onError(function () { _pending_meta = null; _pending_fs_chunks.clear(); useModuleStore.getState().clearAllLiveFlags(); setStatus('closed') })
 342: 
 343:             socket.connect()
 344:         }
 345: 
 346:         return function ()
 347:         {
 348:             _refcount--
 349:             if (_refcount === 0 && _socket !== null)
 350:             {
 351:                 _pending_meta     = null
 352:                 _pending_fs_chunks.clear()
 353:                 _socket.close()
 354:                 _socket = null
 355:             }
 356:         }
 357:     }, [])   // run once per component mount
 358: 
 359:     // ── TX helpers ────────────────────────────────────────────────────────
 360: 
 361:     // Send a JSON string. Plan B is "broadcast + Controller filter": the Gateway
 362:     // does NOT fan out a single target_agents=[id1, id2, ...] message for us, so
 363:     // multi-agent commands are LOOP-EMITTED here — one message per agent, each
 364:     // carrying target_agents=[one_id]. This lets us filter per (agent, feature)
 365:     // consent before emitting.
 366:     //
 367:     // Target resolution when the caller left target_agents empty:
 368:     //   - "Frame focus" modules (screenshot / screen_stream / webcam) look at a
 369:     //     single agent at a time → use focused_agent_id.
 370:     //   - Every other module command → use selected_agent_ids so ONE click can
 371:     //     drive many agents; falls back to focused_agent_id when nothing is
 372:     //     selected.
 373:     //
 374:     // NOTE: the top-level "list_agents" message and any type without a
 375:     // target_agents field are sent as-is (no fan-out, no permission filter).
 376:     function sendCommand(json_string)
 377:     {
 378:         if (!_socket)
 379:         {
 380:             console.warn('[useAgentSocket] sendCommand called before socket is ready')
 381:             return
 382:         }
 383: 
 384:         // Fast path: not JSON we understand — just pass through.
 385:         let msg
 386:         try { msg = JSON.parse(json_string) }
 387:         catch { _socket.send(json_string); return }
 388: 
 389:         // Only "request" and "power" carry target_agents and need fan-out +
 390:         // permission filtering. Anything else (list_agents, etc.) is sent as-is.
 391:         if (msg.type !== MSG_TYPE.REQUEST && msg.type !== MSG_TYPE.POWER)
 392:         {
 393:             _socket.send(json_string)
 394:             return
 395:         }
 396: 
 397:         // Respect explicit targeting from the caller; else auto-resolve targets.
 398:         let targets
 399:         if (Array.isArray(msg.target_agents) && msg.target_agents.length > 0)
 400:         {
 401:             targets = msg.target_agents
 402:         }
 403:         else
 404:         {
 405:             const focused_id = useAgentStore.getState().focused_agent_id
 406:             if (FRAME_FOCUS_MODULES.has(msg.module))
 407:             {
 408:                 targets = focused_id ? [focused_id] : []
 409:             }
 410:             else
 411:             {
 412:                 const selected_ids = useAgentStore.getState().selected_agent_ids
 413:                 targets = (selected_ids && selected_ids.length > 0)
 414:                     ? selected_ids
 415:                     : (focused_id ? [focused_id] : [])
 416:             }
 417:         }
 418: 
 419:         if (targets.length === 0)
 420:         {
 421:             console.warn('[useAgentSocket] command dropped — no selection and no focused agent')
 422:             return
 423:         }
 424: 
 425:         fanoutSend(msg, targets, {})
 426:     }
 427: 
 428:     // Loop-emit a module command to [focused_agent_id] (one agent).
 429:     // Module tabs in FocusView call sendToFocused(buildAppList()) instead of
 430:     // threading agent.id into every builder. Permission filtering still applies.
 431:     // options.silent — when true, suppress the aggregate "N agents not granted"                  //
 432:     // toast (used by polling tabs so a 3 s tick does not spam the operator).                     //
 433:     function sendToFocused(json_string, options)
 434:     {
 435:         const focused_id = useAgentStore.getState().focused_agent_id
 436:         if (!focused_id)
 437:         {
 438:             console.warn('[useAgentSocket] sendToFocused: no agent focused — message dropped')
 439:             return
 440:         }
 441:         dispatchFanout(json_string, [focused_id], options)
 442:     }
 443: 
 444:     // Loop-emit a module command to every agent in selected_agent_ids — one
 445:     // message per agent (never a single multi-ID message). Permission filtering
 446:     // applies, so only agents that granted the feature actually receive it.
 447:     function sendToSelected(json_string, options)
 448:     {
 449:         const ids = useAgentStore.getState().selected_agent_ids
 450:         if (!ids || ids.length === 0)
 451:         {
 452:             console.warn('[useAgentSocket] sendToSelected: no agents selected — message dropped')
 453:             return
 454:         }
 455:         dispatchFanout(json_string, ids, options)
 456:     }
 457: 
 458:     // ── Permission flow helpers (Plan B — consent before any module command) ─
 459: 
 460:     // Resolve which agents a permission action targets. An explicit agent_id
 461:     // (from a per-agent PermissionGate) acts on that one agent; when omitted we
 462:     // act on the whole multi-select set (bulk Connect / Disconnect), falling
 463:     // back to the focused agent. Always returns an array so callers loop-emit.
 464:     // Permission messages are NOT consent-filtered — they establish consent.
 465:     function resolvePermissionTargets(agent_id)
 466:     {
 467:         if (agent_id) return [agent_id]
 468:         const selected = useAgentStore.getState().selected_agent_ids
 469:         if (selected && selected.length > 0) return selected
 470:         const focused = useAgentStore.getState().focused_agent_id
 471:         return focused ? [focused] : []
 472:     }
 473: 
 474:     // Ask each target agent to grant a feature. Marks every pair 'requesting'
 475:     // locally and loop-emits one permission_request per agent; each Agent reply
 476:     // routes back to setPermissionResult.
 477:     function requestPermission(feature, agent_id)
 478:     {
 479:         const targets = resolvePermissionTargets(agent_id)
 480:         if (targets.length === 0)
 481:         {
 482:             console.warn('[useAgentSocket] requestPermission: no agent target — dropped')
 483:             return
 484:         }
 485:         const perm_store = usePermissionStore.getState()
 486:         for (const id of targets)
 487:         {
 488:             perm_store.requestPermission(id, feature)
 489:             sendWithTargets(buildPermissionRequest(feature), [id])   // one per agent
 490:         }
 491:     }
 492: 
 493:     // Withdraw a feature from each target: loop-emit permission_revoke, reset
 494:     // local consent to 'idle', and drop the live indicator (stream / keylog /
 495:     // webcam) for that feature on that agent.
 496:     function revokePermission(feature, agent_id)
 497:     {
 498:         const targets = resolvePermissionTargets(agent_id)
 499:         if (targets.length === 0)
 500:         {
 501:             console.warn('[useAgentSocket] revokePermission: no agent target — dropped')
 502:             return
 503:         }
 504:         const perm_store = usePermissionStore.getState()
 505:         for (const id of targets)
 506:         {
 507:             sendWithTargets(buildPermissionRevoke(feature), [id])    // one per agent
 508:             perm_store.revoke(id, feature)
 509:             stopLocalFeature(id, feature)
 510:         }
 511:     }
 512: 
 513:     // Tell each target Agent to stop a running feature and clear its local live
 514:     // indicator. Loop-emits one stop_module per agent.
 515:     function stopModule(feature, agent_id)
 516:     {
 517:         const targets = resolvePermissionTargets(agent_id)
 518:         if (targets.length === 0)
 519:         {
 520:             console.warn('[useAgentSocket] stopModule: no agent target — dropped')
 521:             return
 522:         }
 523:         for (const id of targets)
 524:         {
 525:             sendWithTargets(buildStopModule(feature), [id])          // one per agent
 526:             stopLocalFeature(id, feature)
 527:         }
 528:     }
 529: 
 530:     return { sendCommand, sendToFocused, sendToSelected, requestPermission, revokePermission, stopModule }
 531: }
 532: 
 533: // ── Private: inject target_agents and send ───────────────────────────────────
 534: 
 535: async function sendToSocketE2EE(agent_id, msgObj) {
 536:     if (!_socket) return;
 537:     const jsonStr = JSON.stringify(msgObj);
 538:     const sessionKey = useE2EEStore.getState().getSessionKey(agent_id);
 539:     if (sessionKey) {
 540:         const seq = useE2EEStore.getState().getSendSeqAndIncrement(agent_id);
 541:         const iv = generateIV();
 542:         const dataBuffer = new TextEncoder().encode(jsonStr);
 543:         try {
 544:             const ciphertextBuffer = await encryptAESGCM(sessionKey, dataBuffer, iv);
 545:             const combined = new Uint8Array(12 + ciphertextBuffer.byteLength);
 546:             combined.set(iv, 0);
 547:             combined.set(new Uint8Array(ciphertextBuffer), 12);
 548:             
 549:             _socket.send(JSON.stringify({
 550:                 type: MSG_TYPE.E2EE_PAYLOAD,
 551:                 target_agents: [agent_id],
 552:                 agent_id: agent_id,
 553:                 seq: seq,
 554:                 data: arrayBufferToBase64(combined.buffer)
 555:             }));
 556:         } catch (e) {
 557:             console.error('[E2EE] Failed to encrypt message', e);
 558:         }
 559:     } else {
 560:         const allowedPlaintext = ['e2ee_init', 'permissions_reset', 'policy_update'];
 561:         if (allowedPlaintext.includes(msgObj.type)) {
 562:             _socket.send(jsonStr);
 563:         } else {
 564:             console.warn(`[E2EE Blocker] Blocked unencrypted message (${msgObj.type}) to ${agent_id}. E2EE state is not ready.`);
 565:         }
 566:     }
 567: }
 568: 
 569: // Parse the JSON string and loop-emit one message per agent in target_ids.
 570: // Each iteration looks up the E2EE session key for that specific agent and
 571: // wraps the payload accordingly. This is intentionally called with a
 572: // single-element array [id] by requestPermission / revokePermission /
 573: // stopModule to maintain per-agent E2EE key isolation.
 574: //
 575: // WARNING: Passing a multi-element array works correctly (each element is
 576: // processed independently), but all call sites should prefer single-element
 577: // arrays for explicit E2EE key isolation.
 578: function sendWithTargets(json_string, target_ids)
 579: {
 580:     if (!_socket)
 581:     {
 582:         console.warn('[useAgentSocket] sendWithTargets called before socket is ready')
 583:         return
 584:     }
 585: 
 586:     if (import.meta.env.DEV && target_ids.length > 1)
 587:     {
 588:         console.warn(
 589:             '[useAgentSocket] sendWithTargets called with %d targets — prefer ' +
 590:             'single-element arrays for explicit E2EE key isolation',
 591:             target_ids.length
 592:         )
 593:     }
 594: 
 595:     try
 596:     {
 597:         const msg = JSON.parse(json_string)
 598:         for (const target_id of target_ids) {
 599:             const one_msg = { ...msg, target_agents: [target_id] }
 600:             sendToSocketE2EE(target_id, one_msg)
 601:         }
 602:     }
 603:     catch (err)
 604:     {
 605:         console.error('[useAgentSocket] failed to inject target_agents:', err)
 606:     }
 607: }
 608: 
 609: // ── Private: fan-out a module command per agent (Plan B broadcast + filter) ──
 610: 
 611: // Parse a builder's JSON string, then fan it out to the given agents.
 612: // Entry point behind sendToFocused / sendToSelected.
 613: function dispatchFanout(json_string, target_ids, options)
 614: {
 615:     if (!_socket)
 616:     {
 617:         console.warn('[useAgentSocket] dispatchFanout called before socket is ready')
 618:         return
 619:     }
 620: 
 621:     let msg
 622:     try { msg = JSON.parse(json_string) }
 623:     catch (err)
 624:     {
 625:         console.error('[useAgentSocket] dispatchFanout: bad JSON:', err)
 626:         return
 627:     }
 628:     fanoutSend(msg, target_ids, options)
 629: }
 630: 
 631: // Loop-emit one message per agent (never a single multi-ID message). For a
 632: // permission-gated command (request / power) we only emit to agents that have
 633: // already granted the matching feature; skipped agents are counted and reported
 634: // in ONE aggregate toast so a bulk action does not spam N warnings.
 635: function fanoutSend(msg, target_ids, options)
 636: {
 637:     if (!_socket)
 638:     {
 639:         console.warn('[useAgentSocket] fanoutSend called before socket is ready')
 640:         return
 641:     }
 642: 
 643:     const feature    = featureForMessage(msg)   // null → no consent needed
 644:     const perm_store = usePermissionStore.getState()
 645:     const silent     = options && options.silent === true                                           // Polling tabs pass silent:true so a 3 s tick does not fire the aggregate "N not granted" toast
 646: 
 647:     let   skipped    = 0
 648: 
 649:     for (const id of target_ids)
 650:     {
 651:         // Permission-gated: skip agents that have not granted this feature.
 652:         if (feature && perm_store.getStatus(id, feature) !== 'granted')
 653:         {
 654:             skipped++
 655:             continue
 656:         }
 657:         const one_msg         = { ...msg, target_agents: [id] }   // one agent per emit
 658:         sendToSocketE2EE(id, one_msg)
 659:     }
 660: 
 661:     if (skipped > 0 && !silent)
 662:     {
 663:         useUiStore.getState().addToast(`Đã bỏ qua ${skipped} agent chưa cấp quyền`, 'error')
 664:     }
 665: }
 666: 
 667: // ── Private: clear the live indicator for a feature after revoke / stop ──────
 668: 
 669: // Only sensitive streaming features have a local "active" flag to turn off.
 670: // application / process / file / power carry no live indicator, so they no-op.
 671: function stopLocalFeature(agent_id, feature)
 672: {
 673:     const module_store = useModuleStore.getState()
 674:     switch (feature)
 675:     {
 676:         case FEATURE.SCREEN:
 677:             module_store.setScreenStreamActive(agent_id, false)
 678:             break
 679:         case FEATURE.KEYLOG:
 680:             module_store.setKeylogActive(agent_id, false)
 681:             break
 682:         case FEATURE.WEBCAM:
 683:             module_store.setWebcamActive(agent_id, false)
 684:             break
 685:         case FEATURE.INPUT:
 686:             module_store.setInputActive(agent_id, false)
 687:             break
 688:         default:
 689:             break
 690:     }
 691: }
 692: 
 693: // ── RX dispatch: route incoming messages to the correct store action ─────────
 694: //
 695: // Routing table (message.type → store action):
 696: //
 697: //   agents_list        → AgentStore.setAgents(agents)
 698: //   agent_status       → AgentStore.setAgentStatus(id, {online, in_session}); unknown id → resync list_agents
 699: //   app_list_result    → ModuleStore.setModuleData(id, 'app', apps)
 700: //   app_action_result  → toast (success / error)
 701: //   proc_list_result   → ModuleStore.setModuleData(id, 'process', procs)
 702: //   proc_kill_result   → toast (success / error)
 703: //   keylog             → ModuleStore.appendKeylog(id, events)
 704: //   keylog_started/stopped/denied → ModuleStore.setKeylogActive(id, …) (+ toast on denied)
 705: //   stream_started/stopped        → ModuleStore.setScreenStreamActive(id, …)
 706: //   webcam_started/stopped/denied → ModuleStore.setWebcamActive(id, …) (+ toast on denied)
 707: //   frame_meta         → stored in _pending_meta; paired with next binary
 708: //   fs_list_result     → ModuleStore.setFsEntries(id, path, entries)
 709: //   fs_get_result      → ModuleStore.appendFileDownloadChunk(id, chunk_info)
 710: //                        (JSON mode: decode data_base64 → bytes here;
 711: //                         binary mode: stash meta, pair with next binary frame)
 712: //   fs_put_result / fs_put_complete → ModuleStore.setFilePutAck(id, …)
 713: //   fs_error           → toast
 714: //   power_result       → toast (confirmed / cancelled)
 715: //   policy_update_result → PolicyStore.setPolicyResult(id, …); toast on failure
 716: //   permission_result  → PermissionStore.setPermissionResult(id, feature, granted) + toast
 717: 
 718: function dispatchMessage(msg, { setStatus, setAgents, setAgentStatus, setModuleData, appendKeylog, appendSysInfo, setKeylogActive, setWebcamActive, setScreenStreamActive, setInputActive, setFsEntries, appendFileDownloadChunk,setFilePutAck, setPolicyResult, setPermissionResult, addToast })
 719: {
 720:     // Every per-agent message MUST carry an agent_id after normalization.
 721:     // Drop malformed messages so we never write into ModuleStore under an
 722:     // "undefined" key. Types without agent_id (agents_list) are listed first
 723:     // and are exempt from this guard.
 724:     const AGENT_ID_EXEMPT = new Set([MSG_TYPE.AGENTS_LIST, MSG_TYPE.AUTH_EXPIRED])
 725:     if (!AGENT_ID_EXEMPT.has(msg.type) && !msg.agent_id)
 726:     {
 727:         console.warn('[useAgentSocket] dropped message missing agent_id:', msg.type)
 728:         return
 729:     }
 730: 
 731:     switch (msg.type)
 732:     {
 733:         // ── Connection ────────────────────────────────────────────────────
 734:         case MSG_TYPE.AGENTS_LIST:
 735:             setAgents(msg.agents)
 736:             // Init E2EE for all online agents
 737:             msg.agents.forEach(a => {
 738:                 if (a.online) {
 739:                     _socket.send(JSON.stringify({ type: 'subscribe', agent_id: a.id }))
 740:                     initE2EE(a.id, _socket)
 741:                 }
 742:             })
 743:             break
 744: 
 745:         case MSG_TYPE.AGENT_STATUS:
 746:         {
 747:             // Realtime online / offline (and in_session) update for ONE agent.
 748:             // Only patch the flags the Gateway actually reported.
 749:             const status_patch = {}
 750:             if (msg.online !== undefined)     status_patch.online     = msg.online
 751:             if (msg.in_session !== undefined) status_patch.in_session = msg.in_session
 752: 
 753:             const is_known = useAgentStore.getState().agents.some((a) => a.id === msg.agent_id)
 754:             if (is_known)
 755:             {
 756:                 setAgentStatus(msg.agent_id, status_patch)
 757:                 // Agent went offline mid-stream → clear its live indicators so                     //
 758:                 // the red badge does not linger until the operator refreshes.                      //
 759:                 if (msg.online === false)
 760:                 {
 761:                     useModuleStore.getState().clearLiveFlagsForAgent(msg.agent_id)
 762:                     useE2EEStore.getState().resetSession(msg.agent_id)
 763:                     usePermissionStore.getState().revokeAll(msg.agent_id)
 764:                 }
 765:                 else if (msg.online === true)
 766:                 {
 767:                     _socket.send(JSON.stringify({ type: 'subscribe', agent_id: msg.agent_id }))
 768:                     initE2EE(msg.agent_id, _socket)
 769:                 }
 770:             }
 771:             else if (_socket)
 772:             {
 773:                 // A brand-new agent just announced itself — resync the full list
 774:                 // so the sidebar picks up its name / os / ip, not just the flag.
 775:                 _socket.send(buildListAgents())
 776:             }
 777:             break
 778:         }
 779: 
 780:         // ── Application ───────────────────────────────────────────────────
 781:         case MSG_TYPE.APP_LIST_RESULT:
 782:             setModuleData(msg.agent_id, 'app', msg.apps)
 783:             break
 784: 
 785:         case MSG_TYPE.APP_ACTION_RESULT:
 786:             addToast(
 787:                 msg.success
 788:                     ? `${msg.name}: ${msg.action === 'app_start' ? 'started' : 'stopped'}`
 789:                     : `${msg.name}: action failed — ${msg.message}`,
 790:                 msg.success ? 'success' : 'error'
 791:             )
 792:             break
 793: 
 794:         // ── Process ───────────────────────────────────────────────────────
 795:         case MSG_TYPE.PROC_LIST_RESULT:
 796:             setModuleData(msg.agent_id, 'process', msg.processes)
 797:             break
 798: 
 799:         case MSG_TYPE.PROC_KILL_RESULT:
 800:             addToast(
 801:                 msg.success
 802:                     ? `${msg.name ?? 'PID ' + msg.pid}: terminated`
 803:                     : `PID ${msg.pid}: kill failed — ${msg.message}`,
 804:                 msg.success ? 'success' : 'error'
 805:             )
 806:             break
 807: 
 808:         // ── Keylog ────────────────────────────────────────────────────────
 809:         case MSG_TYPE.KEYLOG:
 810:             appendKeylog(msg.agent_id, msg.events)
 811:             break
 812: 
 813:         case MSG_TYPE.KEYLOG_STARTED:
 814:             setKeylogActive(msg.agent_id, true)
 815:             break
 816: 
 817:         case MSG_TYPE.KEYLOG_STOPPED:
 818:             setKeylogActive(msg.agent_id, false)
 819:             break
 820: 
 821:         case MSG_TYPE.KEYLOG_DENIED:
 822:             setKeylogActive(msg.agent_id, false)
 823:             addToast(`Keylog denied on ${msg.agent_id}: ${msg.reason ?? 'user declined'}`, 'error')
 824:             break
 825: 
 826:         // ── Screen / Webcam binary frames ─────────────────────────────────
 827:         case MSG_TYPE.STREAM_STARTED:
 828:             // Flip the transparency flag so AgentCard / TopBar light the red
 829:             // dot — Live Screen is a sensitive module and must be visible.
 830:             setScreenStreamActive(msg.agent_id, true)
 831:             break
 832: 
 833:         case MSG_TYPE.STREAM_STOPPED:
 834:             setScreenStreamActive(msg.agent_id, false)
 835:             break
 836: 
 837:         case MSG_TYPE.FRAME_META:
 838:             // Hold this meta until the next binary message arrives.
 839:             // The onBinary callback in the lifecycle block above will
 840:             // consume it and push the completed frame into ModuleStore.
 841:             //
 842:             // ORDERING GUARD: a fresh frame_meta arriving while one is still
 843:             // pending means the previous meta's binary never came directly
 844:             // after it — i.e. the Gateway interleaved another message between a
 845:             // frame_meta and its JPEG. On a single socket this must NOT happen;
 846:             // if it does, pairing would draw a frame into the wrong agent/module
 847:             // slot. We keep the newest meta (last wins) but warn loudly so the
 848:             // Gateway team can fix relay ordering. See docs note in this file.
 849:             if (_pending_meta)
 850:             {
 851:                 console.warn(
 852:                     '[useAgentSocket] frame_meta arrived while a previous meta was still ' +
 853:                     `unpaired (prev agent=${_pending_meta.agent_id}/${_pending_meta.module}, ` +
 854:                     `new agent=${msg.agent_id}/${msg.module}) — Gateway may be interleaving ` +
 855:                     'binary frames out of order'
 856:                 )
 857:             }
 858:             _pending_meta = msg
 859:             break
 860: 
 861:         // ── Webcam ────────────────────────────────────────────────────────
 862:         case MSG_TYPE.WEBCAM_STARTED:
 863:             // Agent granted consent — flip the flag so WebcamTab lights up
 864:             // the visible consent indicator ("Camera đang bật").
 865:             setWebcamActive(msg.agent_id, true)
 866:             break
 867: 
 868:         case MSG_TYPE.WEBCAM_STOPPED:
 869:             setWebcamActive(msg.agent_id, false)
 870:             break
 871: 
 872:         case MSG_TYPE.WEBCAM_DENIED:
 873:             setWebcamActive(msg.agent_id, false)
 874:             addToast(`Webcam denied on ${msg.agent_id}: ${msg.reason ?? 'user declined'}`, 'error')
 875:             break
 876: 
 877:         // ── Remote Input ──────────────────────────────────────────────────
 878:         case MSG_TYPE.INPUT_STARTED:
 879:             setInputActive(msg.agent_id, true)
 880:             break
 881: 
 882:         case MSG_TYPE.INPUT_STOPPED:
 883:             setInputActive(msg.agent_id, false)
 884:             break
 885: 
 886:         case MSG_TYPE.INPUT_DENIED:
 887:             setInputActive(msg.agent_id, false)
 888:             addToast(`Remote Input denied on ${msg.agent_id}: ${msg.reason ?? 'user declined'}`, 'error')
 889:             break
 890: 
 891:         case MSG_TYPE.INPUT_RESULT:
 892:             // Per-command ack — only surface a toast on failure (success is silent
 893:             // so 60 fps mouse move does not spam the feed).
 894:             if (msg.success === false)
 895:             {
 896:                 addToast(`Input error on ${msg.agent_id}: ${msg.message ?? 'unknown'}`, 'error')
 897:             }
 898:             break
 899: 
 900:         // ── File ──────────────────────────────────────────────────────────
 901:         case MSG_TYPE.FS_LIST_RESULT:
 902:             // Merge this directory's entries into the per-agent file tree (sandbox only).
 903:             setFsEntries(msg.agent_id, msg.path, msg.entries)
 904:             break
 905: 
 906:         case MSG_TYPE.FS_GET_RESULT:
 907:         {
 908:             // Two chunk formats are supported (see docs/protocol/File.json):
 909:             //   1) JSON mode  — the chunk bytes are inside data_base64.
 910:             //   2) Binary mode — this JSON is only metadata; the next WS binary
 911:             //                    frame carries the raw bytes. We stash the meta
 912:             //                    into _pending_fs_chunks keyed by transfer_id so
 913:             //                    parallel downloads do not clobber each other.
 914:             if (msg.data_base64)
 915:             {
 916:                 // Decode base64 → Uint8Array once at the boundary so downstream
 917:                 // (store + UI) only ever holds raw bytes.
 918:                 const binary = atob(msg.data_base64)
 919:                 const bytes  = new Uint8Array(binary.length)
 920:                 for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i)
 921:                 appendFileDownloadChunk(msg.agent_id,
 922:                 {
 923:                     transfer_id  : msg.transfer_id,
 924:                     chunk_index  : msg.chunk_index,
 925:                     total_chunks : msg.total_chunks,
 926:                     path         : msg.path,
 927:                     total_size   : msg.total_size,
 928:                     bytes,
 929:                 })
 930:             }
 931:             else
 932:             {
 933:                 if (!msg.transfer_id)
 934:                 {
 935:                     console.warn(
 936:                         '[useAgentSocket] fs_get_result (binary mode) missing transfer_id — dropped; ' +
 937:                         'cannot pair the following binary frame safely'
 938:                     )
 939:                     break
 940:                 }
 941:                 if (_pending_fs_chunks.has(msg.transfer_id))
 942:                 {
 943:                     console.warn(
 944:                         `[useAgentSocket] fs_get_result overwrites pending meta for transfer_id=${msg.transfer_id} ` +
 945:                         '— previous binary never arrived (Gateway may have dropped it)'
 946:                     )
 947:                 }
 948:                 _pending_fs_chunks.set(msg.transfer_id, msg)
 949:             }
 950:             break
 951:         }
 952: 
 953:         case MSG_TYPE.FS_PUT_RESULT:
 954:             // Per-chunk ack — FileTab advances the progress bar when this arrives.
 955:             setFilePutAck(msg.agent_id, { ...msg, complete: false })
 956:             break
 957: 
 958:         case MSG_TYPE.FS_PUT_COMPLETE:
 959:             // Final ack — all chunks received by the Agent; FileTab marks upload as done.
 960:             setFilePutAck(msg.agent_id, { ...msg, complete: true })
 961:             break
 962: 
 963:         case MSG_TYPE.FS_ERROR:
 964:             // Surface sandbox path errors as toast notifications.
 965:             addToast(`File error on ${msg.agent_id}: ${msg.message}`, 'error')
 966:             break
 967: 
 968:         // ── Policy ────────────────────────────────────────────────────────
 969:         case MSG_TYPE.POLICY_UPDATE_RESULT:
 970:             // Record per-agent result. Only surface a toast on FAILURE so a
 971:             // successful multi-agent push does not spam N success toasts.
 972:             setPolicyResult(msg.agent_id, { success: msg.success, message: msg.message })
 973:             if (!msg.success)
 974:             {
 975:                 addToast(`Policy update failed on ${msg.agent_id}: ${msg.message ?? 'unknown error'}`, 'error')
 976:             }
 977:             break
 978: 
 979:         // ── Permission (Plan B consent handshake) ─────────────────────────
 980:         case MSG_TYPE.PERMISSION_RESULT:
 981:             // Update the (agent, feature) status so PermissionGate enables or
 982:             // keeps the module command buttons disabled, and toast the outcome.
 983:             setPermissionResult(msg.agent_id, msg.feature, msg.granted)
 984:             addToast(
 985:                 msg.granted
 986:                     ? `${msg.feature} granted on ${msg.agent_id}`
 987:                     : `${msg.feature} denied on ${msg.agent_id}: ${msg.message || 'user declined'}`,
 988:                 msg.granted ? 'success' : 'error'
 989:             )
 990:             break
 991: 
 992:         case MSG_TYPE.AGENT_STATUS:
 993:             setAgentStatus(msg.agent_id, msg.online)
 994:             if (!msg.online)
 995:             {
 996:                 _pendingE2EEKeys.delete(msg.agent_id)
 997:                 useE2EEStore.getState().setSessionState(msg.agent_id, 'uninitialized', null)
 998:                 usePermissionStore.getState().revokeAll(msg.agent_id)
 999:             }
1000:             break
1001: 
1002:         case MSG_TYPE.PERMISSIONS_RESET:
1003:             usePermissionStore.getState().revokeAll(msg.agent_id)
1004:             useModuleStore.getState().clearLiveFlagsForAgent(msg.agent_id)
1005:             useE2EEStore.getState().resetSession(msg.agent_id)
1006:             initE2EE(msg.agent_id, _socket)
1007:             addToast(`Agent ${msg.agent_id} reconnected. E2EE is negotiating...`, 'info')
1008:             break
1009: 
1010:         // ── E2EE ─────────────────────────────────────────────────────────
1011:         case MSG_TYPE.E2EE_ERROR:
1012:             useE2EEStore.getState().setSessionState(msg.agent_id, 'uninitialized', null)
1013:             useUiStore.getState().addToast(`E2EE Handshake bị từ chối bởi ${msg.agent_id}: ${msg.message || 'Sai mã PIN'}`, 'error')
1014:             break
1015: 
1016:         case MSG_TYPE.E2EE_READY:
1017:         {
1018:             const e2eeStore = useE2EEStore.getState()
1019:             e2eeStore.getAgentPin(msg.agent_id).then(async (savedPin) => {
1020:                 const pin = savedPin || "default-pin-12345"
1021:                 try {
1022:                     const isValid = await verifyHMAC(msg.publicKey, msg.signature, pin)
1023:                     if (!isValid) {
1024:                         useUiStore.getState().addToast(`E2EE MitM Alert: Invalid signature from agent ${msg.agent_id}`, 'error')
1025:                         return
1026:                     }
1027:                     const privateKey = _pendingE2EEKeys.get(msg.agent_id)
1028:                     if (!privateKey) {
1029:                         console.warn(`[E2EE] No pending private key for ${msg.agent_id}`)
1030:                         return
1031:                     }
1032:                     
1033:                     const agentPubKey = await importPublicKeyFromSPKI(msg.publicKey)
1034:                     const sessionKeys = await deriveSessionKey(privateKey, agentPubKey)
1035:                     
1036:                     e2eeStore.setSessionState(msg.agent_id, 'ready', sessionKeys)
1037:                     _pendingE2EEKeys.delete(msg.agent_id)
1038:                     useUiStore.getState().addToast(`E2EE Handshake successful for ${msg.agent_id}`, 'success')
1039:                 } catch (e) {
1040:                     console.error('[E2EE] Handshake finalize failed', e)
1041:                 }
1042:             })
1043:             break
1044:         }
1045: 
1046:         // ── SysInfo ───────────────────────────────────────────────────────
1047:         case MSG_TYPE.SYSINFO_RESULT:
1048:             // Store latest snapshot AND append a percent-only sample to history
1049:             // so the sparkline updates without re-computing anything downstream.
1050:             appendSysInfo(msg.agent_id, msg)
1051:             break
1052: 
1053:         // ── Power ─────────────────────────────────────────────────────────
1054:         case MSG_TYPE.POWER_RESULT:
1055:             // Show a toast so the operator sees the Agent's confirmation.
1056:             addToast(
1057:                 msg.confirmed
1058:                     ? `${msg.agent_id}: ${msg.action} confirmed`
1059:                     : `${msg.agent_id}: ${msg.action} cancelled`,
1060:                 msg.confirmed ? 'success' : 'error'
1061:             )
1062:             break
1063: 
1064:         // ── Auth: access token expired mid-session ────────────────────────
1065:         case MSG_TYPE.AUTH_EXPIRED:
1066:             // Gateway told us our access JWT is no longer valid. Try one
1067:             // refresh using the HttpOnly refresh cookie; on success reopen
1068:             // the WS so the new handshake carries the fresh token; on
1069:             // failure log the operator out.
1070:             refreshAccessToken().then((result) =>
1071:             {
1072:                 if (result.ok && _socket && typeof _socket.reopen === 'function')
1073:                 {
1074:                     _socket.reopen()
1075:                 }
1076:                 else
1077:                 {
1078:                     addToast('Phiên đăng nhập đã hết hạn. Vui lòng đăng nhập lại.', 'error')
1079:                     logout()
1080:                 }
1081:             })
1082:             break
1083: 
1084:         // ── Catch-all ─────────────────────────────────────────────────────
1085:         default:
1086:             console.warn('[useAgentSocket] unhandled message type:', msg.type)
1087:     }
1088: }
