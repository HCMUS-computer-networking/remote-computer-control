 186: // Generate fake text content for a sandbox file and return it as a base64 string.
 187: // Content varies by file extension so downloaded files look realistic in a text editor.
 188: function generateFakeFileContent(file_path)
 189: {
 190:     const ext     = file_path.split('.').pop().toLowerCase()
 191:     let   content = ''
 192: 
 193:     switch (ext)
 194:     {
 195:         case 'txt':
 196:             content = `[Sandbox file: ${file_path}]\n\nLine 1: Hello from the sandbox.\nLine 2: This is simulated content.\nLine 3: All operations are sandbox-restricted.\n`
 197:             break
 198:         case 'csv':
 199:             content = `id,name,value\n1,alpha,100\n2,beta,200\n3,gamma,300\n`
 200:             break
 201:         case 'json':
 202:             content = JSON.stringify({ sandbox: true, path: file_path, note: 'Simulated config file' }, null, 2)
 203:             break
 204:         default:
 205:             content = `[Binary placeholder]\nFile: ${file_path}\nThis is a fake binary file generated by MockSocket.\n`
 206:     }
 207: 
 208:     // Encode to base64 safely (handles ASCII content from our fake data above).
 209:     return btoa(unescape(encodeURIComponent(content)))
 210: }
