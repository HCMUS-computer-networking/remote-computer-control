<file path="controller/src/store/AgentStore.js">
 1: // AgentStore.js — agent list, multi-select set, and focused agent for detail view.
 2: import { create } from 'zustand'
 3: 
 4: // Start empty; the real list arrives via agents_list right after the socket
 5: // opens (MockSocket also emits one on connect, so mock mode still populates).
 6: const useAgentStore = create(function (set, get)
 7: {
 8:     return {
 9:         agents              : [],           // full agent list from gateway
10:         selected_agent_ids  : [],           // IDs checked for multi-agent commands
11:         focused_agent_id    : null,         // single agent open in FocusView
12:         search_query        : '',           // text in the sidebar search box
13: 
14:         // Replace the entire agent list (called when agents_list message arrives).
15:         setAgents: (agents) =>
16:         {
17:             set({ agents });
18:         },
19: 
20:         // Add or remove an agent from the multi-select set.
21:         toggleSelect: (id) =>
22:             set(function (s)
23:             {
24:                 const already_selected = s.selected_agent_ids.includes(id)
25:                 const next_ids = already_selected
26:                     ? s.selected_agent_ids.filter((x) => x !== id)
27:                     : [...s.selected_agent_ids, id]
28:                 return { selected_agent_ids: next_ids }
29:             }),
30: 
31:         // Patch ONE agent's live status (online / in_session) from an
32:         // agent_status push. No-op if the agent id is unknown — the dispatch
33:         // layer then resyncs the whole list via list_agents.
34:         setAgentStatus: (agent_id, patch) =>
35:             set(function (s)
36:             {
37:                 let found = false
38:                 const next_agents = s.agents.map(function (a)
39:                 {
40:                     if (a.id !== agent_id) return a
41:                     found = true
42:                     return { ...a, ...patch }
43:                 })
44:                 return found ? { agents: next_agents } : {}
45:             }),
46: 
47:         // Open one agent in the detail (Focus) view.
48:         setFocused: (id) =>
49:         {
50:             set({ focused_agent_id: id });
51:         },
52: 
53:         // Replace the entire multi-select set with a given array of IDs.
54:         // Used by MultiSelect "select all" to avoid calling toggleSelect in a loop.
55:         setSelectedIds: (ids) =>
56:         {
57:             set({ selected_agent_ids: ids });
58:         },
59: 
60:         // Deselect all agents from the multi-select set.
61:         clearSelection: () =>
62:         {
63:             set({ selected_agent_ids: [] });
64:         },
65: 
66:         setSearchQuery: (q) =>
67:         {
68:             set({ search_query: q });
69:         },
70: 
71:         // Return agents whose name or IP contain the search query.
72:         getFilteredAgents: () =>
73:         {
74:             const { agents, search_query } = get()
75:             const q = search_query.trim().toLowerCase()
76:             if (!q) return agents
77:             return agents.filter(function (a)
78:             {
79:                 return a.name.toLowerCase().includes(q) || a.ip.includes(q)
80:             })
81:         },
82: 
83:         // Return the agent object that is currently open in FocusView, or null.
84:         getFocusedAgent: () =>
85:         {
86:             const { agents, focused_agent_id } = get()
87:             return agents.find((a) => a.id === focused_agent_id) ?? null
88:         },
89:     }
90: })
91: 
92: export default useAgentStore
</file>

<file path="controller/src/store/ConnectionStore.js">
 1: // ConnectionStore.js — tracks the WebSocket connection status and auth token.
 2: // The actual socket lifecycle is managed by UseAgentSocket hook (not here).
 3: // connect() / disconnect() are state-only signals; the hook reacts to them.
 4: //
 5: // AUTH — auth_token holds the SHORT-LIVED access JWT issued by the Gateway
 6: // after a successful login. It lives ONLY in this store (memory) — never in
 7: // sessionStorage / localStorage. A page reload therefore signs the operator
 8: // out; the HttpOnly refresh cookie held by the browser is what lets
 9: // AuthService.refreshAccessToken() re-hydrate the token without a full login.
10: // Socket.js reads this value to build ws://.../controller?token=<JWT>.
11: import { create } from 'zustand'
12: 
13: const useConnectionStore = create(function (set)
14: {
15:     return {
16:         status      : 'idle',                  // 'idle' | 'connecting' | 'open' | 'closed'
17:         gateway_url : 'ws://localhost:8080',   // destination for the real Socket.js
18:         auth_token  : null,                    // access JWT from /api/login (memory only)
19: 
20:         // Mark connection as pending. UseAgentSocket hook watches this and opens the socket.
21:         connect: (url) =>
22:         {
23:             if (url) set({ gateway_url: url });
24:             set({ status: 'connecting' });
25:         },
26: 
27:         // Mark connection as closed and clear the JWT so the next reconnect
28:         // will not carry a token the operator no longer wants used.
29:         disconnect: () =>
30:         {
31:             set({ status: 'closed', auth_token: null });
32:         },
33: 
34:         setStatus: (status) =>
35:         {
36:             set({ status });
37:         },
38: 
39:         setGatewayUrl: (url) =>
40:         {
41:             set({ gateway_url: url });
42:         },
43: 
44:         // Store the JWT after a successful login OR refresh. Password is NEVER stored.
45:         setAuthToken: (auth_token) =>
46:         {
47:             set({ auth_token });
48:         },
49: 
50:         // Drop the JWT on logout so the next reconnect falls back to ?key=.
51:         clearAuthToken: () =>
52:         {
53:             set({ auth_token: null });
54:         },
55:     }
56: })
57: 
58: export default useConnectionStore
</file>

<file path="controller/src/store/UiStore.js">
 1: // UiStore.js — global UI state: theme, layout mode, active module tab, sidebar.
 2: import { create } from 'zustand'
 3: 
 4: // Valid tab IDs — used by setActiveTab to reject unknown values.
 5: const MODULE_TABS = ['sysinfo', 'application', 'process', 'screen', 'keylog', 'file', 'webcam', 'power']
 6: 
 7: let _toast_id = 0
 8: 
 9: const useUiStore = create(function (set)
10: {
11:     return {
12:         theme        : 'light',         // 'light' | 'dark'
13:         layout_mode  : 'grid',          // 'grid'  | 'focus'
14:         active_tab   : 'application',   // one of MODULE_TABS
15:         sidebar_open : true,            // controls mobile sidebar visibility
16:         toasts       : [],              // array of { id, message, variant, timestamp }
17: 
18:         setTheme: (theme) =>
19:         {
20:             set({ theme });
21:         },
22: 
23:         toggleTheme: () =>
24:             set(function (s)
25:             {
26:                 const next_theme = s.theme === 'light' ? 'dark' : 'light'
27:                 return { theme: next_theme }
28:             }),
29: 
30:         setLayoutMode: (mode) =>
31:         {
32:             set({ layout_mode: mode });
33:         },
34: 
35:         // Switching to a tab implies entering focus view for that agent.
36:         setActiveTab: (tab) =>
37:         {
38:             if (MODULE_TABS.includes(tab))
39:             {
40:                 set({ active_tab: tab, layout_mode: 'focus' })
41:             }
42:         },
43: 
44:         toggleSidebar: () =>
45:             set(function (s)
46:             {
47:                 return { sidebar_open: !s.sidebar_open }
48:             }),
49: 
50:         // Push a short-lived notification. Variant: 'success' | 'error' | 'info'.
51:         addToast: (message, variant = 'info') =>
52:         {
53:             const id = ++_toast_id
54:             set(function (s)
55:             {
56:                 return { toasts: [...s.toasts, { id, message, variant, timestamp: Date.now() }] }
57:             })
58:             setTimeout(function ()
59:             {
60:                 set(function (s)
61:                 {
62:                     return { toasts: s.toasts.filter((t) => t.id !== id) }
63:                 })
64:             }, 3000)
65:         },
66: 
67:         dismissToast: (id) =>
68:             set(function (s)
69:             {
70:                 return { toasts: s.toasts.filter((t) => t.id !== id) }
71:             }),
72:     }
73: })
74: 
75: export { MODULE_TABS }
76: export default useUiStore
</file>

<file path="controller/src/components/agents/AgentCard.jsx">
  1: // AgentCard.jsx — one agent row in the sidebar list.
  2: // Left checkbox: toggles multi-select. Clicking the card body: opens focus view.
  3: import useAgentStore from '../../store/AgentStore'
  4: import useUiStore    from '../../store/UiStore'
  5: import useModuleStore from '../../store/ModuleStore'
  6: 
  7: /*
  8:   Props:
  9:     agent — { id, name, os, ip, online, in_session }
 10: */
 11: function AgentCard({ agent })
 12: {
 13:     // subscribe to only the slice that affects THIS card to avoid re-rendering all cards on every selection change
 14:     const is_focused   = useAgentStore((s) => s.focused_agent_id === agent.id)
 15:     const is_selected  = useAgentStore((s) => s.selected_agent_ids.includes(agent.id))
 16:     const setFocused   = useAgentStore((s) => s.setFocused)
 17:     const toggleSelect = useAgentStore((s) => s.toggleSelect)
 18:     const setLayoutMode = useUiStore((s) => s.setLayoutMode)
 19: 
 20:     // Transparency red-dot — visible whenever any sensitive module is active on
 21:     // this agent, OR the agent is being remotely controlled (in_session).
 22:     // Sensitive modules: Live Screen stream, Webcam feed, Input Activity (keylog).
 23:     // The dot must ALWAYS reflect reality — never hide it behind a toggle.
 24:     const screen_active = useModuleStore((s) => s.data[agent.id]?.screen_stream_active ?? false)
 25:     const webcam_active = useModuleStore((s) => s.data[agent.id]?.webcam_active        ?? false)
 26:     const keylog_active = useModuleStore((s) => s.data[agent.id]?.keylog_active        ?? false)
 27:     const sensitive_on  = screen_active || webcam_active || keylog_active || agent.in_session
 28:     const dot_class    = agent.online
 29:         ? 'status-dot status-dot--online'
 30:         : 'status-dot status-dot--offline'
 31: 
 32:     let card_class = 'agent-card'
 33:     if (is_focused)   card_class += ' agent-card--active'
 34:     if (is_selected)  card_class += ' agent-card--selected'
 35:     if (!agent.online) card_class += ' agent-card--offline'
 36: 
 37:     function handleCardClick()
 38:     {
 39:         setFocused(agent.id)
 40:         setLayoutMode('focus')
 41:     }
 42: 
 43:     function handleCheckboxChange(e)
 44:     {
 45:         e.stopPropagation()   // prevent handleCardClick from firing
 46:         toggleSelect(agent.id)
 47:     }
 48: 
 49:     return (
 50:         <div
 51:             className={card_class}
 52:             onClick={handleCardClick}
 53:             role="button"
 54:             tabIndex={0}
 55:             onKeyDown={(e) => e.key === 'Enter' && handleCardClick()}
 56:             aria-pressed={is_focused}
 57:             aria-label={`Agent ${agent.name}, ${agent.online ? 'online' : 'offline'}`}
 58:         >
 59:             <div className="agent-card__row">
 60:                 {/* status dot */}
 61:                 <span className={dot_class} aria-hidden="true" />
 62: 
 63:                 {/* Red transparency dot — one glance tells the operator this
 64:                     agent is currently under a sensitive activity (screen /
 65:                     webcam / keylog / in_session). Placed next to the online
 66:                     dot on purpose so it can never be missed. */}
 67:                 {sensitive_on && (
 68:                     <span
 69:                         className="transparency-dot"
 70:                         aria-label="Sensitive module active"
 71:                         title="Sensitive module active on this agent (screen, webcam, keylog, or session)"
 72:                     />
 73:                 )}
 74: 
 75:                 {/* agent name — takes remaining space */}
 76:                 <span className="agent-card__name">{agent.name}</span>
 77: 
 78:                 {/* offline label — clear text state beyond the gray dot */}
 79:                 {!agent.online && (
 80:                     <span className="agent-card__offline-badge" aria-label="Agent offline">OFFLINE</span>
 81:                 )}
 82: 
 83:                 {/* session badge — only when actively controlled */}
 84:                 {agent.in_session && (
 85:                     <span className="session-badge" aria-label="Session active">SESSION</span>
 86:                 )}
 87: 
 88:                 {/* multi-select checkbox — placed at the far right */}
 89:                 <input
 90:                     type="checkbox"
 91:                     className="agent-card__checkbox"
 92:                     checked={is_selected}
 93:                     onChange={handleCheckboxChange}
 94:                     onClick={(e) => e.stopPropagation()}
 95:                     aria-label={`Select ${agent.name}`}
 96:                     tabIndex={-1}   // card itself is the tab stop; checkbox reachable by click
 97:                 />
 98:             </div>
 99: 
100:             {/* OS and IP — secondary info line */}
101:             <div className="agent-card__info">
102:                 {agent.os} &mdash; {agent.ip}
103:             </div>
104:         </div>
105:     )
106: }
107: 
108: export default AgentCard
</file>

<file path="controller/src/components/modules/KeylogTab/index.jsx">
  1: /* KeylogTab — scrollable terminal log of keystroke events received from the Agent.
  2:    The Agent always shows a consent popup and a visible indicator before sending any
  3:    data; this component only RENDERS what the Agent voluntarily pushes. */
  4: import { useRef, useEffect, useState, useMemo } from 'react'
  5: import { Keyboard, Circle, Trash2, Download, Play, Square } from 'lucide-react'
  6: 
  7: import useModuleStore                    from '../../../store/ModuleStore'
  8: import useAgentSocket                    from '../../../hooks/UseAgentSocket'
  9: import { useGuardedSend, usePendingConsent } from '../../PermissionGate'
 10: import { buildKeylogStart, buildKeylogStop } from '../../../services/Protocol'
 11: 
 12: // Distance (px) from the bottom; within this range auto-scroll stays active.
 13: const SCROLL_THRESHOLD = 60
 14: 
 15: // Stable empty array — prevents a new [] reference on every selector call.
 16: const EMPTY_EVENTS = []
 17: 
 18: // Build a display string from one raw event: "Alt+Tab", "Ctrl+C", "h", etc.
 19: function formatEvent(evt)
 20: {
 21:     const parts = []
 22:     if (evt.ctrl)  parts.push('Ctrl')
 23:     if (evt.alt)   parts.push('Alt')
 24:     // Only show Shift prefix for special keys (e.g. "Shift+F5"); for plain
 25:     // letters the key field already holds the shifted character.
 26:     if (evt.shift && evt.key.length > 1) parts.push('Shift')
 27:     parts.push(evt.key)
 28:     return parts.join('+')
 29: }
 30: 
 31: // Format a unix millisecond timestamp as HH:MM:SS (24-hour, local time).
 32: function formatTime(ts_ms)
 33: {
 34:     return new Date(ts_ms).toLocaleTimeString([], { hour12: false })
 35: }
 36: 
 37: // A raw event is a "printable" character worth joining onto the current
 38: // line when it is a single non-modified glyph. Any modifier or a named key
 39: // (Enter, Tab, F5, arrows, …) breaks the run and becomes its own line so
 40: // the reader can still tell shortcut sequences apart from typed text.
 41: function isPlainChar(evt)
 42: {
 43:     return evt.key.length === 1 && !evt.ctrl && !evt.alt
 44: }
 45: 
 46: // Fold consecutive printable characters into one line and give every other
 47: // event a line of its own. The line's timestamp is the first event's ts,
 48: // so long typing bursts show ONE clock reading instead of one per key.
 49: function groupEventsIntoLines(events)
 50: {
 51:     const lines = []
 52:     let buffer  = null                                                                                  // current in-progress typed run
 53: 
 54:     function flush()
 55:     {
 56:         if (buffer)
 57:         {
 58:             lines.push(buffer)
 59:             buffer = null
 60:         }
 61:     }
 62: 
 63:     for (const evt of events)
 64:     {
 65:         if (evt.key === 'Enter' || evt.key === 'Return')
 66:         {
 67:             // Enter closes the current line and is NOT rendered as its own
 68:             // row — the visible line break IS the semantic content.
 69:             flush()
 70:             continue
 71:         }
 72:         if (isPlainChar(evt))
 73:         {
 74:             if (!buffer)
 75:             {
 76:                 buffer = { timestamp_ms: evt.timestamp_ms, text: evt.key, kind: 'text' }
 77:             }
 78:             else
 79:             {
 80:                 buffer.text += evt.key
 81:             }
 82:             continue
 83:         }
 84:         // Modifier combo or named key — flush the run, then emit this event
 85:         // on its own line so shortcuts stay legible.
 86:         flush()
 87:         lines.push({ timestamp_ms: evt.timestamp_ms, text: formatEvent(evt), kind: 'key' })
 88:     }
 89:     flush()
 90:     return lines
 91: }
 92: 
 93: function KeylogTab({ agent })
 94: {
 95:     const { sendToFocused } = useAgentSocket()
 96:     const guardedSend       = useGuardedSend()
 97:     const is_pending        = usePendingConsent()
 98: 
 99:     // Subscribe to just this agent's keylog slice — no re-render for other agents.
100:     const events      = useModuleStore((s) => s.data[agent.id]?.keylog        ?? EMPTY_EVENTS)
101:     const is_active   = useModuleStore((s) => s.data[agent.id]?.keylog_active ?? false)
102:     const clearModule = useModuleStore((s) => s.clearModule)
103: 
104:     // Fold raw events into visible lines. Recomputed only when the event
105:     // array reference changes — the store already produces a new array on
106:     // every append, so this is O(N) per new event rather than per render.
107:     const lines = useMemo(() => groupEventsIntoLines(events), [events])
108: 
109:     // true while the user has scrolled up so we do not yank them back down.
110:     const [scroll_paused, setScrollPaused] = useState(false)
111: 
112:     const log_ref    = useRef(null)   // the scrollable <div> element
113:     const bottom_ref = useRef(null)   // invisible sentinel at the very bottom
114: 
115:     // Scroll to latest entry whenever the list grows, unless paused.
116:     useEffect(function ()
117:     {
118:         if (!scroll_paused && bottom_ref.current)
119:         {
120:             bottom_ref.current.scrollIntoView({ behavior: 'smooth' })
121:         }
122:     }, [lines.length, scroll_paused])
123: 
124:     // Detect scroll direction: pause auto-scroll when user reads older lines;
125:     // resume when they return near the bottom.
126:     function handleScroll()
127:     {
128:         const el = log_ref.current
129:         if (!el) return
130:         const dist_from_bottom = el.scrollHeight - el.scrollTop - el.clientHeight
131:         setScrollPaused(dist_from_bottom > SCROLL_THRESHOLD)
132:     }
133: 
134:     function handleStart()  { guardedSend(() => sendToFocused(buildKeylogStart())) }
135:     function handleStop()   { sendToFocused(buildKeylogStop())  }   // stop needs no fresh consent
136:     function handleClear()  { clearModule(agent.id, 'keylog')   }
137: 
138:     // Trigger a browser download of the buffered log as plain text. Uses
139:     // the SAME grouped lines the operator sees on screen, so what they save
140:     // matches what they read — not a per-event raw dump.
141:     function handleExport()
142:     {
143:         const text_lines = lines.map((ln) =>
144:             `${formatTime(ln.timestamp_ms)}  ${ln.text}`
145:         )
146:         const blob = new Blob([text_lines.join('\n')], { type: 'text/plain' })
147:         const url  = URL.createObjectURL(blob)
148:         const link = document.createElement('a')
149:         link.href     = url
150:         link.download = `keylog_${agent.id}_${Date.now()}.txt`
151:         link.click()
152:         URL.revokeObjectURL(url)
153:     }
154: 
155:     // Jump to bottom and resume auto-scroll when the notice is clicked.
156:     function handleResumeScroll()
157:     {
158:         setScrollPaused(false)
159:         if (bottom_ref.current)
160:         {
161:             bottom_ref.current.scrollIntoView({ behavior: 'smooth' })
162:         }
163:     }
164: 
165:     return (
166:         <div className="keylog-tab">
167: 
168:             {/* ── toolbar ───────────────────────────────────────────── */}
169:             <div className="keylog-tab__toolbar">
170: 
171:                 <div className="keylog-tab__title-group">
172:                     {/* Consent indicator — always visible; pulses red while active.
173:                         Shows OFFLINE when the agent is unreachable. */}
174:                     <span className={`keylog-tab__indicator${is_active ? ' keylog-tab__indicator--live' : ''}`}>
175:                         <Circle size={8} fill="currentColor" />
176:                         {!agent.online ? 'OFFLINE' : is_active ? 'LIVE' : 'IDLE'}
177:                     </span>
178:                     <span className="keylog-tab__title">
179:                         Input Activity — {agent.name}
180:                     </span>
181:                 </div>
182: 
183:                 <div className="keylog-tab__actions">
184:                     {!is_active
185:                         ? (
186:                             <button
187:                                 className="action-btn action-btn--start"
188:                                 onClick={handleStart}
189:                                 disabled={!agent.online || is_pending}
190:                                 title={is_pending ? 'Đang xin quyền...' : agent.online ? 'Start keylog (requires Agent consent)' : 'Agent is offline'}
191:                             >
192:                                 <Play size={12} /> Start
193:                             </button>
194:                         )
195:                         : (
196:                             <button
197:                                 className="action-btn action-btn--stop"
198:                                 onClick={handleStop}
199:                                 title="Stop keylog"
200:                             >
201:                                 <Square size={12} /> Stop
202:                             </button>
203:                         )
204:                     }
205:                     <button
206:                         className="action-btn action-btn--neutral"
207:                         onClick={handleClear}
208:                         disabled={events.length === 0}
209:                         title="Clear buffer"
210:                     >
211:                         <Trash2 size={12} /> Clear
212:                     </button>
213:                     <button
214:                         className="action-btn action-btn--neutral"
215:                         onClick={handleExport}
216:                         disabled={events.length === 0}
217:                         title="Export as .txt"
218:                     >
219:                         <Download size={12} /> Export
220:                     </button>
221:                 </div>
222: 
223:             </div>
224: 
225:             {/* ── scrollable terminal log ───────────────────────────── */}
226:             <div
227:                 ref={log_ref}
228:                 className="keylog-tab__log"
229:                 onScroll={handleScroll}
230:             >
231:                 {lines.length === 0
232:                     ? (
233:                         <div className="keylog-tab__empty">
234:                             <Keyboard size={32} strokeWidth={1.25} />
235:                             <span>{agent.online ? 'No events — press Start to begin capturing.' : 'Agent is offline — no input to capture.'}</span>
236:                         </div>
237:                     )
238:                     : lines.map((ln, i) => (
239:                         <div key={`${ln.timestamp_ms}-${i}`} className="keylog-tab__row">
240:                             <span className="keylog-tab__time">{formatTime(ln.timestamp_ms)}</span>
241:                             <span className="keylog-tab__key">{ln.text}</span>
242:                         </div>
243:                     ))
244:                 }
245:                 {/* Invisible anchor — scrollIntoView() targets this to jump to bottom */}
246:                 <div ref={bottom_ref} />
247:             </div>
248: 
249:             {/* ── "scroll to latest" pill — shown while paused and active ── */}
250:             {scroll_paused && is_active && (
251:                 <button
252:                     className="keylog-tab__scroll-notice"
253:                     onClick={handleResumeScroll}
254:                 >
255:                     ↓ Scroll to latest
256:                 </button>
257:             )}
258: 
259:         </div>
260:     )
261: }
262: 
263: export default KeylogTab
</file>

<file path="controller/src/components/layout/TopBar.jsx">
  1: /* TopBar.jsx — header bar: breadcrumb title, session badge, connection, theme, admin */
  2: import { Wifi, WifiOff, Loader2, LogOut, LayoutGrid, Maximize2 } from 'lucide-react'
  3: import { useShallow }      from 'zustand/react/shallow'
  4: import useUiStore         from '../../store/UiStore'
  5: import useAgentStore      from '../../store/AgentStore'
  6: import useConnectionStore from '../../store/ConnectionStore'
  7: import useModuleStore     from '../../store/ModuleStore'
  8: import ThemeToggle        from './ThemeToggle'
  9: import { logout }         from '../../services/AuthService'
 10: 
 11: /* map connection status to its icon + colour */
 12: function ConnectionIndicator({ status })
 13: {
 14:   if (status === 'open')
 15:   {
 16:     return (
 17:       <span className="topbar__connection">
 18:         <Wifi size={14} strokeWidth={1.75} style={{ color: 'var(--success)' }} />
 19:         Connected
 20:       </span>
 21:     )
 22:   }
 23:   if (status === 'connecting')
 24:   {
 25:     return (
 26:       <span className="topbar__connection">
 27:         <Loader2 size={14} strokeWidth={1.75} className="spin" style={{ color: 'var(--warning)' }} />
 28:         Connecting…
 29:       </span>
 30:     )
 31:   }
 32:   // 'idle' or 'closed'
 33:   return (
 34:     <span className="topbar__connection">
 35:       <WifiOff size={14} strokeWidth={1.75} style={{ color: 'var(--danger)' }} />
 36:       Disconnected
 37:     </span>
 38:   )
 39: }
 40: 
 41: function TopBar()
 42: {
 43:   const layout_mode      = useUiStore((s) => s.layout_mode)
 44:   const active_tab       = useUiStore((s) => s.active_tab)
 45:   const setLayoutMode    = useUiStore((s) => s.setLayoutMode)
 46:   const focused_agent_id = useAgentStore((s) => s.focused_agent_id)
 47:   const agents           = useAgentStore((s) => s.agents)
 48:   const status           = useConnectionStore((s) => s.status)
 49: 
 50:   // Global transparency badge — list agent ids that currently have any
 51:   // sensitive module running. If non-empty we show a red "SENSITIVE" badge
 52:   // so the operator ALWAYS knows something is being captured, regardless
 53:   // of which view they are in.
 54:   //
 55:   // IMPORTANT: derive the id list INSIDE the selector and use useShallow
 56:   // so this component only re-renders when the id set actually changes.
 57:   // If we instead subscribed to s.data, every incoming frame (24fps in
 58:   // focus mode) would re-render TopBar and cascade into modal children.
 59:   const sensitive_flags = useModuleStore(useShallow(function (s)
 60:   {
 61:       const flags = {}
 62:       for (const agent_id of Object.keys(s.data))
 63:       {
 64:           const d = s.data[agent_id]
 65:           flags[agent_id] = !!(d?.screen_stream_active || d?.webcam_active || d?.keylog_active)
 66:       }
 67:       return flags
 68:   }))
 69:   const sensitive_agent_ids = agents
 70:       .filter((a) => a.in_session || sensitive_flags[a.id])
 71:       .map((a) => a.id)
 72: 
 73:   const focused_agent = agents.find((a) => a.id === focused_agent_id) ?? null
 74: 
 75:   /* build the breadcrumb title shown in the header */
 76:   let title = 'Grid View — All Agents'
 77:   if (layout_mode === 'focus' && focused_agent)
 78:   {
 79:     const tab_label = active_tab.charAt(0).toUpperCase() + active_tab.slice(1)
 80:     title = `${focused_agent.name}  ›  ${tab_label}`
 81:   }
 82:   else if (layout_mode === 'focus')
 83:   {
 84:     title = 'Focus Mode — Select an Agent'
 85:   }
 86: 
 87:   const in_session = focused_agent?.in_session && layout_mode === 'focus'
 88: 
 89:   return (
 90:     <header className="topbar">
 91:       {/* breadcrumb / page title */}
 92:       <span className="topbar__title">{title}</span>
 93: 
 94:       {/* "ĐANG ĐIỀU KHIỂN" badge — only visible while a session is active */}
 95:       {in_session && (
 96:         <span className="session-badge session-badge--topbar">● ĐANG ĐIỀU KHIỂN</span>
 97:       )}
 98: 
 99:       {/* Global transparency badge — any agent with a sensitive module active.
100:           Kept always-visible (across grid + focus) so nothing sensitive can
101:           run silently. Count makes multi-agent activity obvious. */}
102:       {sensitive_agent_ids.length > 0 && (
103:         <span
104:           className="session-badge session-badge--topbar"
105:           title={`Sensitive activity on: ${sensitive_agent_ids.join(', ')}`}
106:           style={{ background: 'var(--danger-solid)', color: 'var(--on-danger)' }}
107:         >
108:           ● SENSITIVE · {sensitive_agent_ids.length}
109:         </span>
110:       )}
111: 
112:       {/* view-mode toggle buttons */}
113:       <button
114:         className="topbar__btn"
115:         onClick={() => setLayoutMode('grid')}
116:         title="Grid view — all agents"
117:         aria-pressed={layout_mode === 'grid'}
118:       >
119:         <LayoutGrid size={14} strokeWidth={1.75} />
120:       </button>
121: 
122:       <button
123:         className="topbar__btn"
124:         onClick={() => setLayoutMode('focus')}
125:         title="Focus view — single agent"
126:         aria-pressed={layout_mode === 'focus'}
127:       >
128:         <Maximize2 size={14} strokeWidth={1.75} />
129:       </button>
130: 
131:       <ConnectionIndicator status={status} />
132: 
133:       <ThemeToggle />
134: 
135:       {/* Logout — clears the JWT; App then unmounts the console shell, which
136:           closes the socket (the ref-counted hook fires its cleanup). */}
137:       <button
138:         className="topbar__btn"
139:         onClick={logout}
140:         title="Đăng xuất"
141:         style={{ display: 'flex', alignItems: 'center', gap: 4 }}
142:       >
143:         <LogOut size={14} strokeWidth={1.75} />
144:         Logout
145:       </button>
146:     </header>
147:   )
148: }
149: 
150: export default TopBar
</file>

<file path="controller/src/components/modules/ApplicationTab/index.jsx">
  1: /* ApplicationTab — shows the app list for the focused agent.
  2:    Thin wrapper around <ModuleTable />: declares the columns and the Start/Stop
  3:    action renderer. The whitelist is NOT hard-coded here — it comes from the
  4:    security policy the Controller pushed (PolicyStore) and the per-app
  5:    in_whitelist flag the Agent returns. Sort state, toolbar, empty state, and
  6:    scroll container all live in ModuleTable.                                    */
  7: import { useEffect, useMemo } from 'react'
  8: 
  9: import useModuleStore     from '../../../store/ModuleStore'
 10: import useConnectionStore from '../../../store/ConnectionStore'
 11: import usePolicyStore     from '../../../store/PolicyStore'
 12: import useAgentSocket     from '../../../hooks/UseAgentSocket'
 13: import ModuleTable        from '../../ModuleTable'
 14: import { useGuardedSend, usePendingConsent } from '../../PermissionGate'
 15: import { buildAppList, buildAppStart, buildAppStop } from '../../../services/Protocol'
 16: 
 17: // How often the tab asks the agent for a fresh snapshot (makes % look live).
 18: const POLL_INTERVAL_MS = 3000
 19: 
 20: // Stable empty array used as the fallback when the store has no data yet.
 21: // Using a module-level constant avoids creating a new [] reference on every
 22: // selector call, which would trigger an infinite re-render loop in Zustand.
 23: const EMPTY_APPS = []
 24: 
 25: // Column definitions passed to ModuleTable.
 26: // Only display_name and status use custom renderers; numeric cells fall back
 27: // to row[key] which prints the raw number.
 28: const COLUMNS =
 29: [
 30:     { key: 'display_name', label: 'App Name',  numeric: false },
 31:     {
 32:         key: 'status',
 33:         label: 'Status',
 34:         numeric: false,
 35:         render: (row) => (
 36:             <span className={`module-table__badge module-table__badge--${row.status}`}>
 37:                 {row.status}
 38:             </span>
 39:         ),
 40:     },
 41:     {
 42:         key: 'cpu_percent',
 43:         label: 'CPU %',
 44:         numeric: true,
 45:         render: (row) => row.cpu_percent.toFixed(1),
 46:     },
 47:     { key: 'ram_mb', label: 'RAM (MB)', numeric: true },
 48: ]
 49: 
 50: function ApplicationTab({ agent })
 51: {
 52:     // sendToFocused auto-injects [focused_agent_id] into target_agents,
 53:     // so tabs never need to thread agent.id into every builder call.
 54:     const { sendToFocused } = useAgentSocket()
 55:     const guardedSend       = useGuardedSend()
 56:     const is_pending        = usePendingConsent()
 57: 
 58:     // Select only this agent's app slice — no re-render when other agents update.
 59:     // EMPTY_APPS (module-level const) keeps the reference stable when data is absent.
 60:     const apps = useModuleStore((s) => s.data[agent.id]?.app ?? EMPTY_APPS)
 61: 
 62:     // Connection status drives the empty-state message (loading vs disconnected).
 63:     const conn_status = useConnectionStore((s) => s.status)
 64: 
 65:     // Whitelist sourced from the pushed security policy (NOT hard-coded).
 66:     // Used as a fallback when an app row has no in_whitelist flag.
 67:     const app_whitelist = usePolicyStore((s) => s.app_whitelist)
 68:     const whitelist_set = useMemo(() => new Set(app_whitelist), [app_whitelist])
 69: 
 70:     // Fetch on mount; refresh every POLL_INTERVAL_MS for live-looking numbers.
 71:     // Effect re-runs if the user focuses a different agent (agent.id changes).
 72:     // Skip polling entirely for offline agents — they cannot answer.
 73:     useEffect(function ()
 74:     {
 75:         if (!agent.online) return
 76: 
 77:         // Wrap the FIRST fetch so opening the tab auto-triggers the consent
 78:         // popup. Later polls skip the wrapper — the socket layer already
 79:         // filters ungranted messages, so extra guardedSend calls each 3s
 80:         // would just enqueue duplicate sendFns.
 81:         guardedSend(function () { sendToFocused(buildAppList()) })
 82: 
 83:         const timer = setInterval(function ()
 84:         {
 85:             sendToFocused(buildAppList(), { silent: true })                                         // Poll tick — suppress the "N agents not granted" toast so the operator isn't spammed every 3 s
 86: 
 87:         }, POLL_INTERVAL_MS)
 88: 
 89:         return () => clearInterval(timer)   // stop polling when tab unmounts or agent changes
 90:         // eslint-disable-next-line react-hooks/exhaustive-deps
 91:     }, [agent.id, agent.online])
 92: 
 93:     // Friendly empty state: distinguish offline agent, dead link, and loading.
 94:     const empty_label = !agent.online     ? 'Agent is offline'
 95:                       : conn_status !== 'open' ? 'Gateway disconnected — waiting to reconnect…'
 96:                       :                        'Loading application list…'
 97: 
 98:     // Action column renderer — Start or Stop depending on current status,
 99:     // disabled entirely for apps outside the pushed policy whitelist.
100:     // Prefer the Agent's in_whitelist flag; fall back to the policy set.
101:     function renderAction(row)
102:     {
103:         const is_whitelisted = row.in_whitelist ?? whitelist_set.has(row.name)
104:         const is_running     = row.status === 'running'
105:         const disabled_tip   = 'Not in whitelist — action blocked'
106: 
107:         if (is_running)
108:         {
109:             return (
110:                 <button
111:                     className="action-btn action-btn--stop"
112:                     disabled={!is_whitelisted || is_pending}
113:                     title={is_pending ? 'Đang xin quyền...' : is_whitelisted ? 'Stop this application' : disabled_tip}
114:                     onClick={() => guardedSend(() => sendToFocused(buildAppStop(row.name)))}
115:                 >
116:                     Stop
117:                 </button>
118:             )
119:         }
120: 
121:         return (
122:             <button
123:                 className="action-btn action-btn--start"
124:                 disabled={!is_whitelisted || is_pending}
125:                 title={is_pending ? 'Đang xin quyền...' : is_whitelisted ? 'Start this application' : disabled_tip}
126:                 onClick={() => guardedSend(() => sendToFocused(buildAppStart(row.name)))}
127:             >
128:                 Start
129:             </button>
130:         )
131:     }
132: 
133:     return (
134:         <ModuleTable
135:             columns={COLUMNS}
136:             rows={apps}
137:             actionColumn={{ header: 'Action', render: renderAction }}
138:             empty_label={empty_label}
139:             title={`Applications — ${agent.name}`}
140:             poll_badge={agent.online}
141:             row_key={(row) => row.name}
142:         />
143:     )
144: }
145: 
146: export default ApplicationTab
</file>

<file path="controller/src/components/modules/ProcessTab/index.jsx">
  1: /* ProcessTab — shows all running processes for the focused agent.
  2:    Thin wrapper around <ModuleTable />: declares the columns and a Kill action
  3:    for every row. Sort state, toolbar, empty state, and scroll container all
  4:    live in ModuleTable.                                                          */
  5: import { useEffect, useState } from 'react'
  6: 
  7: import useModuleStore     from '../../../store/ModuleStore'
  8: import useConnectionStore from '../../../store/ConnectionStore'
  9: import useUiStore         from '../../../store/UiStore'
 10: import useAgentSocket     from '../../../hooks/UseAgentSocket'
 11: import ModuleTable        from '../../ModuleTable'
 12: import { useGuardedSend, usePendingConsent } from '../../PermissionGate'
 13: import { buildProcList, buildProcKill } from '../../../services/Protocol'
 14: 
 15: // How often the tab polls for a fresh process snapshot.
 16: const POLL_INTERVAL_MS = 3000
 17: 
 18: // Stable empty fallback — prevents a new [] from being returned on every selector
 19: // call, which would trigger Zustand's infinite re-render detection.
 20: const EMPTY_PROCS = []
 21: 
 22: // Column definitions passed to ModuleTable.
 23: // Numeric columns without a render fall back to the raw row[key] value.
 24: const COLUMNS =
 25: [
 26:     { key: 'name',        label: 'Process Name', numeric: false },
 27:     { key: 'pid',         label: 'PID',          numeric: true  },
 28:     {
 29:         key: 'cpu_percent',
 30:         label: 'CPU %',
 31:         numeric: true,
 32:         render: (row) => row.cpu_percent.toFixed(1),
 33:     },
 34:     {
 35:         key: 'ram_mb',
 36:         label: 'RAM (MB)',
 37:         numeric: true,
 38:         render: (row) => row.ram_mb.toFixed(0),
 39:     },
 40: ]
 41: 
 42: function ProcessTab({ agent })
 43: {
 44:     // sendToFocused auto-injects [focused_agent_id] into target_agents,
 45:     // so tabs never need to thread agent.id into every builder call.
 46:     const { sendToFocused } = useAgentSocket()
 47:     const addToast          = useUiStore((s) => s.addToast)
 48:     const guardedSend       = useGuardedSend()
 49:     const is_pending        = usePendingConsent()
 50: 
 51:     // ── Manual "Kill by PID" form ─────────────────────────────────────────
 52:     // Validate inline: integer strictly greater than 0. Empty is not an
 53:     // error yet (user hasn't typed) — the submit button just stays disabled.
 54:     const [pid_input,  setPidInput] = useState('')
 55:     const trimmed_pid = pid_input.trim()
 56:     const parsed_pid  = /^\d+$/.test(trimmed_pid) ? parseInt(trimmed_pid, 10) : NaN
 57:     const pid_valid   = Number.isInteger(parsed_pid) && parsed_pid > 0
 58:     const pid_error   = trimmed_pid === ''
 59:         ? ''
 60:         : (pid_valid ? '' : 'PID phải là số nguyên dương')
 61: 
 62:     function handleManualKill(e)
 63:     {
 64:         e.preventDefault()
 65:         if (!pid_valid) return
 66:         guardedSend(function ()
 67:         {
 68:             try
 69:             {
 70:                 sendToFocused(buildProcKill(parsed_pid))
 71:                 setPidInput('')
 72:             }
 73:             catch (err)
 74:             {
 75:                 // Defense-in-depth: builder threw despite our UI check.
 76:                 addToast(err.message ?? 'Failed to build proc_kill request', 'error')
 77:             }
 78:         })
 79:     }
 80: 
 81:     // Select only this agent's process slice — avoids re-render for other agents.
 82:     // EMPTY_PROCS keeps the selector return value stable when no data exists yet.
 83:     const procs = useModuleStore((s) => s.data[agent.id]?.process ?? EMPTY_PROCS)
 84: 
 85:     // Connection status drives the empty-state message (loading vs disconnected).
 86:     const conn_status = useConnectionStore((s) => s.status)
 87: 
 88:     // Fetch on mount; refresh every POLL_INTERVAL_MS.
 89:     // Re-runs when the focused agent changes. Offline agents are not polled.
 90:     useEffect(function ()
 91:     {
 92:         if (!agent.online) return
 93: 
 94:         // Wrap the first fetch so opening the tab auto-triggers the consent
 95:         // popup. Interval ticks skip the wrapper — see ApplicationTab for rationale.
 96:         guardedSend(function () { sendToFocused(buildProcList()) })
 97: 
 98:         const timer = setInterval(function ()
 99:         {
100:             sendToFocused(buildProcList(), { silent: true })                                        // Poll tick — suppress the "N agents not granted" toast so the operator isn't spammed every 3 s
101: 
102:         }, POLL_INTERVAL_MS)
103: 
104:         return () => clearInterval(timer)
105:         // eslint-disable-next-line react-hooks/exhaustive-deps
106:     }, [agent.id, agent.online])
107: 
108:     // Friendly empty state: distinguish offline agent, dead link, and loading.
109:     const empty_label = !agent.online     ? 'Agent is offline'
110:                       : conn_status !== 'open' ? 'Gateway disconnected — waiting to reconnect…'
111:                       :                        'Loading process list…'
112: 
113:     // Action column renderer — Kill button on every row.
114:     function renderAction(row)
115:     {
116:         return (
117:             <button
118:                 className="action-btn action-btn--kill"
119:                 onClick={() => guardedSend(() => sendToFocused(buildProcKill(row.pid)))}
120:                 disabled={is_pending}
121:                 title={is_pending ? 'Đang xin quyền...' : `Kill PID ${row.pid}`}
122:             >
123:                 Kill
124:             </button>
125:         )
126:     }
127: 
128:     return (
129:         <div>
130:             {/* Manual "Kill by PID" — for processes not visible in the current list. */}
131:             <form className="form-inline" onSubmit={handleManualKill}>
132:                 <label htmlFor="proc-kill-pid" className="form-inline__label">Kill by PID:</label>
133:                 <input
134:                     id="proc-kill-pid"
135:                     className={`form-inline__input${pid_error ? ' form-inline__input--error' : ''}`}
136:                     type="number"
137:                     min="1"
138:                     step="1"
139:                     inputMode="numeric"
140:                     placeholder="e.g. 4321"
141:                     value={pid_input}
142:                     onChange={(e) => setPidInput(e.target.value)}
143:                     disabled={!agent.online}
144:                     aria-invalid={Boolean(pid_error)}
145:                     aria-describedby={pid_error ? 'proc-kill-pid-error' : undefined}
146:                 />
147:                 <button
148:                     type="submit"
149:                     className="action-btn action-btn--kill"
150:                     disabled={!pid_valid || !agent.online || is_pending}
151:                     title={is_pending ? 'Đang xin quyền...' : pid_valid ? `Kill PID ${parsed_pid}` : 'Enter a positive integer PID first'}
152:                 >
153:                     Kill
154:                 </button>
155:                 {pid_error && (
156:                     <span id="proc-kill-pid-error" className="form-inline__error">{pid_error}</span>
157:                 )}
158:             </form>
159: 
160:             <ModuleTable
161:                 columns={COLUMNS}
162:                 rows={procs}
163:                 actionColumn={{ header: 'Action', render: renderAction }}
164:                 empty_label={empty_label}
165:                 title={`Processes — ${agent.name}`}
166:                 poll_badge={agent.online}
167:                 row_key={(row) => row.pid}
168:             />
169:         </div>
170:     )
171: }
172: 
173: export default ProcessTab
</file>

