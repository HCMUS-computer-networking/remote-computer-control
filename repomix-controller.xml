793: // ─── SysInfo module (docs/protocol/SysInfo.json) ───────────────────────────
794: // Read-only hardware / OS metrics — Agent does NOT ask for consent on this.
795: // Reply is a "sysinfo_result" message with cpu_percent / ram_used_mb /
796: // ram_total_mb / disk_used_gb / disk_total_gb / uptime_seconds / hostname / ip / os.
797: export function buildSysInfo(targetAgents)
798: {
799:     return buildRequest(MODULE.SYSINFO, {}, targetAgents)
800: }
801: 
802: // ─── Remote Input module (docs/protocol/Input.json) ───────────────────────
803: // All 4 commands are one-shot and gated by feature="input". The Controller
804: // must obtain a permission_result{granted:true, feature:"input"} before
805: // emitting any of these — fanoutSend drops them silently otherwise.
806: // input_mouse_move is fire-and-forget (Agent sends no ACK) to survive
807: // 30+ events/sec without saturating the socket.
808: 
809: export function buildInputMouseMove(x, y, targetAgents)
810: {
811:     assertNonNegativeInt(x, 'x')
812:     assertNonNegativeInt(y, 'y')
813:     return buildRequest(MODULE.INPUT_MOUSE_MOVE, { x, y }, targetAgents)
814: }
815: 
816: export function buildInputMouseClick(button, action, targetAgents)
817: {
818:     assertOneOf(button, ['left', 'right', 'middle'], 'button')
819:     assertOneOf(action, ['down', 'up', 'click'],     'action')
820:     return buildRequest(MODULE.INPUT_MOUSE_CLICK, { button, action }, targetAgents)
821: }
822: 
823: export function buildInputKey(vk, action, targetAgents)
824: {
825:     assertIntInRange(vk, 1, 255, 'vk')
826:     assertOneOf(action, ['down', 'up', 'press'], 'action')
827:     return buildRequest(MODULE.INPUT_KEY, { vk, action }, targetAgents)
828: }
829: 
830: export function buildInputType(text, targetAgents)
831: {
832:     assertNonEmptyString(text, 'text')
833:     return buildRequest(MODULE.INPUT_TYPE, { text }, targetAgents)
834: }
835: 
836: // ─── Power module (docs/protocol/power.json) ───────────────────────────────
837: 
838: // Send a power action. Uses its own "power" type, NOT the generic "request" type.
839: // action — one of the POWER_ACTION constants: lock / restart / shutdown / sleep
840: // Note: lock is immediate; restart / shutdown / sleep must be sent only after
841: //       the Controller shows a 10-second countdown to the operator.
842: export function buildPower(action, targetAgents)
843: {
844:     assertOneOf(action, Object.values(POWER_ACTION), 'power action')
845:     const target_agents = targetAgents ?? []
846:     assertAgentIdList(target_agents, 'target_agents')
847:     return buildMessage(MSG_TYPE.POWER,
848:     {
849:         action,
850:         target_agents,
851:     })
852: }
