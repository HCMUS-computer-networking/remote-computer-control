<file path="controller/src/services/AuthService.js">
  1: // AuthService.js — admin login + refresh + logout against the Gateway REST API.
  2: //
  3: // TOKEN MODEL (C4):
  4: //   - Access token  : short-lived JWT (~30 min) returned in the /api/login JSON
  5: //                     body. Held ONLY in memory (Zustand ConnectionStore) —
  6: //                     NEVER in sessionStorage/localStorage. Vanishes on page
  7: //                     reload; the refresh flow re-hydrates it.
  8: //   - Refresh token : ~7 days, set by the Gateway as an HttpOnly Cookie. The
  9: //                     Controller code NEVER touches it directly — the browser
 10: //                     attaches it automatically via `credentials: 'include'`.
 11: //                     HttpOnly means it is not reachable from JS, which stops
 12: //                     an XSS from stealing it.
 13: //
 14: // INTERCEPTOR: `apiFetch` wraps `fetch` so any authenticated call that comes
 15: // back 401 tries a single refresh, then retries once. If the refresh itself
 16: // fails (401 / network) we log out — the operator lands on LoginScreen.
 17: //
 18: // REFRESH DEDUP: many components / handlers may race a refresh at once
 19: // (WS `auth_expired` + a pending REST 401). We coalesce with a single
 20: // in-flight promise so the Gateway only sees one /api/refresh call.
 21: 
 22: import useConnectionStore from '../store/ConnectionStore'
 23: 
 24: // Derive the HTTP base URL from the WebSocket gateway URL by swapping the
 25: // scheme: ws:// -> http://  and  wss:// -> https://.
 26: function gatewayHttpUrl()
 27: {
 28:     const ws_url = import.meta.env.VITE_GATEWAY_URL ?? 'ws://localhost:8080'
 29:     return ws_url.replace(/^ws(s?):\/\//i, 'http$1://')
 30: }
 31: 
 32: // One shared promise for the current /api/refresh call — new callers reuse it
 33: // instead of firing another network request.
 34: let _refresh_in_flight = null
 35: 
 36: // Monotonic session counter. Bumped on every logout so a refresh in flight can
 37: // tell it belongs to a stale session and MUST NOT write the new token back
 38: // into the store (which would silently un-logout the operator).
 39: let _session_epoch = 0
 40: 
 41: // ─── Public: login ────────────────────────────────────────────────────────────
 42: 
 43: // Attempt an admin login. Returns { ok, token, message }.
 44: // On success the access token is written to ConnectionStore.auth_token
 45: // (memory only). The refresh token is set by the Gateway as an HttpOnly Cookie
 46: // via Set-Cookie — the client never sees it.
 47: export async function login(username, password)
 48: {
 49:     let response
 50:     try
 51:     {
 52:         response = await fetch(`${gatewayHttpUrl()}/api/login`,
 53:         {
 54:             method      : 'POST',
 55:             headers     : { 'Content-Type': 'application/json' },
 56:             body        : JSON.stringify({ username, password }),
 57:             credentials : 'include',   // let the Gateway set the refresh cookie
 58:         })
 59:     }
 60:     catch (err)
 61:     {
 62:         console.error('[AuthService] login network error:', err)
 63:         return { ok: false, message: 'Không kết nối được Gateway. Kiểm tra máy chủ và thử lại.' }
 64:     }
 65: 
 66:     let body = {}
 67:     try { body = await response.json() }
 68:     catch { body = {} }
 69: 
 70:     if (!response.ok || !body.ok || !body.token)
 71:     {
 72:         return { ok: false, message: body.message ?? 'Sai tài khoản hoặc mật khẩu.' }
 73:     }
 74: 
 75:     // Access token lives in memory only — no sessionStorage / localStorage.
 76:     useConnectionStore.getState().setAuthToken(body.token)
 77: 
 78:     return { ok: true, token: body.token, message: body.message ?? 'Đăng nhập thành công.' }
 79: }
 80: 
 81: // ─── Public: refresh access token ─────────────────────────────────────────────
 82: 
 83: // Ask the Gateway for a new access token using the HttpOnly refresh cookie.
 84: // Returns { ok, token, message }. On success the new token replaces the one in
 85: // ConnectionStore. Callers that race are coalesced onto one in-flight request.
 86: export function refreshAccessToken()
 87: {
 88:     if (_refresh_in_flight) return _refresh_in_flight
 89: 
 90:     // Snapshot the session at request-start; a logout during the fetch will
 91:     // bump _session_epoch and this refresh must NOT write its result back.
 92:     const started_epoch = _session_epoch
 93: 
 94:     _refresh_in_flight = (async function ()
 95:     {
 96:         let response
 97:         try
 98:         {
 99:             response = await fetch(`${gatewayHttpUrl()}/api/refresh`,
100:             {
101:                 method      : 'POST',
102:                 credentials : 'include',   // sends the HttpOnly refresh cookie
103:             })
104:         }
105:         catch (err)
106:         {
107:             console.error('[AuthService] refresh network error:', err)
108:             return { ok: false, message: 'Không kết nối được Gateway để làm mới phiên.' }
109:         }
110: 
111:         let body = {}
112:         try { body = await response.json() }
113:         catch { body = {} }
114: 
115:         if (!response.ok || !body.ok || !body.token)
116:         {
117:             return { ok: false, message: body.message ?? 'Phiên đã hết hạn, cần đăng nhập lại.' }
118:         }
119: 
120:         // Race guard: if the operator logged out while this fetch was in
121:         // flight, silently drop the new token instead of un-logging them out.
122:         if (started_epoch !== _session_epoch)
123:         {
124:             return { ok: false, message: 'Đã đăng xuất trong lúc làm mới phiên.' }
125:         }
126: 
127:         useConnectionStore.getState().setAuthToken(body.token)
128:         return { ok: true, token: body.token, message: body.message ?? '' }
129:     })().finally(function ()
130:     {
131:         _refresh_in_flight = null
132:     })
133: 
134:     return _refresh_in_flight
135: }
136: 
137: // ─── Public: logout ───────────────────────────────────────────────────────────
138: 
139: // Clear the in-memory access token immediately (UI drops to LoginScreen this
140: // tick) and fire a best-effort /api/logout in the background so the Gateway
141: // can invalidate the refresh cookie. A network failure is logged and ignored
142: // — the client is already logged out locally.
143: export function logout()
144: {
145:     // Bump the epoch FIRST so any refresh that resolves after this point sees
146:     // a mismatched snapshot and drops its token result.
147:     _session_epoch++
148:     useConnectionStore.getState().clearAuthToken()
149: 
150:     fetch(`${gatewayHttpUrl()}/api/logout`,
151:     {
152:         method      : 'POST',
153:         credentials : 'include',   // sends the cookie so the server can revoke it
154:     })
155:     .catch(function (err)
156:     {
157:         console.warn('[AuthService] logout network error (ignored):', err)
158:     })
159: }
160: 
161: // ─── Public: authenticated fetch with 401 → refresh → retry ───────────────────
162: 
163: // Wrap fetch so any 401 response triggers ONE refresh + retry. If the refresh
164: // itself fails we log out and reject so the caller stops. Every call includes
165: // the refresh cookie via `credentials: 'include'`.
166: export async function apiFetch(url, opts = {})
167: {
168:     const auth_token = useConnectionStore.getState().auth_token
169:     const with_auth  =
170:     {
171:         ...opts,
172:         credentials : 'include',
173:         headers     :
174:         {
175:             ...(opts.headers ?? {}),
176:             ...(auth_token ? { Authorization: `Bearer ${auth_token}` } : {}),
177:         },
178:     }
179: 
180:     let response = await fetch(url, with_auth)
181:     if (response.status !== 401) return response
182: 
183:     const refreshed = await refreshAccessToken()
184:     if (!refreshed.ok)
185:     {
186:         // Refresh cookie is dead — force the operator back to LoginScreen.
187:         await logout()
188:         return response   // return the original 401 so the caller sees it
189:     }
190: 
191:     // Retry ONCE with the newly-issued access token.
192:     const retry_token = useConnectionStore.getState().auth_token
193:     const retry_opts  =
194:     {
195:         ...opts,
196:         credentials : 'include',
197:         headers     :
198:         {
199:             ...(opts.headers ?? {}),
200:             ...(retry_token ? { Authorization: `Bearer ${retry_token}` } : {}),
201:         },
202:     }
203:     return fetch(url, retry_opts)
204: }
205: 
206: // ─── Public: read current token ───────────────────────────────────────────────
207: 
208: export function getToken()
209: {
210:     return useConnectionStore.getState().auth_token
211: }
</file>

<file path="controller/src/store/PermissionStore.js">
 1: // PermissionStore.js — consent state per (agent_id, feature) for Plan B.
 2: //
 3: // Plan B requires the Controller to obtain Agent consent for a feature BEFORE
 4: // sending any module command. This store tracks where each (agent, feature)
 5: // pair is in that handshake so PermissionGate can enable / disable the module
 6: // command buttons accordingly.
 7: //
 8: // Status values (one string per (agent_id, feature)):
 9: //   'idle'       — no request sent yet (default)
10: //   'requesting' — permission_request sent, waiting for the Agent reply
11: //   'granted'    — Agent user approved; module commands are allowed
12: //   'denied'     — Agent user declined the consent popup
13: import { create } from 'zustand'
14: 
15: // Default status when a pair has never been touched.
16: const DEFAULT_STATUS = 'idle'
17: 
18: const usePermissionStore = create(function (set, get)
19: {
20:     return {
21:         // Nested map: permissions[agent_id][feature] = status string.
22:         permissions: {},
23: 
24:         // Mark a pair as 'requesting' right after we send permission_request.
25:         requestPermission: (agent_id, feature) =>
26:             set(function (s)
27:             {
28:                 const agent_perms = s.permissions[agent_id] ?? {}
29:                 return {
30:                     permissions:
31:                     {
32:                         ...s.permissions,
33:                         [agent_id]: { ...agent_perms, [feature]: 'requesting' },
34:                     },
35:                 }
36:             }),
37: 
38:         // Apply the Agent reply: granted → 'granted', otherwise → 'denied'.
39:         setPermissionResult: (agent_id, feature, granted) =>
40:             set(function (s)
41:             {
42:                 const agent_perms = s.permissions[agent_id] ?? {}
43:                 return {
44:                     permissions:
45:                     {
46:                         ...s.permissions,
47:                         [agent_id]: { ...agent_perms, [feature]: granted ? 'granted' : 'denied' },
48:                     },
49:                 }
50:             }),
51: 
52:         // Drop a granted feature back to 'idle' (called on revoke / disconnect).
53:         revoke: (agent_id, feature) =>
54:             set(function (s)
55:             {
56:                 const agent_perms = s.permissions[agent_id] ?? {}
57:                 return {
58:                     permissions:
59:                     {
60:                         ...s.permissions,
61:                         [agent_id]: { ...agent_perms, [feature]: 'idle' },
62:                     },
63:                 }
64:             }),
65: 
66:         // Drop all granted features back to 'idle' (called on reconnect).
67:         revokeAll: (agent_id) =>
68:             set(function (s)
69:             {
70:                 const nextPerms = { ...s.permissions }
71:                 delete nextPerms[agent_id]
72:                 return { permissions: nextPerms }
73:             }),
74: 
75:         // Non-reactive read for hook / callback code (components use a selector).
76:         getStatus: (agent_id, feature) =>
77:         {
78:             return get().permissions[agent_id]?.[feature] ?? DEFAULT_STATUS
79:         },
80:     }
81: })
82: 
83: export default usePermissionStore
</file>

<file path="controller/src/store/PolicyStore.js">
 1: // PolicyStore.js — the security policy the Controller pushes to every Agent.
 2: //
 3: // Single source of truth for the app whitelist + sandbox path. The Controller
 4: // sends this on connect (policy_update); the Agent overrides its local config
 5: // in RAM and replies policy_update_result. Module tabs read the whitelist and
 6: // sandbox path from HERE instead of hard-coding them, per project rules.
 7: // Format: docs/protocol/PolicyUpdate.json.
 8: import { create } from 'zustand'
 9: 
10: // Default policy the Controller ships with. Covers the common apps across the
11: // Windows / Linux / macOS agents so allowed apps can be Started / Stopped.
12: // Apps NOT listed here are still shown but their Start/Stop buttons stay
13: // disabled (e.g. "mspaint" is intentionally omitted to show a blocked case).
14: const DEFAULT_APP_WHITELIST =
15: [
16:     'notepad', 'calc', 'chrome', 'vlc',        // Windows
17:     'firefox', 'code', 'terminal', 'gedit',    // Linux
18:     'safari', 'textedit',                      // macOS
19: ]
20: 
21: // Sandbox root that file operations are confined to on the Agent side.
22: const DEFAULT_SANDBOX_PATH = 'C:\\AgentSandbox\\'
23: 
24: const usePolicyStore = create(function (set)
25: {
26:     return {
27:         app_whitelist : DEFAULT_APP_WHITELIST,   // app short-names allowed to Start/Stop
28:         sandbox_path  : DEFAULT_SANDBOX_PATH,     // Agent sandbox root pushed in the policy
29:         results       : {},                       // { [agent_id]: { success, message } }
30: 
31:         // Replace the whitelist (e.g. from a future admin UI).
32:         setWhitelist: (list) => set({ app_whitelist: list }),
33: 
34:         // Replace the sandbox path.
35:         setSandboxPath: (path) => set({ sandbox_path: path }),
36: 
37:         // Record one agent's policy_update_result so the UI can show it.
38:         setPolicyResult: (agent_id, result) =>
39:             set(function (s)
40:             {
41:                 return { results: { ...s.results, [agent_id]: result } }
42:             }),
43:     }
44: })
45: 
46: export default usePolicyStore
</file>

<file path="controller/src/utils/crypto.js">
  1: /**
  2:  * E2EE Crypto Utilities for Controller (React)
  3:  * Uses Web Crypto API for ECDH, HKDF, HMAC, and AES-GCM.
  4:  */
  5: 
  6: // --- Base64 / ArrayBuffer Utilities ---
  7: 
  8: export const arrayBufferToBase64 = (buffer) => {
  9:     let binary = '';
 10:     const bytes = new Uint8Array(buffer);
 11:     const len = bytes.byteLength;
 12:     for (let i = 0; i < len; i++) {
 13:         binary += String.fromCharCode(bytes[i]);
 14:     }
 15:     return window.btoa(binary);
 16: };
 17: 
 18: export const base64ToArrayBuffer = (base64) => {
 19:     const binaryString = window.atob(base64);
 20:     const len = binaryString.length;
 21:     const bytes = new Uint8Array(len);
 22:     for (let i = 0; i < len; i++) {
 23:         bytes[i] = binaryString.charCodeAt(i);
 24:     }
 25:     return bytes.buffer;
 26: };
 27: 
 28: // --- Key Management (ECDH) ---
 29: 
 30: /**
 31:  * Generates an ECDH KeyPair using the P-256 curve.
 32:  * @returns {Promise<CryptoKeyPair>} { publicKey, privateKey }
 33:  */
 34: export const generateECDHKeyPair = async () => {
 35:     return await window.crypto.subtle.generateKey(
 36:         {
 37:             name: 'ECDH',
 38:             namedCurve: 'P-256',
 39:         },
 40:         true, // extractable
 41:         ['deriveKey', 'deriveBits']
 42:     );
 43: };
 44: 
 45: /**
 46:  * Exports a CryptoKey to SPKI format (Base64)
 47:  * @param {CryptoKey} publicKey 
 48:  * @returns {Promise<string>} Base64 SPKI string
 49:  */
 50: export const exportPublicKeyToSPKI = async (publicKey) => {
 51:     const spkiBuffer = await window.crypto.subtle.exportKey('spki', publicKey);
 52:     return arrayBufferToBase64(spkiBuffer);
 53: };
 54: 
 55: /**
 56:  * Imports a Base64 SPKI string into a CryptoKey for ECDH.
 57:  * @param {string} spkiBase64 
 58:  * @returns {Promise<CryptoKey>}
 59:  */
 60: export const importPublicKeyFromSPKI = async (spkiBase64) => {
 61:     const spkiBuffer = base64ToArrayBuffer(spkiBase64);
 62:     return await window.crypto.subtle.importKey(
 63:         'spki',
 64:         spkiBuffer,
 65:         {
 66:             name: 'ECDH',
 67:             namedCurve: 'P-256'
 68:         },
 69:         true,
 70:         [] // public keys don't have operations like 'deriveKey' directly, they are passed as inputs
 71:     );
 72: };
 73: 
 74: // --- Authentication (HMAC) ---
 75: 
 76: const getHMACKey = async (secretPIN) => {
 77:     const enc = new TextEncoder();
 78:     return await window.crypto.subtle.importKey(
 79:         'raw',
 80:         enc.encode(secretPIN),
 81:         { name: 'HMAC', hash: 'SHA-256' },
 82:         false,
 83:         ['sign', 'verify']
 84:     );
 85: };
 86: 
 87: /**
 88:  * Signs a Base64 string (Public Key) using HMAC-SHA256 and the shared PIN.
 89:  * @param {string} dataBase64 
 90:  * @param {string} secretPIN 
 91:  * @returns {Promise<string>} Base64 Signature
 92:  */
 93: export const signHMAC = async (dataBase64, secretPIN) => {
 94:     const key = await getHMACKey(secretPIN);
 95:     const dataBuffer = new TextEncoder().encode(dataBase64);
 96:     const signatureBuffer = await window.crypto.subtle.sign('HMAC', key, dataBuffer);
 97:     return arrayBufferToBase64(signatureBuffer);
 98: };
 99: 
100: /**
101:  * Verifies an HMAC-SHA256 signature.
102:  * @param {string} dataBase64 
103:  * @param {string} signatureBase64 
104:  * @param {string} secretPIN 
105:  * @returns {Promise<boolean>} true if valid
106:  */
107: export const verifyHMAC = async (dataBase64, signatureBase64, secretPIN) => {
108:     const key = await getHMACKey(secretPIN);
109:     const dataBuffer = new TextEncoder().encode(dataBase64);
110:     const signatureBuffer = base64ToArrayBuffer(signatureBase64);
111:     return await window.crypto.subtle.verify('HMAC', key, signatureBuffer, dataBuffer);
112: };
113: 
114: // --- Key Derivation (HKDF) ---
115: 
116: /**
117:  * Derives a 256-bit AES-GCM Session Key using HKDF.
118:  * @param {CryptoKey} myPrivateKey 
119:  * @param {CryptoKey} agentPublicKey 
120:  * @returns {Promise<CryptoKey>} AES-GCM Session Key
121:  */
122: export const deriveSessionKey = async (myPrivateKey, agentPublicKey) => {
123:     // 1. Derive the raw shared secret (IKM) using ECDH
124:     const sharedSecretBuffer = await window.crypto.subtle.deriveBits(
125:         {
126:             name: 'ECDH',
127:             public: agentPublicKey
128:         },
129:         myPrivateKey,
130:         256 // length in bits
131:     );
132: 
133:     // 2. Import the shared secret as an HKDF key material
134:     const hkdfKeyMaterial = await window.crypto.subtle.importKey(
135:         'raw',
136:         sharedSecretBuffer,
137:         { name: 'HKDF' },
138:         false,
139:         ['deriveKey']
140:     );
141: 
142:     // 3. Derive the final AES-GCM key using HKDF
143:     const infoBuffer = new TextEncoder().encode('RemoteControl_E2EE_v1');
144:     const tcpKey = await window.crypto.subtle.deriveKey(
145:         {
146:             name: 'HKDF',
147:             hash: 'SHA-256',
148:             salt: new Uint8Array(0),
149:             info: infoBuffer
150:         },
151:         hkdfKeyMaterial,
152:         { name: 'AES-GCM', length: 256 },
153:         false, 
154:         ['encrypt', 'decrypt']
155:     );
156: 
157:     const udpInfoBuffer = new TextEncoder().encode('RemoteControl_UDP_v1');
158:     const udpKey = await window.crypto.subtle.deriveKey(
159:         {
160:             name: 'HKDF',
161:             hash: 'SHA-256',
162:             salt: new Uint8Array(0),
163:             info: udpInfoBuffer
164:         },
165:         hkdfKeyMaterial,
166:         { name: 'AES-GCM', length: 256 },
167:         true, // Must be extractable to step the ratchet
168:         ['encrypt', 'decrypt']
169:     );
170: 
171:     const udpKeyBuffer = await window.crypto.subtle.exportKey('raw', udpKey);
172:     return { tcpKey, udpKeyBuffer };
173: };
174: 
175: /**
176:  * Steps the Symmetric Ratchet Key for PFS (Forward Secrecy).
177:  * NextKey = SHA256(CurrentKey + "Ratchet_v1")
178:  */
179: export const stepRatchetKey = async (currentKeyBuffer) => {
180:     const currentBytes = new Uint8Array(currentKeyBuffer);
181:     const suffix = new TextEncoder().encode("Ratchet_v1");
182:     const msg = new Uint8Array(currentBytes.byteLength + suffix.byteLength);
183:     msg.set(currentBytes);
184:     msg.set(suffix, currentBytes.byteLength);
185:     return await window.crypto.subtle.digest('SHA-256', msg);
186: };
187: 
188: // --- Encryption / Decryption (AES-GCM) ---
189: 
190: /**
191:  * Generates a random 12-byte IV.
192:  * @returns {Uint8Array}
193:  */
194: export const generateIV = () => {
195:     return window.crypto.getRandomValues(new Uint8Array(12));
196: };
197: 
198: /**
199:  * Encrypts data using AES-GCM.
200:  * @param {CryptoKey} sessionKey 
201:  * @param {Uint8Array} dataBuffer 
202:  * @param {Uint8Array} iv 12 bytes
203:  * @param {Uint8Array} [aadBuffer] Optional AAD
204:  * @returns {Promise<ArrayBuffer>} Ciphertext + AuthTag
205:  */
206: export const encryptAESGCM = async (sessionKey, dataBuffer, iv, aadBuffer = new Uint8Array(0)) => {
207:     return await window.crypto.subtle.encrypt(
208:         {
209:             name: 'AES-GCM',
210:             iv: iv,
211:             additionalData: aadBuffer
212:         },
213:         sessionKey,
214:         dataBuffer
215:     );
216: };
217: 
218: /**
219:  * Decrypts data using AES-GCM.
220:  * @param {CryptoKey} sessionKey 
221:  * @param {Uint8Array} dataToDecrypt (Ciphertext + AuthTag)
222:  * @param {Uint8Array} iv 12 bytes
223:  * @param {Uint8Array} [aadBuffer] Optional AAD
224:  * @returns {Promise<ArrayBuffer>} Decrypted original data
225:  */
226: export const decryptAESGCM = async (sessionKey, dataToDecrypt, iv, aadBuffer = new Uint8Array(0)) => {
227:     return await window.crypto.subtle.decrypt(
228:         {
229:             name: 'AES-GCM',
230:             iv: iv,
231:             additionalData: aadBuffer
232:         },
233:         sessionKey,
234:         dataToDecrypt
235:     );
236: };
</file>

