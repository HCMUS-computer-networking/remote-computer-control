1607: /* ── 23. Shared transparency dot ─────────────────────────────────────── */
1608: /* One reusable red pulsing dot for "sensitive module active". Used by
1609:    AgentCard next to the online dot. Stays the same vivid tone in both
1610:    themes because it references the solid alert tokens, not the tinted ones. */
1611: .transparency-dot
1612: {
1613:   display       : inline-block;
1614:   width         : 8px;
1615:   height        : 8px;
1616:   border-radius : 50%;
1617:   flex-shrink   : 0;
1618:   background    : var(--danger-solid);
1619:   box-shadow    : 0 0 6px 2px var(--danger-solid-glow);
1620:   animation     : keylog-pulse 1.4s ease-in-out infinite;
1621: }
1622: 
1623: /* ── 24. Offline agent card + offline badge ──────────────────────────── */
1624: /* Dim the whole card so offline machines visibly recede in the list. */
1625: .agent-card--offline
1626: {
1627:   opacity : 0.55;
1628: }
1629: 
1630: .agent-card--offline .agent-card__name
1631: {
1632:   color : var(--text-muted);
1633: }
1634: 
1635: /* Small gray "OFFLINE" pill — a text label so state is clear beyond the dot. */
1636: .agent-card__offline-badge
1637: {
1638:   font-size      : 8px;
1639:   font-weight    : 700;
1640:   padding        : 2px 6px;
1641:   border-radius  : var(--radius-sm);
1642:   background     : var(--bg-surface);
1643:   color          : var(--text-muted);
1644:   border         : 1px solid var(--border);
1645:   white-space    : nowrap;
1646:   letter-spacing : 0.3px;
1647: }
