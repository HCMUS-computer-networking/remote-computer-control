424:                 />
425:                 <label htmlFor="screen-quality" className="form-inline__label">Quality:</label>
426:                 <input
427:                     id="screen-quality"
428:                     className={`form-inline__input form-inline__input--num${quality_parsed.error ? ' form-inline__input--error' : ''}`}
429:                     type="number"
430:                     min={QUALITY_MIN}
431:                     max={QUALITY_MAX}
432:                     step="1"
433:                     inputMode="numeric"
434:                     value={quality_input}
435:                     onChange={(e) => setQualityInput(e.target.value)}
436:                     disabled={streaming}
437:                     aria-invalid={Boolean(quality_parsed.error)}
438:                 />
439:                 {(fps_parsed.error || quality_parsed.error) && (
440:                     <span className="form-inline__error">
441:                         {fps_parsed.error || quality_parsed.error}
442:                     </span>
