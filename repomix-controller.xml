<file path="controller/src/components/livescreen/FocusView.jsx">
  1: /* FocusView.jsx — single-agent view: 7-tab bar + active module panel */
  2: import { AppWindow, Cpu, MonitorPlay, Keyboard, FolderTree, Video, Power, MousePointerClick, Activity, Loader2 } from 'lucide-react'
  3: import useUiStore    from '../../store/UiStore'
  4: import useAgentStore from '../../store/AgentStore'
  5: import useE2EEStore  from '../../store/E2EEStore'
  6: 
  7: import SysInfoTab     from '../modules/SysInfoTab'
  8: import ApplicationTab from '../modules/ApplicationTab'
  9: import ProcessTab     from '../modules/ProcessTab'
 10: import ScreenTab      from '../modules/ScreenTab'
 11: import KeylogTab      from '../modules/KeylogTab'
 12: import FileTab        from '../modules/FileTab'
 13: import WebcamTab      from '../modules/WebcamTab'
 14: import PowerTab       from '../modules/PowerTab'
 15: import PermissionGate from '../PermissionGate'
 16: 
 17: // Tabs that read only non-sensitive metrics and therefore skip the consent
 18: // handshake entirely — no permission_request is ever sent for them.
 19: const NO_PERMISSION_TABS = new Set(['sysinfo'])
 20: 
 21: /* tab definitions — order matches wireframe left-to-right.
 22:    NOTE: each tab id MUST match a FEATURE constant in Protocol.js (used verbatim
 23:    as the `feature` field of permission_request / revoke / stop). The only
 24:    exception is any id listed in NO_PERMISSION_TABS, which renders directly
 25:    without a PermissionGate wrapper. */
 26: const TABS =
 27: [
 28:   { id: 'sysinfo',     label: 'SysInfo',     Icon: Activity   },
 29:   { id: 'application', label: 'Application', Icon: AppWindow  },
 30:   { id: 'process',     label: 'Process',     Icon: Cpu        },
 31:   { id: 'screen',      label: 'Screen',      Icon: MonitorPlay },
 32:   { id: 'keylog',      label: 'Keylog',      Icon: Keyboard   },
 33:   { id: 'file',        label: 'File',        Icon: FolderTree },
 34:   { id: 'webcam',      label: 'Webcam',      Icon: Video      },
 35:   { id: 'power',       label: 'Power',       Icon: Power      },
 36: ]
 37: 
 38: /* map tab id → module component */
 39: const TAB_PANELS =
 40: {
 41:   sysinfo     : SysInfoTab,
 42:   application : ApplicationTab,
 43:   process     : ProcessTab,
 44:   screen      : ScreenTab,
 45:   keylog      : KeylogTab,
 46:   file        : FileTab,
 47:   webcam      : WebcamTab,
 48:   power       : PowerTab,
 49: }
 50: 
 51: function FocusView()
 52: {
 53:   const active_tab        = useUiStore((s) => s.active_tab)
 54:   const setActiveTab      = useUiStore((s) => s.setActiveTab)
 55:   const focused_agent_id  = useAgentStore((s) => s.focused_agent_id)
 56:   const agents            = useAgentStore((s) => s.agents)
 57:   const e2eeState         = useE2EEStore((s) => s.sessions[focused_agent_id]?.state || 'uninitialized')
 58: 
 59:   const focused_agent = agents.find((a) => a.id === focused_agent_id) ?? null
 60: 
 61:   /* no agent focused yet — prompt the user */
 62:   if (!focused_agent)
 63:   {
 64:     return (
 65:       <div className="focus-view">
 66:         <div className="focus-view__no-agent">
 67:           <MousePointerClick size={40} strokeWidth={1.25} />
 68:           <span>No agent selected — pick a machine from the sidebar to start.</span>
 69:         </div>
 70:       </div>
 71:     )
 72:   }
 73: 
 74:   const ActivePanel = TAB_PANELS[active_tab] ?? ApplicationTab
 75: 
 76:   return (
 77:     <div className="focus-view">
 78:       {/* 7-tab navigation bar */}
 79:       <nav className="focus-view__tabs" role="tablist" aria-label="Module tabs">
 80:         {TABS.map(function ({ id, label, Icon })
 81:         {
 82:           const is_active = active_tab === id
 83:           return (
 84:             <button
 85:               key={id}
 86:               role="tab"
 87:               aria-selected={is_active}
 88:               className={`focus-view__tab${is_active ? ' focus-view__tab--active' : ''}`}
 89:               onClick={() => setActiveTab(id)}
 90:             >
 91:               <Icon size={16} strokeWidth={1.75} />
 92:               {label}
 93:             </button>
 94:           )
 95:         })}
 96:       </nav>
 97: 
 98:       {/* active module panel — sysinfo skips PermissionGate (read-only metrics) */}
 99:       <div className="focus-view__panel" role="tabpanel">
100:         {e2eeState === 'handshaking' ? (
101:            <div style={{ display: 'flex', flexDirection: 'column', alignItems: 'center', justifyContent: 'center', height: '100%', background: 'var(--bg-card)' }}>
102:                <Loader2 size={32} className="spin" style={{ marginBottom: '1rem', color: 'var(--brand)' }} />
103:                <h3 style={{ margin: '0 0 0.5rem 0' }}>Đang thiết lập E2EE...</h3>
104:                <p style={{ color: 'var(--text-dim)', fontSize: '0.9rem', margin: 0 }}>Trao đổi khóa công khai và xác thực.</p>
105:            </div>
106:         ) : e2eeState === 'uninitialized' ? (
107:            <div style={{ display: 'flex', flexDirection: 'column', alignItems: 'center', justifyContent: 'center', height: '100%', background: 'var(--bg-card)' }}>
108:                <h3 style={{ margin: '0 0 0.5rem 0', color: 'var(--text-error)' }}>Lỗi Handshake E2EE</h3>
109:                <p style={{ color: 'var(--text-dim)', fontSize: '0.9rem', margin: '0 0 1rem 0' }}>Không thể thiết lập kết nối mã hóa. Sai mã PIN hoặc Agent từ chối.</p>
110:                <button 
111:                    className="btn btn-primary" 
112:                    onClick={() => window.location.reload()}
113:                >
114:                    Tải lại trang (Thử lại)
115:                </button>
116:            </div>
117:         ) : NO_PERMISSION_TABS.has(active_tab) ? (
118:           <ActivePanel key={focused_agent.id} agent={focused_agent} />
119:         ) : (
120:           <PermissionGate feature={active_tab} agent_id={focused_agent.id}>
121:             <ActivePanel key={focused_agent.id} agent={focused_agent} />
122:           </PermissionGate>
123:         )}
124:       </div>
125:     </div>
126:   )
127: }
128: 
129: export default FocusView
</file>

<file path="controller/src/services/Protocol.js">
  1: // Protocol.js — builds and parses all JSON messages exchanged over the WebSocket.
  2: // All formats follow the templates in docs/protocol/*.json exactly.
  3: // Components never call these directly; they go through UseAgentSocket (hook) only.
  4: // No external dependencies — plain JSON only.
  5: 
  6: // ─── RX message type constants (Gateway → Controller) ────────────────────────
  7: 
  8: export const MSG_TYPE =
  9: {
 10:     // TX — Controller sends to Gateway
 11:     LIST_AGENTS        : "list_agents",        // request current agent list
 12:     REQUEST            : "request",            // generic wrapper for almost all commands
 13:     POWER              : "power",              // power action (special type, not "request")
 14:     POLICY_UPDATE      : "policy_update",      // push app_whitelist + sandbox_path to agents
 15:     PERMISSION_REQUEST : "permission_request", // ask an Agent to grant a feature (consent popup)
 16:     PERMISSION_REVOKE  : "permission_revoke",  // withdraw a previously granted feature
 17:     STOP_MODULE        : "stop_module",        // tell the Agent to stop a running feature
 18: 
 19:     // RX — Gateway / Agent sends to Controller
 20:     AGENTS_LIST       : "agents_list",        // reply to list_agents
 21:     AGENT_STATUS      : "agent_status",       // push when an agent goes online / offline
 22:     FRAME_META        : "frame_meta",         // JSON header before a binary JPEG blob
 23:     APP_LIST_RESULT   : "app_list_result",    // reply to app_list request
 24:     APP_ACTION_RESULT : "app_action_result",  // reply to app_start / app_stop
 25:     PROC_LIST_RESULT  : "proc_list_result",   // reply to proc_list request
 26:     PROC_KILL_RESULT  : "proc_kill_result",   // reply to proc_kill request
 27:     KEYLOG            : "keylog",             // batch of keystroke events
 28:     KEYLOG_STARTED    : "keylog_started",     // agent confirmed keylog is active
 29:     KEYLOG_STOPPED    : "keylog_stopped",     // agent confirmed keylog stopped
 30:     KEYLOG_DENIED     : "keylog_denied",      // user rejected keylog consent popup
 31:     STREAM_STARTED    : "stream_started",     // agent confirmed screen stream is active
 32:     STREAM_STOPPED    : "stream_stopped",     // agent confirmed screen stream stopped
 33:     WEBCAM_STARTED    : "webcam_started",     // agent confirmed webcam is active (consent granted)
 34:     WEBCAM_STOPPED    : "webcam_stopped",     // agent confirmed webcam stopped
 35:     WEBCAM_DENIED     : "webcam_denied",      // user rejected webcam consent popup
 36:     FS_LIST_RESULT    : "fs_list_result",     // reply to fs_list request
 37:     FS_GET_RESULT     : "fs_get_result",      // reply to fs_get (may be chunked)
 38:     FS_PUT_RESULT     : "fs_put_result",      // agent acknowledges one upload chunk
 39:     FS_PUT_COMPLETE   : "fs_put_complete",    // agent confirms the full file is saved
 40:     FS_ACTION_RESULT  : "fs_action_result",   // reply to fs_delete etc
 41:     FS_ERROR          : "fs_error",           // file operation error (e.g. path outside sandbox)
 42:     POWER_RESULT      : "power_result",       // agent confirms or denies the power action
 43:     POLICY_UPDATE_RESULT : "policy_update_result", // agent confirms it applied the pushed policy
 44:     PERMISSION_RESULT : "permission_result",  // agent grants or denies a permission_request
 45:     PERMISSIONS_RESET : "permissions_reset",  // agent asks to reset all permissions and re-handshake
 46:     SYSINFO_RESULT    : "sysinfo_result",     // reply to sysinfo request (CPU / RAM / Disk metrics)
 47:     INPUT_STARTED     : "input_started",      // agent confirmed Remote Input consent granted + indicator shown
 48:     INPUT_STOPPED     : "input_stopped",      // agent confirmed Remote Input revoked (or stop_module)
 49:     INPUT_DENIED      : "input_denied",       // user rejected Remote Input consent popup
 50:     INPUT_RESULT      : "input_result",       // per-command ack/error for input_mouse_click / input_key / input_type
 51:     AUTH_EXPIRED      : "auth_expired",       // Gateway signals the access JWT is no longer valid — refresh + reopen
 52: 
 53:     // E2EE Handshake & Payload
 54:     E2EE_INIT         : "e2ee_init",          // Controller sends Public Key to Agent
 55:     E2EE_READY        : "e2ee_ready",         // Agent replies with Public Key
 56:     E2EE_ERROR        : "e2ee_error",         // Agent rejects Handshake
 57:     E2EE_PAYLOAD      : "e2ee_payload",       // Wrapper cho các lệnh và response được mã hóa
 58: }
 59: 
 60: // ─── Feature constants (D6 vocab — used for permission request / revoke / stop) ─
 61: // One value per sensitive capability the Controller must ask consent for before
 62: // issuing any module command. These are the "feature" field values, distinct
 63: // from the MODULE command names above (e.g. FEATURE.SCREEN vs MODULE.SCREENSHOT).
 64: 
 65: export const FEATURE =
 66: {
 67:     APPLICATION : "application",   // Application module (list / start / stop apps)
 68:     PROCESS     : "process",       // Process module (list / kill)
 69:     SCREEN      : "screen",        // Screenshot + live screen stream
 70:     KEYLOG      : "keylog",        // Input activity (keystroke monitoring)
 71:     FILE        : "file",          // Sandbox file operations
 72:     WEBCAM      : "webcam",        // Webcam stream
 73:     POWER       : "power",         // Power actions (lock / restart / shutdown / sleep)
 74:     INPUT       : "input",         // Remote Input (mouse move / click / key / type) — its own consent, distinct from SCREEN
 75: }
 76: 
 77: // ─── Module name constants (value of the "module" field in REQUEST messages) ─
 78: 
 79: export const MODULE =
 80: {
 81:     // Application (docs/protocol/application.json)
 82:     APP_LIST  : "app_list",   // request running / installed app list
 83:     APP_START : "app_start",  // launch a whitelisted app by name
 84:     APP_STOP  : "app_stop",   // stop a running whitelisted app by name
 85: 
 86:     // Process (docs/protocol/process.json)
 87:     PROC_LIST : "proc_list",  // request full process list
 88:     PROC_KILL : "proc_kill",  // terminate a process by PID
 89: 
 90:     // Screen (docs/protocol/livescreen.json)
 91:     SCREENSHOT         : "screenshot",          // single capture (mode: "once")
 92:     SCREEN_STREAM      : "screen_stream",       // start continuous stream
 93:     SCREEN_STREAM_STOP : "screen_stream_stop",  // stop the stream
 94: 
 95:     // Keylog (docs/protocol/keylog.json)
 96:     KEYLOG_START : "keylog_start",   // start keystroke capture (requires Agent consent)
 97:     KEYLOG_STOP  : "keylog_stop",    // stop keystroke capture
 98: 
 99:     // File — sandbox only (docs/protocol/file.json)
100:     FS_LIST   : "fs_list",     // list directory
101:     FS_GET    : "fs_get",      // download file
102:     FS_PUT    : "fs_put",      // upload file
103:     FS_DELETE : "fs_delete",   // delete file/folder
104: 
105:     // Webcam (docs/protocol/webcam.json)
106:     WEBCAM_START : "webcam_start",   // start webcam stream (requires Agent consent)
107:     WEBCAM_STOP  : "webcam_stop",    // stop webcam stream
108: 
109:     // SysInfo (docs/protocol/SysInfo.json) — no consent required, read-only metrics
110:     SYSINFO : "sysinfo",   // request current CPU / RAM / Disk / uptime snapshot
111: 
112:     // Remote Input (docs/protocol/Input.json) — 4 one-shot commands, all gated by feature="input"
113:     INPUT_MOUSE_MOVE  : "input_mouse_move",   // absolute cursor position (fire-and-forget)
114:     INPUT_MOUSE_CLICK : "input_mouse_click",  // button + action (down/up/click)
115:     INPUT_KEY         : "input_key",          // virtual-key code + action (down/up/press)
116:     INPUT_TYPE        : "input_type",         // unicode string via SendInput
117: }
118: 
119: // ─── Power action constants (docs/protocol/power.json) ─────────────────────
120: 
121: export const POWER_ACTION =
122: {
123:     LOCK     : "lock",      // lock immediately — no countdown needed
124:     RESTART  : "restart",   // restart — send only after 10 s countdown on Controller
125:     SHUTDOWN : "shutdown",  // shutdown — send only after 10 s countdown on Controller
126:     SLEEP    : "sleep",     // sleep — send only after 10 s countdown on Controller
127: }
128: 
129: // ─── Input validators (defense-in-depth) ──────────────────────────────────────
130: //
131: // Every builder that receives a value from OUTSIDE (a UI form, a store row,
132: // dev-console) runs its inputs through these validators before shaping the
133: // JSON. On failure they throw a plain Error — the callsite (button onClick,
134: // form submit) is expected to catch and surface a toast. This is the SECOND
135: // line of defense: the primary line is inline form validation in the module
136: // tabs. Bugs that let bad data through the UI still get stopped here rather
137: // than reaching the Agent as malformed JSON.
138: 
139: // Integer greater than zero (used for PID, chunk counts, etc.).
140: function assertPositiveInt(value, field_name)
141: {
142:     if (typeof value !== 'number' || !Number.isInteger(value) || value <= 0)
143:     {
144:         throw new Error(`Protocol: ${field_name} must be a positive integer (got ${JSON.stringify(value)})`)
145:     }
146: }
147: 
148: // Integer inside an inclusive [min, max] range (fps, quality, etc.).
149: function assertIntInRange(value, min, max, field_name)
150: {
151:     if (typeof value !== 'number' || !Number.isInteger(value) || value < min || value > max)
152:     {
153:         throw new Error(`Protocol: ${field_name} must be an integer in [${min}, ${max}] (got ${JSON.stringify(value)})`)
154:     }
155: }
156: 
157: // Non-negative integer (chunk_index, byte counts, etc.).
158: function assertNonNegativeInt(value, field_name)
159: {
160:     if (typeof value !== 'number' || !Number.isInteger(value) || value < 0)
161:     {
162:         throw new Error(`Protocol: ${field_name} must be a non-negative integer (got ${JSON.stringify(value)})`)
163:     }
164: }
165: 
166: // Non-empty string (app names, base64 chunks, etc.).
167: function assertNonEmptyString(value, field_name)
168: {
169:     if (typeof value !== 'string' || value.length === 0)
170:     {
171:         throw new Error(`Protocol: ${field_name} must be a non-empty string`)
172:     }
173: }
174: 
175: // Sandbox path. Must start with '/', have no NUL byte, and contain no ".."
176: // segment (belt-and-suspenders — the Agent already enforces sandbox root).
177: function assertSafePath(value, field_name)
178: {
179:     assertNonEmptyString(value, field_name)
180:     if (value.indexOf('\0') !== -1)
181:     {
182:         throw new Error(`Protocol: ${field_name} must not contain NUL bytes`)
183:     }
184:     if (!value.startsWith('/'))
185:     {
186:         throw new Error(`Protocol: ${field_name} must start with '/' (sandbox-relative)`)
187:     }
188:     const segments = value.split('/')
189:     if (segments.includes('..'))
190:     {
191:         throw new Error(`Protocol: ${field_name} must not contain '..' segments`)
192:     }
193: }
194: 
195: // Value must be one of the enumerated allowed strings (POWER_ACTION, etc.).
196: function assertOneOf(value, allowed, field_name)
197: {
198:     if (!allowed.includes(value))
199:     {
200:         throw new Error(`Protocol: ${field_name} must be one of [${allowed.join(', ')}] (got ${JSON.stringify(value)})`)
201:     }
202: }
203: 
204: // target_agents envelope: must be an array of non-empty strings.
205: // Empty array is legal (meaning "broadcast to all agents"). null/undefined is
206: // accepted at the callsite and normalised to [] there — this validator is only
207: // reached with a real value.
208: function assertAgentIdList(value, field_name)
209: {
210:     if (!Array.isArray(value))
211:     {
212:         throw new Error(`Protocol: ${field_name} must be an array (got ${JSON.stringify(value)})`)
213:     }
214:     for (let i = 0; i < value.length; i++)
215:     {
216:         if (typeof value[i] !== 'string' || value[i].length === 0)
217:         {
218:             throw new Error(`Protocol: ${field_name}[${i}] must be a non-empty string`)
219:         }
220:     }
221: }
222: 
223: // ─── Base builders ────────────────────────────────────────────────────────────
224: 
225: // Merge type + payload into one object, then serialise to a JSON string.
226: // All specific builders below call this to produce the final string for socket.send().
227: // The Agent (C#) ValidatePacket rejects any packet whose command_id is empty and
228: // silently drops it, so we auto-generate a short random id here. A caller-supplied
229: // command_id inside `payload` still wins (spread runs after the default).
230: export function buildMessage(type, payload)
231: {
232:     const command_id = Math.random().toString(36).substring(2, 9)
233:     const msg = { type, command_id, ...payload }
234:     return JSON.stringify(msg)
235: }
236: 
237: // Parse a raw JSON string received from the WebSocket.
238: // Returns the parsed object on success, or null on failure (logs a warning).
239: export function parseMessage(raw)
240: {
241:     try
242:     {
243:         return JSON.parse(raw)
244:     }
245:     catch (err)
246:     {
247:         console.warn('[Protocol] Failed to parse message:', raw, err)
248:         return null
249:     }
250: }
251: 
252: // ─── Incoming adapter (real Gateway/Agent JSON → canonical shape) ─────────────
253: //
254: // The real Gateway/Agent may name fields slightly differently from our mock
255: // (e.g. "agentId" instead of "agent_id", "procs" instead of "processes").
256: // This adapter rewrites every incoming message into the ONE canonical shape the
257: // store + dispatch table already expect, so no component/store code changes.
258: //
259: // The canonical shape per type is exactly what MockSocket produces today and
260: // what dispatchMessage() in UseAgentSocket reads. See the field map below.
261: //
262: // HOW TO EXTEND — when you see a real message with a different field name:
263: //   1) add the real name to the alias array (marked "EDIT POINT" below), or
264: //   2) add / adjust the per-type normalizer in NORMALIZERS.
265: // Everything defaults to identity, so an unknown message passes through safely.
266: 
267: // Return the first present value among the given alias keys, else fallback.
268: // Used to accept several possible source names for one canonical field.
269: function pickField(obj, alias_keys, fallback)
270: {
271:     for (const key of alias_keys)
272:     {
273:         if (obj != null && obj[key] !== undefined) return obj[key]
274:     }
275:     return fallback
276: }
277: 
278: // ── Type-name aliases (real "type" string → canonical MSG_TYPE) ──────────────
279: // EDIT POINT: left side = whatever the real server sends; right = our constant.
280: // Identity entries are omitted — unknown types keep their original name.
281: const TYPE_ALIASES =
282: {
283:     // "agentList"       : MSG_TYPE.AGENTS_LIST,     // example: camelCase variant
284:     // "processList"     : MSG_TYPE.PROC_LIST_RESULT,
285:     // "frameMeta"       : MSG_TYPE.FRAME_META,
286: }
287: 
288: // ── Common field aliases shared by many message types ───────────────────────
289: // EDIT POINT: add real source names here; the FIRST match wins.
290: const AGENT_ID_ALIASES  = ['agent_id', 'agentId', 'agentID', 'machine_id']   // → agent_id
291: const TIMESTAMP_ALIASES = ['timestamp_ms', 'ts', 'time', 'timestamp']        // → timestamp_ms
292: 
293: // Copy the canonical agent_id onto a message from any accepted alias.
294: // Every per-agent RX message needs agent_id for store keying.
295: function withAgentId(msg, src)
296: {
297:     const agent_id = pickField(src, AGENT_ID_ALIASES)
298:     if (agent_id !== undefined) msg.agent_id = agent_id
299:     return msg
300: }
301: 
302: // Normalize one agent record inside agents_list.
303: // Canonical: { id, name, os, ip, online, in_session }
304: function normalizeAgent(a)
305: {
306:     return {
307:         id         : pickField(a, ['id', 'agent_id', 'agentId']),
308:         name       : pickField(a, ['name', 'hostname', 'machine_name']),
309:         os         : pickField(a, ['os', 'os_name', 'platform']),
310:         ip         : pickField(a, ['ip', 'ip_addr', 'address']),
311:         online     : pickField(a, ['online', 'is_online', 'connected'], false),
312:         in_session : pickField(a, ['in_session', 'inSession', 'busy'], false),
313:     }
314: }
315: 
316: // Normalize one app record inside app_list_result.
317: // Canonical: { name, display_name, status, cpu_percent, ram_mb, in_whitelist }
318: function normalizeApp(a)
319: {
320:     return {
321:         name         : pickField(a, ['name', 'app_name']),
322:         display_name : pickField(a, ['display_name', 'displayName', 'title']),
323:         status       : pickField(a, ['status', 'state']),
324:         cpu_percent  : pickField(a, ['cpu_percent', 'cpu', 'cpuPercent'], 0),
325:         ram_mb       : pickField(a, ['ram_mb', 'ram', 'memory_mb'], 0),
326:         in_whitelist : pickField(a, ['in_whitelist', 'whitelisted', 'allowed'], false),
327:     }
328: }
329: 
330: // Normalize one process record inside proc_list_result.
331: // Canonical: { pid, name, cpu_percent, ram_mb }
332: function normalizeProc(p)
333: {
334:     return {
335:         pid         : pickField(p, ['pid', 'process_id']),
336:         name        : pickField(p, ['name', 'proc_name', 'image_name']),
337:         cpu_percent : pickField(p, ['cpu_percent', 'cpu', 'cpuPercent'], 0),
338:         ram_mb      : pickField(p, ['ram_mb', 'ram', 'memory_mb'], 0),
339:     }
340: }
341: 
342: // Normalize one keystroke event inside a keylog batch.
343: // Canonical: { key, ctrl, alt, shift, timestamp_ms }
344: function normalizeKeyEvent(e)
345: {
346:     return {
347:         key          : pickField(e, ['key', 'k', 'char']),
348:         ctrl         : pickField(e, ['ctrl', 'ctrlKey'], false),
349:         alt          : pickField(e, ['alt', 'altKey'], false),
350:         shift        : pickField(e, ['shift', 'shiftKey'], false),
351:         timestamp_ms : pickField(e, TIMESTAMP_ALIASES),
352:     }
353: }
354: 
355: // Normalize one filesystem entry inside fs_list_result.
356: // Canonical: { name, type, size, modified_ms }
357: function normalizeFsEntry(e)
358: {
359:     return {
360:         name        : pickField(e, ['name', 'filename']),
361:         type        : pickField(e, ['type', 'kind']),               // "file" | "directory"
362:         size        : pickField(e, ['size', 'bytes'], null),
363:         modified_ms : pickField(e, ['modified_ms', 'mtime_ms', 'modified'], null),
364:     }
365: }
366: 
367: // Per-type structural normalizers. Each takes the raw message and returns the
368: // canonical message. Types NOT listed here fall through to a shallow copy that
369: // only fixes agent_id + timestamp aliases.
370: const NORMALIZERS =
371: {
372:     [MSG_TYPE.AGENTS_LIST]: (m) =>
373:     ({
374:         type   : MSG_TYPE.AGENTS_LIST,
375:         agents : (pickField(m, ['agents', 'agent_list', 'list'], [])).map(normalizeAgent),
376:     }),
377: 
378:     [MSG_TYPE.AGENT_STATUS]: (m) =>
379:         withAgentId({
380:             type       : MSG_TYPE.AGENT_STATUS,
381:             // Left undefined when the field is absent so the store patch only
382:             // touches the flags the Gateway actually reported.
383:             online     : pickField(m, ['online', 'is_online', 'connected']),
384:             in_session : pickField(m, ['in_session', 'inSession', 'busy']),
385:         }, m),
386: 
387:     [MSG_TYPE.APP_LIST_RESULT]: (m) =>
388:         withAgentId({
389:             type : MSG_TYPE.APP_LIST_RESULT,
390:             apps : (pickField(m, ['apps', 'applications', 'app_list'], [])).map(normalizeApp),
391:         }, m),
392: 
393:     [MSG_TYPE.PROC_LIST_RESULT]: (m) =>
394:         withAgentId({
395:             type      : MSG_TYPE.PROC_LIST_RESULT,
396:             processes : (pickField(m, ['processes', 'procs', 'process_list'], [])).map(normalizeProc),
397:         }, m),
398: 
399:     [MSG_TYPE.KEYLOG]: (m) =>
400:         withAgentId({
401:             type   : MSG_TYPE.KEYLOG,
402:             events : (pickField(m, ['events', 'keys', 'batch'], [])).map(normalizeKeyEvent),
403:         }, m),
404: 
405:     [MSG_TYPE.FRAME_META]: (m) =>
406:         withAgentId({
407:             type         : MSG_TYPE.FRAME_META,
408:             module       : pickField(m, ['module', 'kind', 'source']),         // "screen" | "webcam"
409:             w            : pickField(m, ['w', 'width']),
410:             h            : pickField(m, ['h', 'height']),
411:             len          : pickField(m, ['len', 'length', 'byte_len']),
412:             seq          : pickField(m, ['seq', 'sequence', 'frame_no']),
413:             timestamp_ms : pickField(m, TIMESTAMP_ALIASES),
414:         }, m),
415: 
416:     [MSG_TYPE.FS_LIST_RESULT]: (m) =>
417:         withAgentId({
418:             type    : MSG_TYPE.FS_LIST_RESULT,
419:             path    : pickField(m, ['path', 'dir', 'folder']),
420:             entries : (pickField(m, ['entries', 'files', 'items'], [])).map(normalizeFsEntry),
421:         }, m),
422: 
423:     [MSG_TYPE.FS_GET_RESULT]: (m) =>
424:         withAgentId({
425:             type         : MSG_TYPE.FS_GET_RESULT,
426:             // transfer_id groups all chunks of one download; fall back to
427:             // command_id (Gateway guarantees one of the two is present).
428:             transfer_id  : pickField(m, ['transfer_id', 'transferId', 'command_id', 'commandId']),
429:             path         : pickField(m, ['path', 'filepath']),
430:             total_size   : pickField(m, ['total_size', 'size', 'totalSize']),
431:             chunk_index  : pickField(m, ['chunk_index', 'chunkIndex', 'index'], 0),
432:             total_chunks : pickField(m, ['total_chunks', 'totalChunks', 'chunks'], 1),
433:             // Present only in JSON-chunk mode. Absent in binary-chunk mode —
434:             // in that case the next WS binary frame carries the raw bytes.
435:             data_base64  : pickField(m, ['data_base64', 'data', 'base64', 'content']),
436:         }, m),
437: 
438:     // Per-chunk ack for uploads. transfer_id lets FileTab match this ack to
439:     // the correct upload job — required once multiple uploads to the same
440:     // path can be in flight at once (rename-on-conflict, retries, etc.).
441:     [MSG_TYPE.FS_PUT_RESULT]: (m) =>
442:         withAgentId({
443:             type        : MSG_TYPE.FS_PUT_RESULT,
444:             transfer_id : pickField(m, ['transfer_id', 'transferId', 'command_id', 'commandId']),
445:             path        : pickField(m, ['path', 'filepath']),
446:             chunk_index : pickField(m, ['chunk_index', 'chunkIndex', 'index'], 0),
447:             success     : pickField(m, ['success', 'ok'], false),
448:             message     : pickField(m, ['message', 'msg', 'detail'], ''),
449:         }, m),
450: 
451:     // Final ack when the Agent has stored the whole file. sha256 is optional
452:     // (spec says the Agent may include an integrity checksum).
453:     [MSG_TYPE.FS_PUT_COMPLETE]: (m) =>
454:         withAgentId({
455:             type        : MSG_TYPE.FS_PUT_COMPLETE,
456:             transfer_id : pickField(m, ['transfer_id', 'transferId', 'command_id', 'commandId']),
457:             path        : pickField(m, ['path', 'filepath']),
458:             success     : pickField(m, ['success', 'ok'], true),
459:             sha256      : pickField(m, ['sha256', 'checksum'], null),
460:             message     : pickField(m, ['message', 'msg', 'detail'], ''),
461:         }, m),
462: 
463:     [MSG_TYPE.FS_ACTION_RESULT]: (m) =>
464:         withAgentId({
465:             type    : MSG_TYPE.FS_ACTION_RESULT,
466:             path    : pickField(m, ['path', 'filepath']),
467:             success : pickField(m, ['success', 'ok'], false),
468:             action  : pickField(m, ['action', 'op']),
469:             message : pickField(m, ['message', 'msg'], ''),
470:         }, m),
471: 
472:     [MSG_TYPE.POWER_RESULT]: (m) =>
473:         withAgentId({
474:             type      : MSG_TYPE.POWER_RESULT,
475:             action    : pickField(m, ['action', 'power_action']),
476:             confirmed : pickField(m, ['confirmed', 'success', 'ok'], false),
477:             message   : pickField(m, ['message', 'msg', 'detail'], ''),
478:         }, m),
479: 
480:     [MSG_TYPE.POLICY_UPDATE_RESULT]: (m) =>
481:         withAgentId({
482:             type    : MSG_TYPE.POLICY_UPDATE_RESULT,
483:             success : pickField(m, ['success', 'ok', 'applied'], false),
484:             message : pickField(m, ['message', 'msg', 'detail'], ''),
485:         }, m),
486: 
487:     [MSG_TYPE.SYSINFO_RESULT]: (m) =>
488:         withAgentId({
489:             type           : MSG_TYPE.SYSINFO_RESULT,
490:             cpu_percent    : pickField(m, ['cpu_percent', 'cpu', 'cpuPercent'], 0),
491:             ram_used_mb    : pickField(m, ['ram_used_mb', 'ramUsedMb', 'ram_used'], 0),
492:             ram_total_mb   : pickField(m, ['ram_total_mb', 'ramTotalMb', 'ram_total'], 0),
493:             disk_used_gb   : pickField(m, ['disk_used_gb', 'diskUsedGb', 'disk_used'], 0),
494:             disk_total_gb  : pickField(m, ['disk_total_gb', 'diskTotalGb', 'disk_total'], 0),
495:             uptime_seconds : pickField(m, ['uptime_seconds', 'uptimeSeconds', 'uptime'], 0),
496:             hostname       : pickField(m, ['hostname', 'host', 'machine_name'], ''),
497:             ip             : pickField(m, ['ip', 'ip_addr', 'address'], ''),
498:             os             : pickField(m, ['os', 'os_name', 'platform'], ''),
499:             timestamp_ms   : pickField(m, TIMESTAMP_ALIASES, Date.now()),
500:         }, m),
501: 
502:     [MSG_TYPE.PERMISSION_RESULT]: (m) =>
503:         withAgentId({
504:             type         : MSG_TYPE.PERMISSION_RESULT,
505:             feature      : pickField(m, ['feature', 'capability', 'module']),
506:             granted      : pickField(m, ['granted', 'allowed', 'approved', 'ok'], false),
507:             message      : pickField(m, ['message', 'msg', 'reason', 'detail'], ''),
508:             timestamp_ms : pickField(m, TIMESTAMP_ALIASES),
509:         }, m),
510: }
511: 
512: // Public entry point — normalize ONE parsed incoming message into canonical shape.
513: // UseAgentSocket calls this on every JSON message before dispatchMessage().
514: // Safe on already-canonical messages (mock) — they pass through unchanged.
515: export function normalizeIncoming(raw_msg)
516: {
517:     if (raw_msg == null || typeof raw_msg !== 'object') return raw_msg
518: 
519:     // 1) Canonicalize the type name first (camelCase → snake_case, etc.).
520:     const canonical_type = TYPE_ALIASES[raw_msg.type] ?? raw_msg.type
521: 
522:     // 2) Run the type-specific normalizer if we have one.
523:     const normalizer = NORMALIZERS[canonical_type]
524:     if (normalizer)
525:     {
526:         return normalizer(raw_msg)
527:     }
528: 
529:     // 3) Default path: keep the message, but fix the type + shared aliases so
530:     //    simple confirm/deny messages (keylog_started, webcam_denied, ...)
531:     //    still carry a canonical agent_id + timestamp_ms.
532:     const out = { ...raw_msg, type: canonical_type }
533:     withAgentId(out, raw_msg)
534:     const ts = pickField(raw_msg, TIMESTAMP_ALIASES)
535:     if (ts !== undefined) out.timestamp_ms = ts
536:     return out
537: }
