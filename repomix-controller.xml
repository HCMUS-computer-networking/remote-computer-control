  1: /* SysInfoTab — read-only dashboard of CPU / RAM / Disk for the focused agent.
  2:    Polls `sysinfo` every 2 seconds; each reply is appended to a rolling 60-point
  3:    history in ModuleStore, which drives three sparkline charts. No consent flow:
  4:    sysinfo carries no sensitive data so FocusView bypasses PermissionGate.       */
  5: import { useEffect } from 'react'
  6: import { Cpu, MemoryStick, HardDrive } from 'lucide-react'
  7: import { LineChart, Line, YAxis, Tooltip, ResponsiveContainer } from 'recharts'
  8: 
  9: import useModuleStore     from '../../../store/ModuleStore'
 10: import useConnectionStore from '../../../store/ConnectionStore'
 11: import useAgentSocket     from '../../../hooks/UseAgentSocket'
 12: import { buildSysInfo }   from '../../../services/Protocol'
 13: 
 14: // How often the tab polls for a fresh system snapshot. 2s balances freshness
 15: // with wire pressure (a full JSON is ~200 bytes per agent per tick).
 16: const POLL_INTERVAL_MS = 2000
 17: 
 18: // Stable empty fallback — prevents a new [] from being returned on every
 19: // selector call, which would trigger Zustand's infinite re-render detection.
 20: const EMPTY_HISTORY = []
 21: 
 22: // Format seconds into a compact "1d 03h 12m" string for the uptime line.
 23: function formatUptime(total_seconds)
 24: {
 25:     if (!total_seconds || total_seconds < 0) return '—'
 26:     const days    = Math.floor(total_seconds / 86400)
 27:     const hours   = Math.floor((total_seconds % 86400) / 3600)
 28:     const minutes = Math.floor((total_seconds % 3600) / 60)
 29:     if (days > 0)    return `${days}d ${String(hours).padStart(2, '0')}h ${String(minutes).padStart(2, '0')}m`
 30:     if (hours > 0)   return `${hours}h ${String(minutes).padStart(2, '0')}m`
 31:     return `${minutes}m`
 32: }
 33: 
 34: // One-decimal percent formatter — used in tooltips and current-value labels.
 35: function formatPercent(v)
 36: {
 37:     return `${(v ?? 0).toFixed(1)}%`
 38: }
 39: 
 40: // Convert MB to a compact GB string (RAM lives around 8–32 GB on real hardware).
 41: function formatGbFromMb(mb)
 42: {
 43:     return `${((mb ?? 0) / 1024).toFixed(1)} GB`
 44: }
 45: 
 46: // One stat tile: icon + label + big current value + percent bar + secondary hint.
 47: // Kept local to this file — it is a private layout helper, not a shared building block.
 48: function StatTile({ Icon, label, value_text, hint_text, percent })
 49: {
 50:     // Clamp the fill width so a bad number never overflows the bar visually.
 51:     const width_pct = Math.max(0, Math.min(100, percent ?? 0))
 52: 
 53:     return (
 54:         <div className="sysinfo-tile">
 55:             <div className="sysinfo-tile__header">
 56:                 <Icon size={16} strokeWidth={1.75} />
 57:                 <span className="sysinfo-tile__label">{label}</span>
 58:             </div>
 59:             <div className="sysinfo-tile__value">{value_text}</div>
 60:             <div className="sysinfo-tile__bar" aria-hidden="true">
 61:                 <div className="sysinfo-tile__bar-fill" style={{ width: `${width_pct}%` }} />
 62:             </div>
 63:             <div className="sysinfo-tile__hint">{hint_text}</div>
 64:         </div>
 65:     )
 66: }
 67: 
 68: // One mini line chart. Shares y-domain [0..100] so all three sparklines are
 69: // directly comparable at a glance. The parent controls the height via CSS.
 70: function MiniChart({ data, data_key, color, title })
 71: {
 72:     return (
 73:         <div className="sysinfo-chart">
 74:             <div className="sysinfo-chart__title">{title}</div>
 75:             <div className="sysinfo-chart__body">
 76:                 <ResponsiveContainer width="100%" height="100%">
 77:                     <LineChart data={data} margin={{ top: 4, right: 4, bottom: 0, left: 0 }}>
 78:                         <YAxis domain={[0, 100]} hide />
 79:                         <Tooltip
 80:                             formatter={(v) => formatPercent(v)}
 81:                             labelFormatter={() => ''}
 82:                             contentStyle={{
 83:                                 background : 'var(--bg-elevated)',
 84:                                 border     : '1px solid var(--gray-200)',
 85:                                 fontSize   : '0.75rem',
 86:                             }}
 87:                         />
 88:                         <Line
 89:                             type="monotone"
 90:                             dataKey={data_key}
 91:                             stroke={color}
 92:                             strokeWidth={2}
 93:                             dot={false}
 94:                             isAnimationActive={false}
 95:                         />
 96:                     </LineChart>
 97:                 </ResponsiveContainer>
 98:             </div>
 99:         </div>
100:     )
101: }
102: 
103: function SysInfoTab({ agent })
104: {
105:     const { sendToFocused } = useAgentSocket()
106: 
107:     // Subscribe to only this agent's sysinfo slice so other agents' updates
108:     // do not re-render the dashboard.
109:     const snapshot = useModuleStore((s) => s.data[agent.id]?.sysinfo ?? null)
110:     const history  = useModuleStore((s) => s.data[agent.id]?.sysinfo_history ?? EMPTY_HISTORY)
111: 
112:     // Connection status drives the empty-state message (loading vs disconnected).
113:     const conn_status = useConnectionStore((s) => s.status)
114: 
115:     // Poll every POLL_INTERVAL_MS while this tab is mounted. Cleanup on unmount
116:     // (tab switch, agent change, logout) stops the interval — no leaked timers.
117:     useEffect(function ()
118:     {
119:         if (!agent.online) return
120: 
121:         sendToFocused(buildSysInfo())
122: 
123:         const timer = setInterval(function ()
124:         {
125:             sendToFocused(buildSysInfo(), { silent: true })                                         // Poll tick — suppress the "N agents not granted" toast so the operator isn't spammed every 3 s
126: 
127:         }, POLL_INTERVAL_MS)
128: 
129:         return () => clearInterval(timer)
130:     }, [agent.id, agent.online])
131: 
132:     // Derived percentages for the stat tiles — safe when snapshot is null.
133:     const cpu_percent  = snapshot?.cpu_percent ?? 0
134:     const ram_percent  = snapshot && snapshot.ram_total_mb  > 0
135:         ? (snapshot.ram_used_mb  / snapshot.ram_total_mb)  * 100
136:         : 0
137:     const disk_percent = snapshot && snapshot.disk_total_gb > 0
138:         ? (snapshot.disk_used_gb / snapshot.disk_total_gb) * 100
139:         : 0
140: 
141:     // Friendly empty-state message covers offline / disconnected / loading.
142:     const empty_label = !agent.online          ? 'Agent is offline'
143:                       : conn_status !== 'open' ? 'Gateway disconnected — waiting to reconnect…'
144:                       : !snapshot              ? 'Loading system metrics…'
145:                       : null
146: 
147:     return (
148:         <div className="sysinfo-tab">
149: 
150:             {/* ── Header row: title + host info (hostname / OS / IP / uptime) ── */}
151:             <div className="sysinfo-tab__header">
152:                 <div className="sysinfo-tab__title">System — {agent.name}</div>
153:                 {snapshot && (
154:                     <div className="sysinfo-tab__meta">
155:                         <span title="Hostname">{snapshot.hostname || agent.name}</span>
156:                         <span className="sysinfo-tab__meta-sep">·</span>
157:                         <span title="OS">{snapshot.os || '—'}</span>
158:                         <span className="sysinfo-tab__meta-sep">·</span>
159:                         <span title="IP address">{snapshot.ip || '—'}</span>
160:                         <span className="sysinfo-tab__meta-sep">·</span>
161:                         <span title="Uptime">Uptime: {formatUptime(snapshot.uptime_seconds)}</span>
162:                     </div>
163:                 )}
164:             </div>
165: 
166:             {empty_label
167:                 ? <div className="sysinfo-tab__empty">{empty_label}</div>
168:                 : (
169:                     <>
170:                         {/* ── Stat tiles — big current numbers ─────────────────── */}
171:                         <div className="sysinfo-tab__tiles">
172:                             <StatTile
173:                                 Icon={Cpu}
174:                                 label="CPU"
175:                                 value_text={formatPercent(cpu_percent)}
176:                                 hint_text="Overall CPU load"
177:                                 percent={cpu_percent}
178:                             />
179:                             <StatTile
180:                                 Icon={MemoryStick}
181:                                 label="RAM"
182:                                 value_text={formatPercent(ram_percent)}
183:                                 hint_text={`${formatGbFromMb(snapshot.ram_used_mb)} / ${formatGbFromMb(snapshot.ram_total_mb)}`}
184:                                 percent={ram_percent}
185:                             />
186:                             <StatTile
187:                                 Icon={HardDrive}
188:                                 label="Disk"
189:                                 value_text={formatPercent(disk_percent)}
190:                                 hint_text={`${(snapshot.disk_used_gb ?? 0).toFixed(1)} GB / ${(snapshot.disk_total_gb ?? 0).toFixed(1)} GB`}
191:                                 percent={disk_percent}
192:                             />
193:                         </div>
194: 
195:                         {/* ── Sparkline charts — last 60 samples ───────────────── */}
196:                         <div className="sysinfo-tab__charts">
197:                             <MiniChart
198:                                 data={history}
199:                                 data_key="cpu_percent"
200:                                 color="var(--accent)"
201:                                 title="CPU %"
202:                             />
203:                             <MiniChart
204:                                 data={history}
205:                                 data_key="ram_percent"
206:                                 color="var(--success)"
207:                                 title="RAM %"
208:                             />
209:                             <MiniChart
210:                                 data={history}
211:                                 data_key="disk_percent"
212:                                 color="var(--warning)"
213:                                 title="Disk %"
214:                             />
215:                         </div>
216:                     </>
217:                 )
218:             }
219:         </div>
220:     )
221: }
