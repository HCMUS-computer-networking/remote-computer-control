<file path="controller/src/components/LoginScreen.jsx">
  1: /* LoginScreen.jsx — admin sign-in gate shown until a JWT is present.
  2: 
  3:    The form POSTs to the Gateway via AuthService.login; the Gateway does the
  4:    real bcrypt + JWT check. On success AuthService stores the token in
  5:    ConnectionStore.auth_token, which makes App swap this screen for the console.
  6:    This component never stores the password — it lives only in local state until
  7:    the request is sent. */
  8: import { useState } from 'react'
  9: import { LogIn, Loader2, ShieldAlert } from 'lucide-react'
 10: 
 11: import { login } from '../services/AuthService'
 12: 
 13: function LoginScreen()
 14: {
 15:     const [username, setUsername]   = useState('')
 16:     const [password, setPassword]   = useState('')
 17:     const [error, setError]         = useState('')
 18:     const [submitting, setSubmitting] = useState(false)
 19: 
 20:     async function handleSubmit(event)
 21:     {
 22:         event.preventDefault()
 23:         if (submitting) return
 24: 
 25:         setError('')
 26:         setSubmitting(true)
 27: 
 28:         // AuthService updates ConnectionStore.auth_token on success, which makes
 29:         // App re-render into the console — no navigation needed here.
 30:         const result = await login(username.trim(), password)
 31: 
 32:         if (!result.ok)
 33:         {
 34:             setError(result.message)
 35:             setSubmitting(false)   // keep the form so the operator can retry
 36:         }
 37:         // On success we intentionally leave submitting=true; this component
 38:         // unmounts as App switches to the console.
 39:     }
 40: 
 41:     return (
 42:         <div className="login-screen">
 43:             <form className="login-card" onSubmit={handleSubmit}>
 44: 
 45:                 <div className="login-card__header">
 46:                     <ShieldAlert size={22} strokeWidth={1.75} />
 47:                     <h1 className="login-card__title">Controller — Admin Login</h1>
 48:                 </div>
 49: 
 50:                 <p className="login-card__hint">
 51:                     Đăng nhập để mở console điều khiển. Xác thực do Gateway xử lý.
 52:                 </p>
 53: 
 54:                 <label className="login-card__field">
 55:                     <span className="login-card__label">Username</span>
 56:                     <input
 57:                         className="login-card__input"
 58:                         type="text"
 59:                         value={username}
 60:                         onChange={(e) => setUsername(e.target.value)}
 61:                         autoComplete="username"
 62:                         autoFocus
 63:                         required
 64:                         disabled={submitting}
 65:                     />
 66:                 </label>
 67: 
 68:                 <label className="login-card__field">
 69:                     <span className="login-card__label">Password</span>
 70:                     <input
 71:                         className="login-card__input"
 72:                         type="password"
 73:                         value={password}
 74:                         onChange={(e) => setPassword(e.target.value)}
 75:                         autoComplete="current-password"
 76:                         required
 77:                         disabled={submitting}
 78:                     />
 79:                 </label>
 80: 
 81:                 {/* Error message — shown on wrong credentials or network failure. */}
 82:                 {error && (
 83:                     <div className="login-card__error" role="alert">
 84:                         {error}
 85:                     </div>
 86:                 )}
 87: 
 88:                 <button
 89:                     className="login-card__submit"
 90:                     type="submit"
 91:                     disabled={submitting || !username || !password}
 92:                 >
 93:                     {submitting
 94:                         ? <Loader2 size={16} strokeWidth={2} className="spin" />
 95:                         : <LogIn size={16} strokeWidth={2} />}
 96:                     {submitting ? 'Đang đăng nhập…' : 'Đăng nhập'}
 97:                 </button>
 98: 
 99:             </form>
100:         </div>
101:     )
102: }
