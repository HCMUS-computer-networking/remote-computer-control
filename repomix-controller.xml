<file path="controller/src/components/PermissionGate.jsx">
  1: /* PermissionGate — shared consent wrapper for every module tab (Plan B).
  2: 
  3:    C5 — one-button UX: the operator no longer clicks a separate "Xin quyền"
  4:    button. Every module action button calls `guardedSend(sendFn)` provided via
  5:    React context. Behaviour:
  6:      - already granted        → run sendFn immediately;
  7:      - not granted yet        → queue sendFn, fire permission_request, and
  8:                                  wait; when the Agent grants consent the whole
  9:                                  queue is drained in order.
 10:      - denied or 30 s timeout → toast an error and clear the queue.
 11: 
 12:    The bar on top of the panel now shows only status + Disconnect (when
 13:    granted). No Connect button. Children are NOT wrapped in a disabled
 14:    fieldset — action buttons stay clickable and drive the consent flow
 15:    themselves via `useGuardedSend` / `usePendingConsent`. */
 16: 
 17: import { createContext, useCallback, useContext, useEffect, useMemo, useRef, useState } from 'react'
 18: import { ShieldCheck, ShieldAlert, PlugZap, Loader } from 'lucide-react'
 19: 
 20: import usePermissionStore from '../store/PermissionStore'
 21: import useUiStore         from '../store/UiStore'
 22: import useAgentSocket     from '../hooks/UseAgentSocket'
 23: 
 24: // How long we wait for the Agent user to accept the consent popup before
 25: // giving up and toasting an error. Long enough to read the popup, short
 26: // enough that stuck flows recover on their own.
 27: const CONSENT_TIMEOUT_MS = 30_000
 28: 
 29: // Short human-readable label for the current consent status.
 30: function statusLabel(status)
 31: {
 32:     if (status === 'requesting') return 'Chờ cấp quyền...'   // waiting for Agent reply
 33:     if (status === 'granted')    return 'Đã cấp quyền'        // consent granted
 34:     if (status === 'denied')     return 'Bị từ chối'          // consent denied
 35:     return 'Chưa kết nối'                                     // idle — no request yet
 36: }
 37: 
 38: // Context shared with every action button inside the gate.
 39: // { guardedSend(sendFn), is_pending_consent }
 40: const PermissionContext = createContext(null)
 41: 
 42: // Public hook — every module tab uses this to wrap its action handlers.
 43: // Throws if the tab is rendered outside a PermissionGate (dev safety).
 44: export function useGuardedSend()
 45: {
 46:     const ctx = useContext(PermissionContext)
 47:     if (!ctx) throw new Error('useGuardedSend must be used inside <PermissionGate>')
 48:     return ctx.guardedSend
 49: }
 50: 
 51: // True while we are waiting for the Agent user to grant consent. Buttons use
 52: // this to disable themselves and optionally show a spinner. Returns false
 53: // outside a PermissionGate so read-only tabs (SysInfo) can call it safely.
 54: export function usePendingConsent()
 55: {
 56:     const ctx = useContext(PermissionContext)
 57:     return ctx?.is_pending_consent ?? false
 58: }
 59: 
 60: function PermissionGate({ feature, agent_id, children })
 61: {
 62:     const { requestPermission, revokePermission, stopModule } = useAgentSocket()
 63:     const addToast = useUiStore((s) => s.addToast)
 64: 
 65:     // Subscribe to just this (agent, feature) status — no re-render for others.
 66:     const status = usePermissionStore((s) => s.permissions[agent_id]?.[feature] ?? 'idle')
 67: 
 68:     // Local flow state: whether we have an in-flight request awaiting reply.
 69:     const [is_pending_consent, setPendingConsent] = useState(false)
 70: 
 71:     // Queued sendFns that are waiting for consent to arrive. Kept in a ref so
 72:     // we can drain them from a store-change effect without stale closures.
 73:     const pending_actions_ref = useRef([])
 74:     const timeout_ref         = useRef(null)
 75: 
 76:     // Clear everything: local state, queue, and any pending timeout.
 77:     // Used after grant-drain, deny, timeout, or unmount.
 78:     const resetPending = useCallback(function ()
 79:     {
 80:         setPendingConsent(false)
 81:         pending_actions_ref.current = []
 82:         if (timeout_ref.current)
 83:         {
 84:             clearTimeout(timeout_ref.current)
 85:             timeout_ref.current = null
 86:         }
 87:     }, [])
 88: 
 89:     // React to status changes while a request is in flight.
 90:     useEffect(function ()
 91:     {
 92:         if (!is_pending_consent) return
 93: 
 94:         if (status === 'granted')
 95:         {
 96:             // Drain the queue in the order it was pushed.
 97:             const actions = pending_actions_ref.current
 98:             pending_actions_ref.current = []
 99:             if (timeout_ref.current) { clearTimeout(timeout_ref.current); timeout_ref.current = null }
100:             setPendingConsent(false)
101:             for (const fn of actions)
102:             {
103:                 try { fn() }
104:                 catch (err) { console.error('[PermissionGate] queued action threw:', err) }
105:             }
106:         }
107:         else if (status === 'denied' || status === 'idle')
108:         {
109:             if (status === 'denied') addToast(`Agent từ chối cấp quyền ${feature}`, 'error')
110:             resetPending()
111:         }
112:     }, [status, is_pending_consent, feature, addToast, resetPending])
113: 
114:     // On unmount OR when the (agent, feature) pair changes, drop the queue so
115:     // a stale sendFn cannot fire against a different agent later.
116:     useEffect(function ()
117:     {
118:         return function () { resetPending() }
119:     }, [agent_id, feature, resetPending])
120: 
121:     // Guarded send: enforce consent-before-action from a single call site.
122:     // If consent is already granted, sendFn runs synchronously (same tick as
123:     // the click). Otherwise we queue it and request consent.
124:     const guardedSend = useCallback(function (sendFn)
125:     {
126:         if (typeof sendFn !== 'function') return
127: 
128:         // Read fresh status — the closure's `status` may be one render behind.
129:         const current = usePermissionStore.getState().permissions[agent_id]?.[feature] ?? 'idle'
130:         if (current === 'granted')
131:         {
132:             sendFn()
133:             return
134:         }
135: 
136:         pending_actions_ref.current.push(sendFn)
137: 
138:         // Only fire the request + start the timer for the FIRST queued action.
139:         if (!is_pending_consent)
140:         {
141:             setPendingConsent(true)
142:             
143:             // Fix: Only send the network request if the global store isn't already tracking it.
144:             // This prevents duplicate packets during React Strict Mode remounts.
145:             if (current !== 'requesting')
146:             {
147:                 requestPermission(feature, agent_id)
148:             }
149:             
150:             timeout_ref.current = setTimeout(function ()
151:             {
152:                 addToast(`Hết thời gian chờ cấp quyền ${feature}`, 'error')
153:                 resetPending()
154:                 usePermissionStore.getState().setPermissionResult(agent_id, feature, false)
155:             }, CONSENT_TIMEOUT_MS)
156:         }
157:     }, [agent_id, feature, is_pending_consent, requestPermission, addToast, resetPending])
158: 
159:     // Disconnect = revoke the grant AND tell the Agent to stop the feature.
160:     function handleDisconnect()
161:     {
162:         revokePermission(feature, agent_id)
163:         stopModule(feature, agent_id)
164:         resetPending()
165:     }
166: 
167:     const is_granted    = status === 'granted'
168:     const shown_status  = is_pending_consent ? 'requesting' : status
169:     const shown_label   = is_pending_consent ? 'Đang xin quyền...' : statusLabel(status)
170:     // Memoize the context value so consumers (7 module tabs) only re-render
171:     // when guardedSend or is_pending_consent actually change identity.
172:     const ctx_value = useMemo(
173:         () => ({ guardedSend, is_pending_consent }),
174:         [guardedSend, is_pending_consent]
175:     )
176: 
177:     return (
178:         <PermissionContext.Provider value={ctx_value}>
179:             <div className="permission-gate">
180: 
181:                 {/* ── consent bar ──────────────────────────────────────────── */}
182:                 <div className="permission-gate__bar">
183: 
184:                     <span className={`permission-gate__badge permission-gate__badge--${shown_status}`}>
185:                         {is_pending_consent
186:                             ? <Loader size={14} className="permission-gate__spin" />
187:                             : is_granted
188:                                 ? <ShieldCheck size={14} />
189:                                 : <ShieldAlert  size={14} />}
190:                         <span className="permission-gate__feature">{feature}</span>
191:                         <span className="permission-gate__status">{shown_label}</span>
192:                     </span>
193: 
194:                     <div className="permission-gate__actions">
195:                         {is_granted && !is_pending_consent && (
196:                             <button
197:                                 className="action-btn action-btn--stop"
198:                                 onClick={handleDisconnect}
199:                                 title="Thu hồi quyền và dừng tính năng"
200:                             >
201:                                 <PlugZap size={12} /> Disconnect
202:                             </button>
203:                         )}
204:                     </div>
205: 
206:                 </div>
207: 
208:                 {/* ── module command area — buttons run consent flow themselves ── */}
209:                 <div className="permission-gate__body">
210:                     {children}
211:                 </div>
212: 
213:             </div>
214:         </PermissionContext.Provider>
215:     )
216: }
217: 
218: export default PermissionGate
</file>

