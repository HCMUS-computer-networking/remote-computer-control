  1: /* FileTab — browse, download, and upload files inside the Agent's sandbox.
  2:    ALL operations are restricted to the sandbox directory on the Agent side.
  3:    The Agent rejects any path that escapes outside it, so the Controller
  4:    never accesses arbitrary files on the remote machine. */
  5: import { useState, useEffect, useRef } from 'react'
  6: import {
  7:     Folder, FolderOpen, FileText, FileImage, File,
  8:     ChevronRight, ChevronDown, Download, Upload,
  9:     Loader2, RefreshCw, Lock, CheckCircle, XCircle, X, WifiOff,
 10: } from 'lucide-react'
 11: 
 12: import useModuleStore                      from '../../../store/ModuleStore'
 13: import usePolicyStore                      from '../../../store/PolicyStore'
 14: import useUiStore                          from '../../../store/UiStore'
 15: import useAgentSocket                      from '../../../hooks/UseAgentSocket'
 16: import { useGuardedSend, usePendingConsent } from '../../PermissionGate'
 17: import { buildFsList, buildFsGet, buildFsPut } from '../../../services/Protocol'
 18: 
 19: // ── Constants ────────────────────────────────────────────────────────────────
 20: 
 21: // Each upload is split into chunks this large before being sent.
 22: // Smaller chunks = smoother progress bar but more round-trips.
 23: const CHUNK_SIZE_BYTES = 32 * 1024   // 32 KB per chunk
 24: 
 25: // All uploaded files land in this sandbox folder.
 26: const UPLOAD_DEST_DIR  = '/uploads'
 27: 
 28: // Indent each tree depth level by this many pixels.
 29: const DEPTH_PX = 16
 30: 
 31: // ── Stable defaults ───────────────────────────────────────────────────────────
 32: 
 33: const EMPTY_FILE_STATE      = { tree: {}, path: '/' }   // avoids new object on every selector call
 34: const EMPTY_FILE_DOWNLOADS  = {}                          // stable identity for empty map slice
 35: 
 36: // How long to keep the Blob URL alive after triggering the browser download.
 37: // Long enough for slow save dialogs; short enough that memory is reclaimed.
 38: const BLOB_URL_TTL_MS = 60 * 1000
 39: 
 40: // If a download job goes this long without a new chunk arriving (WS drop /
 41: // Agent hang), abandon it: mark error, toast, and free the buffered bytes.
 42: const DOWNLOAD_STALE_MS      = 15 * 1000
 43: const DOWNLOAD_SCAN_EVERY_MS = 5  * 1000
 44: 
 45: // ── File-type icon map ────────────────────────────────────────────────────────
 46: 
 47: const EXT_ICONS =
 48: {
 49:     txt  : FileText,
 50:     log  : FileText,
 51:     csv  : FileText,
 52:     json : FileText,
 53:     jpg  : FileImage,
 54:     jpeg : FileImage,
 55:     png  : FileImage,
 56:     gif  : FileImage,
 57: }
 58: 
 59: function getFileIcon(name)
 60: {
 61:     const ext = name.split('.').pop().toLowerCase()
 62:     return EXT_ICONS[ext] ?? File
 63: }
 64: 
 65: // ── Utility helpers ───────────────────────────────────────────────────────────
 66: 
 67: function formatSize(bytes)
 68: {
 69:     if (bytes === null || bytes === undefined) return ''
 70:     if (bytes < 1024)        return `${bytes} B`
 71:     if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`
 72:     return `${(bytes / (1024 * 1024)).toFixed(1)} MB`
 73: }
 74: 
 75: // Collapse duplicate slashes so "//" becomes "/".
 76: function normalizePath(p)
 77: {
 78:     return p.replace(/\/+/g, '/')
 79: }
 80: 
 81: // Sandbox path validation used by the "Go to path" input. Returns an error
 82: // message string for display, or '' when the path is valid (or empty — the
 83: // button stays disabled instead of showing an error).
 84: function validateSandboxPath(raw)
 85: {
 86:     const value = raw.trim()
 87:     if (value === '')                    return ''   // untyped: not an error
 88:     if (value.indexOf('\0') !== -1)      return 'Path must not contain NUL bytes'
 89:     if (!value.startsWith('/'))          return 'Path must start with "/"'
 90:     if (value.split('/').includes('..')) return 'Path must not contain ".." segments'
 91:     return ''
 92: }
 93: 
 94: // Encode a Uint8Array slice to a base64 string without using spread (avoids
 95: // stack overflow on large arrays that would blow the call stack in some engines).
 96: function uint8ToBase64(bytes)
 97: {
 98:     let binary = ''
 99:     const len  = bytes.length
100:     for (let i = 0; i < len; i++) binary += String.fromCharCode(bytes[i])
101:     return btoa(binary)
102: }
103: 
104: // Assemble the ordered Uint8Array chunks into a Blob, trigger the browser
105: // download, then revoke the object URL after a delay so the save dialog has
106: // time to grab the bytes (revoking immediately can abort slow downloads).
107: function triggerBlobDownload(filename, byte_chunks)
108: {
109:     try
110:     {
111:         const blob = new Blob(byte_chunks)
112:         const url  = URL.createObjectURL(blob)
113:         const link = document.createElement('a')
114:         link.href     = url
115:         link.download = filename
116:         document.body.appendChild(link)
117:         link.click()
118:         document.body.removeChild(link)
119:         setTimeout(() => URL.revokeObjectURL(url), BLOB_URL_TTL_MS)
120:     }
121:     catch (err)
122:     {
123:         console.error('[FileTab] triggerBlobDownload failed:', err)
124:     }
125: }
126: 
127: // ── Component ─────────────────────────────────────────────────────────────────
128: 
129: function FileTab({ agent })
130: {
131:     const { sendToFocused } = useAgentSocket()
132:     const guardedSend       = useGuardedSend()
133:     const is_pending        = usePendingConsent()
134: 
135:     // Sandbox root comes from the pushed security policy (NOT hard-coded here).
136:     const sandbox_path = usePolicyStore((s) => s.sandbox_path)
137: 
138:     // Store slices — scoped to this agent only.
139:     const file_state       = useModuleStore((s) => s.data[agent.id]?.file           ?? EMPTY_FILE_STATE)
140:     const download_jobs    = useModuleStore((s) => s.data[agent.id]?.file_downloads ?? EMPTY_FILE_DOWNLOADS)
141:     const put_ack          = useModuleStore((s) => s.data[agent.id]?.file_put_ack   ?? null)
142:     const removeFileDownload = useModuleStore((s) => s.removeFileDownload)
143:     const clearFilePutAck    = useModuleStore((s) => s.clearFilePutAck)
144:     const clearModule        = useModuleStore((s) => s.clearModule)
145:     const addToast           = useUiStore((s) => s.addToast)
146: 
147:     // ── "Go to path" form state ─────────────────────────────────────────
148:     // Lets the operator jump the sandbox tree straight to a deep path
149:     // (e.g. /reports/2024) instead of expanding folders one by one.
150:     const [path_input, setPathInput] = useState('')
151:     const path_error = validateSandboxPath(path_input)   // '' when valid or empty
152: 
153:     // ── Tree state ────────────────────────────────────────────────────────
154:     const [open_dirs,        setOpenDirs]        = useState(new Set(['/']))
155:     const [loading_path,     setLoadingPath]     = useState(null)
156:     const [downloading_path, setDownloadingPath] = useState(null)
157: 
158:     // Track which transfer_ids have already been handed to the browser so we
159:     // don't double-download the same job if React re-runs the effect.
160:     const finished_dl_ref = useRef(new Set())
161: 
162:     // ── Upload state ──────────────────────────────────────────────────────
163:     // Each job: { id, name, dest_path, total_size, total_chunks, sent_chunks, status, error }
164:     // status: 'sending' | 'done' | 'error'
165:     const [uploads,   setUploads]   = useState([])
166:     const [drag_over, setDragOver]  = useState(false)
167: 
168:     // Chunk data kept in a ref (not state) so the ack effect can read it without
169:     // going stale. Shape: { [dest_path]: { chunks: string[], total_size, total_chunks } }
170:     const ul_chunks_ref   = useRef({})
171:     const last_ack_seq_ref = useRef(null)
172: 
173:     // Hidden file input used as a click-to-browse fallback.
174:     const file_input_ref = useRef(null)
175: 
176:     // ── On agent switch: reset all local state ────────────────────────────
177:     useEffect(function ()
178:     {
179:         setOpenDirs(new Set(['/']))
180:         setLoadingPath(null)
181:         setDownloadingPath(null)
182:         finished_dl_ref.current = new Set()
183:         ul_chunks_ref.current   = {}
184: 
185:         // Offline agents cannot answer — skip the sandbox request entirely.
186:         if (!agent.online) return
187: 
188:         const current_tree = useModuleStore.getState().data[agent.id]?.file?.tree ?? {}
189:         if (!current_tree['/'])
190:         {
191:             // First list request auto-triggers consent when needed.
192:             guardedSend(function () { sendToFocused(buildFsList('/')) })
193:             setLoadingPath('/')
194:         }
195:         // eslint-disable-next-line react-hooks/exhaustive-deps
196:     }, [agent.id, agent.online])
197: 
198:     // ── Clear loading spinner when the fetched path arrives in the tree ───
199:     useEffect(function ()
200:     {
201:         if (loading_path !== null && file_state.tree[loading_path] !== undefined)
202:         {
203:             setLoadingPath(null)
204:         }
205:     }, [file_state.tree, loading_path])
206: 
207:     // ── Stale download GC: a WS drop mid-transfer would otherwise leave the
208:     //    progress bar frozen forever. Every DOWNLOAD_SCAN_EVERY_MS, look for
209:     //    incomplete jobs whose most recent chunk (`_seq`) is older than
210:     //    DOWNLOAD_STALE_MS and drop them with an error toast.
211:     useEffect(function ()
212:     {
213:         const timer = setInterval(function ()
214:         {
215:             const jobs_now = useModuleStore.getState().data[agent.id]?.file_downloads ?? {}
216:             const cutoff   = Date.now() - DOWNLOAD_STALE_MS
217:             for (const transfer_id of Object.keys(jobs_now))
218:             {
219:                 const job = jobs_now[transfer_id]
220:                 if (job.received_chunks >= job.total_chunks) continue   // completing next tick
221:                 if (job._seq > cutoff)                       continue   // still fresh
222: 
223:                 addToast(`Tải ${job.path.split('/').pop()} bị treo — huỷ.`, 'error')
224:                 removeFileDownload(agent.id, transfer_id)
225:                 if (downloading_path === job.path) setDownloadingPath(null)
226:             }
227:         }, DOWNLOAD_SCAN_EVERY_MS)
228:         return () => clearInterval(timer)
229:     }, [agent.id, addToast, removeFileDownload, downloading_path])
230: 
231:     // ── Watch download jobs: when a job reaches total_chunks, assemble the
232:     //    Blob, trigger the browser download, then drop the job from the store.
233:     useEffect(function ()
234:     {
235:         for (const transfer_id of Object.keys(download_jobs))
236:         {
237:             const job = download_jobs[transfer_id]
238:             if (finished_dl_ref.current.has(transfer_id))       continue
239:             if (job.received_chunks < job.total_chunks)         continue
240: 
241:             finished_dl_ref.current.add(transfer_id)
242:             triggerBlobDownload(job.path.split('/').pop(), job.chunks)
243: 
244:             // Clear the "downloading" spinner on the file row if it was ours.
245:             if (downloading_path === job.path) setDownloadingPath(null)
246: 
247:             // Free the buffered bytes from the store; the browser owns the Blob now.
248:             removeFileDownload(agent.id, transfer_id)
249:             finished_dl_ref.current.delete(transfer_id)
250:         }
251:     }, [download_jobs, agent.id, downloading_path, removeFileDownload])
252: 
253:     // ── Consume fs_put_result / fs_put_complete: advance progress bar ─────
254:     useEffect(function ()
255:     {
256:         if (!put_ack) return
257:         if (put_ack._seq === last_ack_seq_ref.current) return
258:         last_ack_seq_ref.current = put_ack._seq
259: 
260:         const { path, chunk_index, success, complete } = put_ack
261: 
262:         if (complete)
263:         {
264:             // All chunks have arrived at the Agent — mark upload as done.
265:             setUploads((prev) => prev.map((job) =>
266:                 job.dest_path === path
267:                     ? { ...job, sent_chunks: job.total_chunks, status: 'done' }
268:                     : job
269:             ))
270:             delete ul_chunks_ref.current[path]
271:         }
272:         else if (success)
273:         {
274:             const info       = ul_chunks_ref.current[path]
275:             const next_index = chunk_index + 1
276: 
277:             // Advance the progress counter.
278:             setUploads((prev) => prev.map((job) =>
279:                 job.dest_path === path
280:                     ? { ...job, sent_chunks: next_index }
281:                     : job
282:             ))
283: 
284:             // If more chunks remain, send the next one now. Wrap the builder
285:             // in try/catch: a defensive validator throw (bad base64, wrong
286:             // transfer_id, etc.) would otherwise strand the job at 'sending'
287:             // forever with no user feedback.
288:             if (info && next_index < info.total_chunks)
289:             {
290:                 try
291:                 {
292:                     sendToFocused(buildFsPut(path,
293:                     {
294:                         transfer_id  : info.transfer_id,
295:                         total_size   : info.total_size,
296:                         chunk_index  : next_index,
297:                         total_chunks : info.total_chunks,
298:                         data_base64  : info.chunks[next_index],
299:                     }))
300:                 }
301:                 catch (err)
302:                 {
303:                     setUploads((prev) => prev.map((job) =>
304:                         job.dest_path === path
305:                             ? { ...job, status: 'error', error: err.message ?? 'Chunk build failed' }
306:                             : job
307:                     ))
308:                     delete ul_chunks_ref.current[path]
309:                 }
310:             }
311:         }
312:         else
313:         {
314:             // Chunk was rejected (e.g. path outside sandbox).
315:             setUploads((prev) => prev.map((job) =>
316:                 job.dest_path === path
317:                     ? { ...job, status: 'error', error: put_ack.message ?? 'Upload failed' }
318:                     : job
319:             ))
320:             delete ul_chunks_ref.current[path]
321:         }
322: 
323:         clearFilePutAck(agent.id)
324:     }, [put_ack])
325: 
326:     // ── Read files from a FileList, split into chunks, start sending ──────
327:     async function handleFiles(file_list)
328:     {
329:         for (const file of file_list)
330:         {
331:             const buffer      = await file.arrayBuffer()
332:             const all_bytes   = new Uint8Array(buffer)
333:             const total_chunks = Math.max(1, Math.ceil(all_bytes.length / CHUNK_SIZE_BYTES))
334:             const dest_path   = normalizePath(UPLOAD_DEST_DIR + '/' + file.name)
335: 
336:             // Pre-compute every chunk's base64 string so the ack handler can
337:             // access them without re-reading the file.
338:             const chunks = []
339:             for (let i = 0; i < total_chunks; i++)
340:             {
341:                 const slice = all_bytes.slice(i * CHUNK_SIZE_BYTES, (i + 1) * CHUNK_SIZE_BYTES)
342:                 chunks.push(uint8ToBase64(slice))
343:             }
344: 
345:             // One transfer_id per file — every chunk of this upload carries the
346:             // same id so the Agent can stitch them back together (File.json spec).
347:             const transfer_id = crypto.randomUUID()
348:             ul_chunks_ref.current[dest_path] = { chunks, total_size: file.size, total_chunks, transfer_id }
349: 
350:             // Add a job card to the upload list.
351:             setUploads((prev) =>
352:             [
353:                 ...prev,
354:                 {
355:                     id           : `${Date.now()}-${file.name}`,
356:                     name         : file.name,
357:                     dest_path,
358:                     total_size   : file.size,
359:                     total_chunks,
360:                     sent_chunks  : 0,
361:                     status       : 'sending',
362:                     error        : null,
363:                 },
364:             ])
365: 
366:             // Kick off the first chunk; the rest are sent after each ack arrives.
367:             // First chunk is guarded — subsequent chunks (fired from the ack
368:             // effect) skip the wrap since consent is already granted by then.
369:             guardedSend(function ()
370:             {
371:                 sendToFocused(buildFsPut(dest_path,
372:                 {
373:                     transfer_id,
374:                     total_size   : file.size,
375:                     chunk_index  : 0,
376:                     total_chunks,
377:                     data_base64  : chunks[0],
378:                 }))
379:             })
380:         }
381:     }
382: 
383:     // ── Drag-and-drop handlers ────────────────────────────────────────────
384: 
385:     function handleDragOver(e)
386:     {
387:         e.preventDefault()
388:         setDragOver(true)
389:     }
390: 
391:     function handleDragLeave(e)
392:     {
393:         // Only clear when the cursor leaves the drop zone entirely (not child elements).
394:         if (!e.currentTarget.contains(e.relatedTarget)) setDragOver(false)
395:     }
396: 
397:     function handleDrop(e)
398:     {
399:         e.preventDefault()
400:         setDragOver(false)
401:         const files = e.dataTransfer?.files
402:         if (files?.length) handleFiles(files)
403:     }
404: 
405:     function handleInputChange(e)
406:     {
407:         const files = e.target.files
408:         if (files?.length) handleFiles(files)
409:         e.target.value = ''   // reset so the same file can be re-selected
410:     }
411: 
412:     // ── Tree navigation helpers ───────────────────────────────────────────
413: 
414:     function fetchDir(path)
415:     {
416:         setLoadingPath(path)
417:         guardedSend(function () { sendToFocused(buildFsList(path)) })
418:     }
419: 
420:     function handleDirToggle(entry_name, parent_path)
421:     {
422:         const child_path = normalizePath(parent_path + '/' + entry_name)
423:         const next_open  = new Set(open_dirs)
424: 
425:         if (open_dirs.has(child_path))
426:         {
427:             for (const p of next_open)
428:             {
429:                 if (p === child_path || p.startsWith(child_path + '/')) next_open.delete(p)
430:             }
431:         }
432:         else
433:         {
434:             next_open.add(child_path)
435:             if (!file_state.tree[child_path]) fetchDir(child_path)
436:         }
437: 
438:         setOpenDirs(next_open)
439:     }
440: 
441:     function handleDownload(full_path)
442:     {
443:         setDownloadingPath(full_path)
444:         guardedSend(function () { sendToFocused(buildFsGet(full_path)) })
445:     }
446: 
447:     // Jump the tree to a user-typed sandbox path. Fetches its listing (if not
448:     // cached) and expands every ancestor so the target row is visible.
449:     function handleGoToPath(e)
450:     {
451:         e.preventDefault()
452:         const value = normalizePath(path_input.trim())
453:         if (path_error || value === '') return
454:         try
455:         {
456:             guardedSend(function () { sendToFocused(buildFsList(value)) })
457:             setLoadingPath(value)
458:             const next_open = new Set(open_dirs)
459:             const segments  = value.split('/').filter(Boolean)
460:             let acc = ''
461:             next_open.add('/')
462:             for (const seg of segments)
463:             {
464:                 acc += '/' + seg
465:                 next_open.add(acc)
466:             }
467:             setOpenDirs(next_open)
468:         }
469:         catch (err)
470:         {
471:             addToast(err.message ?? 'Invalid sandbox path', 'error')
472:         }
473:     }
474: 
475:     function handleRefresh()
476:     {
477:         clearModule(agent.id, 'file')
478:         setOpenDirs(new Set(['/']))
479:         setLoadingPath('/')
480:         // Drop any in-flight download bookkeeping — the tree is being reset.
481:         for (const tid of Object.keys(download_jobs)) removeFileDownload(agent.id, tid)
482:         finished_dl_ref.current = new Set()
483:         guardedSend(function () { sendToFocused(buildFsList('/')) })
484:     }
485: 
486:     // Remove jobs that have finished or errored from the upload list.
487:     function clearDoneUploads()
488:     {
