  1: // ModuleStore.js — per-agent, per-module data received from the Gateway.
  2: // Shape: data[agent_id][module] — each module key holds its own data type.
  3: import { create } from 'zustand'
  4: 
  5: // Hard limit on buffered keylog events to prevent unbounded memory growth.
  6: const MAX_KEYLOG_EVENTS = 1000
  7: 
  8: // Number of sysinfo samples kept for the sparkline history (2s poll → ~2 min).
  9: const MAX_SYSINFO_HISTORY = 60
 10: 
 11: // Return the default empty state for one agent's module slots.
 12: function createAgentModuleState()
 13: {
 14:     return {
 15:         app          : [],                         // app_list_result: array of app objects
 16:         process      : [],                         // proc_list_result: array of process objects
 17:         keylog       : [],                         // accumulated keystroke event objects
 18:         keylog_active : false,                      // true while Agent is sending keylog data
 19:         screen        : { frame: null, meta: null },// latest screen JPEG (ArrayBuffer) + frame_meta
 20:         webcam        : { frame: null, meta: null },// latest webcam JPEG (ArrayBuffer) + frame_meta
 21:         webcam_active : false,                      // true after Agent confirmed webcam_started (consent granted)
 22:         screen_stream_active : false,               // true while Agent is streaming its screen (Livescreen)
 23:         input_active  : false,                      // true after Agent confirmed input_started (Remote Input consent granted)
 24:         // file.tree caches directory listings keyed by path (sandbox only).
 25:         // file_downloads is a map keyed by transfer_id — each entry accumulates
 26:         //   raw chunk bytes (Uint8Array[]) so FileTab can render a progress bar
 27:         //   per job and assemble a Blob when all chunks have arrived. Kept as a
 28:         //   map (not a single slot) so bursts of chunks can never overwrite one
 29:         //   another before React consumes them.
 30:         // file_put_ack holds the latest fs_put_result / fs_put_complete so FileTab
 31:         //   can advance the progress bar after each acknowledged chunk.
 32:         file           : { tree: {}, path: '/' },
 33:         file_downloads : {},
 34:         file_put_ack   : null,
 35:         // Latest sysinfo snapshot + a rolling history of samples for the sparkline.
 36:         // Each history point: { t, cpu_percent, ram_percent, disk_percent }
 37:         sysinfo         : null,
 38:         sysinfo_history : [],
 39:     }
 40: }
 41: 
 42: const useModuleStore = create(function (set)
 43: {
 44:     return {
 45:         data: {},
 46: 
 47:         // Write (or merge) a payload into one agent + module slot.
 48:         // Creates the agent entry if it does not exist yet.
 49:         setModuleData: (agent_id, module, payload) =>
 50:             set(function (s)
 51:             {
 52:                 const agent_data = s.data[agent_id] ?? createAgentModuleState()
 53:                 return {
 54:                     data: {
 55:                         ...s.data,
 56:                         [agent_id]:
 57:                         {
 58:                             ...agent_data,
 59:                             [module]: payload,
 60:                         },
 61:                     },
 62:                 }
 63:             }),
 64: 
 65:         // Append incoming keylog events to the buffer instead of replacing it.
 66:         // Old entries are trimmed when the buffer exceeds MAX_KEYLOG_EVENTS.
 67:         appendKeylog: (agent_id, events) =>
 68:             set(function (s)
 69:             {
 70:                 const agent_data   = s.data[agent_id] ?? createAgentModuleState()
 71:                 const merged       = [...agent_data.keylog, ...events]
 72:                 const trimmed      = merged.slice(-MAX_KEYLOG_EVENTS)
 73:                 return {
 74:                     data: {
 75:                         ...s.data,
 76:                         [agent_id]: { ...agent_data, keylog: trimmed },
 77:                     },
 78:                 }
 79:             }),
 80: 
 81:         // Set the screen-stream active flag for one agent (true = Agent is sending frames).
 82:         // Drives the red transparency indicator on AgentCard / TopBar.
 83:         setScreenStreamActive: (agent_id, active) =>
 84:             set(function (s)
 85:             {
 86:                 const agent_data = s.data[agent_id] ?? createAgentModuleState()
 87:                 return {
 88:                     data: {
 89:                         ...s.data,
 90:                         [agent_id]: { ...agent_data, screen_stream_active: active },
 91:                     },
 92:                 }
 93:             }),
 94: 
 95:         // Set the webcam active flag for one agent (true = Agent granted consent + is streaming).
 96:         // Drives the visible consent indicator in WebcamTab.
 97:         setWebcamActive: (agent_id, active) =>
 98:             set(function (s)
 99:             {
100:                 const agent_data = s.data[agent_id] ?? createAgentModuleState()
101:                 return {
102:                     data: {
103:                         ...s.data,
104:                         [agent_id]: { ...agent_data, webcam_active: active },
105:                     },
106:                 }
107:             }),
108: 
109:         // Set the keylog active flag for one agent (true = Agent is sending events).
110:         setKeylogActive: (agent_id, active) =>
111:             set(function (s)
112:             {
113:                 const agent_data = s.data[agent_id] ?? createAgentModuleState()
114:                 return {
115:                     data: {
116:                         ...s.data,
117:                         [agent_id]: { ...agent_data, keylog_active: active },
118:                     },
119:                 }
120:             }),
121: 
122:         // Set the Remote Input active flag for one agent (true = Agent granted input consent).
123:         setInputActive: (agent_id, active) =>
124:             set(function (s)
125:             {
126:                 const agent_data = s.data[agent_id] ?? createAgentModuleState()
127:                 return {
128:                     data: {
129:                         ...s.data,
130:                         [agent_id]: { ...agent_data, input_active: active },
131:                     },
132:                 }
133:             }),
134: 
135:         // Merge a new directory listing into file.tree under the given path (sandbox only).
136:         // Called by UseAgentSocket when an fs_list_result message arrives.
137:         setFsEntries: (agent_id, path, entries) =>
138:             set(function (s)
139:             {
140:                 const agent_data = s.data[agent_id] ?? createAgentModuleState()
141:                 const file_state = agent_data.file
142:                 return {
143:                     data: {
144:                         ...s.data,
145:                         [agent_id]:
146:                         {
147:                             ...agent_data,
148:                             file: { tree: { ...file_state.tree, [path]: entries }, path },
149:                         },
150:                     },
151:                 }
152:             }),
153: 
154:         // Append one raw chunk (Uint8Array) into the download job keyed by
155:         // transfer_id. Creates the job on the first chunk. This preserves every
156:         // chunk even when the Gateway bursts them faster than React can render.
157:         // chunk_info = { transfer_id, chunk_index, total_chunks, path, total_size, bytes }
158:         appendFileDownloadChunk: (agent_id, chunk_info) =>
159:             set(function (s)
160:             {
161:                 // Bounds guard: a buggy Agent or mis-paired binary frame could
162:                 // hand us an out-of-range chunk_index. Writing past the array
163:                 // would grow it silently and every() would never return true,
164:                 // leaving the job stuck. Drop the chunk with a warning instead.
165:                 const total  = chunk_info.total_chunks
166:                 const index  = chunk_info.chunk_index
167:                 if (!Number.isInteger(total) || total < 1
168:                     || !Number.isInteger(index) || index < 0 || index >= total)
169:                 {
170:                     console.warn(
171:                         `[ModuleStore] appendFileDownloadChunk: out-of-range chunk ${index}/${total} ` +
172:                         `for transfer_id=${chunk_info.transfer_id} — dropped`
173:                     )
174:                     return s   // no state change
175:                 }
176: 
177:                 const agent_data = s.data[agent_id] ?? createAgentModuleState()
178:                 const jobs       = agent_data.file_downloads ?? {}
179:                 const prev_job   = jobs[chunk_info.transfer_id]
180:                 const chunks     = prev_job
181:                     ? prev_job.chunks.slice()
182:                     : new Array(total).fill(null)
183: 
184:                 // Skip duplicates: if this chunk slot is already filled, keep the
185:                 // received count intact instead of double-counting.
186:                 const is_new     = chunks[index] == null
187:                 chunks[index] = chunk_info.bytes
188: 
189:                 const next_job =
190:                 {
191:                     transfer_id     : chunk_info.transfer_id,
192:                     path            : chunk_info.path,
193:                     total_size      : chunk_info.total_size,
194:                     total_chunks    : chunk_info.total_chunks,
195:                     received_chunks : (prev_job?.received_chunks ?? 0) + (is_new ? 1 : 0),
196:                     chunks,
197:                     _seq            : Date.now(),
198:                 }
199: 
200:                 return {
201:                     data: {
202:                         ...s.data,
203:                         [agent_id]:
204:                         {
205:                             ...agent_data,
206:                             file_downloads: { ...jobs, [chunk_info.transfer_id]: next_job },
207:                         },
208:                     },
209:                 }
210:             }),
211: 
212:         // Remove one download job (called after the Blob has been assembled +
213:         // handed to the browser, or when the user cancels).
214:         removeFileDownload: (agent_id, transfer_id) =>
215:             set(function (s)
216:             {
217:                 const agent_data = s.data[agent_id] ?? createAgentModuleState()
218:                 const next_jobs  = { ...(agent_data.file_downloads ?? {}) }
219:                 delete next_jobs[transfer_id]
220:                 return {
221:                     data: {
222:                         ...s.data,
223:                         [agent_id]: { ...agent_data, file_downloads: next_jobs },
224:                     },
225:                 }
226:             }),
227: 
228:         // Store the latest fs_put_result or fs_put_complete acknowledgement.
229:         // The complete flag is true only when all chunks have been received by the Agent.
230:         // A monotonic _seq ensures the watching useEffect always fires on a new ack.
231:         setFilePutAck: (agent_id, result) =>
232:             set(function (s)
233:             {
234:                 const agent_data = s.data[agent_id] ?? createAgentModuleState()
235:                 return {
236:                     data: {
237:                         ...s.data,
238:                         [agent_id]: { ...agent_data, file_put_ack: { ...result, _seq: Date.now() } },
239:                     },
240:                 }
241:             }),
242: 
243:         // Clear file_put_ack after the component has consumed it.
244:         clearFilePutAck: (agent_id) =>
245:             set(function (s)
246:             {
247:                 const agent_data = s.data[agent_id] ?? createAgentModuleState()
248:                 return {
249:                     data: {
250:                         ...s.data,
251:                         [agent_id]: { ...agent_data, file_put_ack: null },
252:                     },
253:                 }
254:             }),
255: 
256: // Store the newest sysinfo snapshot and append a compact percent-only
257:         // sample to the rolling history (trimmed to MAX_SYSINFO_HISTORY).
258:         // The history keeps only percentages so the line charts have a single
259:         // y-axis domain (0..100) shared across CPU / RAM / Disk.
260:         appendSysInfo: (agent_id, snapshot) =>
261:             set(function (s)
262:             {
263:                 const agent_data   = s.data[agent_id] ?? createAgentModuleState()
264:                 const ram_percent  = snapshot.ram_total_mb  > 0
265:                     ? (snapshot.ram_used_mb  / snapshot.ram_total_mb)  * 100
266:                     : 0
267:                 const disk_percent = snapshot.disk_total_gb > 0
268:                     ? (snapshot.disk_used_gb / snapshot.disk_total_gb) * 100
269:                     : 0
270:                 const sample = {
271:                     t            : snapshot.timestamp_ms ?? Date.now(),
272:                     cpu_percent  : snapshot.cpu_percent ?? 0,
273:                     ram_percent,
274:                     disk_percent,
275:                 }
276:                 const merged  = [...agent_data.sysinfo_history, sample]
277:                 const trimmed = merged.slice(-MAX_SYSINFO_HISTORY)
278:                 return {
279:                     data: {
280:                         ...s.data,
281:                         [agent_id]:
282:                         {
283:                             ...agent_data,
284:                             sysinfo         : snapshot,
285:                             sysinfo_history : trimmed,
286:                         },
287:                     },
288:                 }
289:             }),
290: 
291:         // Reset one module slot back to its default empty value.
292:         clearModule: (agent_id, module) =>
293:             set(function (s)
294:             {
295:                 const agent_data    = { ...(s.data[agent_id] ?? createAgentModuleState()) }
296:                 const default_state = createAgentModuleState()
297:                 agent_data[module]  = default_state[module] ?? null
298:                 return { data: { ...s.data, [agent_id]: agent_data } }
299:             }),
300: 
301:         // Remove all module data for an agent (called when an agent disconnects).
302:         clearAgent: (agent_id) =>
303:             set(function (s)
304:             {
305:                 const next = { ...s.data }
306:                 delete next[agent_id]
307:                 return { data: next }
308:             }),
309: 
310:         // Reset the 3 live-stream flags for ONE agent. Called when the Gateway
311:         // reports agent_status.online=false so a stale "LIVE / CAM ON" badge
312:         // does not linger after the Agent drops mid-stream.
313:         clearLiveFlagsForAgent: (agent_id) =>
314:             set(function (s)
315:             {
316:                 const agent_data = s.data[agent_id]
317:                 if (!agent_data) return s                                                           // nothing to clear yet
318:                 return {
319:                     data: {
320:                         ...s.data,
321:                         [agent_id]:
322:                         {
323:                             ...agent_data,
324:                             webcam_active        : false,
325:                             screen_stream_active : false,
326:                             keylog_active        : false,
327:                             input_active         : false,
328:                         },
329:                     },
330:                 }
331:             }),
332: 
333:         // Reset the 3 live-stream flags for EVERY known agent. Called when the
334:         // WebSocket itself closes (Gateway down / network drop) — every stream
335:         // is by definition dead until the socket comes back up.
336:         clearAllLiveFlags: () =>
337:             set(function (s)
338:             {
339:                 const next = {}
340:                 for (const [id, agent_data] of Object.entries(s.data))
341:                 {
342:                     next[id] = {
343:                         ...agent_data,
344:                         webcam_active        : false,
345:                         screen_stream_active : false,
346:                         keylog_active        : false,
347:                         input_active         : false,
348:                     }
349:                 }
350:                 return { data: next }
351:             }),
352:     }
353: })
354: 
355: export default useModuleStore
</file>

