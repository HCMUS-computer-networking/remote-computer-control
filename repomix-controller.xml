  1: // App.jsx — root gate: shows LoginScreen until a JWT is present, then mounts the
  2: // console shell (which owns the socket) so no data flows before authentication.
  3: import { useEffect }      from 'react'
  4: import { WifiOff, Loader2 } from 'lucide-react'
  5: import useUiStore         from './store/UiStore'
  6: import useConnectionStore from './store/ConnectionStore'
  7: import useAgentSocket     from './hooks/UseAgentSocket'
  8: import LoginScreen        from './components/LoginScreen'
  9: import Sidebar            from './components/layout/Sidebar'
 10: import TopBar             from './components/layout/TopBar'
 11: import GridView           from './components/livescreen/GridView'
 12: import FocusView          from './components/livescreen/FocusView'
 13: import E2EEUnlockModal    from './components/E2EEUnlockModal'
 14: 
 15: // Full-width strip shown while the socket is not open. Warns the operator that
 16: // data may be stale and that a reconnect is in progress. Hidden when connected.
 17: function ConnectionBanner({ status })
 18: {
 19:     if (status === 'connecting')
 20:     {
 21:         return (
 22:             <div className="conn-banner conn-banner--warning" role="status">
 23:                 <Loader2 size={14} strokeWidth={2} className="spin" />
 24:                 Connecting to Gateway…
 25:             </div>
 26:         )
 27:     }
 28:     if (status === 'closed')
 29:     {
 30:         return (
 31:             <div className="conn-banner conn-banner--danger" role="alert">
 32:                 <WifiOff size={14} strokeWidth={2} />
 33:                 Gateway disconnected — retrying…
 34:             </div>
 35:         )
 36:     }
 37:     return null   // 'open' or 'idle' — no banner
 38: }
 39: 
 40: // Authenticated console shell — owns the socket (via useAgentSocket) so the
 41: // connection only opens AFTER login and closes automatically on logout when this
 42: // component unmounts (the hook is ref-counted: last unmount → socket.close()).
 43: function ConsoleShell()
 44: {
 45:     const layout_mode  = useUiStore((s) => s.layout_mode)
 46:     const conn_status  = useConnectionStore((s) => s.status)
 47: 
 48:     // open the socket connection and start receiving data from MockSocket / Gateway
 49:     useAgentSocket()
 50: 
 51:     return (
 52:         <div className="app-shell">
 53:             <Sidebar />
 54: 
 55:             <div className="right-panel">
 56:                 <ConnectionBanner status={conn_status} />
 57:                 <TopBar />
 58: 
 59:                 <main className="main-area">
 60:                     {layout_mode === 'grid' ? <GridView /> : <FocusView />}
 61:                 </main>
 62:             </div>
 63:         </div>
 64:     )
 65: }
 66: 
 67: function App()
 68: {
 69:     const theme        = useUiStore((s) => s.theme)
 70:     const toasts       = useUiStore((s) => s.toasts)
 71:     const dismissToast = useUiStore((s) => s.dismissToast)
 72:     const auth_token   = useConnectionStore((s) => s.auth_token)
 73: 
 74:     // sync the data-theme attribute on <html> so all CSS variables flip correctly
 75:     useEffect(function ()
 76:     {
 77:         if (theme === 'dark')
 78:         {
 79:             document.documentElement.setAttribute('data-theme', 'dark')
 80:         }
 81:         else
 82:         {
 83:             document.documentElement.removeAttribute('data-theme')
 84:         }
 85:     }, [theme])
 86: 
 87:     return (
 88:         <>
 89:             <E2EEUnlockModal />
 90:             {/* Gate: no JWT → login form; with JWT → console (socket owner). */}
 91:             {auth_token ? <ConsoleShell /> : <LoginScreen />}
 92: 
 93:             {/* ── Toast notifications (shown in both login + console) ────── */}
 94:             {toasts.length > 0 && (
 95:                 <div className="toast-container" aria-live="polite">
 96:                     {toasts.map(function (t)
 97:                     {
 98:                         return (
 99:                             <div
100:                                 key={t.id}
101:                                 className={`toast toast--${t.variant}`}
102:                                 onClick={() => dismissToast(t.id)}
103:                                 role="status"
104:                             >
105:                                 {t.message}
106:                             </div>
107:                         )
108:                     })}
109:                 </div>
110:             )}
111:         </>
