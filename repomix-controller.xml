 241: // Build a fresh process list with random cpu_percent / ram_mb values.
 242: // Uses the OS-specific pool so process names look realistic per platform.
 243: // Called each time proc_list is requested so numbers look "live".
 244: // Format matches docs/protocol/process.json → proc_list_result
 245: function generateFakeProcs(os_family)
 246: {
 247:     const pool = PROC_NAME_POOL_BY_OS[os_family] ?? PROC_NAME_POOL_BY_OS.windows
 248:     return pool.map((name, index) =>
 249:     ({
 250:         pid         : 1000 + index * 100 + randomInt(0, 99),
 251:         name,
 252:         cpu_percent : randomFloat(0, 25),
 253:         ram_mb      : randomFloat(10, 512),
 254:     }))
 255: }
