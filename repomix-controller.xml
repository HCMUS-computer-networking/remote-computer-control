 1: // MultiSelect.jsx — toolbar that lets the user select multiple agents at once.
 2: // Sits above the agent list in the sidebar.
 3: // "Select all" picks every online agent; clicking again clears the selection.
 4: import useAgentStore from '../../store/AgentStore'
 5: 
 6: function MultiSelect()
 7: {
 8:     const agents             = useAgentStore((s) => s.agents)
 9:     const selected_agent_ids = useAgentStore((s) => s.selected_agent_ids)
10:     const setSelectedIds     = useAgentStore((s) => s.setSelectedIds)
11:     const clearSelection     = useAgentStore((s) => s.clearSelection)
12: 
13:     // only online agents can be targeted by multi-agent commands
14:     const online_ids     = agents.filter((a) => a.online).map((a) => a.id)
15:     const selected_count = selected_agent_ids.length
16:     const all_selected   = online_ids.length > 0 &&
17:                            online_ids.every((id) => selected_agent_ids.includes(id))
18: 
19:     function handleSelectAll()
20:     {
21:         if (all_selected)
22:         {
23:             clearSelection()
24:         }
25:         else
26:         {
27:             setSelectedIds(online_ids)   // select every online agent
28:         }
29:     }
30: 
31:     // hide the bar completely when there are no agents to select
32:     if (online_ids.length === 0) return null
33: 
34:     return (
35:         <div className="multi-select-bar">
36:             <label className="multi-select-bar__label">
37:                 <input
38:                     type="checkbox"
39:                     className="multi-select-bar__checkbox"
40:                     checked={all_selected}
41:                     onChange={handleSelectAll}
42:                     aria-label="Select all online agents"
43:                 />
44:                 {selected_count > 0
45:                     ? `${selected_count} agent${selected_count > 1 ? 's' : ''} selected`
46:                     : 'Select all'}
47:             </label>
48: 
49:             {/* show the clear button only when at least one agent is checked */}
50:             {selected_count > 0 && (
51:                 <button
52:                     className="multi-select-bar__clear"
53:                     onClick={clearSelection}
54:                     aria-label="Clear selection"
55:                 >
56:                     Clear
57:                 </button>
58:             )}
59:         </div>
60:     )
61: }
62: 
63: export default MultiSelect
</file>

