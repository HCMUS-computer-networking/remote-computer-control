<file path="controller/src/components/ModuleTable.jsx">
  1: // ModuleTable.jsx — shared table template used by ApplicationTab and ProcessTab.
  2: //
  3: // Placed directly under src/components/ (not in a subfolder) because it is a
  4: // cross-feature primitive. Module tabs stay thin: they only declare COLUMNS
  5: // and an actionColumn render — the sort state, toolbar, scroll container,
  6: // click-to-sort headers, and empty state all live here.
  7: //
  8: // The template is pure UI — it never imports any store or service.
  9: 
 10: import { useState }              from 'react'
 11: import { ChevronUp, ChevronDown } from 'lucide-react'
 12: 
 13: // Props:
 14: //   columns       — array of { key, label, numeric?, render? }
 15: //                     render(row) is optional; defaults to row[key].
 16: //                     numeric=true right-aligns the cell and sorts by number.
 17: //   rows          — array of data objects to display
 18: //   actionColumn  — { header, render(row) } appended as the last column
 19: //   empty_label   — string shown when rows.length === 0
 20: //   title         — string shown in the toolbar (top-left)
 21: //   poll_badge    — bool, shows the "● Live" badge in the toolbar
 22: //   row_key       — function(row) → unique key; defaults to first column value
 23: function ModuleTable(
 24: {
 25:     columns,
 26:     rows,
 27:     actionColumn,
 28:     empty_label = 'No data',
 29:     title,
 30:     poll_badge  = false,
 31:     row_key,
 32: })
 33: {
 34:     // Sort state is UI-only — it does not belong in any store.
 35:     // Default to the first column, descending, so numeric tables (like Process
 36:     // sorted by CPU) look useful on first render.
 37:     const [sort_col, setSortCol] = useState(columns[0].key)
 38:     const [sort_dir, setSortDir] = useState('desc')
 39: 
 40:     // Click a column header: toggle direction if already active;
 41:     // switch column + reset to 'desc' otherwise.
 42:     function handleSortClick(col_key)
 43:     {
 44:         if (col_key === sort_col)
 45:         {
 46:             setSortDir((d) => (d === 'asc' ? 'desc' : 'asc'))
 47:         }
 48:         else
 49:         {
 50:             setSortCol(col_key)
 51:             setSortDir('desc')
 52:         }
 53:     }
 54: 
 55:     // Sort a COPY of rows — never mutate the array the parent passed in.
 56:     const sorted_rows = [...rows].sort(function (a, b)
 57:     {
 58:         const a_val = a[sort_col]
 59:         const b_val = b[sort_col]
 60: 
 61:         if (typeof a_val === 'string')
 62:         {
 63:             return sort_dir === 'asc'
 64:                 ? a_val.localeCompare(b_val)
 65:                 : b_val.localeCompare(a_val)
 66:         }
 67: 
 68:         return sort_dir === 'asc' ? a_val - b_val : b_val - a_val
 69:     })
 70: 
 71:     // Default row key extractor uses the first column value (usually a unique name/id).
 72:     const getRowKey = row_key ?? ((row) => row[columns[0].key])
 73: 
 74:     return (
 75:         <div className="module-table">
 76: 
 77:             {/* ── toolbar ──────────────────────────────────────────── */}
 78:             <div className="module-table__toolbar">
 79:                 <span className="module-table__title">
 80:                     {title}
 81:                 </span>
 82:                 {poll_badge && (
 83:                     <span className="module-table__poll-badge">● Live</span>
 84:                 )}
 85:             </div>
 86: 
 87:             {/* ── scrollable table ─────────────────────────────────── */}
 88:             <div className="module-table__scroll">
 89:                 <table>
 90:                     <thead>
 91:                         <tr>
 92:                             {columns.map(function ({ key, label, numeric })
 93:                             {
 94:                                 const is_active  = sort_col === key
 95:                                 const SortIcon   = sort_dir === 'asc' ? ChevronUp : ChevronDown
 96:                                 const th_classes = [
 97:                                     'module-table__th',
 98:                                     'module-table__th--sortable',
 99:                                     is_active ? 'module-table__th--active' : '',
100:                                     numeric   ? 'module-table__th--num'    : '',
101:                                 ].filter(Boolean).join(' ')
102: 
103:                                 return (
104:                                     <th
105:                                         key={key}
106:                                         className={th_classes}
107:                                         onClick={() => handleSortClick(key)}
108:                                         title={`Sort by ${label}`}
109:                                     >
110:                                         <span className="module-table__th-inner">
111:                                             {label}
112:                                             {is_active && (
113:                                                 <SortIcon size={12} strokeWidth={2} />
114:                                             )}
115:                                         </span>
116:                                     </th>
117:                                 )
118:                             })}
119:                             {actionColumn && (
120:                                 <th className="module-table__th module-table__th--action">
121:                                     <span className="module-table__th-inner">
122:                                         {actionColumn.header}
123:                                     </span>
124:                                 </th>
125:                             )}
126:                         </tr>
127:                     </thead>
128:                     <tbody>
129:                         {sorted_rows.map(function (row)
130:                         {
131:                             return (
132:                                 <tr key={getRowKey(row)} className="module-table__row">
133: 
134:                                     {columns.map(function ({ key, numeric, render })
135:                                     {
136:                                         const cell_classes = [
137:                                             'module-table__td',
138:                                             numeric ? 'module-table__td--num' : '',
139:                                         ].filter(Boolean).join(' ')
140: 
141:                                         return (
142:                                             <td key={key} className={cell_classes}>
143:                                                 {render ? render(row) : row[key]}
144:                                             </td>
145:                                         )
146:                                     })}
147: 
148:                                     {actionColumn && (
149:                                         <td className="module-table__td module-table__td--action">
150:                                             {actionColumn.render(row)}
151:                                         </td>
152:                                     )}
153: 
154:                                 </tr>
155:                             )
156:                         })}
157:                     </tbody>
158:                 </table>
159: 
160:                 {sorted_rows.length === 0 && (
161:                     <div className="module-table__empty">{empty_label}</div>
162:                 )}
163:             </div>
164: 
165:         </div>
166:     )
167: }
168: 
169: export default ModuleTable
</file>

<file path="controller/src/services/FrameEventBus.js">
 1: class FrameEventBus extends EventTarget {
 2:     constructor() {
 3:         super();
 4:     }
 5: 
 6:     // Tên sự kiện (event name) được cấu thành từ agent_id và module
 7:     // VD: "frame_agent123_screen"
 8:     _getEventName(agentId, module) {
 9:         return `frame_${agentId}_${module}`;
10:     }
11: 
12:     emit(agentId, module, frameBuffer, frameMeta) {
13:         const eventName = this._getEventName(agentId, module);
14:         const event = new CustomEvent(eventName, {
15:             detail: {
16:                 frame_buffer: frameBuffer,
17:                 frame_meta: frameMeta
18:             }
19:         });
20:         this.dispatchEvent(event);
21:     }
22: 
23:     on(agentId, module, callback) {
24:         const eventName = this._getEventName(agentId, module);
25:         const listener = (e) => callback(e.detail.frame_buffer, e.detail.frame_meta);
26:         this.addEventListener(eventName, listener);
27:         // Trả về hàm cleanup chính nó để dễ dàng unsubscribe trong useEffect
28:         return () => this.removeEventListener(eventName, listener);
29:     }
30: }
31: 
32: const frameEventBus = new FrameEventBus();
33: export default frameEventBus;
</file>

<file path="controller/src/services/index.js">
 1: // index.js — the ONE place that decides mock vs real socket.
 2: //
 3: // Both classes share the exact same API shape (onOpen / onMessage / onBinary /
 4: // onClose / onError / connect / close / send), so the rest of the app never
 5: // needs to know which one it is using. UseAgentSocket imports AgentSocket from
 6: // here — swapping backend is a single env flag, no code change.
 7: //
 8: //   VITE_USE_MOCK = "true"  → use MockSocket (default for local dev)
 9: //   VITE_USE_MOCK = "false" → use the real Socket (talk to the Gateway)
10: //
11: // Default is mock when the flag is missing, so `npm run dev` works out of the box.
12: 
13: import MockSocket from './MockSocket'
14: import Socket     from './Socket'
15: 
16: // Read the env flag; treat anything other than the string "false" as mock.
17: const USE_MOCK = import.meta.env.VITE_USE_MOCK !== 'false'
18: 
19: // The single socket class the whole app uses. Same shape either way.
20: const AgentSocket = USE_MOCK ? MockSocket : Socket
21: 
22: export default AgentSocket
</file>

