   1: // MockSocket.js — simulates the Gateway + Agent for local development.
   2: // Has the SAME API shape as Socket.js (real WebSocket wrapper) so swapping
   3: // them only requires changing one import line — no component changes needed.
   4: // All response formats follow docs/protocol/*.json exactly.
   5: // No external dependencies.
   6: 
   7: // ─── Timing constants ─────────────────────────────────────────────────────────
   8: 
   9: const CONNECT_DELAY_MS = 300;   // time before the mock connection "opens"
  10: const REPLY_MIN_MS     = 400;   // minimum wait before a mock reply
  11: const REPLY_MAX_MS     = 800;   // maximum wait before a mock reply
  12: const STAGGER_MS       = 80;    // extra delay between each agent's reply
  13: 
  14: // ─── Keylog stream defaults ───────────────────────────────────────────────────
  15: 
  16: const KEYLOG_INTERVAL_MS = 1500   // ms between each fake keystroke batch
  17: const KEYLOG_BATCH_MIN   = 2      // minimum events per batch
  18: const KEYLOG_BATCH_MAX   = 5      // maximum events per batch
  19: 
  20: // Pool of key event templates sampled at random to build each fake batch.
  21: // { key, ctrl, alt, shift } — timestamp_ms is stamped at emit time.
  22: const FAKE_KEY_POOL =
  23: [
  24:     { key: 'h',         ctrl: false, alt: false, shift: false },
  25:     { key: 'e',         ctrl: false, alt: false, shift: false },
  26:     { key: 'l',         ctrl: false, alt: false, shift: false },
  27:     { key: 'o',         ctrl: false, alt: false, shift: false },
  28:     { key: ' ',         ctrl: false, alt: false, shift: false },
  29:     { key: 'w',         ctrl: false, alt: false, shift: false },
  30:     { key: 'r',         ctrl: false, alt: false, shift: false },
  31:     { key: 'd',         ctrl: false, alt: false, shift: false },
  32:     { key: 'a',         ctrl: false, alt: false, shift: false },
  33:     { key: 't',         ctrl: false, alt: false, shift: false },
  34:     { key: 'i',         ctrl: false, alt: false, shift: false },
  35:     { key: 'n',         ctrl: false, alt: false, shift: false },
  36:     { key: 's',         ctrl: false, alt: false, shift: false },
  37:     { key: 'Enter',     ctrl: false, alt: false, shift: false },
  38:     { key: 'Backspace', ctrl: false, alt: false, shift: false },
  39:     { key: 'C',         ctrl: true,  alt: false, shift: false },   // Ctrl+C
  40:     { key: 'V',         ctrl: true,  alt: false, shift: false },   // Ctrl+V
  41:     { key: 'Z',         ctrl: true,  alt: false, shift: false },   // Ctrl+Z
  42:     { key: 'S',         ctrl: true,  alt: false, shift: false },   // Ctrl+S
  43:     { key: 'Tab',       ctrl: false, alt: true,  shift: false },   // Alt+Tab
  44: ]
  45: 
  46: // Build a small random batch of keystrokes with incrementing timestamps.
  47: function generateFakeKeyBatch()
  48: {
  49:     const count  = randomInt(KEYLOG_BATCH_MIN, KEYLOG_BATCH_MAX)
  50:     const now    = Date.now()
  51:     const batch  = []
  52:     for (let i = 0; i < count; i++)
  53:     {
  54:         const template = FAKE_KEY_POOL[randomInt(0, FAKE_KEY_POOL.length - 1)]
  55:         batch.push({ ...template, timestamp_ms: now + i * 80 })
  56:     }
  57:     return batch
  58: }
