/* =====================================================================
   index.css — global CSS variables, base reset, layout, and utilities
   All component class names live here to avoid scattering CSS files.
   ===================================================================== */

/* ── 1. CSS custom properties (light theme default) ─────────────────── */
:root
{
  /* grayscale scale */
  --gray-0:   #FFFFFF;
  --gray-50:  #F8FAFC;
  --gray-100: #F1F5F9;
  --gray-200: #E2E8F0;
  --gray-300: #CBD5E1;
  --gray-400: #94A3B8;
  --gray-500: #64748B;
  --gray-600: #475569;
  --gray-700: #334155;
  --gray-800: #1E293B;
  --gray-900: #0F172A;

  /* semantic surface tokens */
  --bg:          var(--gray-0);    /* main page background */
  --bg-surface:  var(--gray-50);   /* sidebar, topbar, table rows */
  --bg-elevated: var(--gray-0);    /* cards, modals, inputs */
  --border:      var(--gray-200);  /* default border */
  --text:        var(--gray-800);  /* primary text */
  --text-muted:  var(--gray-500);  /* secondary / placeholder text */

  /* accent — blue */
  --accent:        #3B82F6;
  --accent-hover:  #2563EB;
  --accent-bg:     #DBEAFE;
  --accent-border: #93C5FD;

  /* status colours */
  --success:    #22C55E;
  --success-bg: #DCFCE7;
  --danger:     #EF4444;
  --danger-bg:  #FEE2E2;
  --warning:    #F59E0B;
  --warning-bg: #FEF3C7;

  /* fixed-dark surfaces — never change with theme */
  --surface-feed:      #0F172A;  /* live screen / webcam frame bg */
  --border-feed:       #334155;  /* frame border */
  --text-feed:         #94A3B8;  /* placeholder text inside feed */
  --text-feed-name:    #FFFFFF;  /* agent name on dark feed header — always white */
  --surface-terminal:  #0B1220;  /* keylogger terminal bg */
  --text-terminal:     #4ADE80;  /* keylogger text (green) */
  --text-terminal-dim: #4A5568;  /* dim timestamp on terminal bg */

  /* misc UI tokens */
  --text-on-accent:    #FFFFFF;              /* text sitting on --accent surfaces */
  --shadow-notice:     0 2px 8px rgba(0, 0, 0, 0.35);   /* floating pill shadow */
  --shadow-modal:      0 8px 32px rgba(0, 0, 0, 0.35);  /* modal card drop shadow */

  /* spacing scale — one source of truth so gaps/paddings stay consistent */
  --space-1: 4px;
  --space-2: 8px;
  --space-3: 12px;
  --space-4: 16px;
  --space-5: 20px;
  --space-6: 24px;

  /* corner radius scale */
  --radius-sm: 4px;
  --radius-md: 6px;
  --radius-lg: 8px;

  /* solid alert palette — used by transparency dots, sensitive badges, modal overlays.
     Kept separate from --danger/--warning (which are theme-tinted) because these must
     stay the SAME vivid tone in light and dark theme so operators never miss them. */
  --danger-solid:      #E53935;
  --danger-solid-glow: rgba(229, 57, 53, 0.55);
  --danger-deep:       #C62828;
  --warning-solid:     #F0AD4E;
  --on-danger:         #FFFFFF;
  --on-warning-solid:  #000000;
  --overlay-scrim:     rgba(0, 0, 0, 0.55);

  /* typography */
  --font-sans: system-ui, 'Segoe UI', Roboto, sans-serif;
  --font-mono: ui-monospace, Consolas, monospace;

  font-family: var(--font-sans);
  font-size: 14px;
  line-height: 1.5;
  color: var(--text);
  background: var(--bg);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* ── 2. Dark theme overrides ─────────────────────────────────────────── */
[data-theme="dark"]
{
  --gray-0:   #0F172A;
  --gray-50:  #16181D;
  --gray-100: #1E293B;
  --gray-200: #334155;
  --gray-300: #475569;
  --gray-400: #64748B;
  --gray-500: #94A3B8;
  --gray-800: #F1F5F9;

  --bg:          var(--gray-0);
  --bg-surface:  var(--gray-50);
  --bg-elevated: var(--gray-100);
  --border:      var(--gray-200);
  --text:        var(--gray-800);
  --text-muted:  var(--gray-500);

  --accent:        #60A5FA;
  --accent-hover:  #3B82F6;
  --accent-bg:     rgba(96, 165, 250, 0.16);
  --accent-border: rgba(96, 165, 250, 0.4);

  --success:    #4ADE80;
  --success-bg: rgba(74, 222, 128, 0.14);
  --danger:     #F87171;
  --danger-bg:  rgba(248, 113, 113, 0.16);
  --warning:    #FBBF24;
  --warning-bg: rgba(251, 191, 36, 0.14);

  --shadow-overlay: rgba(0, 0, 0, 0.2);
  --bg-overlay:     rgba(0, 0, 0, 0.4);

  /* surface-feed and surface-terminal stay dark regardless of theme */
}

/* ── 3. Base reset ───────────────────────────────────────────────────── */
*,
*::before,
*::after
{
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body
{
  margin: 0;
  overflow: hidden;   /* the app shell manages its own scroll */
}

#root
{
  width: 100%;
  height: 100vh;
}

button
{
  font-family: inherit;
  font-size: inherit;
  cursor: pointer;
}

input
{
  font-family: inherit;
  font-size: inherit;
}

/* ── 4. App shell — two-column grid ─────────────────────────────────── */
.app-shell
{
  display: grid;
  grid-template-columns: 220px 1fr;
  height: 100vh;
  overflow: hidden;
  background: var(--bg);
  color: var(--text);
}

/* right-panel stacks topbar above the main content */
.right-panel
{
  display: flex;
  flex-direction: column;
  overflow: hidden;
  height: 100vh;
}

/* ── 5. Sidebar ──────────────────────────────────────────────────────── */
.sidebar
{
  background: var(--bg-surface);
  border-right: 1px solid var(--border);
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
}

.sidebar__header
{
  padding: 14px 16px 10px;
  flex-shrink: 0;
}

.sidebar__logo
{
  font-size: 15px;
  font-weight: 700;
  color: var(--text);
  letter-spacing: 0.5px;
}

.sidebar__label
{
  font-size: 11px;
  color: var(--text-muted);
  margin-top: 2px;
}

.sidebar__search-wrap
{
  padding: 0 14px 10px;
  flex-shrink: 0;
}

.sidebar__search-input
{
  width: 100%;
  padding: 7px 10px;
  border: 1px solid var(--border);
  border-radius: 6px;
  background: var(--bg-elevated);
  color: var(--text);
  font-size: 11px;
  outline: none;
  transition: border-color 0.15s, box-shadow 0.15s;
}

.sidebar__search-input::placeholder
{
  color: var(--text-muted);
}

.sidebar__search-input:focus
{
  border-color: var(--accent);
  box-shadow: 0 0 0 2px var(--accent-border);
}

.sidebar__agent-list
{
  flex: 1;
  overflow-y: auto;
  padding: 0 14px 8px;
}

/* thin scrollbar inside sidebar */
.sidebar__agent-list::-webkit-scrollbar        { width: 4px; }
.sidebar__agent-list::-webkit-scrollbar-track  { background: transparent; }
.sidebar__agent-list::-webkit-scrollbar-thumb  { background: var(--border); border-radius: 2px; }

.sidebar__footer
{
  padding: 10px 16px;
  border-top: 1px solid var(--border);
  display: flex;
  align-items: center;
  gap: 8px;
  flex-shrink: 0;
}

.sidebar__footer-text
{
  font-size: 10px;
  color: var(--text-muted);
}

/* ── 6. Agent card (sidebar) ─────────────────────────────────────────── */
.agent-card
{
  background: var(--bg-elevated);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 8px 10px 8px 10px;
  margin-bottom: 8px;
  cursor: pointer;
  position: relative;
  transition: border-color 0.15s, background 0.15s;
}

.agent-card:hover
{
  border-color: var(--accent-border);
}

.agent-card--active
{
  background: var(--accent-bg);
  border-color: var(--accent);
}

.agent-card__row
{
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 3px;
}

.agent-card__name
{
  font-size: 12px;
  font-weight: 600;
  color: var(--text);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.agent-card__info
{
  font-size: 9px;
  color: var(--text-muted);
  padding-left: 18px;   /* indent to align under name (past the dot) */
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ── 7. Status dot (shared) ──────────────────────────────────────────── */
.status-dot
{
  width: 10px;
  height: 10px;
  border-radius: 50%;
  flex-shrink: 0;
  display: inline-block;
}

.status-dot--online   { background: var(--success); }
.status-dot--offline  { background: var(--gray-400); }
.status-dot--session  { background: var(--danger); }

/* small dot variant used inside grid thumbnails */
.status-dot--sm
{
  width: 8px;
  height: 8px;
}

/* ── 8. Session badge (shared) ───────────────────────────────────────── */
.session-badge
{
  font-size: 8px;
  font-weight: 700;
  padding: 2px 6px;
  border-radius: 4px;
  background: var(--danger-bg);
  color: var(--danger);
  border: 1px solid var(--danger);
  white-space: nowrap;
  letter-spacing: 0.3px;
}

/* active-session indicator inside TopBar (larger) */
.session-badge--topbar
{
  font-size: 10px;
  padding: 4px 10px;
  border-radius: 6px;
}

/* ── 9. TopBar ───────────────────────────────────────────────────────── */
.topbar
{
  height: 60px;
  min-height: 60px;
  background: var(--bg-elevated);
  border-bottom: 1px solid var(--border);
  display: flex;
  align-items: center;
  padding: 0 20px;
  gap: 12px;
  flex-shrink: 0;
}

.topbar__title
{
  font-size: 16px;
  font-weight: 700;
  color: var(--text);
  flex: 1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.topbar__connection
{
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 11px;
  color: var(--text-muted);
  white-space: nowrap;
}

.topbar__btn
{
  padding: 6px 14px;
  border: 1px solid var(--border);
  border-radius: 6px;
  background: var(--bg-elevated);
  color: var(--text);
  font-size: 10px;
  white-space: nowrap;
  transition: border-color 0.15s;
}

.topbar__btn:hover
{
  border-color: var(--accent-border);
  color: var(--accent);
}

/* ── 10. Main area ───────────────────────────────────────────────────── */
.main-area
{
  flex: 1;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

/* ── 11. Grid view ───────────────────────────────────────────────────── */
.grid-view
{
  flex: 1;
  overflow-y: auto;
  padding: 20px;
}

.grid-view__subtitle
{
  font-size: 11px;
  color: var(--text-muted);
  margin-bottom: 16px;
}

.grid-view__grid
{
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
  gap: 16px;
}

.grid-view__empty
{
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 320px;
  gap: 12px;
  color: var(--text-muted);
  font-size: 13px;
}

/* ── 12. Agent thumbnail (grid tile) ─────────────────────────────────── */
.agent-thumbnail
{
  background: var(--surface-feed);
  border: 1px solid var(--border-feed);
  border-radius: 8px;
  overflow: hidden;
  cursor: pointer;
  transition: border-color 0.15s, box-shadow 0.15s;
}

.agent-thumbnail:hover
{
  border-color: var(--accent);
  box-shadow: 0 0 0 2px var(--accent-border);
}

.agent-thumbnail__header
{
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 10px 12px;
}

.agent-thumbnail__name
{
  font-size: 11px;
  font-weight: 700;
  color: var(--text-feed-name);
  flex: 1;
}

.agent-thumbnail__feed
{
  height: 200px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.agent-thumbnail__placeholder
{
  font-size: 10px;
  color: var(--text-feed);
  letter-spacing: 0.5px;
}

/* ── 13. Focus view ──────────────────────────────────────────────────── */
.focus-view
{
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* Tab bar — 7 equal tabs spanning full width */
.focus-view__tabs
{
  display: flex;
  border-bottom: 1px solid var(--border);
  flex-shrink: 0;
  background: var(--bg-elevated);
}

.focus-view__tab
{
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 12px 6px;
  border: none;
  border-bottom: 2px solid transparent;
  background: transparent;
  color: var(--text-muted);
  font-size: 12px;
  font-weight: 500;
  cursor: pointer;
  transition: color 0.15s, border-bottom-color 0.15s, background 0.15s;
  white-space: nowrap;
}

.focus-view__tab:hover
{
  color: var(--accent);
  background: var(--accent-bg);
}

.focus-view__tab--active
{
  color: var(--accent);
  border-bottom-color: var(--accent);
  background: var(--accent-bg);
  font-weight: 700;
}

/* Scrollable module content panel */
.focus-view__panel
{
  flex: 1;
  overflow: auto;
}

/* prompt shown when no agent is selected in focus mode */
.focus-view__no-agent
{
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  gap: 10px;
  color: var(--text-muted);
  font-size: 13px;
}

/* ── 14. Module placeholder ──────────────────────────────────────────── */
.module-placeholder
{
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  min-height: 300px;
  gap: 12px;
  color: var(--text-muted);
}

.module-placeholder__label
{
  font-size: 13px;
}

/* ── 15. Utility classes ─────────────────────────────────────────────── */

/* Generic spinner — rotates any icon it is applied to (e.g. Loader2). */
.spin
{
  animation: file-tab-spin 0.9s linear infinite;
}

.visually-hidden
{
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
}

/* ── 16. Agent list empty state ─────────────────────────────────────── */
.agent-list__empty
{
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  padding: 24px 0;
  color: var(--text-muted);
  font-size: 11px;
}

/* ── 17. Multi-select bar (above agent list in sidebar) ──────────────── */
.multi-select-bar
{
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 4px 2px 8px;
  margin-bottom: 2px;
}

.multi-select-bar__label
{
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 10px;
  color: var(--text-muted);
  cursor: pointer;
  user-select: none;
}

/* the "select all" checkbox inside the label */
.multi-select-bar__checkbox
{
  width: 13px;
  height: 13px;
  accent-color: var(--accent);   /* tints the native checkbox in modern browsers */
  cursor: pointer;
}

.multi-select-bar__clear
{
  font-size: 10px;
  padding: 2px 8px;
  border: 1px solid var(--border);
  border-radius: 4px;
  background: transparent;
  color: var(--text-muted);
  cursor: pointer;
  transition: border-color 0.15s, color 0.15s;
}

.multi-select-bar__clear:hover
{
  border-color: var(--danger);
  color: var(--danger);
}

/* ── 18. AgentCard checkbox + selected state ─────────────────────────── */

/* highlighted border when the agent is checked in multi-select */
.agent-card--selected
{
  border-color: var(--accent-border);
  background: var(--accent-bg);
}

/* the per-row checkbox inside each AgentCard */
.agent-card__checkbox
{
  width: 13px;
  height: 13px;
  flex-shrink: 0;
  accent-color: var(--accent);
  cursor: pointer;
}

/* ── 20. Module data table — ApplicationTab and ProcessTab ──────────────── */

/*
 * .module-table wraps the whole tab content area.
 * .module-table__scroll is the actual overflow container so sticky
 * <thead> cells work correctly (they stick to the scroll viewport).
 */
.module-table
{
  display: flex;
  flex-direction: column;
  height: 100%;
  padding: 16px 20px;
  gap: 12px;
  box-sizing: border-box;
}

.module-table__toolbar
{
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
}

.module-table__title
{
  font-size: 14px;
  font-weight: 700;
  color: var(--text);
}

/* pulsing "● Live" indicator shown while auto-polling is active */
.module-table__poll-badge
{
  font-size: 10px;
  font-weight: 600;
  padding: 2px 8px;
  border-radius: 4px;
  background: var(--success-bg);
  color: var(--success);
  letter-spacing: 0.3px;
}

/* scrollable container — sticky <th> sticks to the top of this element */
.module-table__scroll
{
  flex: 1;
  overflow: auto;
  border: 1px solid var(--border);
  border-radius: 8px;
  background: var(--bg-elevated);
  min-height: 0;    /* allow flex children to shrink below intrinsic size */
}

.module-table table
{
  width: 100%;
  border-collapse: collapse;
  font-size: 12px;
}

.module-table__th
{
  position: sticky;
  top: 0;
  z-index: 1;
  background: var(--bg-surface);
  color: var(--text-muted);
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.3px;
  text-align: left;
  padding: 9px 12px;
  border-bottom: 1px solid var(--border);
  white-space: nowrap;
  user-select: none;
}

/* numeric and action columns — right-aligned headers */
.module-table__th--num    { text-align: right; }
.module-table__th--action { text-align: right; }

/* sortable header — shows pointer cursor, highlights on hover */
.module-table__th--sortable
{
  cursor: pointer;
  transition: color 0.15s, background 0.15s;
}

.module-table__th--sortable:hover
{
  color: var(--accent);
  background: var(--accent-bg);
}

/* currently active sort column */
.module-table__th--active { color: var(--accent); }

/* flex wrapper inside a <th> to place label and sort icon side by side */
.module-table__th-inner
{
  display: flex;
  align-items: center;
  gap: 4px;
}

/* right-align inner content for numeric / action header cells */
.module-table__th--num .module-table__th-inner,
.module-table__th--action .module-table__th-inner
{
  justify-content: flex-end;
}

.module-table__row
{
  border-bottom: 1px solid var(--border);
  transition: background 0.1s;
}

.module-table__row:last-child { border-bottom: none; }

.module-table__row:hover { background: var(--accent-bg); }

.module-table__td
{
  padding: 8px 12px;
  color: var(--text);
  font-size: 12px;
  vertical-align: middle;
}

/* name column — bold, truncated if too long */
.module-table__td--name
{
  font-weight: 500;
  max-width: 200px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* numeric columns — right-aligned, tabular figures */
.module-table__td--num
{
  text-align: right;
  font-variant-numeric: tabular-nums;
  color: var(--text-muted);
}

/* action column — right-aligned, no text wrap */
.module-table__td--action
{
  text-align: right;
  white-space: nowrap;
}

/* status badge in the Status column (ApplicationTab) */
.module-table__badge
{
  display: inline-block;
  font-size: 10px;
  font-weight: 600;
  padding: 2px 8px;
  border-radius: 4px;
  letter-spacing: 0.3px;
  white-space: nowrap;
  text-transform: capitalize;
}

.module-table__badge--running
{
  background: var(--success-bg);
  color: var(--success);
}

.module-table__badge--stopped
{
  background: var(--bg-surface);
  color: var(--text-muted);
  border: 1px solid var(--border);
}

/* shown when the data list is empty or still loading */
.module-table__empty
{
  padding: 40px 24px;
  text-align: center;
  color: var(--text-muted);
  font-size: 12px;
}

/* ── 21. Action buttons — Start / Stop / Kill inside table rows ──────────── */

.action-btn
{
  font-size: 11px;
  font-weight: 600;
  padding: 4px 12px;
  border-radius: 5px;
  border: 1px solid transparent;
  cursor: pointer;
  white-space: nowrap;
  transition: background 0.15s, color 0.15s, opacity 0.15s;
}

.action-btn:disabled
{
  opacity: 0.35;
  cursor: not-allowed;
}

/* Start — green */
.action-btn--start
{
  background: var(--success-bg);
  color: var(--success);
  border-color: var(--success);
}

.action-btn--start:not(:disabled):hover
{
  background: var(--success);
  color: var(--gray-0);
}

/* Stop — amber */
.action-btn--stop
{
  background: var(--warning-bg);
  color: var(--warning);
  border-color: var(--warning);
}

.action-btn--stop:not(:disabled):hover
{
  background: var(--warning);
  color: var(--gray-0);
}

/* Kill — red */
.action-btn--kill
{
  background: var(--danger-bg);
  color: var(--danger);
  border-color: var(--danger);
}

.action-btn--kill:not(:disabled):hover
{
  background: var(--danger);
  color: var(--gray-0);
}

/* ── 22. ScreenTab — screenshot + live stream panel ────────────────────── */

.screen-tab
{
  display: flex;
  flex-direction: column;
  height: 100%;
  padding: 16px 20px;
  gap: 10px;
  box-sizing: border-box;
}

.screen-tab__toolbar
{
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
}

.screen-tab__title
{
  font-size: 14px;
  font-weight: 700;
  color: var(--text);
}

.screen-tab__actions
{
  display: flex;
  gap: 8px;
}

.screen-tab__btn
{
  display: flex;
  align-items: center;
  gap: 5px;
  font-size: 11px;
  font-weight: 600;
  padding: 6px 14px;
  border-radius: 6px;
  border: 1px solid transparent;
  cursor: pointer;
  white-space: nowrap;
  transition: background 0.15s, color 0.15s, opacity 0.15s;
}

.screen-tab__btn:disabled
{
  opacity: 0.35;
  cursor: not-allowed;
}

.screen-tab__btn--primary
{
  background: var(--accent);
  color: var(--gray-0);
}

.screen-tab__btn--primary:not(:disabled):hover
{
  background: var(--accent-hover);
}

.screen-tab__btn--secondary
{
  background: var(--bg-surface);
  color: var(--text);
  border-color: var(--border);
}

.screen-tab__btn--secondary:not(:disabled):hover
{
  border-color: var(--accent);
  color: var(--accent);
}

.screen-tab__btn--danger
{
  background: var(--danger-bg);
  color: var(--danger);
  border-color: var(--danger);
}

.screen-tab__btn--danger:not(:disabled):hover
{
  background: var(--danger);
  color: var(--gray-0);
}

.screen-tab__status
{
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 11px;
  color: var(--text-muted);
  flex-shrink: 0;
}

.screen-tab__live-badge
{
  font-size: 10px;
  font-weight: 700;
  padding: 2px 8px;
  border-radius: 4px;
  background: var(--danger-bg);
  color: var(--danger);
  letter-spacing: 0.3px;
  animation: pulse-badge 1.5s ease-in-out infinite;
}

@keyframes pulse-badge
{
  0%, 100% { opacity: 1; }
  50%      { opacity: 0.5; }
}

.screen-tab__resolution
{
  font-variant-numeric: tabular-nums;
}

/* Canvas wrapper fills remaining vertical space with dark background */
.screen-tab__canvas-wrapper
{
  flex: 1;
  min-height: 0;
  background: var(--surface-feed);
  border: 1px solid var(--border-feed);
  border-radius: 8px;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.screen-tab__placeholder
{
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
  color: var(--text-feed);
  font-size: 12px;
  text-align: center;
  padding: 20px;
}

/* ── 19. Toast notifications ────────────────────────────────────────── */
.toast-container
{
  position: fixed;
  bottom: 20px;
  right: 20px;
  z-index: 900;
  display: flex;
  flex-direction: column;
  gap: 8px;
  pointer-events: none;
}

.toast
{
  pointer-events: auto;
  padding: 10px 16px;
  border-radius: 6px;
  font-size: 13px;
  font-weight: 500;
  color: var(--gray-0);
  cursor: pointer;
  box-shadow: 0 4px 12px var(--shadow-overlay);
  animation: toast-slide-in 0.25s ease-out;
}

.toast--success { background: var(--success); color: var(--gray-900); }
.toast--error   { background: var(--danger);  }
.toast--info    { background: var(--accent);  color: var(--gray-900); }

@keyframes toast-slide-in
{
  from { opacity: 0; transform: translateY(12px); }
  to   { opacity: 1; transform: translateY(0);    }
}

/* ── 19b. action-btn--neutral (Clear / Export style) ─────────────────── */
.action-btn--neutral
{
  background   : var(--bg-elevated);
  color        : var(--text-muted);
  border-color : var(--border);
}

.action-btn--neutral:not(:disabled):hover
{
  background   : var(--bg-surface);
  color        : var(--text);
  border-color : var(--gray-400);
}

/* ── 19c. Keylog tab ──────────────────────────────────────────────────── */
.keylog-tab
{
  display        : flex;
  flex-direction : column;
  height         : 100%;
  overflow       : hidden;
  position       : relative;   /* anchor for .keylog-tab__scroll-notice */
  background     : var(--bg-surface);
}

.keylog-tab__toolbar
{
  display         : flex;
  align-items     : center;
  justify-content : space-between;
  gap             : 10px;
  padding         : 10px 14px;
  border-bottom   : 1px solid var(--border);
  flex-shrink     : 0;
}

.keylog-tab__title-group
{
  display     : flex;
  align-items : center;
  gap         : 10px;
}

.keylog-tab__title
{
  font-weight : 600;
  font-size   : 13px;
  color       : var(--text);
}

/* Consent indicator badge — always visible so observers can see module state */
.keylog-tab__indicator
{
  display        : inline-flex;
  align-items    : center;
  gap            : 5px;
  font-size      : 11px;
  font-weight    : 700;
  letter-spacing : 0.05em;
  padding        : 2px 8px;
  border-radius  : 99px;
  background     : var(--bg-elevated);
  border         : 1px solid var(--border);
  color          : var(--text-muted);
  transition     : color 0.2s, background 0.2s, border-color 0.2s;
}

.keylog-tab__indicator--live
{
  background   : var(--danger-bg);
  border-color : var(--danger);
  color        : var(--danger);
  animation    : keylog-pulse 1.4s ease-in-out infinite;
}

@keyframes keylog-pulse
{
  0%, 100% { opacity: 1;   }
  50%      { opacity: 0.55; }
}

.keylog-tab__actions
{
  display     : flex;
  align-items : center;
  gap         : 6px;
}

/* Dark terminal area — matches --surface-terminal and --text-terminal tokens */
.keylog-tab__log
{
  flex        : 1;
  overflow-y  : auto;
  background  : var(--surface-terminal);
  font-family : var(--font-mono);
  font-size   : 12px;
  padding     : 10px 14px;
}

/* Empty state shown before any events arrive */
.keylog-tab__empty
{
  display         : flex;
  flex-direction  : column;
  align-items     : center;
  justify-content : center;
  gap             : 12px;
  height          : 100%;
  min-height      : 160px;
  color           : var(--text-feed);
  font-family     : var(--font-sans);
  font-size       : 13px;
}

/* One event row: timestamp on the left, key combo on the right */
.keylog-tab__row
{
  display     : flex;
  gap         : 16px;
  padding     : 1px 0;
  line-height : 1.65;
  color       : var(--text-terminal);
}

.keylog-tab__time
{
  flex-shrink : 0;
  width       : 72px;
  color       : var(--text-terminal-dim);   /* dimmer than key text so timestamps recede */
}

.keylog-tab__key { word-break: break-all; }

/* Pill shown when user scrolled up; click jumps back to the latest entry */
.keylog-tab__scroll-notice
{
  position      : absolute;
  bottom        : 14px;
  left          : 50%;
  transform     : translateX(-50%);
  background    : var(--accent);
  color         : var(--text-on-accent);
  font-size     : 11px;
  font-weight   : 600;
  padding       : 4px 14px;
  border-radius : 99px;
  border        : none;
  cursor        : pointer;
  box-shadow    : var(--shadow-notice);
  white-space   : nowrap;
  z-index       : 10;
  transition    : opacity 0.15s;
}

.keylog-tab__scroll-notice:hover { opacity: 0.85; }

/* ── 19d. File tab ────────────────────────────────────────────────────── */
.file-tab
{
  display        : flex;
  flex-direction : column;
  height         : 100%;
  overflow       : hidden;
  background     : var(--bg-surface);
}

.file-tab__toolbar
{
  display         : flex;
  align-items     : center;
  gap             : 10px;
  padding         : 10px 14px;
  border-bottom   : 1px solid var(--border);
  flex-shrink     : 0;
}

.file-tab__title
{
  font-weight  : 600;
  font-size    : 13px;
  color        : var(--text);
  margin-right : auto;   /* push sandbox badge + button to the right */
}

/* Small "sandbox only" pill — reminds operators that path access is restricted */
.file-tab__sandbox-badge
{
  display        : inline-flex;
  align-items    : center;
  gap            : 4px;
  font-size      : 10px;
  font-weight    : 600;
  letter-spacing : 0.04em;
  padding        : 2px 8px;
  border-radius  : 99px;
  background     : var(--warning-bg);
  border         : 1px solid var(--warning);
  color          : var(--warning);
}

/* Scrollable tree area */
.file-tab__tree
{
  flex       : 1;
  overflow-y : auto;
  padding    : 6px 0;
}

/* Empty / loading state (centered content) */
.file-tab__empty
{
  display         : flex;
  flex-direction  : column;
  align-items     : center;
  justify-content : center;
  gap             : 10px;
  height          : 100%;
  min-height      : 140px;
  color           : var(--text-muted);
  font-size       : 13px;
}

/* Shared row base — both dirs and files */
.file-tab__row
{
  display     : flex;
  align-items : center;
  gap         : 6px;
  width       : 100%;
  min-height  : 30px;
  padding-top    : 2px;
  padding-bottom : 2px;
  padding-right  : 10px;
  font-size   : 13px;
  line-height : 1.4;
  border      : none;
  background  : none;
  text-align  : left;
  cursor      : default;
  color       : var(--text);
}

.file-tab__row--dir
{
  cursor      : pointer;
  font-weight : 500;
  color       : var(--text);
}

.file-tab__row--dir:hover { background: var(--accent-bg); }

.file-tab__row--file:hover { background: var(--bg-elevated); }

/* Leading icon — folder or file */
.file-tab__icon        { flex-shrink: 0; color: var(--accent);     }
.file-tab__icon--file  { color: var(--text-muted);                  }

/* Entry name — fills available space and truncates if too long */
.file-tab__name
{
  flex     : 1;
  overflow : hidden;
  white-space   : nowrap;
  text-overflow : ellipsis;
}

/* File size — muted, right of the name */
.file-tab__size
{
  flex-shrink : 0;
  font-size   : 11px;
  color       : var(--text-muted);
  min-width   : 52px;
  text-align  : right;
}

/* Expand/collapse chevron on dir rows */
.file-tab__chevron { flex-shrink: 0; color: var(--text-muted); }

/* Compact download button on file rows */
.file-tab__dl-btn
{
  flex-shrink  : 0;
  padding      : 3px 8px;
  font-size    : 11px;
  display      : flex;
  align-items  : center;
  gap          : 4px;
}

/* Spinning loader animation — used by Loader2 icon */
.file-tab__spin
{
  flex-shrink : 0;
  animation   : file-tab-spin 0.9s linear infinite;
  color       : var(--accent);
}

@keyframes file-tab-spin
{
  from { transform: rotate(0deg);   }
  to   { transform: rotate(360deg); }
}

/* ── 19e. File tab — upload drop zone ─────────────────────────────────── */

.file-tab__drop-zone
{
  display         : flex;
  align-items     : center;
  justify-content : center;
  gap             : 8px;
  flex-shrink     : 0;
  margin          : 10px 14px 0;
  padding         : 14px;
  border          : 1px dashed var(--border);
  border-radius   : 8px;
  color           : var(--text-muted);
  font-size       : 12px;
  cursor          : pointer;
  background      : var(--bg-elevated);
  transition      : border-color 0.15s, background 0.15s, color 0.15s;
}

.file-tab__drop-zone:hover { border-color: var(--accent); color: var(--text); }

.file-tab__drop-zone--over
{
  border-color : var(--accent);
  background   : var(--accent-bg);
  color        : var(--accent);
}

.file-tab__drop-icon { flex-shrink: 0; }

.file-tab__drop-label code
{
  font-size  : 11px;
  padding    : 1px 5px;
  border-radius : 4px;
  background : var(--bg-surface);
}

/* ── 19f. File tab — upload progress list ─────────────────────────────── */

.file-tab__upload-list
{
  flex-shrink    : 0;
  max-height     : 180px;
  overflow-y     : auto;
  margin         : 10px 14px 0;
  padding        : 8px 10px;
  border         : 1px solid var(--border);
  border-radius  : 8px;
  background     : var(--bg-elevated);
  display        : flex;
  flex-direction : column;
  gap            : 8px;
}

.file-tab__upload-list-header
{
  display         : flex;
  align-items     : center;
  justify-content : space-between;
}

.file-tab__upload-list-title
{
  font-size      : 11px;
  font-weight    : 600;
  letter-spacing : 0.04em;
  text-transform : uppercase;
  color          : var(--text-muted);
}

.file-tab__clear-done
{
  padding     : 2px 7px;
  font-size   : 10px;
  display     : flex;
  align-items : center;
  gap         : 3px;
}

.file-tab__upload-job
{
  display        : flex;
  flex-direction : column;
  gap            : 4px;
}

.file-tab__upload-info
{
  display     : flex;
  align-items : center;
  gap         : 6px;
  font-size   : 12px;
}

.file-tab__upload-icon              { flex-shrink: 0; color: var(--accent);  }
.file-tab__upload-icon--done        { color: var(--success);                }
.file-tab__upload-icon--error       { color: var(--danger);                 }

/* File name — fills available space and truncates if too long */
.file-tab__upload-name
{
  flex          : 1;
  overflow      : hidden;
  white-space   : nowrap;
  text-overflow : ellipsis;
  color         : var(--text);
}

.file-tab__upload-pct
{
  flex-shrink : 0;
  font-size   : 11px;
  font-weight : 600;
  min-width   : 34px;
  text-align  : right;
  color       : var(--text-muted);
}

.file-tab__upload-pct--done  { color: var(--success); }
.file-tab__upload-pct--error { color: var(--danger);  }

.file-tab__upload-size
{
  flex-shrink : 0;
  font-size   : 11px;
  color       : var(--text-muted);
  min-width   : 48px;
  text-align  : right;
}

/* Progress bar track + animated fill */
.file-tab__progress-track
{
  width         : 100%;
  height        : 5px;
  border-radius : 99px;
  background    : var(--bg-surface);
  overflow      : hidden;
}

.file-tab__progress-fill
{
  height        : 100%;
  border-radius : 99px;
  background    : var(--accent);
  transition    : width 0.2s ease-out;
}

.file-tab__progress-fill--done  { background: var(--success); }
.file-tab__progress-fill--error { background: var(--danger);  }

.file-tab__upload-error
{
  font-size : 11px;
  color     : var(--danger);
}

/* ── 23. Shared transparency dot ─────────────────────────────────────── */
/* One reusable red pulsing dot for "sensitive module active". Used by
   AgentCard next to the online dot. Stays the same vivid tone in both
   themes because it references the solid alert tokens, not the tinted ones. */
.transparency-dot
{
  display       : inline-block;
  width         : 8px;
  height        : 8px;
  border-radius : 50%;
  flex-shrink   : 0;
  background    : var(--danger-solid);
  box-shadow    : 0 0 6px 2px var(--danger-solid-glow);
  animation     : keylog-pulse 1.4s ease-in-out infinite;
}

/* ── 24. Offline agent card + offline badge ──────────────────────────── */
/* Dim the whole card so offline machines visibly recede in the list. */
.agent-card--offline
{
  opacity : 0.55;
}

.agent-card--offline .agent-card__name
{
  color : var(--text-muted);
}

/* Small gray "OFFLINE" pill — a text label so state is clear beyond the dot. */
.agent-card__offline-badge
{
  font-size      : 8px;
  font-weight    : 700;
  padding        : 2px 6px;
  border-radius  : var(--radius-sm);
  background     : var(--bg-surface);
  color          : var(--text-muted);
  border         : 1px solid var(--border);
  white-space    : nowrap;
  letter-spacing : 0.3px;
}

/* ── 25. Connection banner (shown while not connected) ───────────────── */
/* Full-width strip above the TopBar. Warning tone while reconnecting,
   danger tone once the socket is closed. Hidden when the socket is open. */
.conn-banner
{
  display         : flex;
  align-items     : center;
  justify-content : center;
  gap             : var(--space-2);
  padding         : var(--space-2) var(--space-4);
  font-size       : 12px;
  font-weight     : 600;
  flex-shrink     : 0;
}

.conn-banner--warning
{
  background    : var(--warning-bg);
  color         : var(--warning);
  border-bottom : 1px solid var(--warning);
}

.conn-banner--danger
{
  background    : var(--danger-bg);
  color         : var(--danger);
  border-bottom : 1px solid var(--danger);
}

/* ── 26. Webcam consent badges (ScreenTab status bar) ────────────────── */
/* Solid alert tones so the "camera is broadcasting" state is unmissable
   and identical in both themes. Replaces old inline styles in WebcamTab. */
.screen-tab__consent-badge
{
  display        : inline-flex;
  align-items    : center;
  gap            : 4px;
  font-size      : 10px;
  font-weight    : 700;
  padding        : 2px 8px;
  border-radius  : var(--radius-sm);
  letter-spacing : 0.3px;
}

.screen-tab__consent-badge--on
{
  background : var(--danger-deep);
  color      : var(--on-danger);
}

.screen-tab__consent-badge--waiting
{
  background : var(--warning-solid);
  color      : var(--on-warning-solid);
}

/* ── 27. PowerTab action grid + countdown modal ──────────────────────── */
/* Moved out of inline styles so spacing/colour follow the token scale. */
.power-tab__grid
{
  display               : grid;
  grid-template-columns : repeat(auto-fit, minmax(180px, 1fr));
  gap                   : var(--space-3);
  padding               : var(--space-4);
}

/* Bigger, centered variant of screen-tab__btn for the power action grid. */
.power-tab__btn
{
  padding         : var(--space-4);
  justify-content : center;
}

.power-modal__overlay
{
  position        : fixed;
  inset           : 0;
  background      : var(--overlay-scrim);
  display         : flex;
  align-items     : center;
  justify-content : center;
  z-index         : 1000;
}

.power-modal__card
{
  background    : var(--bg-elevated);
  color         : var(--text);
  border-radius : var(--radius-lg);
  padding       : var(--space-5) var(--space-6);
  min-width     : 340px;
  max-width     : 420px;
  box-shadow    : var(--shadow-modal);
}

.power-modal__title
{
  font-size     : 16px;
  font-weight   : 600;
  margin-bottom : var(--space-2);
}

.power-modal__msg
{
  font-size     : 13px;
  color         : var(--text-muted);
  margin-bottom : var(--space-4);
}

/* Big countdown number — turns danger-red in the final seconds. */
.power-modal__count
{
  font-size            : 48px;
  font-weight          : 700;
  text-align           : center;
  margin-bottom        : var(--space-4);
  font-variant-numeric : tabular-nums;
  color                : var(--text);
}

.power-modal__count--urgent
{
  color : var(--danger-deep);
}

.power-modal__actions
{
  display         : flex;
  justify-content : flex-end;
  gap             : var(--space-2);
}

/* ── 28. Module offline / disconnected state (shared) ────────────────── */
/* Reuses the same centered layout as other empty states. Used by
   ScreenTab / WebcamTab / PowerTab when the agent is offline. */
.module-offline
{
  display         : flex;
  flex-direction  : column;
  align-items     : center;
  justify-content : center;
  gap             : var(--space-3);
  height          : 100%;
  min-height      : 200px;
  color           : var(--text-muted);
  font-size       : 13px;
  text-align      : center;
  padding         : var(--space-5);
}

/* ── 20. Responsive — collapse sidebar on narrow screens ─────────────── */
@media (max-width: 768px)
{
  .app-shell
  {
    grid-template-columns: 1fr;
  }

  .sidebar
  {
    display: none;
    position: fixed;
    inset: 0 auto 0 0;
    z-index: 200;
    width: 220px;
    box-shadow: 2px 0 12px var(--shadow-overlay);
  }

  /* shown when UiStore.sidebar_open is true */
  .sidebar--open
  {
    display: flex;
  }

  /* overlay behind open sidebar */
  .sidebar-overlay
  {
    position: fixed;
    inset: 0;
    background: var(--bg-overlay);
    z-index: 199;
  }
}

/* ── 30. PermissionGate — consent wrapper shared by every module tab ─────── */

.permission-gate
{
  display: flex;
  flex-direction: column;
  height: 100%;
  min-height: 0;
}

/* consent bar sitting above the module command area */
.permission-gate__bar
{
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding: 8px 12px;
  border-bottom: 1px solid var(--border);
  background: var(--bg-surface);
}

/* status badge — icon + feature name + short status text */
.permission-gate__badge
{
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 12px;
  font-weight: 600;
  color: var(--text-muted);
}

.permission-gate__feature
{
  text-transform: uppercase;
  letter-spacing: 0.04em;
  color: var(--text);
}

.permission-gate__status
{
  font-weight: 500;
  color: var(--text-muted);
}

/* colour the badge per status (borrow the semantic vars) */
.permission-gate__badge--granted    { color: var(--success); }
.permission-gate__badge--denied     { color: var(--danger);  }
.permission-gate__badge--requesting { color: var(--warning); }

.permission-gate__actions
{
  display: flex;
  gap: 8px;
}

/* module command area — fieldset resets so it looks like a plain container */
.permission-gate__body
{
  flex: 1;
  min-height: 0;
  margin: 0;
  padding: 0;
  border: 0;
  display: flex;
  flex-direction: column;
}

/* dim the whole command area while consent is not granted */
.permission-gate__body:disabled
{
  opacity: 0.55;
}

/* spinner shown on the Connect button while a request is pending */
.permission-gate__spin
{
  animation: permission-gate-spin 0.9s linear infinite;
}

@keyframes permission-gate-spin
{
  to { transform: rotate(360deg); }
}

/* ── 31. LoginScreen — admin sign-in gate ───────────────────────────────── */

.login-screen
{
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 24px;
  background: var(--bg);
  box-sizing: border-box;
}

.login-card
{
  display: flex;
  flex-direction: column;
  gap: 14px;
  width: 100%;
  max-width: 360px;
  padding: 28px;
  background: var(--bg-elevated);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-modal);
}

.login-card__header
{
  display: flex;
  align-items: center;
  gap: 10px;
  color: var(--accent);
}

.login-card__title
{
  font-size: 18px;
  font-weight: 600;
  margin: 0;
  color: var(--text);
}

.login-card__hint
{
  font-size: 13px;
  color: var(--text-muted);
  margin: 0;
}

.login-card__field
{
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.login-card__label
{
  font-size: 12px;
  font-weight: 600;
  color: var(--text-muted);
}

.login-card__input
{
  padding: 9px 12px;
  font-size: 14px;
  color: var(--text);
  background: var(--bg-surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  outline: none;
  transition: border-color 0.15s;
}

.login-card__input:focus
{
  border-color: var(--accent);
}

.login-card__input:disabled
{
  opacity: 0.6;
  cursor: not-allowed;
}

/* error banner shown on wrong credentials or network failure */
.login-card__error
{
  padding: 8px 12px;
  font-size: 13px;
  color: var(--danger);
  background: var(--danger-bg);
  border: 1px solid var(--danger);
  border-radius: var(--radius-md);
}

.login-card__submit
{
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  margin-top: 4px;
  padding: 10px 16px;
  font-size: 14px;
  font-weight: 600;
  color: var(--text-on-accent);
  background: var(--accent);
  border: 1px solid var(--accent);
  border-radius: var(--radius-md);
  cursor: pointer;
  transition: background 0.15s, opacity 0.15s;
}

.login-card__submit:not(:disabled):hover
{
  background: var(--accent-hover);
}

.login-card__submit:disabled
{
  opacity: 0.5;
  cursor: not-allowed;
}

/* ─── SysInfo tab ─────────────────────────────────────────────────────────── */

.sysinfo-tab
{
  display        : flex;
  flex-direction : column;
  gap            : var(--space-5);
  padding        : var(--space-5);
  overflow-y     : auto;
  height         : 100%;
}

.sysinfo-tab__header
{
  display        : flex;
  flex-direction : column;
  gap            : var(--space-1);
}

.sysinfo-tab__title
{
  font-size   : 1rem;
  font-weight : 600;
  color       : var(--text);
}

.sysinfo-tab__meta
{
  display    : flex;
  flex-wrap  : wrap;
  gap        : var(--space-2);
  font-size  : 0.8125rem;
  color      : var(--text-muted);
}

.sysinfo-tab__meta-sep
{
  color : var(--border);
}

.sysinfo-tab__empty
{
  padding    : var(--space-6);
  text-align : center;
  color      : var(--text-muted);
  background : var(--bg-elevated);
  border     : 1px dashed var(--border);
  border-radius : var(--radius-md);
}

.sysinfo-tab__tiles
{
  display               : grid;
  grid-template-columns : repeat(3, 1fr);
  gap                   : var(--space-4);
}

.sysinfo-tab__charts
{
  display               : grid;
  grid-template-columns : repeat(3, 1fr);
  gap                   : var(--space-4);
}

/* one stat tile ------------------------------------------------------------- */

.sysinfo-tile
{
  display        : flex;
  flex-direction : column;
  gap            : var(--space-2);
  padding        : var(--space-4);
  background     : var(--bg-elevated);
  border         : 1px solid var(--border);
  border-radius  : var(--radius-md);
}

.sysinfo-tile__header
{
  display     : flex;
  align-items : center;
  gap         : var(--space-2);
  color       : var(--text-muted);
  font-size   : 0.8125rem;
  font-weight : 500;
}

.sysinfo-tile__label
{
  text-transform : uppercase;
  letter-spacing : 0.04em;
}

.sysinfo-tile__value
{
  font-size   : 1.75rem;
  font-weight : 600;
  color       : var(--text);
  line-height : 1.1;
}

.sysinfo-tile__bar
{
  width         : 100%;
  height        : 6px;
  background    : var(--bg-surface);
  border-radius : 999px;
  overflow      : hidden;
}

.sysinfo-tile__bar-fill
{
  height        : 100%;
  background    : var(--accent);
  border-radius : 999px;
  transition    : width 0.4s ease-out;
}

.sysinfo-tile__hint
{
  font-size : 0.75rem;
  color     : var(--text-muted);
}

/* one mini chart card ------------------------------------------------------- */

.sysinfo-chart
{
  display        : flex;
  flex-direction : column;
  gap            : var(--space-2);
  padding        : var(--space-3);
  background     : var(--bg-elevated);
  border         : 1px solid var(--border);
  border-radius  : var(--radius-md);
}

.sysinfo-chart__title
{
  font-size   : 0.75rem;
  font-weight : 600;
  color       : var(--text-muted);
  text-transform : uppercase;
  letter-spacing : 0.04em;
}

.sysinfo-chart__body
{
  width  : 100%;
  height : 120px;
}

/* ── Inline form validation (used by ProcessTab, FileTab, ScreenTab, WebcamTab) ── */
/* Shared style for a small "one row" form that lives inside a tab toolbar:
   label + input + submit button, with an inline error message underneath. */

.form-inline
{
  display        : flex;
  align-items    : center;
  gap            : var(--space-2);
  flex-wrap      : wrap;
  padding        : var(--space-2);
}

.form-inline__label
{
  font-size      : 0.85rem;
  color          : var(--text);
}

.form-inline__input
{
  padding        : var(--space-1) var(--space-2);
  border         : 1px solid var(--border);
  border-radius  : var(--radius-sm);
  background     : var(--bg-elevated);
  color          : var(--text);
  font-family    : var(--font-sans);
  font-size      : 0.85rem;
  min-width      : 96px;
}

/* Narrower input for compact numeric fields (fps / quality). */
.form-inline__input--num
{
  min-width      : 72px;
}

/* Wider input for path / URL entry. */
.form-inline__input--wide
{
  min-width      : 180px;
}

/* Red border when the current value is invalid — paired with the error text below. */
.form-inline__input--error
{
  border-color   : var(--danger);
  background     : var(--danger-bg);
}

.form-inline__error
{
  color        : var(--danger);
  font-size    : 0.75rem;
  margin-top   : var(--space-1);
  width        : 100%;
  flex-basis   : 100%;
}
