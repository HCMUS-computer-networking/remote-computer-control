 257: // ─── MockSocket class ─────────────────────────────────────────────────────────
 258: 
 259: class MockSocket
 260: {
 261:     constructor()
 262:     {
 263:         this._on_message     = null;   // fired for every incoming JSON message
 264:         this._on_binary      = null;   // fired for incoming binary (ArrayBuffer) data
 265:         this._on_open        = null;   // fired once when the connection opens
 266:         this._on_close       = null;   // fired when the connection closes
 267:         this._on_error       = null;   // kept for API parity with real Socket (unused here)
 268:         this._connected      = false;  // true after connect() fires _on_open
 269:         this._connect_timer  = null;   // saved so close() can cancel it
 270: 
 271:         // Per-agent mutable state so Start/Stop/Kill have visible effects.
 272:         // Keyed by agent_id. Lazily initialised on first request.
 273:         this._app_state      = {};   // { [agent_id]: [ ...app objects ] }
 274:         this._proc_state     = {};   // { [agent_id]: [ ...proc objects ] }
 275:         this._sysinfo_state  = {};   // { [agent_id]: { cpu_percent, ram_used_mb, ram_total_mb, disk_used_gb, disk_total_gb, started_at, hostname, ip, os } }
 276: 
 277:         // Per-agent uploaded files, keyed by parent directory path.
 278:         // Shape: { [agent_id]: { [parent_path]: [ { name, type:'file', size, modified_ms } ] } }
 279:         // Merged into FAKE_FS_TREE on fs_list so uploads appear on Refresh.
 280:         this._uploaded_files = {};
 281: 
 282:         // Active frame streams keyed by "agentId:module" (e.g. "agent-01:screen").
 283:         // Each value is a setInterval ID. Cleared on stop or close.
 284:         this._streams        = {};
 285: 
 286:         // Active keylog streams keyed by agent_id. Each value is a setInterval ID.
 287:         this._keylog_streams = {};
 288: 
 289:         // Security policy last pushed by the Controller (policy_update). When set,
 290:         // app_list computes each app's in_whitelist from this whitelist Set,
 291:         // simulating the Agent applying the pushed policy in RAM.
 292:         // Shape: { whitelist: Set<string>, sandbox_path: string } | null
 293:         this._policy = null;
 294: 
 295:         // Sequence counter per stream key. Increments with every frame.
 296:         this._seq_counters   = {};
 297: 
 298:         // Shared off-screen canvas for generating fake JPEG frames.
 299:         // Created lazily by _getCanvas().
 300:         this._canvas         = null;
 301:         this._canvas_ctx     = null;
 302:     }
 303: 
 304:     // ── Callback registration (mirror the real Socket API) ─────────────────
 305: 
 306:     onOpen(callback)    { this._on_open    = callback; }
 307:     onMessage(callback) { this._on_message = callback; }
 308:     onBinary(callback)  { this._on_binary  = callback; }
 309:     onClose(callback)   { this._on_close   = callback; }
 310:     onError(callback)   { this._on_error   = callback; }
 311: 
 312:     // ── Lifecycle ──────────────────────────────────────────────────────────
 313: 
 314:     connect()
 315:     {
 316:         this._connect_timer = setTimeout(() =>
 317:         {
 318:             this._connected = true;
 319:             if (this._on_open) this._on_open();
 320:         }, CONNECT_DELAY_MS);
 321:     }
 322: 
 323:     close()
 324:     {
 325:         clearTimeout(this._connect_timer);   // cancel pending connect timer if still waiting
 326: 
 327:         // Stop all running frame streams to prevent leaked intervals
 328:         for (const key of Object.keys(this._streams))
 329:         {
 330:             clearInterval(this._streams[key]);
 331:         }
 332:         this._streams      = {};
 333:         this._seq_counters = {};
 334: 
 335:         // Stop all keylog streams
 336:         for (const key of Object.keys(this._keylog_streams))
 337:         {
 338:             clearInterval(this._keylog_streams[key]);
 339:         }
 340:         this._keylog_streams = {};
 341: 
 342:         this._connected = false;
 343:         if (this._on_close) this._on_close();
 344:     }
 345: 
 346:     // ── Send (entry point for outgoing commands) ───────────────────────────
 347: 
 348:     // Receive a JSON string from the app (same contract as a real WebSocket send).
 349:     send(message)
 350:     {
 351:         if (!this._connected)
 352:         {
 353:             console.warn('[MockSocket] send() called before connect()');
 354:             return;
 355:         }
 356: 
 357:         let parsed;
 358:         try
 359:         {
 360:             parsed = JSON.parse(message);
 361:         }
 362:         catch (err)
 363:         {
 364:             console.warn('[MockSocket] Received non-JSON message:', message, err);
 365:             return;
 366:         }
 367: 
 368:         this._dispatch(parsed);
 369:     }
 370: 
 371:     // ── Per-agent state helpers ──────────────────────────────────────────
 372: 
 373:     // Return (and lazily create) the mutable app list for one agent.
 374:     // Template is picked based on the agent's OS family (Windows/Linux/macOS).
 375:     _getApps(agent_id)
 376:     {
 377:         if (!this._app_state[agent_id])
 378:         {
 379:             const os_family = getOsFamily(agent_id)
 380:             const template  = INITIAL_APPS_BY_OS[os_family] ?? INITIAL_APPS_BY_OS.windows
 381:             this._app_state[agent_id] = template.map((a) => ({ ...a }))
 382:         }
 383:         return this._app_state[agent_id]
 384:     }
 385: 
 386:     // Return (and lazily create) the mutable process list for one agent.
 387:     // Template is picked based on the agent's OS family (Windows/Linux/macOS).
 388:     _getProcs(agent_id)
 389:     {
 390:         if (!this._proc_state[agent_id])
 391:         {
 392:             this._proc_state[agent_id] = generateFakeProcs(getOsFamily(agent_id))
 393:         }
 394:         return this._proc_state[agent_id]
 395:     }
 396: 
 397:     // Return (and lazily create) the mutable sysinfo snapshot for one agent.
 398:     // Different agents get different hardware profiles so the tab looks alive.
 399:     _getSysInfoState(agent_id)
 400:     {
 401:         if (!this._sysinfo_state[agent_id])
 402:         {
 403:             const agent = FAKE_AGENTS.find((a) => a.id === agent_id) ?? {}
 404:             // Vary hardware size across agents so RAM/Disk totals are not identical.
 405:             const ram_total  = randomInt(8192, 32768)
 406:             const disk_total = randomInt(256, 1024)
 407:             this._sysinfo_state[agent_id] = {
 408:                 cpu_percent   : randomFloat(5, 40),
 409:                 ram_used_mb   : randomFloat(2048, ram_total  * 0.6),
 410:                 ram_total_mb  : ram_total,
 411:                 disk_used_gb  : randomFloat(disk_total * 0.2, disk_total * 0.7),
 412:                 disk_total_gb : disk_total,
 413:                 started_at    : Date.now() - randomInt(60, 86400) * 1000,   // fake uptime seed
 414:                 hostname      : agent.name ?? agent_id,
 415:                 ip            : agent.ip   ?? '0.0.0.0',
 416:                 os            : agent.os   ?? 'Unknown',
 417:             }
 418:         }
 419:         return this._sysinfo_state[agent_id]
 420:     }
 421: 
 422:     // Return the merged directory listing for one agent + path.
 423:     // Combines the static FAKE_FS_TREE with per-agent uploaded files.
 424:     _getFsEntries(agent_id, path)
 425:     {
 426:         const base    = FAKE_FS_TREE[path] ?? []
 427:         const extra   = this._uploaded_files[agent_id]?.[path] ?? []
 428:         return [...base, ...extra]
 429:     }
 430: 
 431:     // Record an uploaded file so it appears on the next fs_list of its parent dir.
 432:     // Deduplicates by name — re-uploading the same filename replaces the old entry.
 433:     _recordUpload(agent_id, full_path, size)
 434:     {
 435:         const slash_at    = full_path.lastIndexOf('/')
 436:         const parent_path = slash_at <= 0 ? '/' : full_path.slice(0, slash_at)
 437:         const file_name   = full_path.slice(slash_at + 1)
 438: 
 439:         if (!this._uploaded_files[agent_id])            this._uploaded_files[agent_id] = {}
 440:         if (!this._uploaded_files[agent_id][parent_path]) this._uploaded_files[agent_id][parent_path] = []
 441: 
 442:         const list = this._uploaded_files[agent_id][parent_path]
 443:         const idx  = list.findIndex((e) => e.name === file_name)
 444:         const entry = { name: file_name, type: 'file', size, modified_ms: Date.now() }
 445:         if (idx >= 0) list[idx] = entry
 446:         else          list.push(entry)
 447:     }
 448: 
 449:     // ── Private: dispatch ──────────────────────────────────────────────────
 450: 
 451:     // Route a parsed message to the matching handler by its type field.
 452:     // All module commands arrive as type "request" — sub-dispatch on msg.module.
 453:     _dispatch(msg)
 454:     {
 455:         switch (msg.type)
 456:         {
 457:             case 'list_agents':   this._handleListAgents(msg); break;
 458:             case 'request':       this._handleRequest(msg);    break;
 459:             case 'power':         this._handlePower(msg);      break;
 460:             case 'policy_update': this._handlePolicy(msg);     break;
 461: 
 462:             // TODO: add handlers for new top-level message types here
 463: 
 464:             default:
 465:                 console.warn('[MockSocket] Unknown message type:', msg.type);
 466:         }
 467:     }
 468: 
 469:     // ── Private: message handlers ──────────────────────────────────────────
 470: 
 471:     _handleListAgents()
 472:     {
 473:         // Reply quickly — agent list is always ready on the Gateway side.
 474:         this._reply({ type: 'agents_list', agents: FAKE_AGENTS }, 200);
 475:     }
 476: 
 477:     // All module commands arrive as type:"request"; dispatch on msg.module.
 478:     _handleRequest(msg)
 479:     {
 480:         switch (msg.module)
 481:         {
 482:             // ── Application (application.json) ─────────────────────────────
 483:             case 'app_list':
 484:                 this._replyPerAgent(msg.target_agents, (agent_id) =>
 485:                 {
 486:                     // Return current stateful app list with fresh random CPU/RAM for running apps.
 487:                     // in_whitelist is derived from the pushed policy when present,
 488:                     // simulating the Agent applying the Controller's whitelist.
 489:                     const policy_set = this._policy?.whitelist
 490:                     const apps = this._getApps(agent_id).map((a) =>
 491:                     ({
 492:                         ...a,
 493:                         in_whitelist : policy_set ? policy_set.has(a.name) : a.in_whitelist,
 494:                         cpu_percent  : a.status === 'running' ? randomFloat(0.1, 15) : 0,
 495:                         ram_mb       : a.status === 'running' ? randomInt(5, 500)     : 0,
 496:                     }))
 497:                     return { type: 'app_list_result', agent_id, apps }
 498:                 },
 499:                 300);
 500:                 break;
 501: 
 502:             case 'app_start':
 503:             case 'app_stop':
 504:             {
 505:                 const app_name   = msg.params?.name ?? ''
 506:                 const new_status = msg.module === 'app_start' ? 'running' : 'stopped'
 507: 
 508:                 this._replyPerAgent(msg.target_agents, (agent_id) =>
 509:                 {
 510:                     // Mutate the persistent app state so the next poll reflects the change
 511:                     const apps = this._getApps(agent_id)
 512:                     const target = apps.find((a) => a.name === app_name)
 513:                     if (target) target.status = new_status
 514: 
 515:                     return {
 516:                         type    : 'app_action_result',
 517:                         agent_id,
 518:                         action  : msg.module,
 519:                         name    : app_name,
 520:                         success : true,
 521:                         message : msg.module === 'app_start'
 522:                             ? `${app_name} started successfully`
 523:                             : `${app_name} stopped successfully`,
 524:                     }
 525:                 },
 526:                 300);
 527:                 break;
 528:             }
 529: 
 530:             // ── Process (process.json) ─────────────────────────────────────
 531:             case 'proc_list':
 532:                 this._replyPerAgent(msg.target_agents, (agent_id) =>
 533:                 {
 534:                     // Return persistent list with fresh random CPU/RAM each poll
 535:                     const procs = this._getProcs(agent_id).map((p) =>
 536:                     ({
 537:                         ...p,
 538:                         cpu_percent : randomFloat(0, 25),
 539:                         ram_mb      : randomFloat(10, 512),
 540:                     }))
 541:                     return { type: 'proc_list_result', agent_id, processes: procs }
 542:                 },
 543:                 300);
 544:                 break;
 545: 
 546:             case 'proc_kill':
 547:             {
 548:                 const kill_pid = msg.params?.pid
 549: 
 550:                 this._replyPerAgent(msg.target_agents, (agent_id) =>
 551:                 {
 552:                     // Remove the process from persistent state so it disappears on next poll
 553:                     const procs = this._getProcs(agent_id)
 554:                     const idx   = procs.findIndex((p) => p.pid === kill_pid)
 555:                     const name  = idx >= 0 ? procs[idx].name : `PID ${kill_pid}`
 556:                     if (idx >= 0) procs.splice(idx, 1)
 557: 
 558:                     return {
 559:                         type    : 'proc_kill_result',
 560:                         agent_id,
 561:                         pid     : kill_pid,
 562:                         name,
 563:                         success : idx >= 0,
 564:                         message : idx >= 0 ? `${name} terminated` : `PID ${kill_pid} not found`,
 565:                     }
 566:                 },
 567:                 300);
 568:                 break;
 569:             }
 570: 
 571:             // ── SysInfo (SysInfo.json) ─────────────────────────────────────
 572:             case 'sysinfo':
 573:                 this._replyPerAgent(msg.target_agents, (agent_id) =>
 574:                 {
 575:                     // Smoothly evolve fake metrics per agent so the sparkline
 576:                     // shows a plausible waveform instead of pure white noise.
 577:                     const state = this._getSysInfoState(agent_id)
 578:                     state.cpu_percent  = clampPercent(state.cpu_percent  + randomFloat(-6, 6))
 579:                     state.ram_used_mb  = clampRange(state.ram_used_mb + randomFloat(-150, 150), 1024, state.ram_total_mb - 512)
 580:                     state.disk_used_gb = clampRange(state.disk_used_gb + randomFloat(-0.3, 0.3), 20, state.disk_total_gb - 5)
 581: 
 582:                     return {
 583:                         type           : 'sysinfo_result',
 584:                         agent_id,
 585:                         cpu_percent    : state.cpu_percent,
 586:                         ram_used_mb    : state.ram_used_mb,
 587:                         ram_total_mb   : state.ram_total_mb,
 588:                         disk_used_gb   : state.disk_used_gb,
 589:                         disk_total_gb  : state.disk_total_gb,
 590:                         uptime_seconds : Math.floor((Date.now() - state.started_at) / 1000),
 591:                         hostname       : state.hostname,
 592:                         ip             : state.ip,
 593:                         os             : state.os,
 594:                     }
 595:                 },
 596:                 200);
 597:                 break;
 598: 
 599:             // ── Screen (livescreen.json) ───────────────────────────────────
 600:             case 'screenshot':
 601:                 // Single capture: emit one frame_meta + binary pair per agent
 602:                 this._replyPerAgent(msg.target_agents, (agent_id) =>
 603:                 {
 604:                     this._emitSingleFrame(agent_id, 'screen');
 605:                     return null;   // _emitSingleFrame calls _reply itself
 606:                 },
 607:                 0);
 608:                 break;
 609: 
 610:             case 'screen_stream':
 611:                 this._replyPerAgent(msg.target_agents, (agent_id) =>
 612:                 {
 613:                     const fps = msg.params?.fps ?? 24;
 614:                     this._startFrameStream(agent_id, 'screen', fps);
 615: 
 616:                     // Confirm stream started
 617:                     this._reply({ type: 'stream_started', agent_id, module: 'screen' }, 100);
 618:                     return null;
 619:                 },
 620:                 0);
 621:                 break;
 622: 
 623:             case 'screen_stream_stop':
 624:                 this._replyPerAgent(msg.target_agents, (agent_id) =>
 625:                 {
 626:                     this._stopFrameStream(agent_id, 'screen');
 627:                     return { type: 'stream_stopped', agent_id, module: 'screen' };
 628:                 },
 629:                 200);
 630:                 break;
 631: 
 632:             // ── Keylog (keylog.json) ───────────────────────────────────────
 633:             case 'keylog_start':
 634:                 this._replyPerAgent(msg.target_agents, (agent_id, i) =>
 635:                 {
 636:                     const base = 400 + i * STAGGER_MS;
 637: 
 638:                     // Agents in DENIED_AGENTS refuse consent — reply keylog_denied
 639:                     // instead of keylog_started so the Controller can show the
 640:                     // consent-denied UX (toast + IDLE indicator staying gray).
 641:                     if (DENIED_AGENTS.has(agent_id))
 642:                     {
 643:                         this._reply({ type: 'keylog_denied', agent_id, reason: 'User declined on Agent machine' }, base);
 644:                         return null;
 645:                     }
 646: 
 647:                     // 1) Confirm keylog started (simulates Agent consent granted)
 648:                     this._reply({ type: 'keylog_started', agent_id }, base);
 649: 
 650:                     // 2) Begin continuous stream once the start confirmation fires
 651:                     setTimeout(() => this._startKeylogStream(agent_id), base + 50);
 652: 
 653:                     return null;   // _replyPerAgent skips null returns
 654:                 },
 655:                 0);
 656:                 break;
 657: 
 658:             case 'keylog_stop':
 659:                 this._replyPerAgent(msg.target_agents, (agent_id) =>
 660:                 {
 661:                     // Stop the interval first so no extra batches arrive after stopped
 662:                     this._stopKeylogStream(agent_id);
 663:                     return { type: 'keylog_stopped', agent_id };
 664:                 },
 665:                 300);
 666:                 break;
 667: 
 668:             // ── File (file.json) ───────────────────────────────────────────
 669:             case 'fs_list':
 670:             {
 671:                 // Merge static tree + per-agent uploads so uploaded files appear.
 672:                 // This simulates the sandbox restriction: only known paths have content.
 673:                 const list_path = msg.params?.path ?? '/'
 674:                 this._replyPerAgent(msg.target_agents, (agent_id) =>
 675:                 ({
 676:                     type    : 'fs_list_result',
 677:                     agent_id,
 678:                     path    : list_path,
 679:                     entries : this._getFsEntries(agent_id, list_path),
 680:                 }),
 681:                 300);
 682:                 break;
 683:             }
 684: 
 685:             case 'fs_get':
 686:             {
 687:                 // Return fake file content encoded as base64 (single chunk, sandbox only).
 688:                 const get_path = msg.params?.path ?? ''
 689:                 const content  = generateFakeFileContent(get_path)
 690:                 this._replyPerAgent(msg.target_agents, (agent_id) =>
 691:                 ({
 692:                     type         : 'fs_get_result',
 693:                     agent_id,
 694:                     path         : get_path,
 695:                     total_size   : content.length,
 696:                     chunk_index  : 0,
 697:                     total_chunks : 1,
 698:                     data_base64  : content,
 699:                 }),
 700:                 400);
 701:                 break;
 702:             }
 703: 
 704:             case 'fs_put':
 705:             {
 706:                 // All operations are sandbox-restricted on the Agent side.
 707:                 const put_path      = msg.params?.path        ?? ''
 708:                 const total_size    = msg.params?.total_size  ?? 0
 709:                 const chunk_index   = msg.params?.chunk_index ?? 0
 710:                 const total_chunks  = msg.params?.total_chunks ?? 1
 711:                 const is_last_chunk = chunk_index === total_chunks - 1
 712: 
 713:                 this._replyPerAgent(msg.target_agents, (agent_id, i) =>
 714:                 {
 715:                     // After the last chunk is acked, persist the file and send fs_put_complete.
 716:                     if (is_last_chunk)
 717:                     {
 718:                         // Record the upload so it shows up on the next fs_list.
 719:                         this._recordUpload(agent_id, put_path, total_size)
 720: 
 721:                         this._reply(
 722:                         {
 723:                             type    : 'fs_put_complete',
 724:                             agent_id,
 725:                             path    : put_path,
 726:                             success : true,
 727:                             message : 'File saved to sandbox',
 728:                         },
 729:                         280 + i * STAGGER_MS);   // slightly after the per-chunk ack
 730:                     }
 731: 
 732:                     return {
 733:                         type        : 'fs_put_result',
 734:                         agent_id,
 735:                         path        : put_path,
 736:                         chunk_index,
 737:                         success     : true,
 738:                         message     : 'Chunk received',
 739:                     }
 740:                 },
 741:                 150);   // fast reply so progress bar moves smoothly
 742:                 break;
 743:             }
 744: 
 745:             // ── Webcam (webcam.json) ───────────────────────────────────────
 746:             // Reuses the SAME frame stream engine as screen — the only
 747:             // difference is frame_meta.module = "webcam". This mirrors the
 748:             // Controller side, where FrameCanvas is shared between Livescreen
 749:             // and WebcamTab so both modules go through one decode/render path.
 750:             case 'webcam_start':
 751:                 this._replyPerAgent(msg.target_agents, (agent_id, i) =>
 752:                 {
 753:                     const base = 400 + i * STAGGER_MS;
 754: 
 755:                     // Agents in DENIED_AGENTS refuse consent — reply webcam_denied
 756:                     // instead of webcam_started so the Controller can display the
 757:                     // consent-denied UX (toast + no camera feed).
 758:                     if (DENIED_AGENTS.has(agent_id))
 759:                     {
 760:                         this._reply({ type: 'webcam_denied', agent_id, reason: 'User declined on Agent machine' }, base);
 761:                         return null;
 762:                     }
 763: 
 764:                     // 1) Confirm webcam started (simulates Agent consent granted)
 765:                     this._reply({ type: 'webcam_started', agent_id }, base);
 766: 
 767:                     // 2) Begin continuous webcam frame stream once confirmation fires.
 768:                     //    Uses the shared _startFrameStream engine — same code path as
 769:                     //    screen streams, only the module tag differs.
 770:                     const fps = msg.params?.fps ?? 15;
 771:                     setTimeout(() => this._startFrameStream(agent_id, 'webcam', fps), base + 50);
 772: 
 773:                     return null;
 774:                 },
 775:                 0);
 776:                 break;
 777: 
 778:             case 'webcam_stop':
 779:                 this._replyPerAgent(msg.target_agents, (agent_id) =>
 780:                 {
 781:                     this._stopFrameStream(agent_id, 'webcam');
 782:                     return { type: 'webcam_stopped', agent_id };
 783:                 },
 784:                 300);
 785:                 break;
 786: 
 787:             // TODO: add mock responses for new modules here
 788: 
 789:             default:
 790:                 this._resolveTargets(msg.target_agents).forEach((agent_id) =>
 791:                 {
 792:                     this._reply({ type: 'module_denied', agent_id, module: msg.module, reason: 'unknown module' });
 793:                 });
 794:         }
 795:     }
 796: 
 797:     // Apply a pushed security policy and confirm per agent.
 798:     // Format: docs/protocol/PolicyUpdate.json → policy_update_result
 799:     _handlePolicy(msg)
 800:     {
 801:         const app_whitelist = msg.params?.app_whitelist ?? []
 802:         const sandbox_path  = msg.params?.sandbox_path  ?? ''
 803: 
 804:         // Store in RAM — next app_list uses this whitelist to set in_whitelist.
 805:         this._policy = { whitelist: new Set(app_whitelist), sandbox_path }
 806: 
 807:         this._replyPerAgent(msg.target_agents, (agent_id) =>
 808:         ({
 809:             type    : 'policy_update_result',
 810:             agent_id,
 811:             success : true,
 812:             message : 'Policy updated successfully on memory',
 813:         }),
 814:         350);
 815:     }
 816: 
 817:     _handlePower(msg)
 818:     {
 819:         // Format: docs/protocol/power.json → power_result
 820:         this._replyPerAgent(msg.target_agents, (agent_id) =>
 821:         ({
 822:             type      : 'power_result',
 823:             agent_id,
 824:             action    : msg.action,
 825:             confirmed : true,
 826:             message   : `System action "${msg.action}" executed`,
 827:         }),
 828:         400);
 829:     }
 830: 
 831:     // ── Private: keylog stream engine ─────────────────────────────────────
 832:     //
 833:     // Emits batches of random fake keystrokes on a fixed interval until stopped.
 834: 
 835:     _startKeylogStream(agent_id)
 836:     {
 837:         // Cancel any existing stream for this agent before creating a new one
 838:         this._stopKeylogStream(agent_id);
 839: 
 840:         this._keylog_streams[agent_id] = setInterval(() =>
 841:         {
 842:             if (!this._connected || !this._on_message) return;
 843: 
 844:             this._on_message(
 845:             {
 846:                 type     : 'keylog',
 847:                 agent_id,
 848:                 events   : generateFakeKeyBatch(),
 849:             });
 850:         }, KEYLOG_INTERVAL_MS);
 851:     }
 852: 
 853:     _stopKeylogStream(agent_id)
 854:     {
 855:         if (this._keylog_streams[agent_id])
 856:         {
 857:             clearInterval(this._keylog_streams[agent_id]);
 858:             delete this._keylog_streams[agent_id];
 859:         }
 860:     }
 861: 
 862:     // ── Private: frame stream engine ──────────────────────────────────────
 863:     //
 864:     // Simulates the Agent capturing its screen and sending JPEG frames.
 865:     // Uses an off-screen <canvas> to draw a numbered card with the agent id
 866:     // and a timestamp, then encodes it to a JPEG blob → ArrayBuffer.
 867:     // Each frame produces TWO messages in order (matching real protocol):
 868:     //   1) JSON   — frame_meta  (type, agent_id, module, w, h, len, seq, timestamp_ms)
 869:     //   2) Binary — raw JPEG bytes as ArrayBuffer
 870: 
 871:     // Lazily create a shared off-screen canvas (no DOM attachment needed).
 872:     _getCanvas()
 873:     {
 874:         if (!this._canvas)
 875:         {
 876:             this._canvas     = document.createElement('canvas');
 877:             this._canvas.width  = FRAME_W;
 878:             this._canvas.height = FRAME_H;
 879:             this._canvas_ctx = this._canvas.getContext('2d');
 880:         }
 881:         return { canvas: this._canvas, ctx: this._canvas_ctx };
 882:     }
 883: 
 884:     // Draw a visually distinct test card on the shared canvas.
 885:     // Each agent gets a different background hue so tiles are distinguishable.
 886:     _drawTestCard(agent_id, module, seq)
 887:     {
 888:         const { canvas, ctx } = this._getCanvas();
 889: 
 890:         // Derive a stable hue from the agent_id string
 891:         let hash = 0;
 892:         for (let i = 0; i < agent_id.length; i++)
 893:         {
 894:             hash = agent_id.charCodeAt(i) + ((hash << 5) - hash);
 895:         }
 896:         const hue = Math.abs(hash) % 360;
 897: 
 898:         // Fill background with agent-specific colour
 899:         ctx.fillStyle = `hsl(${hue}, 40%, 25%)`;
 900:         ctx.fillRect(0, 0, canvas.width, canvas.height);
 901: 
 902:         // Draw agent name at top
 903:         ctx.fillStyle = '#FFFFFF';
 904:         ctx.font      = 'bold 16px monospace';
 905:         ctx.textAlign = 'center';
 906:         ctx.fillText(agent_id, canvas.width / 2, 40);
 907: 
 908:         // Draw module label
 909:         ctx.font = '12px monospace';
 910:         ctx.fillText(module.toUpperCase(), canvas.width / 2, 65);
 911: 
 912:         // Draw frame sequence number (large, centered)
 913:         ctx.font = 'bold 48px monospace';
 914:         ctx.fillText(`#${seq}`, canvas.width / 2, 120);
 915: 
 916:         // Draw current timestamp at bottom
 917:         ctx.font = '11px monospace';
 918:         ctx.fillStyle = '#AAAAAA';
 919:         const time_str = new Date().toLocaleTimeString();
 920:         ctx.fillText(time_str, canvas.width / 2, 165);
 921:     }
 922: 
 923:     // Emit a single frame_meta + binary JPEG pair for one agent.
 924:     // Used by both screenshot (one-shot) and stream (repeated).
 925:     _emitSingleFrame(agent_id, module)
 926:     {
 927:         const key = `${agent_id}:${module}`;
 928:         if (!this._seq_counters[key]) this._seq_counters[key] = 0;
 929:         const seq = ++this._seq_counters[key];
 930: 
 931:         this._drawTestCard(agent_id, module, seq);
 932: 
 933:         const { canvas } = this._getCanvas();
 934: 
 935:         // Convert canvas to JPEG blob, then to ArrayBuffer
 936:         canvas.toBlob((blob) =>
 937:         {
 938:             if (!blob || !this._connected) return;
 939: 
 940:             blob.arrayBuffer().then((buffer) =>
 941:             {
 942:                 if (!this._connected) return;
 943: 
 944:                 // 1) Send frame_meta JSON (matches docs/protocol/livescreen.json)
 945:                 if (this._on_message)
 946:                 {
 947:                     this._on_message(
 948:                     {
 949:                         type         : 'frame_meta',
 950:                         module,
 951:                         agent_id,
 952:                         w            : FRAME_W,
 953:                         h            : FRAME_H,
 954:                         len          : buffer.byteLength,
 955:                         seq,
 956:                         timestamp_ms : Date.now(),
 957:                     });
 958:                 }
 959: 
 960:                 // 2) Send raw JPEG binary immediately after
 961:                 if (this._on_binary)
 962:                 {
 963:                     this._on_binary(buffer);
 964:                 }
 965:             });
 966:         }, 'image/jpeg', FRAME_QUALITY);
 967:     }
 968: 
 969:     // Start a repeating frame stream at the given fps.
 970:     // If a stream is already running for this agent+module, stop it first.
 971:     _startFrameStream(agent_id, module, fps)
 972:     {
 973:         const key = `${agent_id}:${module}`;
 974: 
 975:         // Stop any existing stream for this key (prevents duplicate intervals)
 976:         if (this._streams[key])
 977:         {
 978:             clearInterval(this._streams[key]);
 979:         }
 980: 
 981:         const interval_ms = Math.round(1000 / fps);
 982: 
 983:         this._streams[key] = setInterval(() =>
 984:         {
 985:             this._emitSingleFrame(agent_id, module);
 986:         }, interval_ms);
 987:     }
 988: 
 989:     // Stop a running frame stream for one agent+module.
 990:     _stopFrameStream(agent_id, module)
 991:     {
 992:         const key = `${agent_id}:${module}`;
 993:         if (this._streams[key])
 994:         {
 995:             clearInterval(this._streams[key]);
 996:             delete this._streams[key];
 997:         }
 998:     }
 999: 
1000:     // ── Private: utilities ─────────────────────────────────────────────────
1001: 
1002:     // Push a response object to the caller after `delay` ms.
1003:     // Skips silently if the socket was closed before the timer fires.
1004:     _reply(payload, delay)
1005:     {
1006:         const wait = delay ?? randomDelay();
1007:         setTimeout(() =>
1008:         {
1009:             if (this._connected && this._on_message)
1010:             {
1011:                 this._on_message(payload);
1012:             }
1013:         }, wait);
1014:     }
1015: 
1016:     // Call builder(agent_id, index) for each resolved target and _reply the result.
1017:     // If builder returns null the reply is skipped (used when the builder
1018:     // calls _reply itself, e.g. keylog_start which sends two messages).
1019:     _replyPerAgent(target_agents, builder, base_delay)
1020:     {
1021:         const target_ids = this._resolveTargets(target_agents);
1022:         target_ids.forEach((agent_id, i) =>
1023:         {
1024:             const payload = builder(agent_id, i);
1025:             if (payload !== null)
1026:             {
1027:                 this._reply(payload, base_delay + i * STAGGER_MS);
1028:             }
1029:         });
1030:     }
1031: 
1032:     // Return the list of agent IDs to reply to.
1033:     // Empty / missing target_agents means all online agents.
1034:     _resolveTargets(target_agents)
1035:     {
1036:         if (!target_agents || target_agents.length === 0)
1037:         {
1038:             return FAKE_AGENTS
1039:                 .filter((a) => a.online)
1040:                 .map((a) => a.id);
1041:         }
1042:         return target_agents;
1043:     }
1044: }
1045: 
1046: export default MockSocket;
</file>

<file path="controller/src/components/livescreen/GridView.jsx">
  1: // GridView.jsx — overview grid of low-fps thumbnails for all online agents.
  2: //
  3: // STREAM LIFECYCLE:
  4: // On mount, requests a 2 fps screen stream for every online agent so the
  5: // grid tiles show live thumbnails without consuming excessive bandwidth.
  6: // On unmount (user switches to focus mode or navigates away), all grid
  7: // streams are stopped to free network and CPU resources.
  8: //
  9: // The stream commands go through useAgentSocket → MockSocket (or real Socket),
 10: // which sends frame_meta + binary pairs. UseAgentSocket dispatches each
 11: // completed frame into ModuleStore.data[agent_id].screen. Each AgentThumbnail
 12: // subscribes to its own agent's screen.frame slice via a Zustand selector,
 13: // so only the tile whose frame changed will re-render.
 14: 
 15: import { useEffect, useRef }  from 'react'
 16: import { Inbox, Expand, Loader2 }      from 'lucide-react'
 17: import useAgentStore           from '../../store/AgentStore'
 18: import useUiStore              from '../../store/UiStore'
 19: import useModuleStore          from '../../store/ModuleStore'
 20: import useConnectionStore      from '../../store/ConnectionStore'
 21: import useAgentSocket          from '../../hooks/UseAgentSocket'
 22: import useE2EEStore            from '../../store/E2EEStore'
 23: import { buildStreamStart, buildStreamStop } from '../../services/Protocol'
 24: import FrameCanvas             from '../FrameCanvas'
 25: 
 26: // Low fps for grid thumbnails — saves bandwidth vs. 24 fps focus stream
 27: const GRID_FPS     = 2
 28: const GRID_QUALITY = 50
 29: 
 30: // One tile in the grid — clicking opens focus mode for that agent.
 31: function AgentThumbnail({ agent })
 32: {
 33:     const setFocused    = useAgentStore((s) => s.setFocused)
 34:     const setLayoutMode = useUiStore((s) => s.setLayoutMode)
 35: 
 36:     // Subscribe to ONLY this agent's screen frame meta.
 37:     // Other agents' frame updates will not cause this tile to re-render.
 38:     const frame_meta = useModuleStore((s) => s.data[agent.id]?.screen?.meta ?? null)
 39:     const e2eeState = useE2EEStore(s => s.sessions[agent.id]?.state || 'uninitialized')
 40: 
 41:     function handleExpand()
 42:     {
 43:         setFocused(agent.id)
 44:         setLayoutMode('focus')
 45:     }
 46: 
 47:     const dot_class = agent.online
 48:         ? 'status-dot status-dot--sm status-dot--online'
 49:         : 'status-dot status-dot--sm status-dot--offline'
 50: 
 51:     return (
 52:         <div className="agent-thumbnail" onClick={handleExpand}>
 53:             {/* tile header — always dark to remain legible over the feed */}
 54:             <div className="agent-thumbnail__header">
 55:                 <span
 56:                     className={dot_class}
 57:                     aria-hidden="true"
 58:                 />
 59:                 <span className="agent-thumbnail__name">{agent.name}</span>
 60: 
 61:                 {agent.in_session && (
 62:                     <span className="session-badge" aria-label="Session active">SESSION</span>
 63:                 )}
 64: 
 65:                 <Expand size={12} strokeWidth={1.75} style={{ color: 'var(--text-feed)', flexShrink: 0 }} />
 66:             </div>
 67: 
 68:             {/* feed area — FrameCanvas when frame data exists, placeholder otherwise */}
 69:             <div className="agent-thumbnail__feed">
 70:                 {e2eeState !== 'ready'
 71:                     ? (
 72:                         <div className="agent-thumbnail__placeholder" style={{flexDirection: 'column', color: 'var(--brand)'}}>
 73:                             <Loader2 size={24} className="spin" style={{marginBottom: '0.5rem'}} />
 74:                             <span style={{color: 'var(--text-dim)', fontSize: '0.75rem'}}>E2EE Negotiating...</span>
 75:                         </div>
 76:                     )
 77:                     : frame_meta
 78:                         ? <FrameCanvas agent_id={agent.id} module="screen" width="100%" height="100%" />
 79:                         : <span className="agent-thumbnail__placeholder">Waiting for stream…</span>}
 80:             </div>
 81:         </div>
 82:     )
 83: }
 84: 
 85: function GridView()
 86: {
 87:     const agents          = useAgentStore((s) => s.agents)
 88:     const conn_status     = useConnectionStore((s) => s.status)
 89:     const { sendCommand } = useAgentSocket()
 90: 
 91:     // Keep track of which agent IDs we started streams for,
 92:     // so we can stop exactly those on unmount.
 93:     const streaming_ids_ref = useRef([])
 94: 
 95:     const online_agents = agents.filter((a) => a.online)
 96: 
 97:     // Stable signature of the online agent id set — sorted + joined so the string
 98:     // changes whenever the SET changes (not just the count). This catches the
 99:     // simultaneous swap case where one agent goes offline and another comes
100:     // online in the same tick: length stays the same but the set is different.
101:     const online_ids_key = online_agents.map((a) => a.id).sort().join(',')
102: 
103:     // Start low-fps streams once the socket is connected and agents are known.
104:     // Depends on conn_status so the effect waits until the socket is actually
105:     // open before sending any commands (the socket has a 300 ms connect delay).
106:     // Also re-runs when the online agent SET changes (via online_ids_key).
107:     // On unmount (user leaves grid view), cleanup stops all streams.
108:     useEffect(function ()
109:     {
110:         if (conn_status !== 'open') return
111:         if (online_ids_key === '') return
112: 
113:         const online_ids = online_ids_key.split(',')
114: 
115:         sendCommand(buildStreamStart(GRID_FPS, GRID_QUALITY, online_ids))
116:         streaming_ids_ref.current = online_ids
117: 
118:         // Cleanup: stop every stream we started when leaving the grid view
119:         // or when the online agent set changes. This prevents frames from
120:         // being sent after the component unmounts, which would waste
121:         // bandwidth and leave orphaned intervals in MockSocket.
122:         return function ()
123:         {
124:             if (streaming_ids_ref.current.length > 0)
125:             {
126:                 sendCommand(buildStreamStop(streaming_ids_ref.current))
127:                 streaming_ids_ref.current = []
128:             }
129:         }
130:     }, [conn_status, online_ids_key])
131: 
132:     return (
133:         <div className="grid-view">
134:             <p className="grid-view__subtitle">
135:                 Quick overview of all online Agents. Click a tile to open Focus mode.
136:             </p>
137: 
138:             {online_agents.length === 0
139:                 ? (
140:                     <div className="grid-view__empty">
141:                         <Inbox size={36} strokeWidth={1.5} />
142:                         <span>No agents online</span>
143:                     </div>
144:                 )
145:                 : (
146:                     <div className="grid-view__grid">
147:                         {online_agents.map(function (agent)
148:                         {
149:                             return <AgentThumbnail key={agent.id} agent={agent} />
150:                         })}
151:                     </div>
152:                 )
153:             }
154:         </div>
155:     )
156: }
157: 
158: export default GridView
</file>

<file path="controller/src/components/modules/WebcamTab/index.jsx">
  1: // WebcamTab/index.jsx — live webcam feed for one focused agent.
  2: //
  3: // SHARED TEMPLATE — the actual JPEG decode + canvas draw is done by the
  4: // FrameCanvas template imported from 'src/components/FrameCanvas.jsx'.
  5: // The SAME primitive powers Livescreen (ScreenTab / GridView / FocusView) and
  6: // this WebcamTab, so both modules go through ONE code path for decoding a
  7: // binary frame buffer and painting it to a <canvas>. If we ever change how
  8: // frames are rendered (e.g. add downscaling or a filter), we only touch
  9: // FrameCanvas and every consumer benefits — no duplicate logic to keep in sync.
 10: //
 11: // STREAM LIFECYCLE:
 12: //   - "Bật webcam"  → buildWebcamStart → Agent shows consent popup.
 13: //                     On accept, Agent replies webcam_started + streams frames.
 14: //                     On reject, Agent replies webcam_denied (toast is raised
 15: //                     by UseAgentSocket; the button flips back to idle).
 16: //   - "Tắt webcam"  → buildWebcamStop → Agent stops the camera stream.
 17: //   - On UNMOUNT (user switches tab or leaves focus), the cleanup effect
 18: //     stops the stream automatically so the camera does not stay on for an
 19: //     agent nobody is watching. This is important for privacy — an orphaned
 20: //     webcam stream would keep the physical camera LED on.
 21: //
 22: // This component only reads state from ModuleStore.data[agent.id].webcam and
 23: // ModuleStore.data[agent.id].webcam_active; it never touches the socket
 24: // directly — every command goes through useAgentSocket.
 25: 
 26: import { useState, useEffect, useRef } from 'react'
 27: import { Video, VideoOff, ShieldCheck, WifiOff } from 'lucide-react'
 28: import useModuleStore                    from '../../../store/ModuleStore'
 29: import useUiStore                        from '../../../store/UiStore'
 30: import useAgentSocket                    from '../../../hooks/UseAgentSocket'
 31: import { useGuardedSend, usePendingConsent } from '../../PermissionGate'
 32: import
 33: {
 34:     buildWebcamStart,
 35:     buildWebcamStop,
 36: }
 37: from '../../../services/Protocol'
 38: // Shared frame-render template — same file used by Livescreen. Do NOT
 39: // re-implement canvas / ImageBitmap logic here; keep it in FrameCanvas.
 40: import FrameCanvas from '../../FrameCanvas'
 41: 
 42: const WEBCAM_FPS     = 15   // per docs/protocol/webcam.json default
 43: const WEBCAM_QUALITY = 60   // JPEG quality (0–100)
 44: 
 45: // Allowed ranges — matched to Protocol.js buildWebcamStart guard.
 46: const FPS_MIN     = 1
 47: const FPS_MAX     = 30
 48: const QUALITY_MIN = 1
 49: const QUALITY_MAX = 100
 50: 
 51: // Parse a form input string as a positive integer inside [min, max].
 52: function parseIntInRange(raw, min, max, field_label)
 53: {
 54:     const trimmed = String(raw).trim()
 55:     if (trimmed === '') return { value: NaN, error: `${field_label} is required` }
 56:     if (!/^\d+$/.test(trimmed)) return { value: NaN, error: `${field_label} must be an integer` }
 57:     const n = parseInt(trimmed, 10)
 58:     if (n < min || n > max) return { value: NaN, error: `${field_label} must be in [${min}, ${max}]` }
 59:     return { value: n, error: '' }
 60: }
 61: 
 62: function WebcamTab({ agent })
 63: {
 64:     const { sendCommand }   = useAgentSocket()
 65:     const addToast          = useUiStore((s) => s.addToast)
 66:     const guardedSend       = useGuardedSend()
 67:     const is_pending        = usePendingConsent()
 68:     const [streaming, setStreaming] = useState(false)
 69: 
 70:     // ── Stream settings form ─────────────────────────────────────────
 71:     const [fps_input,     setFpsInput]     = useState(String(WEBCAM_FPS))
 72:     const [quality_input, setQualityInput] = useState(String(WEBCAM_QUALITY))
 73:     const fps_parsed     = parseIntInRange(fps_input,     FPS_MIN,     FPS_MAX,     'FPS')
 74:     const quality_parsed = parseIntInRange(quality_input, QUALITY_MIN, QUALITY_MAX, 'Quality')
 75:     const form_valid     = !fps_parsed.error && !quality_parsed.error
 76: 
 77:     // Read this agent's webcam frame_meta straight from ModuleStore.
 78:     // The frame_buffer is now distributed directly via FrameEventBus.
 79:     const frame_meta    = useModuleStore((s) => s.data[agent.id]?.webcam?.meta         ?? null)
 80:     const webcam_active = useModuleStore((s) => s.data[agent.id]?.webcam_active        ?? false)
 81: 
 82:     // Track which agent we started for, so cleanup stops the right one when
 83:     // the focused agent changes without an explicit stop click.
 84:     const streaming_agent_ref = useRef(null)
 85: 
 86:     // Stop the webcam stream for the previously-focused agent on unmount OR
 87:     // when the focused agent changes. Without this the camera LED would stay
 88:     // on for an agent that nobody is looking at any more — a privacy leak.
 89:     useEffect(function ()
 90:     {
 91:         return function ()
 92:         {
 93:             if (streaming_agent_ref.current)
 94:             {
 95:                 sendCommand(buildWebcamStop([streaming_agent_ref.current]))
 96:                 streaming_agent_ref.current = null
 97:                 setStreaming(false)
 98:             }
 99:         }
100:     }, [agent.id])
101: 
102:     function handleStart()
103:     {
104:         if (!form_valid) return
105:         guardedSend(function ()
106:         {
107:             try
108:             {
109:                 sendCommand(buildWebcamStart(fps_parsed.value, quality_parsed.value, [agent.id]))
110:                 streaming_agent_ref.current = agent.id
111:                 setStreaming(true)
112:             }
113:             catch (err)
114:             {
115:                 addToast(err.message ?? 'Invalid webcam settings', 'error')
116:             }
117:         })
118:     }
119: 
120:     function handleStop()
121:     {
122:         sendCommand(buildWebcamStop([agent.id]))
123:         streaming_agent_ref.current = null
124:         setStreaming(false)
125:     }
126: 
127:     // Small human-readable line about the last frame received.
128:     const resolution_text = frame_meta
129:         ? `${frame_meta.w}×${frame_meta.h}  ·  seq #${frame_meta.seq}`
130:         : 'No frame yet'
131: 
132:     // Consent is "confirmed" only when the Agent has echoed webcam_started
133:     // (webcam_active === true). Merely clicking the button does not count —
134:     // the Agent user might still deny the popup.
135:     const consent_confirmed = webcam_active && streaming
136: 
137:     return (
138:         <div className="screen-tab">
139:             {/* ── Toolbar ────────────────────────────────────── */}
140:             <div className="screen-tab__toolbar">
141:                 <span className="screen-tab__title">
142:                     Webcam — {agent.name}
143:                 </span>
144: 
145:                 <div className="screen-tab__actions">
146:                     {streaming
147:                         ? (
148:                             <button
149:                                 className="screen-tab__btn screen-tab__btn--danger"
150:                                 onClick={handleStop}
151:                                 title="Stop the webcam stream"
152:                             >
153:                                 <VideoOff size={14} strokeWidth={2} />
154:                                 Tắt webcam
155:                             </button>
156:                         )
157:                         : (
158:                             <button
159:                                 className="screen-tab__btn screen-tab__btn--primary"
160:                                 onClick={handleStart}
161:                                 disabled={!agent.online || !form_valid || is_pending}
162:                                 title={is_pending
163:                                     ? 'Đang xin quyền...'
164:                                     : form_valid
165:                                         ? 'Ask the Agent for webcam consent and start streaming'
166:                                         : 'Fix the settings error first'}
167:                             >
168:                                 <Video size={14} strokeWidth={2} />
169:                                 Bật webcam
170:                             </button>
171:                         )
172:                     }
173:                 </div>
174:             </div>
175: 
176:             {/* ── Stream settings (fps + quality) ─────────────── */}
177:             <form
178:                 className="form-inline"
179:                 onSubmit={(e) => { e.preventDefault(); handleStart() }}
180:             >
181:                 <label htmlFor="webcam-fps" className="form-inline__label">FPS:</label>
182:                 <input
183:                     id="webcam-fps"
184:                     className={`form-inline__input form-inline__input--num${fps_parsed.error ? ' form-inline__input--error' : ''}`}
185:                     type="number"
186:                     min={FPS_MIN}
187:                     max={FPS_MAX}
188:                     step="1"
189:                     inputMode="numeric"
190:                     value={fps_input}
191:                     onChange={(e) => setFpsInput(e.target.value)}
192:                     disabled={streaming}
193:                     aria-invalid={Boolean(fps_parsed.error)}
194:                 />
195:                 <label htmlFor="webcam-quality" className="form-inline__label">Quality:</label>
196:                 <input
197:                     id="webcam-quality"
198:                     className={`form-inline__input form-inline__input--num${quality_parsed.error ? ' form-inline__input--error' : ''}`}
199:                     type="number"
200:                     min={QUALITY_MIN}
201:                     max={QUALITY_MAX}
202:                     step="1"
203:                     inputMode="numeric"
204:                     value={quality_input}
205:                     onChange={(e) => setQualityInput(e.target.value)}
206:                     disabled={streaming}
207:                     aria-invalid={Boolean(quality_parsed.error)}
208:                 />
209:                 {(fps_parsed.error || quality_parsed.error) && (
210:                     <span className="form-inline__error">
211:                         {fps_parsed.error || quality_parsed.error}
212:                     </span>
213:                 )}
214:             </form>
215: 
216:             {/* ── Status bar ─────────────────────────────────── */}
217:             <div className="screen-tab__status">
218:                 {consent_confirmed && (
219:                     // Visible consent indicator — matches the Agent-side camera
220:                     // LED so the operator can see at a glance that the remote
221:                     // machine is actively broadcasting its webcam.
222:                     <span
223:                         className="screen-tab__consent-badge screen-tab__consent-badge--on"
224:                         title="Agent granted consent — webcam is broadcasting"
225:                     >
226:                         <ShieldCheck size={12} strokeWidth={2.5} />
227:                         ● CAM ON · {fps_parsed.value || WEBCAM_FPS} fps
228:                     </span>
229:                 )}
230:                 {streaming && !webcam_active && (
231:                     // Waiting on the Agent user to accept the consent popup.
232:                     <span className="screen-tab__consent-badge screen-tab__consent-badge--waiting">
233:                         Waiting for consent…
234:                     </span>
235:                 )}
236:                 <span className="screen-tab__resolution">{resolution_text}</span>
237:             </div>
238: 
239:             {/* ── Frame display (shared template) ────────────── */}
240:             <div className="screen-tab__canvas-wrapper">
241:                 {!agent.online
242:                     ? (
243:                         <div className="screen-tab__placeholder">
244:                             <WifiOff size={40} strokeWidth={1.25} />
245:                             <span>Agent is offline — webcam unavailable</span>
246:                         </div>
247:                     )
248:                     : frame_meta
249:                     ? (
250:                         // Use the SHARED FrameCanvas template — same decoder /
251:                         // renderer that Livescreen uses. Passing module="webcam"
252:                         // and label="WEBCAM" so the corner badge is visible.
253:                         <FrameCanvas
254:                             agent_id={agent.id}
255:                             module="webcam"
256:                             label="WEBCAM"
257:                             width="100%"
258:                             height="100%"
259:                         />
260:                     )
261:                     : (
262:                         <div className="screen-tab__placeholder">
263:                             <Video size={40} strokeWidth={1.25} />
264:                             <span>Press "Bật webcam" — the Agent will show a consent popup before streaming</span>
265:                         </div>
266:                     )
267:                 }
268:             </div>
269:         </div>
270:     )
271: }
272: 
273: export default WebcamTab
</file>

