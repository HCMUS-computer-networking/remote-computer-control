200:         private unsafe Rectangle GetDifferenceBoundingBox(Bitmap current, Bitmap previous)
201:         {
202:             if (current.Width != previous.Width || current.Height != previous.Height)
203:                 return new Rectangle(0, 0, current.Width, current.Height);
204: 
205:             int width = current.Width;
206:             int height = current.Height;
207: 
208:             BitmapData dataCur = current.LockBits(new Rectangle(0, 0, width, height), ImageLockMode.ReadOnly, PixelFormat.Format32bppArgb);
209:             BitmapData dataPrev = previous.LockBits(new Rectangle(0, 0, width, height), ImageLockMode.ReadOnly, PixelFormat.Format32bppArgb);
210: 
211:             int minX = width, minY = height, maxX = 0, maxY = 0;
212:             bool hasChanges = false;
213: 
214:             try
215:             {
216:                 byte* ptrCur = (byte*)dataCur.Scan0;
217:                 byte* ptrPrev = (byte*)dataPrev.Scan0;
218:                 int stride = dataCur.Stride;
219: 
220:                 for (int y = 0; y < height; y++)
221:                 {
222:                     int* rowCur = (int*)(ptrCur + y * stride);
223:                     int* rowPrev = (int*)(ptrPrev + y * stride);
224:                     
225:                     bool rowHasChange = false;
226:                     int rowMinX = width;
227:                     int rowMaxX = 0;
228: 
229:                     for (int x = 0; x < width; x++)
230:                     {
231:                         if (rowCur[x] != rowPrev[x])
232:                         {
233:                             if (x < rowMinX) rowMinX = x;
234:                             if (x > rowMaxX) rowMaxX = x;
235:                             rowHasChange = true;
236:                         }
237:                     }
238: 
239:                     if (rowHasChange)
240:                     {
241:                         hasChanges = true;
242:                         if (y < minY) minY = y;
243:                         if (y > maxY) maxY = y;
244:                         if (rowMinX < minX) minX = rowMinX;
245:                         if (rowMaxX > maxX) maxX = rowMaxX;
246:                     }
247:                 }
248:             }
249:             finally
250:             {
251:                 current.UnlockBits(dataCur);
252:                 previous.UnlockBits(dataPrev);
253:             }
254: 
255:             if (!hasChanges)
256:                 return Rectangle.Empty;
257: 
258:             return new Rectangle(minX, minY, maxX - minX + 1, maxY - minY + 1);
259:         }
260: 
261:         private async Task CaptureAndSendAsync(string commandId, int quality, bool isFromStream)
262:         {
263:             // Chờ tối đa 1000ms để vào vùng Critical Section (thay thế cho TryEnter)
264:             bool lockTaken = await captureSemaphore.WaitAsync(1000);
265:             
266:             if (!lockTaken)
267:             {
268:                 if (isFromStream) return; // Rớt 1 frame stream thì bỏ qua
269:                 
270:                 context.SendResponse(new
271:                 {
272:                     type = "ERROR",
273:                     command_id = commandId,
274:                     module = "screen",
275:                     message = "Hệ thống đang bận xử lý luồng ảnh khác, không thể chụp màn hình lúc này."
276:                 });
277:                 return; 
278:             }
279: 
280:             try
281:             {
282:                 Rectangle bounds = Screen.PrimaryScreen.Bounds;
283:                 
284:                 if (captureBitmap == null || lastScreenSize != bounds.Size)
285:                 {
286:                     captureGraphics?.Dispose();
287:                     captureBitmap?.Dispose();
288:                     scaledGraphics?.Dispose();
289:                     scaledBitmap?.Dispose();
290:                     
291:                     captureBitmap = new Bitmap(bounds.Width, bounds.Height, PixelFormat.Format32bppArgb);
292:                     captureGraphics = Graphics.FromImage(captureBitmap);
293:                     
294:                     scaledBitmap = new Bitmap(TargetSize.Width, TargetSize.Height, PixelFormat.Format32bppArgb);
295:                     scaledGraphics = Graphics.FromImage(scaledBitmap);
296:                     scaledGraphics.InterpolationMode = System.Drawing.Drawing2D.InterpolationMode.Bilinear;
297:                     
298:                     lastScreenSize = bounds.Size;
299:                 }
300: 
301:                 // Thực hiện copy pixel từ màn hình
302:                 captureGraphics.CopyFromScreen(Point.Empty, Point.Empty, bounds.Size);
303:                 scaledGraphics.DrawImage(captureBitmap, new Rectangle(0, 0, TargetSize.Width, TargetSize.Height));
304:                 
305:                 Rectangle diffRect;
306:                 bool isKeyframe = false;
307: 
308:                 if (!isFromStream || previousBitmap == null || framesSinceLastKeyframe >= KeyframeInterval)
309:                 {
310:                     diffRect = new Rectangle(0, 0, TargetSize.Width, TargetSize.Height);
311:                     isKeyframe = true;
312:                     if (isFromStream) framesSinceLastKeyframe = 0;
313:                 }
314:                 else
315:                 {
316:                     diffRect = GetDifferenceBoundingBox(scaledBitmap, previousBitmap);
317:                     if (diffRect == Rectangle.Empty) return; // Không có thay đổi
318:                     framesSinceLastKeyframe++;
319:                 }
320: 
321:                 byte[] imageBytes;
322:                 if (diffRect.Width == TargetSize.Width && diffRect.Height == TargetSize.Height)
323:                 {
324:                     imageBytes = ImageUtils.CompressImageToJpeg(scaledBitmap, quality);
325:                 }
326:                 else
327:                 {
328:                     using (Bitmap diffBitmap = new Bitmap(diffRect.Width, diffRect.Height, PixelFormat.Format32bppArgb))
329:                     using (Graphics g = Graphics.FromImage(diffBitmap))
330:                     {
331:                         g.DrawImage(scaledBitmap, new Rectangle(0, 0, diffRect.Width, diffRect.Height), diffRect, GraphicsUnit.Pixel);
332:                         imageBytes = ImageUtils.CompressImageToJpeg(diffBitmap, quality);
333:                     }
334:                 }
335: 
336:                 if (isFromStream)
337:                 {
338:                     if (previousBitmap == null || previousBitmap.Size != TargetSize)
339:                     {
340:                         previousBitmap?.Dispose();
341:                         previousBitmap = new Bitmap(TargetSize.Width, TargetSize.Height, PixelFormat.Format32bppArgb);
342:                     }
343:                     using (Graphics gPrev = Graphics.FromImage(previousBitmap))
344:                     {
345:                         gPrev.DrawImage(scaledBitmap, Point.Empty);
346:                     }
347:                 }
348:                 
349:                 long timestamp = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
350:                 ushort seq = (ushort)(isFromStream ? currentSequence++ : 0);
351:                 await UdpStreamSender.SendFrameAsync(context.AgentId, commandId, 0, seq, imageBytes, timestamp, isKeyframe, diffRect, context.Crypto);
352:             }
353:             catch (Exception ex)
354:             {
355:                 Log.Error(ex, "Lỗi quá trình chụp và scale ảnh: {ErrorMessage}", ex.Message);
356:                 
357:                 if (!isFromStream)
358:                 {
359:                     context.SendResponse(new { type = "ERROR", command_id = commandId, module = "screen", message = $"Lỗi chụp ảnh: {ex.Message}" });
360:                 }
361:                 else if (isStreaming)
362:                 {
363:                     StopStream(commandId);
364:                 }
365:             }
366:             finally
367:             {
368:                 // Giải phóng Semaphore
369:                 captureSemaphore.Release();
370:             }
371:         }
372:     }
373: }
