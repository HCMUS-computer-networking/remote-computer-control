<file path="agent/Utils/UdpStreamSender.cs">
  1: using System;
  2: using System.Drawing;
  3: using System.Net.Sockets;
  4: using System.Text;
  5: using System.Threading.Tasks;
  6: using AgentSystem.Managers;
  7: 
  8: namespace AgentSystem.Utils
  9: {
 10:     public static class UdpStreamSender
 11:     {
 12:         private static UdpClient _udpClient;
 13:         private static string _gatewayIp;
 14:         private static int _gatewayPort = 9000;
 15:         private static bool _isInitialized = false;
 16:         private const int MAX_PAYLOAD_SIZE = 1300;
 17: 
 18:         public static void Initialize()
 19:         {
 20:             if (_isInitialized) return;
 21: 
 22:             try
 23:             {
 24:                 _udpClient = new UdpClient();
 25:                 // Extract IP from GatewayUrl (e.g., ws://localhost:8080)
 26:                 Uri uri = new Uri(ConfigManager.Current.GatewayUrl);
 27:                 _gatewayIp = uri.Host;
 28:                 _isInitialized = true;
 29:                 Serilog.Log.Information("[UdpStreamSender] Initialized UDP Client. Target: {Ip}:{Port}", _gatewayIp, _gatewayPort);
 30:             }
 31:             catch (Exception ex)
 32:             {
 33:                 Serilog.Log.Error(ex, "[UdpStreamSender] Failed to initialize UDP client");
 34:             }
 35:         }
 36: 
 37:         public static async Task SendFrameAsync(string agentId, string commandId, byte moduleType, ushort frameId, byte[] payloadData, long timestamp, bool isKeyframe, Rectangle bounds, agent.Modules.CryptoModule crypto)
 38:         {
 39:             if (!_isInitialized) Initialize();
 40:             if (!_isInitialized || payloadData == null || payloadData.Length == 0) return;
 41: 
 42:             try
 43:             {
 44:                 byte[] finalPayload = payloadData;
 45:                 if (crypto != null && crypto.IsE2EEReady)
 46:                 {
 47:                     // AAD: Frame_ID (2 bytes) + Timestamp (8 bytes) = 10 bytes
 48:                     byte[] aad = new byte[10];
 49:                     BitConverter.GetBytes((ushort)frameId).CopyTo(aad, 0);
 50:                     BitConverter.GetBytes((ulong)timestamp).CopyTo(aad, 2);
 51:                     
 52:                     finalPayload = crypto.EncryptUdpAESGCM(payloadData, aad);
 53:                 }
 54: 
 55:                 int totalChunks = (int)Math.Ceiling((double)finalPayload.Length / MAX_PAYLOAD_SIZE);
 56:                 if (totalChunks > 255)
 57:                 {
 58:                     Serilog.Log.Warning("[UdpStreamSender] Frame size too large. Chunks: {Count} > 255", totalChunks);
 59:                     return;
 60:                 }
 61: 
 62:                 byte[] agentIdBytes = Encoding.UTF8.GetBytes(agentId ?? "");
 63:                 byte[] commandIdBytes = Encoding.UTF8.GetBytes(commandId ?? "");
 64:                 
 65:                 byte l1 = (byte)agentIdBytes.Length;
 66:                 byte l2 = (byte)commandIdBytes.Length;
 67: 
 68:                 for (int i = 0; i < totalChunks; i++)
 69:                 {
 70:                     byte chunkIndex = (byte)i;
 71:                     int offset = i * MAX_PAYLOAD_SIZE;
 72:                     int chunkSize = Math.Min(MAX_PAYLOAD_SIZE, finalPayload.Length - offset);
 73: 
 74:                     // Allocate Header Buffer
 75:                     int headerSize = 24 + l1 + l2;
 76:                     byte[] packet = new byte[headerSize + chunkSize];
 77: 
 78:                     // Fixed Header (24 bytes)
 79:                     packet[0] = chunkIndex;
 80:                     packet[1] = (byte)totalChunks;
 81:                     packet[2] = moduleType;
 82:                     packet[3] = (byte)(isKeyframe ? 1 : 0);
 83:                     
 84:                     BitConverter.GetBytes((ushort)frameId).CopyTo(packet, 4);
 85:                     BitConverter.GetBytes((ushort)bounds.X).CopyTo(packet, 6);
 86:                     BitConverter.GetBytes((ushort)bounds.Y).CopyTo(packet, 8);
 87:                     BitConverter.GetBytes((ushort)bounds.Width).CopyTo(packet, 10);
 88:                     BitConverter.GetBytes((ushort)bounds.Height).CopyTo(packet, 12);
 89:                     BitConverter.GetBytes((ulong)timestamp).CopyTo(packet, 14);
 90:                     
 91:                     packet[22] = l1;
 92:                     packet[23] = l2;
 93: 
 94:                     // Dynamic Strings
 95:                     if (l1 > 0) Buffer.BlockCopy(agentIdBytes, 0, packet, 24, l1);
 96:                     if (l2 > 0) Buffer.BlockCopy(commandIdBytes, 0, packet, 24 + l1, l2);
 97: 
 98:                     // Payload
 99:                     Buffer.BlockCopy(finalPayload, offset, packet, headerSize, chunkSize);
100: 
101:                     // Send Datagram
102:                     await _udpClient.SendAsync(packet, packet.Length, _gatewayIp, _gatewayPort);
103:                 }
104: 
105:                 // --- Forward Error Correction (FEC) Parity Chunk ---
106:                 if (totalChunks > 1)
107:                 {
108:                     byte[] parityPayload = new byte[4 + MAX_PAYLOAD_SIZE]; // 4 bytes for length + max chunk size (auto padded with 0x00)
109:                     BitConverter.GetBytes(finalPayload.Length).CopyTo(parityPayload, 0);
110: 
111:                     for (int i = 0; i < totalChunks; i++)
112:                     {
113:                         int offset = i * MAX_PAYLOAD_SIZE;
114:                         int size = Math.Min(MAX_PAYLOAD_SIZE, finalPayload.Length - offset);
115:                         for (int j = 0; j < size; j++)
116:                         {
117:                             parityPayload[4 + j] ^= finalPayload[offset + j];
118:                         }
119:                         // Chú ý 3: Mặc định mảng byte trong C# khởi tạo bằng 0. 
120:                         // Vòng lặp chỉ chạy tới size thật của chunk cuối, 
121:                         // tương đương với việc các byte dư (padding) của chunk cuối là 0x00 khi XOR.
122:                     }
123: 
124:                     int headerSize = 24 + l1 + l2;
125:                     byte[] parityPacket = new byte[headerSize + parityPayload.Length];
126: 
127:                     // Fixed Header for Parity Chunk (Chú ý 1)
128:                     parityPacket[0] = (byte)totalChunks; // Chunk_Index = totalChunks identifies the parity chunk
129:                     parityPacket[1] = (byte)totalChunks;
130:                     parityPacket[2] = moduleType;
131:                     parityPacket[3] = (byte)(isKeyframe ? 1 : 0);
132:                     
133:                     BitConverter.GetBytes((ushort)frameId).CopyTo(parityPacket, 4);
134:                     BitConverter.GetBytes((ushort)bounds.X).CopyTo(parityPacket, 6);
135:                     BitConverter.GetBytes((ushort)bounds.Y).CopyTo(parityPacket, 8);
136:                     BitConverter.GetBytes((ushort)bounds.Width).CopyTo(parityPacket, 10);
137:                     BitConverter.GetBytes((ushort)bounds.Height).CopyTo(parityPacket, 12);
138:                     BitConverter.GetBytes((ulong)timestamp).CopyTo(parityPacket, 14);
139:                     
140:                     parityPacket[22] = l1;
141:                     parityPacket[23] = l2;
142: 
143:                     if (l1 > 0) Buffer.BlockCopy(agentIdBytes, 0, parityPacket, 24, l1);
144:                     if (l2 > 0) Buffer.BlockCopy(commandIdBytes, 0, parityPacket, 24 + l1, l2);
145: 
146:                     Buffer.BlockCopy(parityPayload, 0, parityPacket, headerSize, parityPayload.Length);
147: 
148:                     await _udpClient.SendAsync(parityPacket, parityPacket.Length, _gatewayIp, _gatewayPort);
149:                 }
150:             }
151:             catch (Exception ex)
152:             {
153:                 Serilog.Log.Error("[UdpStreamSender] Error sending UDP frame: {Message}", ex.Message);
154:             }
155:         }
156:     }
157: }
</file>

