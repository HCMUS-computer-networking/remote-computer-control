185:         public void RouteCommand(CommandPacket packet)
186:         {
187:             if (!ValidatePacket(packet))
188:             {
189:                 Log.Warning("[Security] Nhận được gói tin không hợp lệ hoặc không dành cho Agent này. Đã bỏ qua.");
190:                 return;
191:             }
192: 
193:             if (packet.Type == "e2ee_init")
194:             {
195:                 try
196:                 {
197:                     string pubKeyBase64 = packet.PublicKey;
198:                     string signature = packet.Signature;
199:                     
200:                     if (string.IsNullOrEmpty(pubKeyBase64) || string.IsNullOrEmpty(signature))
201:                     {
202:                         Log.Warning("[E2EE] Missing PublicKey or Signature in e2ee_init packet.");
203:                         return;
204:                     }
205: 
206:                     // Kiểm tra chữ ký bằng mã PIN. Nếu sai, ném lỗi về thẳng Controller để hiển thị thông báo.
207:                     if (!Crypto.VerifyHMAC(pubKeyBase64, signature))
208:                     {
209:                         Log.Warning("[E2EE] Invalid Controller Signature. Sai mã PIN hoặc có MitM.");
210:                         SendResponse(new {
211:                             type = "e2ee_error",
212:                             agent_id = AgentId,
213:                             message = "Invalid PIN"
214:                         }, false); // encrypt = false
215:                         return;
216:                     }
217:                     
218:                     // Nếu đúng PIN, tạo Session Key và phản hồi e2ee_ready
219:                     Crypto.DeriveSessionKey(pubKeyBase64);
220:                     
221:                     string myPubKeyBase64 = Crypto.GetPublicKeySPKIBase64();
222:                     string mySignature = Crypto.SignHMAC(myPubKeyBase64);
223:                     
224:                     SendResponse(new {
225:                         type = "e2ee_ready",
226:                         agent_id = AgentId,
227:                         publicKey = myPubKeyBase64,
228:                         signature = mySignature
229:                     }, false); // encrypt = false
230:                     
231:                     Log.Information("[E2EE] Handshake completed successfully. Session Key is ready.");
232:                 }
233:                 catch (Exception ex)
234:                 {
235:                     Log.Error(ex, "[E2EE] Handshake failed.");
236:                 }
237:                 return;
238:             }
239: 
240:             if (packet.Type != "policy_update" && packet.Type != "permissions_reset" && packet.Type != "e2ee_init" && !Crypto.IsE2EEReady)
241:             {
242:                 Log.Warning($"[E2EE] Đang chờ Handshake, tạm chặn lệnh {packet.Type}.");
243:                 return;
244:             }
245: 
246:             if (packet.Type == "policy_update")
247:             {
248:                 try
249:                 {
250:                     List<string> whitelist = null;
251:                     string sandbox = null;
252: 
253:                     // Xử lý an toàn: Có biến nào thì đọc biến đó (Hỗ trợ Update từng phần)
254:                     if (packet.Params.TryGetProperty("app_whitelist", out var wlProp) && wlProp.ValueKind != JsonValueKind.Null)
255:                     {
256:                         whitelist = JsonSerializer.Deserialize<List<string>>(wlProp.GetRawText());
257:                     }
258: 
259:                     if (packet.Params.TryGetProperty("sandbox_path", out var sbProp) && sbProp.ValueKind != JsonValueKind.Null)
260:                     {
261:                         sandbox = sbProp.GetString();
262:                     }
263: 
264:                     SecurityManager.UpdatePolicy(whitelist, sandbox);
265: 
266:                     // Gửi xác nhận thành công về cho Gateway
267:                     SendResponse(new 
268:                     {
269:                         type = "policy_update_result",
270:                         agent_id = AgentId,
271:                         command_id = packet.CommandId,
272:                         success = true,
273:                         message = "Policy updated successfully in RAM."
274:                     });
275:                 }
276:                 catch (Exception ex)
277:                 {
278:                     Log.Error(ex, "[AgentClient] Lỗi khi giải mã tham số policy_update");
279:                     
280:                     // Gửi báo cáo lỗi về cho Gateway
281:                     SendResponse(new 
282:                     {
283:                         type = "policy_update_result",
284:                         agent_id = AgentId,
285:                         command_id = packet.CommandId,
286:                         success = false,
287:                         message = $"Failed to parse policy data: {ex.Message}"
288:                     });
289:                 }
290:                 return;
291:             }
292: 
293:             if (packet.Type == "permission_request")
294:             {
295:                 _ = Task.Run(async () =>
296:                 {
297:                     ConsentOutcome outcome = await UIManager.ShowConsentPopupOutcomeAsync(packet.Feature, 30000);
298:                     bool granted = outcome == ConsentOutcome.Granted;
299:                     if (granted)
300:                     {
301:                         lock (_grantedFeatures)
302:                         {
303:                             _grantedFeatures.Add(packet.Feature);
304:                         }
305:                     }
306:                     AuditLogger.LogCommand(packet.CommandId, "permission_request", packet.Feature, granted);
307:                     SendResponse(new
308:                     {
309:                         type = "permission_result",
310:                         agent_id = AgentId,
311:                         feature = packet.Feature,
312:                         granted = granted
313:                     });
314: 
315:                     // Remote Input has NO start/stop command of its own (each input_*
316:                     // packet is one-shot) — so the "started/denied" signal must be
317:                     // synthesised here from the consent outcome. Distinguish timeout
318:                     // vs decline vs busy so the operator sees an accurate toast.
319:                     if (packet.Feature == "input")
320:                     {
321:                         InputModule inputMod = ResolveInputModule();
322:                         if (granted)
323:                         {
324:                             inputMod?.OnInputGranted(packet.CommandId);
325:                         }
326:                         else
327:                         {
328:                             string reason = outcome switch
329:                             {
330:                                 ConsentOutcome.Timeout  => "timeout",
331:                                 ConsentOutcome.Busy     => "busy",
332:                                 _                       => "user declined",
333:                             };
334:                             SendResponse(new
335:                             {
336:                                 type       = "input_denied",
337:                                 agent_id   = AgentId,
338:                                 command_id = packet.CommandId,
339:                                 reason     = reason,
340:                             });
341:                         }
342:                     }
343:                 });
344:                 return;
345:             }
346: 
347:             if (packet.Type == "permission_revoke")
348:             {
349:                 lock (_grantedFeatures)
350:                 {
351:                     _grantedFeatures.Remove(packet.Feature);
352:                 }
353:                 AuditLogger.LogCommand(packet.CommandId, "permission_revoke", packet.Feature, false);
354: 
355:                 if (packet.Feature == "input")
356:                 {
357:                     ResolveInputModule()?.OnInputRevoked();                                         // Hide overlay + emit input_stopped
358:                 }
359:                 return;
360:             }
361: 
362:             if (packet.Type == "stop_module")
363:             {
364:                 // Remote Input is stateless — stop just means "hide indicator + notify".          //
365:                 if (packet.Feature == "input")
366:                 {
367:                     ResolveInputModule()?.OnInputRevoked();
368:                     return;
369:                 }
370: 
371:                 string commandToStop = packet.Feature switch
372:                 {
373:                     "screen" => "screen_stream_stop",
374:                     "keylog" => "keylog_stop",
375:                     "webcam" => "webcam_stop",
376:                     _ => null
377:                 };
378: 
379:                 if (commandToStop != null && _moduleRegistry.TryGetValue(commandToStop, out BaseModule mod))
380:                 {
381:                     _ = Task.Run(async () => await mod.ExecuteAsync(commandToStop, packet.Params, packet.CommandId));
382:                 }
383:                 return;
384:             }
385: 
386:             // SỬA: Định tuyến thông minh, gộp chung xử lý cho mọi module kể cả Power
387:             string routingKey = packet.Module ?? packet.Type; 
388:             
389:             // THÊM: Gate kiểm tra quyền
390:             if (_commandToFeatureMap.TryGetValue(routingKey, out string requiredFeature))
391:             {
392:                 bool hasPermission;
393:                 lock (_grantedFeatures)
394:                 {
395:                     hasPermission = _grantedFeatures.Contains(requiredFeature);
396:                 }
397:                 
398:                 if (!hasPermission)
399:                 {
400:                     AuditLogger.LogCommand(packet.CommandId, packet.Type, requiredFeature, false);
401:                     SendResponse(new { 
402:                         type = "module_error", 
403:                         agent_id = AgentId, 
404:                         feature = requiredFeature, 
405:                         message = "Chưa được cấp quyền" 
406:                     });
407:                     return;
408:                 }
409:             }
410: 
411:             if (routingKey != null && _moduleRegistry.TryGetValue(routingKey, out BaseModule module))
412:             {
413:                 if (_commandToFeatureMap.TryGetValue(routingKey, out string f))
414:                 {
415:                     AuditLogger.LogCommand(packet.CommandId, packet.Type, f, true);
416:                 }
417: 
418:                 // Sử dụng Fire-and-Forget Task với async/await
419:                 _ = Task.Run(async () =>
420:                 {
421:                     try
422:                     {
423:                         await module.ExecuteAsync(packet.Action ?? routingKey, packet.Params, packet.CommandId);
424:                     }
425:                     catch (Exception ex)
426:                     {
427:                         SendResponse(new { type = "ERROR", agent_id = AgentId, command_id = packet.CommandId, message = ex.Message });
428:                     }
429:                 });
430:             }
431:         }
432: 
433:         private bool ValidatePacket(CommandPacket packet)
434:         {
435:             // command_id không được rỗng (trừ một số lệnh đặc biệt nếu có)
436:             if (string.IsNullOrWhiteSpace(packet.CommandId)) 
437:                 return false;
438:             
439:             // target_agents phải chứa AgentId này (hoặc rỗng/null = broadcast)
440:             if (packet.TargetAgents != null && packet.TargetAgents.Length > 0)
441:             {
442:                 if (!Array.Exists(packet.TargetAgents, t => t == AgentId || t == "all"))
443:                     return false;
444:             }
445:             
446:             return true;
447:         }
448:     }
449: }
