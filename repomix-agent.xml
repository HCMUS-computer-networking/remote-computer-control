<file path="agent/Managers/UIManager.cs">
  1: using System;
  2: using System.Drawing;
  3: using System.Threading;
  4: using System.Windows.Forms;
  5: using Timer = System.Windows.Forms.Timer;
  6: using Serilog;
  7: using System.Runtime.InteropServices;
  8: 
  9: namespace AgentSystem.Managers
 10: {
 11:     // Outcome of a consent popup. The bool return of ShowConsentPopupAsync
 12:     // conflated three cases; callers that need to surface a precise reason
 13:     // (e.g. Remote Input toast on the Controller) use the enum overload.
 14:     public enum ConsentOutcome
 15:     {
 16:         Granted,                                                                                    // User clicked Approve
 17:         Declined,                                                                                   // User clicked Reject
 18:         Timeout,                                                                                    // ConsentForm auto-closed without a click
 19:         Busy,                                                                                       // Anti-DoS: previous popup for same module still open
 20:     }
 21: 
 22:     public class UIManager
 23:     {
 24:         private OverlayForm currentOverlay;                                                         //
 25:         private Thread overlayThread;                                                               //
 26:         private InputOverlayForm currentInputOverlay;                                               // Separate overlay for Remote Input so it does not collide with Webcam red dot
 27:         private Thread inputOverlayThread;                                                          //
 28:         private static HashSet<string> _activePermissionPopups = new HashSet<string>();
 29:         private static readonly object _lock = new object();
 30:         
 31:         // 1. Consent popup — blocks the caller until the user answers or timeout fires.
 32:         //    ConsentOutcome tells the caller WHICH negative case happened so it can
 33:         //    surface a clearer reason to the operator (e.g. Remote Input toast).
 34:         public async Task<ConsentOutcome> ShowConsentPopupOutcomeAsync(string moduleName, int timeoutMs)
 35:         {
 36:             lock (_lock)
 37:             {
 38:                 // Anti-DoS: an earlier popup for the SAME module is still open, so
 39:                 // reject this request immediately instead of stacking dialogs.
 40:                 if (_activePermissionPopups.Contains(moduleName))
 41:                 {
 42:                     Log.Information("[UIManager] Consent request for '{moduleName}' auto-rejected (previous popup still open — Anti-DoS).", moduleName);
 43:                     return ConsentOutcome.Busy;
 44:                 }
 45:                 _activePermissionPopups.Add(moduleName);
 46:             }
 47: 
 48:             var tcs = new TaskCompletionSource<bool>();                                             // true = user clicked Approve
 49: 
 50:             Thread uiThread = new Thread(() =>
 51:             {
 52:                 try
 53:                 {
 54:                     using (var form = new ConsentForm(moduleName, timeoutMs))
 55:                     {
 56:                         form.ShowDialog();
 57:                         tcs.TrySetResult(form.IsApproved);
 58:                     }
 59:                 }
 60:                 catch (Exception ex)
 61:                 {
 62:                     // Surface the exception to the awaiting Task rather than
 63:                     // silently hanging the permission_request pipeline.
 64:                     tcs.TrySetException(ex);
 65:                 }
 66:                 finally
 67:                 {
 68:                     lock (_lock)
 69:                     {
 70:                         _activePermissionPopups.Remove(moduleName);
 71:                     }
 72:                 }
 73:             });
 74:             uiThread.SetApartmentState(ApartmentState.STA);
 75:             uiThread.Start();
 76: 
 77:             // Hard timeout guard = form's own timeout + 2 s slack for teardown.
 78:             // When THIS delay wins, the ConsentForm never posted a result, so
 79:             // we treat it as a genuine hard-timeout (not a user decline).
 80:             var completedTask = await Task.WhenAny(tcs.Task, Task.Delay(timeoutMs + 2000));
 81:             if (completedTask == tcs.Task)
 82:             {
 83:                 bool approved = await tcs.Task;
 84:                 return approved ? ConsentOutcome.Granted : ConsentOutcome.Declined;
 85:             }
 86: 
 87:             Log.Warning("[UIManager] ConsentForm hard-timeout triggered for '{moduleName}'.", moduleName);
 88:             lock (_lock) { _activePermissionPopups.Remove(moduleName); }
 89:             return ConsentOutcome.Timeout;
 90:         }
 91: 
 92:         // Legacy bool wrapper — kept so PowerModule and any other caller that
 93:         // only cares about "did the user say yes" does not need to change.
 94:         public async Task<bool> ShowConsentPopupAsync(string moduleName, int timeoutMs)
 95:         {
 96:             ConsentOutcome outcome = await ShowConsentPopupOutcomeAsync(moduleName, timeoutMs);
 97:             return outcome == ConsentOutcome.Granted;
 98:         }
