  1: using System;
  2: using System.Drawing;
  3: using System.Drawing.Imaging;
  4: using System.IO;
  5: using System.Text.Json;
  6: using System.Threading;
  7: using System.Threading.Tasks;
  8: using AgentSystem.Core;
  9: using OpenCvSharp;
 10: using OpenCvSharp.Extensions;
 11: using Serilog;
 12: using AgentSystem.Utils;
 13: using AgentSystem.Managers;
 14: 
 15: namespace AgentSystem.Modules
 16: {
 17:     public class WebcamModule : BaseModule
 18:     {
 19:         private VideoCapture capture;
 20:         private bool isCapturing = false;
 21:         private int currentSequence = 0;
 22:         private int currentQuality = 60;
 23:         private int currentFps = 15;
 24:         
 25:         // Cải tiến sử dụng SemaphoreSlim thay thế lock để có thể dùng với async/await
 26:         private readonly SemaphoreSlim captureSemaphore = new SemaphoreSlim(1, 1);
 27:         private CancellationTokenSource webcamCts;
 28:         private CancellationTokenSource _startupCts;
 29: 
 30:         public override string[] SupportedCommands => new[] { "webcam_start", "webcam_stop" };
 31: 
 32:         public WebcamModule(IAgentContext context, SecurityManager security, UIManager ui) 
 33:             : base(context, security, ui) { }
 34: 
 35:         public override async Task ExecuteAsync(string action, JsonElement parameters, string commandId)
 36:         {
 37:             if (action == "webcam_start")
 38:             {
 39:                 currentQuality = parameters.TryGetProperty("quality", out var qProp) ? qProp.GetInt32() : 60;
 40:                 currentFps = parameters.TryGetProperty("fps", out var fpsProp) ? fpsProp.GetInt32() : 15;
 41:                 await StartWebcamWithConsentAsync(commandId);
 42:             }
 43:             else if (action == "webcam_stop")
 44:             {
 45:                 StopWebcam(commandId);
 46:             }
 47:         }
 48: 
 49:         public override void OnDisconnected()
 50:         {
 51:             _startupCts?.Cancel();
 52:             if (isCapturing)
 53:             {
 54:                 Log.Warning("[WebcamModule] Phát hiện mất kết nối mạng. Đang tự động tắt Webcam...");
 55:                 StopWebcam("auto_disconnect");
 56:             }
 57:         }
 58: 
 59:         private async Task StartWebcamWithConsentAsync(string commandId)
 60:         {
 61:             if (isCapturing)
 62:             {
 63:                 Log.Information("Đã điều chỉnh Webcam sang FPS: {Fps}, Quality: {Quality}", currentFps, currentQuality);
 64:                 context.SendResponse(new { type = "webcam_updated", agent_id = context.AgentId, command_id = commandId });
 65:                 return;
 66:             }
 67: 
 68:             ui.ShowCountdown(10, "Cảnh báo Ghi hình", "Camera sẽ được kích hoạt sau {0} giây...");
 69:             
 70:             _startupCts = new CancellationTokenSource();
 71:             try
 72:             {
 73:                 await Task.Delay(10000, _startupCts.Token);
 74:             }
 75:             catch (TaskCanceledException)
 76:             {
 77:                 return;
 78:             }
 79: 
 80:             capture = new VideoCapture(0); 
 81:             if (!capture.IsOpened())
 82:             {
 83:                 context.SendResponse(new 
 84:                 { 
 85:                     type = "ERROR", 
 86:                     agent_id = context.AgentId,
 87:                     command_id = commandId,
 88:                     message = "No webcam found or access denied" 
 89:                 });
 90:                 return;
 91:             }
 92:             
 93:             double currentWidth = capture.Get(VideoCaptureProperties.FrameWidth);
 94:             double currentHeight = capture.Get(VideoCaptureProperties.FrameHeight);
 95: 
 96:             if (currentWidth > 1280 || currentHeight > 720)
 97:             {
 98:                 capture.Set(VideoCaptureProperties.FrameWidth, 1280);
 99:                 capture.Set(VideoCaptureProperties.FrameHeight, 720);
100:                 Log.Information("Đã giảm độ phân giải Webcam từ {W}x{H} xuống 1280x720", currentWidth, currentHeight);
101:             }
102: 
103:             ui.ShowRedDotOverlay();
104: 
105:             isCapturing = true;
106:             currentSequence = 1;
107:             
108:             webcamCts = new CancellationTokenSource();
109: 
110:             // Khởi động luồng chạy ngầm OpenCV (Vẫn dùng Task.Run vì capture.Read() có thể block)
111:             _ = Task.Run(() => CaptureLoopAsync(webcamCts.Token, commandId));
112: 
113:             context.SendResponse(new 
114:             { 
115:                 type = "webcam_started", 
116:                 agent_id = context.AgentId,
117:                 command_id = commandId 
118:             });
119:         }
120: 
121:         private async Task CaptureLoopAsync(CancellationToken token, string commandId)
122:         {
123:             try
124:             {
125:                 using (Mat frame = new Mat())
126:                 {
127:                     while (isCapturing && capture != null && !capture.IsDisposed && !token.IsCancellationRequested)
128:                     {
129:                         if (capture.Read(frame) && !frame.Empty())
130:                         {
131:                             await ProcessAndSendFrameAsync(frame, commandId);
132:                         }
133: 
134:                         int sleepMs = 1000 / (currentFps > 0 ? currentFps : 15);
135:                         
136:                         // Thay thế Thread.Sleep bằng Delay bất đồng bộ
137:                         await Task.Delay(sleepMs, token);
138:                     }
139:                 }
140:             }
141:             catch (OperationCanceledException)
142:             {
143:                 // Ngắt mượt mà khi huỷ Token
144:             }
145:             catch (Exception ex)
146:             {
147:                 Log.Error(ex, "Lỗi vòng lặp thu hình Webcam ngầm: {ErrorMessage}", ex.Message);
148:             }
149:             finally
150:             {
151:                 isCapturing = false;
152: 
153:                 if (capture != null)
154:                 {
155:                     try
156:                     {
157:                         if (!capture.IsDisposed) capture.Release();
158:                         capture.Dispose();
159:                     }
160:                     catch { }
161:                     capture = null;
162:                 }
163: 
164:                 ui.HideRedDotOverlay(); 
165:             }
166:         }
167: 
168:         private async Task ProcessAndSendFrameAsync(Mat frame, string commandId)
169:         {
170:             bool lockTaken = await captureSemaphore.WaitAsync(0);
171:             if (!lockTaken) return;
172: 
173:             try
174:             {
175:                 using (Bitmap bitmap = frame.ToBitmap())
176:                 {
177:                     byte[] frameBytes = ImageUtils.CompressImageToJpeg(bitmap, currentQuality);
178: 
179:                     long timestamp = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
180:                     ushort seq = (ushort)currentSequence++;
181:                     Rectangle bounds = new Rectangle(0, 0, bitmap.Width, bitmap.Height);
182:                     await UdpStreamSender.SendFrameAsync(context.AgentId, commandId, 1, seq, frameBytes, timestamp, true, bounds, context.Crypto);
183:                 }
184:             }
185:             catch (Exception ex)
186:             {
187:                 Log.Error(ex, "Lỗi xử lý và gửi khung hình Webcam: {ErrorMessage}", ex.Message);
188:             }
189:             finally
190:             {
191:                 captureSemaphore.Release();
192:             }
193:         }
194: 
195:         private void StopWebcam(string commandId)
196:         {
197:             isCapturing = false;
198:             
199:             _startupCts?.Cancel();
200: 
201:             // Ra lệnh ngừng delay ngay lập tức
202:             webcamCts?.Cancel();
203:             webcamCts?.Dispose();
204:             webcamCts = null;
205: 
206:             context.SendResponse(new 
207:             { 
208:                 type = "webcam_stopped", 
209:                 agent_id = context.AgentId,
210:                 command_id = commandId 
211:             });
212:         }
213:     }
214: }
