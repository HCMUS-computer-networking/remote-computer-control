<file path="agent/Modules/CryptoModule.cs">
  1: using System;
  2: using System.IO;
  3: using System.Security.Cryptography;
  4: using System.Text;
  5: 
  6: namespace agent.Modules
  7: {
  8:     public class CryptoModule : IDisposable
  9:     {
 10:         private ECDiffieHellman _ecdh;
 11:         private byte[] _sessionKey;
 12:         private byte[] _udpSessionKey;
 13:         private uint _udpFramesSent = 0;
 14:         public uint UdpEpoch => _udpFramesSent / 100;
 15:         private readonly string _e2eeSharedSecret;
 16: 
 17:         public bool IsE2EEReady => _sessionKey != null;
 18: 
 19:         public CryptoModule(string e2eeSharedSecret)
 20:         {
 21:             _e2eeSharedSecret = e2eeSharedSecret;
 22:             // Initialize ECDH with NIST P-256 (secp256r1)
 23:             _ecdh = ECDiffieHellman.Create(ECCurve.NamedCurves.nistP256);
 24:         }
 25: 
 26:         // Sequence Number for Sliding Window
 27:         private uint _sendSeq = 0;
 28:         private uint _recvSeq = unchecked((uint)-1);
 29:         private readonly object _seqLock = new object();
 30: 
 31:         public uint GetNextSendSeq()
 32:         {
 33:             lock (_seqLock)
 34:             {
 35:                 return ++_sendSeq;
 36:             }
 37:         }
 38: 
 39:         public bool CheckAndUpdateRecvSeq(uint seq)
 40:         {
 41:             lock (_seqLock)
 42:             {
 43:                 // Sliding window size = 5
 44:                 if (_recvSeq != unchecked((uint)-1) && seq + 5 <= _recvSeq)
 45:                 {
 46:                     return false; // Replay / Too old
 47:                 }
 48: 
 49:                 if (_recvSeq == unchecked((uint)-1) || seq > _recvSeq)
 50:                 {
 51:                     _recvSeq = seq;
 52:                 }
 53:                 return true;
 54:             }
 55:         }
 56: 
 57:         /// <summary>
 58:         /// Exports the Agent's Public Key as a Base64 SPKI string.
 59:         /// </summary>
 60:         public string GetPublicKeySPKIBase64()
 61:         {
 62:             byte[] spkiBytes = _ecdh.ExportSubjectPublicKeyInfo();
 63:             return Convert.ToBase64String(spkiBytes);
 64:         }
 65: 
 66:         /// <summary>
 67:         /// Signs the Base64 SPKI string using HMAC-SHA256 and the shared PIN.
 68:         /// </summary>
 69:         public string SignHMAC(string dataBase64)
 70:         {
 71:             byte[] keyBytes = Encoding.UTF8.GetBytes(_e2eeSharedSecret);
 72:             using (var hmac = new HMACSHA256(keyBytes))
 73:             {
 74:                 byte[] dataBytes = Encoding.UTF8.GetBytes(dataBase64);
 75:                 byte[] signatureBytes = hmac.ComputeHash(dataBytes);
 76:                 return Convert.ToBase64String(signatureBytes);
 77:             }
 78:         }
 79: 
 80:         /// <summary>
 81:         /// Verifies the HMAC-SHA256 signature from the Controller.
 82:         /// </summary>
 83:         public bool VerifyHMAC(string dataBase64, string signatureBase64)
 84:         {
 85:             string expectedSignature = SignHMAC(dataBase64);
 86:             return expectedSignature == signatureBase64;
 87:         }
 88: 
 89:         /// <summary>
 90:         /// Derives the AES-256-GCM Session Key using HKDF.
 91:         /// </summary>
 92:         public void DeriveSessionKey(string controllerPublicKeySPKIBase64)
 93:         {
 94:             byte[] controllerSpki = Convert.FromBase64String(controllerPublicKeySPKIBase64);
 95:             using (var controllerKey = ECDiffieHellman.Create())
 96:             {
 97:                 controllerKey.ImportSubjectPublicKeyInfo(controllerSpki, out _);
 98: 
 99:                 // Derive the raw shared secret
100:                 byte[] sharedSecret = _ecdh.DeriveKeyMaterial(controllerKey.PublicKey);
101: 
102:                 // Use HKDF to derive the final session key, matching Web Crypto API
103:                 _sessionKey = HKDF.DeriveKey(
104:                     hashAlgorithmName: HashAlgorithmName.SHA256,
105:                     ikm: sharedSecret,
106:                     outputLength: 32, // 256 bits
107:                     salt: Array.Empty<byte>(),
108:                     info: Encoding.UTF8.GetBytes("RemoteControl_E2EE_v1")
109:                 );
110: 
111:                 _udpSessionKey = HKDF.DeriveKey(
112:                     hashAlgorithmName: HashAlgorithmName.SHA256,
113:                     ikm: sharedSecret,
114:                     outputLength: 32, // 256 bits
115:                     salt: Array.Empty<byte>(),
116:                     info: Encoding.UTF8.GetBytes("RemoteControl_UDP_v1")
117:                 );
118: 
119:                 // Reset sequence numbers for the new session (important when Controller refreshes without Agent reconnecting)
120:                 lock (_seqLock)
121:                 {
122:                     _sendSeq = 0;
123:                     _recvSeq = unchecked((uint)-1);
124:                 }
125:             }
126:         }
127: 
128:         public void RatchetUdpKey()
129:         {
130:             byte[] msg = new byte[_udpSessionKey.Length + 10];
131:             Buffer.BlockCopy(_udpSessionKey, 0, msg, 0, _udpSessionKey.Length);
132:             byte[] ratchetStr = Encoding.UTF8.GetBytes("Ratchet_v1");
133:             Buffer.BlockCopy(ratchetStr, 0, msg, _udpSessionKey.Length, ratchetStr.Length);
134:             
135:             using (var sha = SHA256.Create())
136:             {
137:                 _udpSessionKey = sha.ComputeHash(msg);
138:             }
139:         }
140: 
141:         /// <summary>
142:         /// Generates a random 12-byte IV for AES-GCM.
143:         /// </summary>
144:         public byte[] GenerateIV()
145:         {
146:             byte[] iv = new byte[12];
147:             RandomNumberGenerator.Fill(iv);
148:             return iv;
149:         }
150: 
151:         /// <summary>
152:         /// Encrypts data using AES-GCM.
153:         /// Returns a byte array structured as: [IV (12)] + [Ciphertext (N)] + [AuthTag (16)]
154:         /// </summary>
155:         public byte[] EncryptAESGCM(byte[] plaintext, byte[] aad = null)
156:         {
157:             if (!IsE2EEReady)
158:                 throw new InvalidOperationException("E2EE is not ready. Session key is missing.");
159: 
160:             byte[] iv = GenerateIV();
161:             byte[] ciphertext = new byte[plaintext.Length];
162:             byte[] authTag = new byte[16];
163: 
164:             using (var aesGcm = new AesGcm(_sessionKey, 16))
165:             {
166:                 aesGcm.Encrypt(iv, plaintext, ciphertext, authTag, aad);
167:             }
168: 
169:             // Pack the E2EE Packet: IV + Ciphertext + AuthTag
170:             byte[] e2eePacket = new byte[iv.Length + ciphertext.Length + authTag.Length];
171:             Buffer.BlockCopy(iv, 0, e2eePacket, 0, iv.Length);
172:             Buffer.BlockCopy(ciphertext, 0, e2eePacket, iv.Length, ciphertext.Length);
173:             Buffer.BlockCopy(authTag, 0, e2eePacket, iv.Length + ciphertext.Length, authTag.Length);
174: 
175:             return e2eePacket;
176:         }
177: 
178:         public byte[] EncryptUdpAESGCM(byte[] plaintext, byte[] aad = null)
179:         {
180:             if (!IsE2EEReady)
181:                 throw new InvalidOperationException("E2EE is not ready. Session key is missing.");
182: 
183:             uint currentEpoch = UdpEpoch;
184:             _udpFramesSent++;
185:             uint nextEpoch = UdpEpoch;
186: 
187:             if (nextEpoch > currentEpoch)
188:             {
189:                 RatchetUdpKey();
190:             }
191: 
192:             byte[] iv = GenerateIV();
193:             byte[] ciphertext = new byte[plaintext.Length];
194:             byte[] authTag = new byte[16];
195: 
196:             using (var aesGcm = new AesGcm(_udpSessionKey, 16))
197:             {
198:                 aesGcm.Encrypt(iv, plaintext, ciphertext, authTag, aad);
199:             }
200: 
201:             byte[] e2eePacket = new byte[iv.Length + ciphertext.Length + authTag.Length];
202:             Buffer.BlockCopy(iv, 0, e2eePacket, 0, iv.Length);
203:             Buffer.BlockCopy(ciphertext, 0, e2eePacket, iv.Length, ciphertext.Length);
204:             Buffer.BlockCopy(authTag, 0, e2eePacket, iv.Length + ciphertext.Length, authTag.Length);
205: 
206:             return e2eePacket;
207:         }
208: 
209:         /// <summary>
210:         /// Decrypts an E2EE packet structured as: [IV (12)] + [Ciphertext (N)] + [AuthTag (16)]
211:         /// </summary>
212:         public byte[] DecryptAESGCM(byte[] e2eePacket, byte[] aad = null)
213:         {
214:             if (!IsE2EEReady)
215:                 throw new InvalidOperationException("E2EE is not ready. Session key is missing.");
216: 
217:             if (e2eePacket.Length < 12 + 16)
218:                 throw new ArgumentException("Packet is too small to be a valid E2EE packet.");
219: 
220:             byte[] iv = new byte[12];
221:             byte[] authTag = new byte[16];
222:             byte[] ciphertext = new byte[e2eePacket.Length - 12 - 16];
223: 
224:             Buffer.BlockCopy(e2eePacket, 0, iv, 0, 12);
225:             Buffer.BlockCopy(e2eePacket, 12, ciphertext, 0, ciphertext.Length);
226:             Buffer.BlockCopy(e2eePacket, 12 + ciphertext.Length, authTag, 0, 16);
227: 
228:             byte[] plaintext = new byte[ciphertext.Length];
229: 
230:             using (var aesGcm = new AesGcm(_sessionKey, 16))
231:             {
232:                 aesGcm.Decrypt(iv, ciphertext, authTag, plaintext, aad);
233:             }
234: 
235:             return plaintext;
236:         }
237: 
238:         /// <summary>
239:         /// Resets the Crypto Module (e.g., for Reconnect)
240:         /// </summary>
241:         public void Reset()
242:         {
243:             if (_sessionKey != null)
244:             {
245:                 Array.Clear(_sessionKey, 0, _sessionKey.Length);
246:                 _sessionKey = null;
247:             }
248:             if (_udpSessionKey != null)
249:             {
250:                 Array.Clear(_udpSessionKey, 0, _udpSessionKey.Length);
251:                 _udpSessionKey = null;
252:             }
253:             _udpFramesSent = 0;
254:             _ecdh?.Dispose();
255:             _ecdh = ECDiffieHellman.Create(ECCurve.NamedCurves.nistP256);
256:             
257:             // Reset lại Sequence Number để khớp với Controller sau khi Reconnect
258:             lock (_seqLock)
259:             {
260:                 _sendSeq = 0;
261:                 _recvSeq = unchecked((uint)-1);
262:             }
263:         }
264: 
265:         public void Dispose()
266:         {
267:             _ecdh?.Dispose();
268:             if (_sessionKey != null)
269:             {
270:                 Array.Clear(_sessionKey, 0, _sessionKey.Length);
271:             }
272:             if (_udpSessionKey != null)
273:             {
274:                 Array.Clear(_udpSessionKey, 0, _udpSessionKey.Length);
275:             }
276:         }
277:     }
278: }
</file>

<file path="agent/Modules/PowerModule.cs">
  1: using System;
  2: using System.Diagnostics;
  3: using System.Text.Json;
  4: using System.Threading;
  5: using AgentSystem.Core;
  6: using AgentSystem.Managers;
  7: using Serilog;
  8: 
  9: namespace AgentSystem.Modules
 10: {
 11:     public class PowerModule : BaseModule
 12:     {
 13:         public override string[] SupportedCommands => new[] { "power" };
 14:         public PowerModule(IAgentContext context, SecurityManager security, UIManager ui) : base(context, security, ui) { }
 15: 
 16:         public override async Task ExecuteAsync(string action, JsonElement parameters, string commandId)
 17:         {
 18:             try
 19:             {
 20:                 string safeAction = action?.ToLower() ?? string.Empty;
 21: 
 22:                 // 1. Kiểm tra quyền thực thi (Popup Consent)
 23:                 // Lệnh "lock" được phép chạy ngay lập tức, các lệnh khác phải xin phép.
 24:                 if (safeAction == "shutdown" || safeAction == "restart" || safeAction == "sleep")
 25:                 {
 26:                     // Hiển thị popup chờ tối đa 30 giây (30000ms)
 27:                     bool isApproved = await ui.ShowConsentPopupAsync("power", 30000);
 28: 
 29:                     if (!isApproved)
 30:                     {
 31:                         AuditLogger.LogCommand(commandId, "power", safeAction, false);
 32:                         context.SendResponse(new
 33:                         {
 34:                             type = "power_result",
 35:                             agent_id = context.AgentId,
 36:                             action = safeAction,
 37:                             confirmed = false,
 38:                             message = "User declined permission"
 39:                         });
 40:                         return; // Ngắt luồng, không thực thi
 41:                     }
 42:                 }
 43: 
 44:                 bool success = true;
 45:                 string message = $"System is executing {safeAction}";
 46: 
 47:                 // 2. Thực thi lệnh
 48:                 switch (safeAction)
 49:                 {
 50:                     case "shutdown":
 51:                         ExecuteSystemCommand("shutdown", "/s /t 0 /f");
 52:                         break;
 53:                     case "restart":
 54:                         ExecuteSystemCommand("shutdown", "/r /t 0 /f");
 55:                         break;
 56:                     case "sleep":
 57:                         // Lệnh đưa Windows vào chế độ Sleep (hoặc Hibernate tùy cấu hình)
 58:                         ExecuteSystemCommand("rundll32.exe", "powrprof.dll,SetSuspendState 0,1,0");
 59:                         break;
 60:                     case "lock":
 61:                         ExecuteSystemCommand("rundll32.exe", "user32.dll,LockWorkStation");
 62:                         break;
 63:                     default:
 64:                         success = false;
 65:                         message = $"Unknown power action: {action}";
 66:                         break;
 67:                 }
 68:                 AuditLogger.LogCommand(commandId, "power", safeAction, success);
 69:                 Log.Information("[PowerModule] Thực thi lệnh nguồn '{Action}' từ Gateway...", safeAction);
 70: 
 71:                 // 3. Trả về kết quả
 72:                 context.SendResponse(new
 73:                 {
 74:                     type = "power_result",
 75:                     command_id = commandId,
 76:                     action = safeAction,
 77:                     confirmed = success,
 78:                     message = message,
 79:                     agent_id = context.AgentId
 80:                 });
 81:             }
 82:             catch (Exception ex)
 83:             {
 84:                 Log.Error(ex, "[PowerModule] Lỗi khi thực thi lệnh nguồn '{Action}'", action);
 85:                 context.SendResponse(new
 86:                 {
 87:                     type = "power_result",
 88:                     command_id = commandId,
 89:                     action = action,
 90:                     confirmed = false,
 91:                     message = $"Error executing power command: {ex.Message}"
 92:                 });
 93:             }
 94:         }
 95: 
 96:         private void ExecuteSystemCommand(string fileName, string arguments)
 97:         {
 98:             ProcessStartInfo psi = new ProcessStartInfo
 99:             {
100:                 FileName = fileName,
101:                 Arguments = arguments,
102:                 CreateNoWindow = true,
103:                 UseShellExecute = false
104:             };
105:             Process.Start(psi);
106:         }
107:     }
108: }
