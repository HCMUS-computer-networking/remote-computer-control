<file path="agent/Modules/SysInfoModule.cs">
  1: using System;
  2: using System.Diagnostics;
  3: using System.IO;
  4: using System.Linq;
  5: using System.Net;
  6: using System.Net.Sockets;
  7: using System.Text.Json;
  8: using System.Threading.Tasks;
  9: using AgentSystem.Core;
 10: using AgentSystem.Managers;
 11: 
 12: namespace AgentSystem.Modules
 13: {
 14:     public class SysInfoModule : BaseModule
 15:     {
 16:         public override string[] SupportedCommands => new[] { "sysinfo" };
 17:         
 18:         public SysInfoModule(IAgentContext context, SecurityManager security, UIManager ui) 
 19:             : base(context, security, ui) { }
 20: 
 21:         public override async Task ExecuteAsync(string action, JsonElement parameters, string commandId)
 22:         {
 23:             if (action == "sysinfo")
 24:             {
 25:                 await GetSysInfoAsync(commandId);
 26:             }
 27:         }
 28: 
 29:         private async Task GetSysInfoAsync(string commandId)
 30:         {
 31:             try
 32:             {
 33:                 // CPU
 34:                 double cpuPercent = await GetCpuUsageAsync();
 35:                 
 36:                 // RAM
 37:                 var gcMemoryInfo = GC.GetGCMemoryInfo();
 38:                 double ramTotalMb = Math.Round(gcMemoryInfo.TotalAvailableMemoryBytes / (1024.0 * 1024.0), 2);
 39:                 
 40:                 double ramAvailableMb = 0;
 41:                 try
 42:                 {
 43:                     using (var ramCounter = new PerformanceCounter("Memory", "Available MBytes", true))
 44:                     {
 45:                         ramAvailableMb = ramCounter.NextValue();
 46:                     }
 47:                 }
 48:                 catch { }
 49: 
 50:                 double ramUsedMb = Math.Max(0, ramTotalMb - ramAvailableMb);
 51: 
 52:                 // Disk
 53:                 double diskTotalGb = 0;
 54:                 double diskUsedGb = 0;
 55:                 foreach (DriveInfo drive in DriveInfo.GetDrives())
 56:                 {
 57:                     if (drive.IsReady && drive.DriveType == DriveType.Fixed)
 58:                     {
 59:                         diskTotalGb += drive.TotalSize / (1024.0 * 1024.0 * 1024.0);
 60:                         diskUsedGb += (drive.TotalSize - drive.TotalFreeSpace) / (1024.0 * 1024.0 * 1024.0);
 61:                     }
 62:                 }
 63: 
 64:                 // Uptime
 65:                 long uptimeSeconds = Environment.TickCount64 / 1000;
 66: 
 67:                 // IP
 68:                 string ip = Dns.GetHostAddresses(Dns.GetHostName())
 69:                     .FirstOrDefault(a => a.AddressFamily == AddressFamily.InterNetwork)?.ToString() ?? "unknown";
 70: 
 71:                 context.SendResponse(new
 72:                 {
 73:                     type = "sysinfo_result",
 74:                     agent_id = context.AgentId,
 75:                     command_id = commandId,
 76:                     cpu_percent = Math.Round(cpuPercent, 2),
 77:                     ram_used_mb = Math.Round(ramUsedMb, 2),
 78:                     ram_total_mb = Math.Round(ramTotalMb, 2),
 79:                     disk_used_gb = Math.Round(diskUsedGb, 2),
 80:                     disk_total_gb = Math.Round(diskTotalGb, 2),
 81:                     uptime_seconds = uptimeSeconds,
 82:                     hostname = Environment.MachineName,
 83:                     ip = ip,
 84:                     os = Environment.OSVersion.ToString()
 85:                 });
 86:             }
 87:             catch (Exception ex)
 88:             {
 89:                 context.SendResponse(new
 90:                 {
 91:                     type = "ERROR",
 92:                     agent_id = context.AgentId,
 93:                     command_id = commandId,
 94:                     message = $"Error getting sysinfo: {ex.Message}"
 95:                 });
 96:             }
 97:         }
 98: 
 99:         private async Task<double> GetCpuUsageAsync()
100:         {
101:             try
102:             {
103:                 using (var cpuCounter = new PerformanceCounter("Processor", "% Processor Time", "_Total", true))
104:                 {
105:                     cpuCounter.NextValue();
106:                     await Task.Delay(500); // Non-blocking wait
107:                     return cpuCounter.NextValue();
108:                 }
109:             }
110:             catch
111:             {
112:                 return 0;
113:             }
114:         }
115:     }
116: }
