168:         private async Task TakeSingleScreenshotAsync(int quality, string commandId)
169:         {
170:              if (isStreaming)
171:              {
172:                  await captureSemaphore.WaitAsync();
173:                  try
174:                  {
175:                      if (scaledBitmap != null)
176:                      {
177:                          byte[] imageBytes = ImageUtils.CompressImageToJpeg(scaledBitmap, quality);
178:                          long timestamp = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
179:                          await UdpStreamSender.SendFrameAsync(context.AgentId, commandId, 0, 0, imageBytes, timestamp, true, new Rectangle(0, 0, TargetSize.Width, TargetSize.Height), context.Crypto);
180:                          return;
181:                      }
182:                  }
183:                  finally
184:                  {
185:                      captureSemaphore.Release();
186:                  }
187:              }
188:              
189:              await CaptureAndSendAsync(commandId, quality, false);
190:         }
191:         public override void OnDisconnected()
192:         {
193:             if (isStreaming)
194:             {
195:                 Log.Warning("[StreamModule] Phát hiện mất kết nối mạng. Đang tự động ngắt quay màn hình...");
196:                 StopStream("auto_disconnect"); 
197:             }
198:         }
