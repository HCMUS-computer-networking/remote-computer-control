383:     // 4. Blue keyboard-icon Overlay for Remote Input (top-LEFT corner)                             //
384:     //    Rendered as a solid blue square with a white "K" so it is instantly                       //
385:     //    distinguishable from the webcam red dot (top-right).                                      //
386:     internal class InputOverlayForm : Form
387:     {
388:         private bool isIconVisible = true;                                                          //
389:         private Timer flashTimer;                                                                   //
390: 
391:         public InputOverlayForm()
392:         {
393:             this.FormBorderStyle = FormBorderStyle.None;
394:             this.TopMost         = true;
395:             this.ShowInTaskbar   = false;
396:             this.BackColor       = Color.Magenta;
397:             this.TransparencyKey = Color.Magenta;
398: 
399:             // Top-LEFT so it never overlaps the webcam overlay at top-right.
400:             this.Size     = new Size(50, 50);
401:             this.Location = new Point(20, 20);
402: 
403:             flashTimer = new Timer { Interval = 700 };                                              // Slower flash than webcam so the two are visually distinct
404:             flashTimer.Tick += (s, e) =>
405:             {
406:                 isIconVisible = !isIconVisible;
407:                 this.Invalidate();
408:             };
409:             flashTimer.Start();
410:         }
411: 
412:         protected override void OnPaint(PaintEventArgs e)
413:         {
414:             base.OnPaint(e);
415:             if (!isIconVisible) return;
416: 
417:             using (Brush bg = new SolidBrush(Color.DodgerBlue))
418:             {
419:                 e.Graphics.FillRectangle(bg, 5, 5, 40, 40);                                         // Solid blue rounded-ish square
420:             }
421:             using (Brush fg = new SolidBrush(Color.White))
422:             using (Font  font = new Font("Arial", 18, FontStyle.Bold))
423:             {
424:                 e.Graphics.DrawString("K", font, fg, 13, 8);                                        // "K" = keyboard/input
425:             }
426:         }
427: 
428:         // Click-through so it never steals input from the Agent user's own apps.
429:         protected override CreateParams CreateParams
430:         {
431:             get
432:             {
433:                 CreateParams cp = base.CreateParams;
434:                 cp.ExStyle |= 0x20;                                                                 // WS_EX_TRANSPARENT
435:                 return cp;
436:             }
437:         }
438: 
439:         // Stop + Dispose the flashing Timer when the form is torn down.                            //
440:         // Without this, every grant/revoke cycle would leak one WinForms                           //
441:         // Timer (and its GDI handle) — the loop runs on Application.Run's                          //
442:         // pumped thread and outlives the form otherwise.                                           //
443:         protected override void Dispose(bool disposing)
444:         {
445:             if (disposing && flashTimer != null)
446:             {
447:                 flashTimer.Stop();
448:                 flashTimer.Dispose();
449:                 flashTimer = null;
450:             }
451:             base.Dispose(disposing);
452:         }
453:     }
454: 
455:     #endregion
456: }
