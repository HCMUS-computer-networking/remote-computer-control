100:         private async void BtnScan_Click(object sender, EventArgs e)
101:         {
102:             btnScan.Enabled = false;
103:             lblStatus.Text = "Đang lắng nghe tín hiệu Gateway trên mạng LAN (Port 8888)...";
104:             lblStatus.ForeColor = Color.Blue;
105: 
106:             cts = new CancellationTokenSource();
107:             
108:             try
109:             {
110:                 // Mở cổng UDP 8888 để lắng nghe Broadcast
111:                 using (UdpClient udpClient = new UdpClient(8888))
112:                 {
113:                     // Chờ tối đa 5 giây
114:                     var receiveTask = udpClient.ReceiveAsync();
115:                     var delayTask = Task.Delay(5000, cts.Token);
116:                     
117:                     var completedTask = await Task.WhenAny(receiveTask, delayTask);
118: 
119:                     if (completedTask == receiveTask)
120:                     {
121:                         var result = receiveTask.Result;
122:                         string message = Encoding.UTF8.GetString(result.Buffer);
123:                         
124:                         // Quy ước: Gateway gửi chuỗi "GATEWAY_ANNOUNCE|wss://192.168.X.X:8080"
125:                         if (message.StartsWith("GATEWAY_ANNOUNCE|"))
126:                         {
127:                             string[] parts = message.Split('|');
128:                             if (parts.Length == 2)
129:                             {
130:                                 // Kiểm tra an toàn: Đảm bảo Gateway trả về link WSS
131:                                 string discoveredUrl = parts[1];
132:                                 
133:                                 txtUrl.Text = discoveredUrl;
134:                                 lblStatus.Text = $"Tìm thấy Gateway an toàn tại: {result.RemoteEndPoint.Address}";
135:                                 lblStatus.ForeColor = Color.Green;
136:                             }
137:                         }
138:                     }
139:                     else
140:                     {
141:                         lblStatus.Text = "Hết thời gian (5s). Không tìm thấy Gateway nào phát tín hiệu.";
142:                         lblStatus.ForeColor = Color.Red;
143:                     }
144:                 }
145:             }
146:             catch (SocketException ex)
147:             {
148:                 lblStatus.Text = $"Lỗi cổng UDP: {ex.Message} (Có thể app khác đang dùng port 8888)";
149:                 lblStatus.ForeColor = Color.Red;
150:             }
151:             catch (Exception ex)
152:             {
153:                 lblStatus.Text = $"Lỗi: {ex.Message}";
154:                 lblStatus.ForeColor = Color.Red;
155:             }
156:             finally
157:             {
158:                 btnScan.Enabled = true;
159:                 cts.Dispose();
160:             }
161:         }
162:     }
163: }
