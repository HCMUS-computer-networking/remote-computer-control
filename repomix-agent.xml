14:             ImageCodecInfo jpegEncoder = GetEncoder(ImageFormat.Jpeg);
15:             using (var encoderParameters = new EncoderParameters(1))
16:             using (var memoryStream = new MemoryStream())
17:             {
18:                 var encoderParameter = new EncoderParameter(System.Drawing.Imaging.Encoder.Quality, (long)quality);
19:                 encoderParameters.Param[0] = encoderParameter;
20:                 
21:                 bmp.Save(memoryStream, jpegEncoder, encoderParameters);
22:                 return memoryStream.ToArray();
23:             }
24:         }
25: 
26:         private static ImageCodecInfo GetEncoder(ImageFormat format)
27:         {
28:             ImageCodecInfo[] codecs = ImageCodecInfo.GetImageDecoders();
29:             foreach (ImageCodecInfo codec in codecs)
30:             {
31:                 if (codec.FormatID == format.Guid)
32:                 {
33:                     return codec;
34:                 }
35:             }
36:             return null;
37:         }
38:     }
39: }
