 26:         
 27:         private Bitmap previousBitmap = null;
 28:         private int framesSinceLastKeyframe = 0;
 29:         private const int KeyframeInterval = 30;
 30:         
 31:         private bool isStreaming = false;
 32:         private string streamCommandId = string.Empty;
 33:         
 34:         // Quản lý luồng Stream bằng PeriodicTimer và CancellationToken
 35:         private CancellationTokenSource streamCts;
 36:         private Task streamTask;
 37:         
 38:         private int currentSequence = 0;
 39:         private int currentQuality = 70;
 40:         
 41:         // Sử dụng SemaphoreSlim thay cho 'lock' truyền thống để hỗ trợ async/await
 42:         private readonly SemaphoreSlim captureSemaphore = new SemaphoreSlim(1, 1);
 43: 
 44:         public override string[] SupportedCommands => new[] { "screenshot", "screen_stream", "screen_stream_stop" };
 45:         
 46:         public StreamModule(IAgentContext context, SecurityManager security, UIManager ui) 
 47:             : base(context, security, ui) { }
 48: 
 49:         public override async Task ExecuteAsync(string action, JsonElement parameters, string commandId)
 50:         {
 51:             try
 52:             {
 53:                 if (action == "screen_stream")
 54:                 {
 55:                     int fps = parameters.TryGetProperty("fps", out var fpsProp) ? fpsProp.GetInt32() : 24;
 56:                     int quality = parameters.TryGetProperty("quality", out var qProp) ? qProp.GetInt32() : 70;
 57:                     await StartStreamAsync(fps, quality, commandId);
 58:                 }
 59:                 else if (action == "screen_stream_stop")
 60:                 {
 61:                     StopStream(commandId);
 62:                 }
 63:                 else if (action == "screenshot")
 64:                 {
 65:                     int quality = parameters.TryGetProperty("quality", out var qProp) ? qProp.GetInt32() : 90;
 66:                     await TakeSingleScreenshotAsync(quality, commandId);
 67:                 }
 68:             }
 69:             catch (Exception ex)
 70:             {
 71:                 context.SendResponse(new
 72:                 {
 73:                     type = "ERROR",
 74:                     command_id = commandId,
 75:                     module = "screen",
 76:                     message = $"Error in StreamModule: {ex.Message}"
 77:                 });
 78:             }
 79:         }
 80: 
 81:         private async Task StartStreamAsync(int fps, int quality, string commandId)
 82:         {
 83:             int safeFps = fps > 0 ? fps : 24;
 84:             int intervalMs = 1000 / safeFps;
 85:             currentQuality = quality;
 86: 
 87:             if (isStreaming)
 88:             {
 89:                 // Nếu đang stream, khởi động lại luồng với cấu hình mới
 90:                 StopStream(commandId);
 91:                 Log.Information("Đã điều chỉnh luồng Stream sang FPS: {Fps}, Quality: {Quality}", safeFps, quality);
 92:             }
 93:             else
 94:             {
 95:                 // Chỉ đếm ngược 10s nếu là phiên stream hoàn toàn mới
 96:                 ui.ShowCountdown(10, "Cảnh báo Chia sẻ Màn hình", "Màn hình sẽ bị theo dõi sau {0} giây...");
 97:                 await Task.Delay(10000);
 98:             }
 99: 
100:             isStreaming = true;
101:             streamCommandId = commandId;
102:             currentSequence = 1;
103:             currentQuality = quality;
104: 
105:             context.SendResponse(new { type = "stream_started", command_id = commandId, module = "screen" });
106:             
107:             // Khởi tạo và chạy vòng lặp Stream ngầm
108:             streamCts = new CancellationTokenSource();
109:             streamTask = StreamLoopAsync(intervalMs, streamCts.Token);
110:         }
111: 
112:         private async Task StreamLoopAsync(int intervalMs, CancellationToken token)
113:         {
114:             // Sử dụng PeriodicTimer giúp tối ưu CPU và tránh nghẽn vòng lặp
115:             using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(intervalMs));
116:             
117:             try
118:             {
119:                 while (await timer.WaitForNextTickAsync(token))
120:                 {
121:                     await CaptureAndSendAsync(streamCommandId, currentQuality, true);
122:                 }
123:             }
124:             catch (OperationCanceledException)
125:             {
126:                 // Luồng stream bị hủy chủ động
127:             }
128:             catch (Exception ex)
129:             {
130:                 Log.Error(ex, "Lỗi nghiêm trọng trong vòng lặp Stream: {ErrorMessage}", ex.Message);
131:             }
132:         }
133: 
134:         private void StopStream(string commandId)
135:         {
136:             if (!isStreaming) return;
137:             isStreaming = false;
138:             
139:             // Hủy luồng PeriodicTimer an toàn
140:             streamCts?.Cancel();
141:             streamCts?.Dispose();
142:             streamCts = null;
143: 
144:             // Chặn tạm thời để dọn dẹp GDI+ an toàn
145:             captureSemaphore.Wait();
146:             try
147:             {
148:                 captureGraphics?.Dispose();
149:                 captureGraphics = null;
150:                 captureBitmap?.Dispose();
151:                 captureBitmap = null;
152:                 scaledGraphics?.Dispose();
153:                 scaledGraphics = null;
154:                 scaledBitmap?.Dispose();
155:                 scaledBitmap = null;
156:                 previousBitmap?.Dispose();
157:                 previousBitmap = null;
158:                 lastScreenSize = Size.Empty;
159:             }
160:             finally
161:             {
162:                 captureSemaphore.Release();
163:             }
164: 
165:             context.SendResponse(new { type = "stream_stopped", command_id = commandId, module = "screen" });
166:         }
