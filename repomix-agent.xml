<file path="agent/Modules/AppModule.cs">
  1: using System;
  2: using System.Collections.Generic;
  3: using System.Diagnostics;
  4: using System.Linq;
  5: using System.Text.Json;
  6: using AgentSystem.Core;
  7: using AgentSystem.Managers; 
  8: using Serilog;
  9: 
 10: namespace AgentSystem.Modules
 11: {
 12:     public class AppModule : BaseModule
 13:     {
 14:         public override string[] SupportedCommands => new[] { "app_start", "app_stop", "app_list" };
 15:         public AppModule(IAgentContext context, SecurityManager security, UIManager ui) 
 16:             : base(context, security, ui) { }
 17: 
 18:         public override async Task ExecuteAsync(string action, JsonElement parameters, string commandId)
 19:         {
 20:             try
 21:             {
 22:                 if (action == "app_list")
 23:                 {
 24:                     await Task.Run(() => GetRunningApps(commandId));
 25:                 }
 26:                 else if (action == "app_start" || action == "app_stop")
 27:                 {
 28:                     string appName = parameters.GetProperty("name").GetString();
 29: 
 30:                     // Ràng buộc bảo mật: Bắt buộc đối chiếu Whitelist
 31:                     if (!security.IsAppWhitelisted(appName))
 32:                     {
 33:                         // SỬA LỖI: Sửa cấu trúc phản hồi cho đúng chuẩn từ chối lệnh
 34:                         context.SendResponse(new
 35:                         {
 36:                             type = "app_action_result", 
 37:                             agent_id = context.AgentId,
 38:                             command_id = commandId,
 39:                             action = action,
 40:                             name = appName,
 41:                             success = false,
 42:                             message = "Application is not in the whitelist."
 43:                         });
 44:                         return;
 45:                     }
 46: 
 47:                     if (action == "app_start") StartApp(appName, commandId);
 48:                     else StopApp(appName, commandId);
 49:                 }
 50:                 await Task.CompletedTask;
 51:             }
 52:             catch (Exception ex)
 53:             {
 54:                 context.SendResponse(new
 55:                 {
 56:                     type = "ERROR",
 57:                     agent_id = context.AgentId, // BỔ SUNG
 58:                     command_id = commandId,
 59:                     message = $"Error in AppModule: {ex.Message}"
 60:                 });
 61:             }
 62:         }
 63: 
 64:         private void GetRunningApps(string commandId)
 65:         {
 66:             var appList = new List<object>();
 67: 
 68:             // Lọc các tiến trình có giao diện (MainWindowHandle != 0)
 69:             var processes = Process.GetProcesses().Where(p => p.MainWindowHandle != IntPtr.Zero);
 70: 
 71:             foreach (var p in processes)
 72:             {
 73:                 try
 74:                 {
 75:                     // 1. Tính toán dung lượng RAM (Chuyển từ Bytes sang MB)
 76:                     double ramMb = Math.Round(p.WorkingSet64 / (1024.0 * 1024.0), 2);
 77: 
 78:                     // 2. Xác định trạng thái ứng dụng
 79:                     string status = p.Responding ? "running" : "not_responding";
 80: 
 81:                     // 3. SỬA LỖI: Tính toán CPU tức thời bằng PerformanceCounter
 82:                     double cpuPercent = 0.0;
 83:                     try
 84:                     {
 85:                         using (var counter = new PerformanceCounter("Process", "% Processor Time", p.ProcessName, true))
 86:                         {
 87:                             counter.NextValue(); // Lần lấy mẫu đầu tiên luôn bằng 0
 88:                             System.Threading.Thread.Sleep(50); // Cần một độ trễ nhỏ để tính toán sự thay đổi
 89:                             cpuPercent = Math.Round(counter.NextValue() / Environment.ProcessorCount, 2);
 90:                         }
 91:                     }
 92:                     catch
 93:                     {
 94:                         // Bỏ qua nếu Agent không đủ quyền đọc chỉ số CPU của tiến trình này
 95:                     }
 96: 
 97:                     appList.Add(new
 98:                     {
 99:                         name = p.ProcessName.ToLower(),
100:                         display_name = string.IsNullOrEmpty(p.MainWindowTitle) ? p.ProcessName : p.MainWindowTitle,
101:                         status = status,
102:                         cpu_percent = cpuPercent,
103:                         ram_mb = ramMb,
104:                         in_whitelist = security.IsAppWhitelisted(p.ProcessName)
105:                     });
106:                 }
107:                 catch
108:                 {
109:                     // Bỏ qua các tiến trình gặp lỗi đọc thông tin hoặc vừa bị đóng trong lúc vòng lặp chạy
110:                 }
111:                 finally
112:                 {
113:                     p.Dispose(); // CHỮA LỖI: Chống tràn Handle (Handle Leak)
114:                 }
115:             }
116: 
117:             context.SendResponse(new
118:             {
119:                 type = "app_list_result",
120:                 agent_id = context.AgentId, // BỔ SUNG
121:                 command_id = commandId,
122:                 apps = appList
123:             });
124:         }
125: 
126:         private void StartApp(string name, string commandId)
127:         {
128:             try
129:             {
130:                 Log.Information("[AppModule] Đang khởi chạy ứng dụng: {AppName}", name);
131:                 Process.Start(name);
132:                 context.SendResponse(new
133:                 {
134:                     type = "app_action_result",
135:                     agent_id = context.AgentId, // BỔ SUNG
136:                     command_id = commandId,
137:                     action = "app_start",
138:                     name = name,
139:                     success = true,
140:                     message = "Application started successfully."
141:                 });
142:             }
143:             catch (Exception ex)
144:             {
145:                 Log.Error(ex, "[AppModule] Lỗi khi khởi chạy ứng dụng {AppName}", name);
146:                 context.SendResponse(new
147:                 {
148:                     type = "app_action_result",
149:                     agent_id = context.AgentId, // BỔ SUNG
150:                     command_id = commandId,
151:                     action = "app_start",
152:                     name = name,
153:                     success = false,
154:                     message = $"Failed to start app: {ex.Message}"
155:                 });
156:             }
157:         }
158: 
159:         private void StopApp(string name, string commandId)
160:         {
161:             try
162:             {
163:                 var processes = Process.GetProcessesByName(name);
164: 
165:                 if (processes.Length == 0)
166:                 {
167:                     context.SendResponse(new
168:                     {
169:                         type = "app_action_result",
170:                         agent_id = context.AgentId, // BỔ SUNG
171:                         command_id = commandId,
172:                         action = "app_stop",
173:                         name = name,
174:                         success = false,
175:                         message = "Application is not currently running."
176:                     });
177:                     return;
178:                 }
179: 
180:                 Log.Information("[AppModule] Đang tắt ứng dụng: {AppName}", name);
181:                 foreach (var process in processes)
182:                 {
183:                     process.Kill();
184:                     process.WaitForExit(2000);
185:                 }
186: 
187:                 context.SendResponse(new
188:                 {
189:                     type = "app_action_result",
190:                     agent_id = context.AgentId, // BỔ SUNG
191:                     command_id = commandId,
192:                     action = "app_stop",
193:                     name = name,
194:                     success = true,
195:                     message = "Application stopped successfully."
196:                 });
197:             }
198:             catch (Exception ex)
199:             {
200:                 Log.Error(ex, "[AppModule] Lỗi khi quản lý ứng dụng {AppName}", name);
201:                 context.SendResponse(new
202:                 {
203:                     type = "app_action_result",
204:                     agent_id = context.AgentId, // BỔ SUNG
205:                     command_id = commandId,
206:                     action = "app_stop",
207:                     name = name,
208:                     success = false,
209:                     message = $"Failed to stop app: {ex.Message}"
210:                 });
211:             }
212:         }
213:     }
214: }
