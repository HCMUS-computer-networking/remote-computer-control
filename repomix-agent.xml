 1: using System;
 2: using System.Collections.Generic;
 3: using System.IO;
 4: using System.Linq;
 5: using AgentSystem.Models;
 6: using Serilog;
 7: 
 8: namespace AgentSystem.Managers
 9: {
10:     public class SecurityManager
11:     {
12:         private List<string> appWhitelist = new List<string>();
13:         private string sandboxRootPath = @"C:\AgentSandbox\";
14: 
15:         public void UpdatePolicy(List<string> newWhitelist, string newSandboxPath)
16:         {
17:             bool isChanged = false;
18: 
19:             if (newWhitelist != null)
20:             {
21:                 this.appWhitelist = new List<string>(newWhitelist.Select(x => x.ToLower()));
22:                 isChanged = true;
23:             }
24:             
25:             if (!string.IsNullOrEmpty(newSandboxPath))
26:             {
27:                 this.sandboxRootPath = newSandboxPath;
28:                 isChanged = true;
29:             }
30: 
31:             if (isChanged)
32:             {
33:                 // Audit log chuẩn: Ghi rõ số lượng ứng dụng và đường dẫn Sandbox đang áp dụng
34:                 Log.Information("[SecurityPolicy] Cập nhật Policy thành công (In-Memory). Whitelist: {AppCount} apps, Sandbox: '{SandboxPath}'", 
35:                     this.appWhitelist.Count, this.sandboxRootPath);
36:             }
37:         }
38:         public SecurityManager()
39:         {
40:             appWhitelist = ConfigManager.Current.AppWhitelist;
41:             sandboxRootPath = ConfigManager.Current.SandboxRootPath;
42: 
43:             if (!Directory.Exists(sandboxRootPath))
44:             {
45:                 Directory.CreateDirectory(sandboxRootPath);
46:             }
47:         }
48: 
49:         public bool IsAppWhitelisted(string appName)
50:         {
51:             return appWhitelist.Contains(appName.ToLower());
52:         }
53: 
54:         public bool IsPathInSandbox(string targetPath)
55:         {
56:             string normalizedPath = NormalizeAndValidatePath(targetPath);
57:             return normalizedPath.StartsWith(sandboxRootPath, StringComparison.OrdinalIgnoreCase);
58:         }
59: 
60:         public string NormalizeAndValidatePath(string relativePath)
61:         {
62:             if (relativePath.StartsWith("/"))
63:             {
64:                 relativePath = relativePath.Substring(1);
65:             }
66: 
67:             string absoluteSandboxRoot = Path.GetFullPath(sandboxRootPath);
68: 
69:             // FIX: Đảm bảo đường dẫn gốc luôn kết thúc bằng dấu \
70:             // Nếu không có, thêm vào để tránh trường hợp C:\AgentSandbox khớp với C:\AgentSandbox_Hacked
71:             if (!absoluteSandboxRoot.EndsWith(Path.DirectorySeparatorChar.ToString()))
72:             {
73:                 absoluteSandboxRoot += Path.DirectorySeparatorChar;
74:             }
75: 
76:             // Sử dụng đường dẫn gốc đã chuẩn hóa để tạo fullPath
77:             string fullPath = Path.GetFullPath(Path.Combine(absoluteSandboxRoot, relativePath));
78: 
79:             // Kiểm tra Path Traversal với đường dẫn gốc đã có dấu \
80:             if (!fullPath.StartsWith(absoluteSandboxRoot, StringComparison.OrdinalIgnoreCase))
81:             {
82:                 throw new UnauthorizedAccessException("Attempted Path Traversal detected!");
83:             }
84: 
85:             return fullPath;
86:         }
87:     }
88: }
</file>

<file path="agent/Modules/InputModule.cs">
  1: using System;
  2: using System.Runtime.InteropServices;
  3: using System.Text.Json;
  4: using System.Threading.Tasks;
  5: using AgentSystem.Core;
  6: using AgentSystem.Managers;
  7: using Serilog;
  8: 
  9: namespace AgentSystem.Modules
 10: {
 11:     public class InputModule : BaseModule
 12:     {
 13:         // Grant runs on a ThreadPool worker (Task.Run in AgentClient) while
 14:         // Revoke runs on the WebSocket message thread — a fast toggle can
 15:         // race and leave the overlay stuck open (grant wins after revoke)
 16:         // or stuck hidden (revoke arrives before the grant flip). Serialize
 17:         // every state flip through this lock and make each op idempotent.
 18:         private readonly object _stateLock = new object();
 19:         private bool isIndicatorActive = false;                                                     // Guarded by _stateLock
 20: 
 21:         public override string[] SupportedCommands => new[]
 22:         {
 23:             "input_mouse_move",
 24:             "input_mouse_click",
 25:             "input_key",
 26:             "input_type"
 27:         };
 28: 
 29:         public InputModule(IAgentContext context, SecurityManager security, UIManager ui)
 30:             : base(context, security, ui) { }
 31: 
 32:         // Called by AgentClient when a permission_request for feature="input"
 33:         // is GRANTED by the Agent user. Shows the on-screen indicator and
 34:         // echoes input_started back so the Controller flips its live badge.
 35:         public void OnInputGranted(string commandId)
 36:         {
 37:             bool showOverlay = false;
 38:             lock (_stateLock)
 39:             {
 40:                 if (!isIndicatorActive)
 41:                 {
 42:                     isIndicatorActive = true;
 43:                     showOverlay       = true;
 44:                 }
 45:             }
 46:             if (showOverlay)
 47:             {
 48:                 ui.ShowInputOverlay();                                                              // WinForms call — kept OUT of the lock
 49:                 Log.Information("[InputModule] Remote Input GRANTED — overlay shown");
 50:             }
 51:             context.SendResponse(new
 52:             {
 53:                 type       = "input_started",
 54:                 agent_id   = context.AgentId,
 55:                 command_id = commandId,
 56:             });
 57:         }
 58: 
 59:         // Called by AgentClient on permission_revoke or stop_module for
 60:         // feature="input". Hides the overlay and tells the Controller to
 61:         // clear its live badge. Always emits input_stopped even when the
 62:         // overlay was already hidden, so an out-of-order revoke still
 63:         // reaches the Controller.
 64:         public void OnInputRevoked()
 65:         {
 66:             bool hideOverlay = false;
 67:             lock (_stateLock)
 68:             {
 69:                 if (isIndicatorActive)
 70:                 {
 71:                     isIndicatorActive = false;
 72:                     hideOverlay       = true;
 73:                 }
 74:             }
 75:             if (hideOverlay)
 76:             {
 77:                 ui.HideInputOverlay();
 78:                 Log.Information("[InputModule] Remote Input REVOKED — overlay hidden");
 79:             }
 80:             context.SendResponse(new
 81:             {
 82:                 type     = "input_stopped",
 83:                 agent_id = context.AgentId,
 84:             });
 85:         }
 86: 
 87:         public override void OnDisconnected()
 88:         {
 89:             // Socket dropped mid-session — kill the indicator so it does not linger.
 90:             bool hideOverlay = false;
 91:             lock (_stateLock)
 92:             {
 93:                 if (isIndicatorActive)
 94:                 {
 95:                     isIndicatorActive = false;
 96:                     hideOverlay       = true;
 97:                 }
 98:             }
 99:             if (hideOverlay)
100:             {
101:                 ui.HideInputOverlay();
102:                 Log.Warning("[InputModule] Socket disconnected — Remote Input overlay force-hidden");
103:             }
104:         }
105: 
106:         public override Task ExecuteAsync(string action, JsonElement parameters, string commandId)
107:         {
108:             switch (action)
109:             {
110:                 case "input_mouse_move":
111:                     HandleMouseMove(parameters, commandId);
112:                     break;
113:                 case "input_mouse_click":
114:                     HandleMouseClick(parameters, commandId);
115:                     break;
116:                 case "input_key":
117:                     HandleKey(parameters, commandId);
118:                     break;
119:                 case "input_type":
120:                     HandleType(parameters, commandId);
121:                     break;
122:                 default:
123:                     context.SendResponse(new
124:                     {
125:                         type = "input_result",
126:                         agent_id = context.AgentId,
127:                         command_id = commandId,
128:                         success = false,
129:                         message = $"Unknown action: {action}"
130:                     });
131:                     break;
132:             }
133: 
134:             return Task.CompletedTask;
135:         }
136: 
137:         private void HandleMouseMove(JsonElement parameters, string commandId)
138:         {
139:             if (parameters.ValueKind == JsonValueKind.Object && parameters.TryGetProperty("x", out var xProp) && parameters.TryGetProperty("y", out var yProp))
140:             {
141:                 int x = xProp.GetInt32();
142:                 int y = yProp.GetInt32();
143:                 SetCursorPos(x, y);
144:             }
145:             else
146:             {
147:                 context.SendResponse(new
148:                 {
149:                     type = "input_result",
150:                     agent_id = context.AgentId,
151:                     command_id = commandId,
152:                     success = false,
153:                     message = "Missing x or y parameters."
154:                 });
155:             }
156:         }
157: 
158:         private void HandleMouseClick(JsonElement parameters, string commandId)
159:         {
160:             bool isObj = parameters.ValueKind == JsonValueKind.Object;
161:             string button = isObj && parameters.TryGetProperty("button", out var bProp) ? bProp.GetString() : "left";
162:             string act = isObj && parameters.TryGetProperty("action", out var aProp) ? aProp.GetString() : "click";
163: 
164:             uint downFlag, upFlag;
165:             switch (button?.ToLower())
166:             {
167:                 case "right":
168:                     downFlag = MOUSEEVENTF_RIGHTDOWN;
169:                     upFlag = MOUSEEVENTF_RIGHTUP;
170:                     break;
171:                 case "middle":
172:                     downFlag = MOUSEEVENTF_MIDDLEDOWN;
173:                     upFlag = MOUSEEVENTF_MIDDLEUP;
174:                     break;
175:                 case "left":
176:                 default:
177:                     downFlag = MOUSEEVENTF_LEFTDOWN;
178:                     upFlag = MOUSEEVENTF_LEFTUP;
179:                     break;
180:             }
181: 
182:             switch (act?.ToLower())
183:             {
184:                 case "down":
185:                     SendMouseInput(downFlag);
186:                     break;
187:                 case "up":
188:                     SendMouseInput(upFlag);
189:                     break;
190:                 case "click":
191:                 default:
192:                     SendMouseInput(downFlag);
193:                     SendMouseInput(upFlag);
194:                     break;
195:             }
196: 
197:             context.SendResponse(new
198:             {
199:                 type = "input_result",
200:                 agent_id = context.AgentId,
201:                 command_id = commandId,
202:                 success = true
203:             });
204:         }
205: 
206:         private void HandleKey(JsonElement parameters, string commandId)
207:         {
208:             if (parameters.ValueKind == JsonValueKind.Object && parameters.TryGetProperty("vk", out var vkProp))
209:             {
210:                 int vk = vkProp.GetInt32();
211:                 string act = parameters.TryGetProperty("action", out var aProp) ? aProp.GetString() : "press";
212: 
213:                 switch (act?.ToLower())
214:                 {
215:                     case "down":
216:                         SendKeyInput((ushort)vk, KEYEVENTF_KEYDOWN);
217:                         break;
218:                     case "up":
219:                         SendKeyInput((ushort)vk, KEYEVENTF_KEYUP);
220:                         break;
221:                     case "press":
222:                     default:
223:                         SendKeyInput((ushort)vk, KEYEVENTF_KEYDOWN);
224:                         SendKeyInput((ushort)vk, KEYEVENTF_KEYUP);
225:                         break;
226:                 }
227: 
228:                 context.SendResponse(new
229:                 {
230:                     type = "input_result",
231:                     agent_id = context.AgentId,
232:                     command_id = commandId,
233:                     success = true
234:                 });
235:             }
236:             else
237:             {
238:                 context.SendResponse(new
239:                 {
240:                     type = "input_result",
241:                     agent_id = context.AgentId,
242:                     command_id = commandId,
243:                     success = false,
244:                     message = "Missing vk parameter."
245:                 });
246:             }
247:         }
248: 
249:         private void HandleType(JsonElement parameters, string commandId)
250:         {
251:             if (parameters.ValueKind == JsonValueKind.Object && parameters.TryGetProperty("text", out var textProp))
252:             {
253:                 string text = textProp.GetString();
254:                 if (!string.IsNullOrEmpty(text))
255:                 {
256:                     foreach (char c in text)
257:                     {
258:                         SendUnicodeChar(c);
259:                     }
260:                 }
261: 
262:                 context.SendResponse(new
263:                 {
264:                     type = "input_result",
265:                     agent_id = context.AgentId,
266:                     command_id = commandId,
267:                     success = true
268:                 });
269:             }
270:             else
271:             {
272:                 context.SendResponse(new
273:                 {
274:                     type = "input_result",
275:                     agent_id = context.AgentId,
276:                     command_id = commandId,
277:                     success = false,
278:                     message = "Missing text parameter."
279:                 });
280:             }
281:         }
282: 
283:         #region P/Invoke SendInput
284:         [DllImport("user32.dll", SetLastError = true)]
285:         private static extern bool SetCursorPos(int X, int Y);
286: 
287:         [DllImport("user32.dll", SetLastError = true)]
288:         private static extern uint SendInput(uint nInputs, INPUT[] pInputs, int cbSize);
289: 
290:         private const uint INPUT_MOUSE = 0;
291:         private const uint INPUT_KEYBOARD = 1;
292: 
293:         private const uint MOUSEEVENTF_LEFTDOWN = 0x0002;
294:         private const uint MOUSEEVENTF_LEFTUP = 0x0004;
295:         private const uint MOUSEEVENTF_RIGHTDOWN = 0x0008;
296:         private const uint MOUSEEVENTF_RIGHTUP = 0x0010;
297:         private const uint MOUSEEVENTF_MIDDLEDOWN = 0x0020;
298:         private const uint MOUSEEVENTF_MIDDLEUP = 0x0040;
299: 
300:         private const uint KEYEVENTF_KEYDOWN = 0x0000;
301:         private const uint KEYEVENTF_KEYUP = 0x0002;
302:         private const uint KEYEVENTF_UNICODE = 0x0004;
303: 
304:         [StructLayout(LayoutKind.Sequential)]
305:         private struct INPUT
306:         {
307:             public uint type;
308:             public InputUnion u;
309:         }
310: 
311:         [StructLayout(LayoutKind.Explicit)]
312:         private struct InputUnion
313:         {
314:             [FieldOffset(0)]
315:             public MOUSEINPUT mi;
316:             [FieldOffset(0)]
317:             public KEYBDINPUT ki;
318:             [FieldOffset(0)]
319:             public HARDWAREINPUT hi;
320:         }
321: 
322:         [StructLayout(LayoutKind.Sequential)]
323:         private struct MOUSEINPUT
324:         {
325:             public int dx;
326:             public int dy;
327:             public uint mouseData;
328:             public uint dwFlags;
329:             public uint time;
330:             public IntPtr dwExtraInfo;
331:         }
332: 
333:         [StructLayout(LayoutKind.Sequential)]
334:         private struct KEYBDINPUT
335:         {
336:             public ushort wVk;
337:             public ushort wScan;
338:             public uint dwFlags;
339:             public uint time;
340:             public IntPtr dwExtraInfo;
341:         }
342: 
343:         [StructLayout(LayoutKind.Sequential)]
344:         private struct HARDWAREINPUT
345:         {
346:             public uint uMsg;
347:             public ushort wParamL;
348:             public ushort wParamH;
349:         }
350: 
351:         private void SendMouseInput(uint dwFlags)
352:         {
353:             INPUT[] inputs = new INPUT[1];
354:             inputs[0].type = INPUT_MOUSE;
355:             inputs[0].u.mi.dwFlags = dwFlags;
356:             SendInput(1, inputs, Marshal.SizeOf(typeof(INPUT)));
357:         }
358: 
359:         private void SendKeyInput(ushort vk, uint dwFlags)
360:         {
361:             INPUT[] inputs = new INPUT[1];
362:             inputs[0].type = INPUT_KEYBOARD;
363:             inputs[0].u.ki.wVk = vk;
364:             inputs[0].u.ki.dwFlags = dwFlags;
365:             SendInput(1, inputs, Marshal.SizeOf(typeof(INPUT)));
366:         }
367: 
368:         private void SendUnicodeChar(char c)
369:         {
370:             INPUT[] inputs = new INPUT[2];
371: 
372:             inputs[0].type = INPUT_KEYBOARD;
373:             inputs[0].u.ki.wScan = c;
374:             inputs[0].u.ki.dwFlags = KEYEVENTF_UNICODE;
375: 
376:             inputs[1].type = INPUT_KEYBOARD;
377:             inputs[1].u.ki.wScan = c;
378:             inputs[1].u.ki.dwFlags = KEYEVENTF_UNICODE | KEYEVENTF_KEYUP;
379: 
380:             SendInput(2, inputs, Marshal.SizeOf(typeof(INPUT)));
381:         }
382:         #endregion
383:     }
384: }
