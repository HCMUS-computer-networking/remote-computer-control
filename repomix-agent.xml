<file path="agent/Modules/ProcessModule.cs">
  1: using System;
  2: using System.Collections.Generic;
  3: using System.Collections.Concurrent;
  4: using System.ComponentModel;
  5: using System.Diagnostics;
  6: using System.Linq;
  7: using System.Text.Json;
  8: using AgentSystem.Core;
  9: using System.Threading.Tasks;
 10: using System.Threading;
 11: using AgentSystem.Managers;
 12: using System.Management;
 13: using System.Runtime.InteropServices;
 14: using System.Security.Principal;
 15: 
 16: namespace AgentSystem.Modules
 17: {
 18:     public class ProcessModule : BaseModule
 19:     {
 20:         private readonly ConcurrentDictionary<int, (TimeSpan CpuTime, DateTime LastCheck)> cpuHistory = new ConcurrentDictionary<int, (TimeSpan, DateTime)>();
 21: 
 22:         public override string[] SupportedCommands => new[] { "proc_list", "proc_kill" };
 23:         
 24:         public ProcessModule(IAgentContext context, SecurityManager security, UIManager ui) 
 25:             : base(context, security, ui) { }
 26: 
 27:         public override async Task ExecuteAsync(string action, JsonElement parameters, string commandId)
 28:         {
 29:             try
 30:             {
 31:                 if (action == "proc_list")
 32:                 {
 33:                     // Chạy ngầm thao tác liệt kê để không block luồng xử lý gói tin WebSocket
 34:                     await Task.Run(() => GetProcessList(commandId));
 35:                 }
 36:                 else if (action == "proc_kill")
 37:                 {
 38:                     if (parameters.TryGetProperty("pid", out JsonElement pidElement) && pidElement.TryGetInt32(out int pid))
 39:                     {
 40:                         await KillProcessAsync(pid, commandId);
 41:                     }
 42:                     else
 43:                     {
 44:                         context.SendResponse(new
 45:                         {
 46:                             type = "proc_kill_result",
 47:                             agent_id = context.AgentId,
 48:                             command_id = commandId,
 49:                             pid = -1,
 50:                             success = false,
 51:                             message = "Missing or invalid 'pid' parameter."
 52:                         });
 53:                     }
 54:                 }
 55:             }
 56:             catch (Exception ex)
 57:             {
 58:                 context.SendResponse(new
 59:                 {
 60:                     type = "ERROR",
 61:                     agent_id = context.AgentId,
 62:                     command_id = commandId,
 63:                     message = $"Error in ProcessModule: {ex.Message}"
 64:                 });
 65:             }
 66:         }
 67: 
 68:         private void GetProcessList(string commandId)
 69:         {
 70:             var processList = new ConcurrentBag<object>();
 71:             var processes = Process.GetProcesses();
 72:             var currentTime = DateTime.UtcNow;
 73: 
 74:             Parallel.ForEach(processes, p =>
 75:             {
 76:                 try
 77:                 {
 78:                     double ramMb = Math.Round(p.WorkingSet64 / (1024.0 * 1024.0), 2);
 79:                     double cpuPercent = 0.0;
 80: 
 81:                     try
 82:                     {
 83:                         TimeSpan currentCpuTime = p.TotalProcessorTime;
 84:                         
 85:                         if (cpuHistory.TryGetValue(p.Id, out var history))
 86:                         {
 87:                             double msPassed = (currentTime - history.LastCheck).TotalMilliseconds;
 88:                             double cpuMsPassed = (currentCpuTime - history.CpuTime).TotalMilliseconds;
 89:                             
 90:                             if (msPassed > 0)
 91:                             {
 92:                                 cpuPercent = Math.Round((cpuMsPassed / msPassed) / Environment.ProcessorCount * 100, 2);
 93:                             }
 94:                         }
 95:                         
 96:                         cpuHistory[p.Id] = (currentCpuTime, currentTime);
 97:                     }
 98:                     catch (Win32Exception) { }
 99:                     catch (InvalidOperationException) { }
100: 
101:                     string username = GetProcessOwner(p);
102: 
103:                     processList.Add(new
104:                     {
105:                         pid = p.Id,
106:                         name = p.ProcessName + ".exe",
107:                         username = username,
108:                         cpu_percent = cpuPercent,
109:                         ram_mb = ramMb
110:                     });
111:                 }
112:                 catch { }
113:                 finally
114:                 {
115:                     p.Dispose();
116:                 }
117:             });
118: 
119:             var currentPids = processes.Select(p => p.Id).ToHashSet();
120:             var pidsToRemove = cpuHistory.Keys.Where(pid => !currentPids.Contains(pid)).ToList();
121:             
122:             foreach (var pid in pidsToRemove) 
123:             {
124:                 cpuHistory.TryRemove(pid, out _); 
125:             }
126: 
127:             context.SendResponse(new
128:             {
129:                 type = "proc_list_result",
130:                 agent_id = context.AgentId,
131:                 command_id = commandId,
132:                 processes = processList.ToList() 
133:             });
134:         }
135: 
136:         private readonly string[] criticalSystemProcesses = { 
137:             "csrss", "winlogon", "lsass", "smss", "services", "system", "explorer" 
138:         };
139: 
140:         private async Task KillProcessAsync(int pid, string commandId)
141:         {
142:             try
143:             {
144:                 var process = Process.GetProcessById(pid);
145:                 
146:                 // 1. Chặn can thiệp tiến trình lõi của hệ điều hành (Case-insensitive)
147:                 if (criticalSystemProcesses.Contains(process.ProcessName.ToLower()))
148:                 {
149:                     context.SendResponse(new {
150:                         type = "proc_kill_result",
151:                         agent_id = context.AgentId,
152:                         command_id = commandId,
153:                         pid = pid,
154:                         success = false,
155:                         message = "Access Denied: Cannot terminate critical system process."
156:                     });
157:                     return;
158:                 }
159: 
160:                 // 2. Chặn can thiệp tiến trình của hệ thống (Case-insensitive)
161:                 string owner = GetProcessOwner(process);
162:                 string ownerLower = owner.ToLower();
163:                 if (ownerLower.Contains("nt authority\\system") || ownerLower.Contains("local service") || ownerLower.Contains("network service"))
164:                 {
165:                     context.SendResponse(new {
166:                         type = "proc_kill_result",
167:                         agent_id = context.AgentId,
168:                         command_id = commandId,
169:                         pid = pid,
170:                         success = false,
171:                         message = $"Access Denied: Process is owned by privileged account ({owner})."
172:                     });
173:                     return;
174:                 }
175: 
176:                 process.Kill();
177:                 
178:                 // Đợi bất đồng bộ với Timeout 2 giây thay vì chặn luồng như WaitForExit()
179:                 using (var cts = new CancellationTokenSource(2000))
180:                 {
181:                     try
182:                     {
183:                         await process.WaitForExitAsync(cts.Token);
184:                     }
185:                     catch (OperationCanceledException)
186:                     {
187:                         // Tiến trình chưa thoát hẳn sau 2s, bỏ qua
188:                     }
189:                 }
190:                 
191:                 context.SendResponse(new
192:                 {
193:                     type = "proc_kill_result",
194:                     agent_id = context.AgentId,
195:                     command_id = commandId,
196:                     pid = pid,
197:                     success = true,
198:                     message = "Process terminated"
199:                 });
200:             }
201:             catch (ArgumentException)
202:             {
203:                 context.SendResponse(new
204:                 {
205:                     type = "proc_kill_result",
206:                     agent_id = context.AgentId,
207:                     command_id = commandId,
208:                     pid = pid,
209:                     success = false,
210:                     message = "Process not found."
211:                 });
212:             }
213:             catch (Exception ex)
214:             {
215:                 context.SendResponse(new
216:                 {
217:                     type = "proc_kill_result",
218:                     agent_id = context.AgentId,
219:                     command_id = commandId,
220:                     pid = pid,
221:                     success = false,
222:                     message = $"Failed to terminate process: {ex.Message}"
223:                 });
224:             }
225:         }
226: 
227:         private static string GetProcessOwner(Process process)
228:         {
229:             IntPtr tokenHandle = IntPtr.Zero;
230:             try
231:             {
232:                 if (NativeMethods.OpenProcessToken(process.Handle, NativeMethods.TOKEN_QUERY, out tokenHandle))
233:                 {
234:                     using (var identity = new WindowsIdentity(tokenHandle))
235:                     {
236:                         return identity.Name;
237:                     }
238:                 }
239:             }
240:             catch
241:             {
242:                 // Fallback for system or protected processes
243:             }
244:             finally
245:             {
246:                 if (tokenHandle != IntPtr.Zero)
247:                 {
248:                     NativeMethods.CloseHandle(tokenHandle);
249:                 }
250:             }
251:             return "Unknown";
252:         }
253: 
254:         private static class NativeMethods
255:         {
256:             public const uint TOKEN_QUERY = 0x0008;
257: 
258:             [DllImport("advapi32.dll", SetLastError = true)]
259:             [return: MarshalAs(UnmanagedType.Bool)]
260:             public static extern bool OpenProcessToken(IntPtr ProcessHandle, uint DesiredAccess, out IntPtr TokenHandle);
261: 
262:             [DllImport("kernel32.dll", SetLastError = true)]
263:             [return: MarshalAs(UnmanagedType.Bool)]
264:             public static extern bool CloseHandle(IntPtr hObject);
265:         }
266:     }
267: }
</file>

<file path="agent/Core/WebSocketClient.cs">
  1: using System;
  2: using System.IO;
  3: using System.Net.WebSockets;
  4: using System.Text;
  5: using System.Threading;
  6: using System.Threading.Tasks;
  7: using Timer = System.Threading.Timer;
  8: using System.Net.Security;
  9: using System.Security.Cryptography.X509Certificates;
 10: using System.Net;
 11: using System.Net.Sockets;
 12: using Serilog;
 13: using AgentSystem.Managers;
 14: using System.Diagnostics;
 15: 
 16: namespace AgentSystem.Core
 17: {
 18:     public class WebSocketClient
 19:     {
 20:         public event Action OnConnectedEvent;
 21:         public event Action OnDisconnectedEvent;
 22:         private readonly AgentClient context;
 23:         private readonly string url;
 24:         
 25:         private ClientWebSocket webSocket;
 26:         private CancellationTokenSource cts;
 27:         private Timer heartbeatTimer;
 28:         
 29:         // Cờ kiểm soát trạng thái kết nối
 30:         private bool isReconnecting = false;
 31:         
 32:         // SemaphoreSlim đảm bảo không có 2 luồng cùng gọi SendAsync cùng lúc
 33:         // (ClientWebSocket của .NET sẽ văng lỗi nếu SendAsync bị gọi đồng thời)
 34:         private readonly SemaphoreSlim sendLock = new SemaphoreSlim(1, 1);
 35: 
 36:         public WebSocketClient(AgentClient context, string url)
 37:         {
 38:             this.context = context;
 39:             this.url = url;
 40:         }
 41: 
 42:         public void Connect()
 43:         {
 44:             // Bắt đầu tiến trình kết nối bất đồng bộ trong nền
 45:             _ = ConnectAsync();
 46:         }
 47: 
 48:         private async Task ConnectAsync()
 49:         {
 50:             try
 51:             {
 52:                 cts = new CancellationTokenSource();
 53:                 webSocket = new ClientWebSocket();
 54: 
 55:                 try
 56:                 {
 57:                     webSocket.Options.RemoteCertificateValidationCallback = (sender, cert, chain, sslErrors) => true;
 58:                 }
 59:                 catch (Exception certEx)
 60:                 {
 61:                     Log.Debug(certEx, "[WebSocket] Ignore cert validation config error for non-SSL connection");
 62:                 }
 63: 
 64:                 string finalUrl = $"{url.TrimEnd('/')}/agent?key={ConfigManager.Current.AuthKey}";
 65:                 Log.Information("[WebSocket] Đang kết nối tới {finalUrl}...", finalUrl);
 66:                 await webSocket.ConnectAsync(new Uri(finalUrl), cts.Token);
 67:                 Log.Information("[WebSocket] KẾT NỐI THÀNH CÔNG!");
 68:                 OnConnectedEvent?.Invoke();
 69:                 
 70:                 isReconnecting = false;
 71:                 
 72:                 string ip = Dns.GetHostAddresses(Dns.GetHostName())
 73:                     .FirstOrDefault(a => a.AddressFamily == AddressFamily.InterNetwork)?.ToString() ?? "unknown";
 74: 
 75:                 context.Crypto.Reset();
 76:                 context.SendResponse(new { 
 77:                     type = "REGISTER", 
 78:                     agent_id = context.AgentId,
 79:                     secret = ConfigManager.Current.AuthKey,
 80:                     hostname = Environment.MachineName,
 81:                     ip = ip,
 82:                     os = Environment.OSVersion.ToString()
 83:                 }, false);
 84:                 context.NotifyReconnected();
 85:                 StartHeartbeat();
 86:                 _ = ReceiveLoopAsync();
 87:             }
 88:             catch (Exception ex)
 89:             {
 90:                 Log.Error(ex, "[WebSocket Lỗi] Không thể kết nối tới Gateway");
 91:                 _ = HandleReconnectAsync();
 92:             }
 93:         }
 94: 
 95:         public void Disconnect()
 96:         {
 97:             try
 98:             {
 99:                 // Xóa sạch trạng thái E2EE cũ khi ngắt kết nối
100:                 context.Crypto.Reset();
101:                 
102:                 heartbeatTimer?.Dispose();
103:                 cts?.Cancel();
104:                 
105:                 if (webSocket != null && webSocket.State == WebSocketState.Open)
106:                 {
107:                     // Đóng kết nối an toàn với timeout
108:                     webSocket.CloseAsync(WebSocketCloseStatus.NormalClosure, "Agent shutting down", CancellationToken.None).Wait(2000);
109:                 }
110:                 
111:                 webSocket?.Dispose();
112:                 Log.Information("[WebSocket] Đã ngắt kết nối.");
113:             }
114:             catch (Exception ex)
115:             {
116:                 Log.Error(ex, "[WebSocket] Lỗi khi ngắt kết nối: {Message}", ex.Message );
117:             }
118:         }
119: 
120:         public void SendText(string json)
121:         {
122:             _ = SendDataAsync(Encoding.UTF8.GetBytes(json), WebSocketMessageType.Text);
123:         }
124: 
125:         public void SendBinary(byte[] bytes)
126:         {
127:             _ = SendDataAsync(bytes, WebSocketMessageType.Binary);
128:         }
129: 
130:         private async Task SendDataAsync(byte[] data, WebSocketMessageType type)
131:         {
132:             if (webSocket == null || webSocket.State != WebSocketState.Open) return;
133: 
134:             await sendLock.WaitAsync();
135:             try
136:             {
137:                 await webSocket.SendAsync(new ArraySegment<byte>(data), type, true, cts.Token);
138:             }
139:             catch (Exception ex)
140:             {
141:                 Log.Error(ex, "[WebSocket TX Lỗi] {Message}", ex.Message);
142:                 _ = HandleReconnectAsync();
143:             }
144:             finally
145:             {
146:                 sendLock.Release();
147:             }
148:         }
149: 
150:         private async Task ReceiveLoopAsync()
151:         {
152:             var buffer = new byte[8192]; // Bộ đệm 8KB cho mỗi chunk
153: 
154:             try
155:             {
156:                 while (webSocket.State == WebSocketState.Open && !cts.Token.IsCancellationRequested)
157:                 {
158:                     using (var ms = new MemoryStream())
159:                     {
160:                         WebSocketReceiveResult result;
161:                         const int MAX_MESSAGE_SIZE = 4 * 1024 * 1024; // 4 MB
162:                         do
163:                         {
164:                             result = await webSocket.ReceiveAsync(new ArraySegment<byte>(buffer), cts.Token);
165:                             
166:                             if (result.MessageType == WebSocketMessageType.Close)
167:                             {
168:                                 Log.Information("[WebSocket] Server chủ động ngắt kết nối.");
169:                                 OnDisconnectedEvent?.Invoke();
170:                                 _ = HandleReconnectAsync();
171:                                 return;
172:                             }
173:                             
174:                             ms.Write(buffer, 0, result.Count);
175: 
176:                             if (ms.Length > MAX_MESSAGE_SIZE)
177:                             {
178:                                 Log.Warning("[Security] Message vượt quá kích thước cho phép ({Size} bytes). Bị bỏ qua.", ms.Length);
179:                                 break; // Thoát khỏi vòng lặp đọc
180:                             }
181:                         } 
182:                         while (!result.EndOfMessage);
183: 
184:                         if (ms.Length > MAX_MESSAGE_SIZE)
185:                         {
186:                             continue; // Bỏ qua việc xử lý message này
187:                         }
188: 
189:                         // Xử lý gói tin văn bản (Điều khiển từ Controller)
190:                         if (result.MessageType == WebSocketMessageType.Text)
191:                         {
192:                             string message = Encoding.UTF8.GetString(ms.ToArray());
193:                             
194:                             // Lọc các gói tin Heartbeat để tránh làm rác log / Dispatcher
195:                             if (message.Contains("\"type\":\"PONG\"") || message.Contains("\"type\": \"PONG\""))
196:                             {
197:                                 // Bỏ qua hoặc log lại
198:                                 continue;
199:                             }
200: 
201:                             // Chuyển thông điệp cho MessageDispatcher phân tích
202:                             context.Dispatcher.Dispatch(message);
203:                         }
204:                         else if (result.MessageType == WebSocketMessageType.Binary)
205:                         {
206:                             context.HandleBinaryFrame(ms.ToArray());
207:                         }
208:                     }
209:                 }
210:             }
211:             catch (OperationCanceledException)
212:             {
213:                 // Bị hủy chủ động từ hàm Disconnect
214:             }
215:             catch (Exception ex)
216:             {
217:                 Log.Error(ex, "[WebSocket RX Lỗi] Vòng lặp nhận dữ liệu bị ngắt: {Message}", ex.Message);
218:                 OnDisconnectedEvent?.Invoke();
219:                 _ = HandleReconnectAsync();
220:             }
221:         }
222: 
223:         private void StartHeartbeat()
224:         {
225:             heartbeatTimer?.Dispose();
226:             // Thiết lập gửi PING mỗi 15 giây
227:             heartbeatTimer = new Timer((state) =>
228:             {
229:                 if (webSocket != null && webSocket.State == WebSocketState.Open)
230:                 {
231:                     string pingMsg = "{\"type\":\"PING\"}";
232:                     SendText(pingMsg);
233:                 }
234:             }, null, 15000, 15000);
235:         }
236: 
237:         private async Task HandleReconnectAsync()
238:         {
239:             if (isReconnecting || (cts != null && cts.IsCancellationRequested)) return;
240:             isReconnecting = true;
241: 
242:             // Xóa sạch trạng thái E2EE cũ trước khi thử kết nối lại
243:             context.Crypto.Reset();
244: 
245:             Log.Information("[WebSocket] Bắt đầu tiến trình tự động kết nối lại (Reconnect)...");
246:             heartbeatTimer?.Dispose();
247:             webSocket?.Dispose();
248: 
249:             int retryCount = 0;
250:             // Lặp lại việc kết nối với Exponential Backoff (5s, 10s, 20s... tối đa 120s)
251:             while (isReconnecting && !cts.IsCancellationRequested)
252:             {
253:                 int delaySeconds = Math.Min(5 * (int)Math.Pow(2, retryCount), 120);
254:                 Log.Information("[WebSocket] Đang thử kết nối lại sau {Delay}s (lần {Count})...", delaySeconds, retryCount + 1);
255:                 await Task.Delay(delaySeconds * 1000);
256:                 retryCount++;
257: 
258:                 try
259:                 {
260:                     webSocket = new ClientWebSocket();
261:                     string finalUrl = $"{url.TrimEnd('/')}/agent?key={ConfigManager.Current.AuthKey}";
262:                     await webSocket.ConnectAsync(new Uri(finalUrl), cts.Token);
263:                     
264:                     Log.Information("[WebSocket] TÁI KẾT NỐI THÀNH CÔNG!");
265:                     OnConnectedEvent?.Invoke();
266:                     isReconnecting = false;
267:                     
268:                     string ip = Dns.GetHostAddresses(Dns.GetHostName())
269:                         .FirstOrDefault(a => a.AddressFamily == AddressFamily.InterNetwork)?.ToString() ?? "unknown";
270: 
271:                     // Gửi lại gói đăng ký AgentId sau khi có kết nối mới
272:                     context.Crypto.Reset();
273:                     // Đảm bảo gửi REGISTER với tham số thứ 2 là false (encrypt = false)
274:                     context.SendResponse(new { 
275:                         type = "REGISTER", 
276:                         agent_id = context.AgentId,
277:                         secret = ConfigManager.Current.AuthKey,
278:                         hostname = Environment.MachineName,
279:                         ip = ip,
280:                         os = Environment.OSVersion.ToString()
281:                     }, false); 
282:                     
283:                     // Notify the Controller that permissions and E2EE must be re-established
284:                     context.NotifyReconnected();
285:                     
286:                     StartHeartbeat();
287:                     _ = ReceiveLoopAsync();
288:                 }
289:                 catch
290:                 {
291:                     // Ghi đè rác bộ nhớ cho lượt kết nối tiếp theo
292:                     webSocket?.Dispose();
293:                 }
294:             }
295:         }
296:     }
297: }
