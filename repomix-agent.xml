130:                 if (System.IO.Directory.Exists(logPath))
131:                 {
132:                     System.Diagnostics.Process.Start("explorer.exe", logPath);
133:                 }
134:                 else
135:                 {
136:                     MessageBox.Show("Thư mục Log chưa được tạo.", "Thông báo", MessageBoxButtons.OK, MessageBoxIcon.Information);
137:                 }
138:             }
139:             catch (Exception ex)
140:             {
141:                 MessageBox.Show($"Lỗi khi mở thư mục Log: {ex.Message}", "Lỗi", MessageBoxButtons.OK, MessageBoxIcon.Error);
142:                 Log.Error(ex, "[TrayApp] Lỗi mở thư mục log");
143:             }
144:         }
