<file path="agent/Modules/FileModule.cs">
  1: using System;
  2: using System.Collections.Concurrent;
  3: using System.Collections.Generic;
  4: using System.IO;
  5: using System.Linq;
  6: using System.Text.Json;
  7: using System.Threading.Tasks;
  8: using AgentSystem.Core;
  9: using AgentSystem.Managers;
 10: using System.Security.Cryptography;
 11: 
 12: namespace AgentSystem.Modules
 13: {
 14:     public class FileModule : BaseModule
 15:     {
 16:         private readonly ConcurrentDictionary<string, TaskCompletionSource<byte[]>> _binaryWaiters = new ConcurrentDictionary<string, TaskCompletionSource<byte[]>>();
 17:         private ConcurrentDictionary<string, ConcurrentDictionary<int, byte[]>> _pendingUploads = new ConcurrentDictionary<string, ConcurrentDictionary<int, byte[]>>();
 18:         private ConcurrentDictionary<string, SemaphoreSlim> _uploadLocks = new ConcurrentDictionary<string, SemaphoreSlim>();
 19: 
 20:         public override string[] SupportedCommands => new[] { "fs_list", "fs_get", "fs_put", "fs_delete" };
 21: 
 22:         public FileModule(IAgentContext context, SecurityManager security, UIManager ui) 
 23:             : base(context, security, ui) { }
 24: 
 25:         public void HandleBinaryChunk(byte[] bytes)
 26:         {
 27:             // Luồng dữ liệu Binary Frame (hiện tại fs_put đã chuyển qua dùng Base64).
 28:             // Hàm này giữ lại để đảm bảo tương thích AgentClient.
 29:         }
 30: 
 31:         public override async Task ExecuteAsync(string action, JsonElement parameters, string commandId)
 32:         {
 33:             try
 34:             {
 35:                 bool isObj = parameters.ValueKind == JsonValueKind.Object;
 36:                 string relativePath = isObj && parameters.TryGetProperty("path", out var pathElement) ? pathElement.GetString() : "/";
 37:                 if (!security.IsPathInSandbox(relativePath))
 38:                 {
 39:                     SendError(commandId, action, relativePath, "Path is outside the sandbox");
 40:                     return;
 41:                 }
 42: 
 43:                 string fullPath = security.NormalizeAndValidatePath(relativePath);
 44: 
 45:                 switch (action)
 46:                 {
 47:                     case "fs_list":
 48:                         ListDirectory(fullPath, relativePath, commandId);
 49:                         break;
 50:                     case "fs_get":
 51:                         await GetFileAsync(fullPath, relativePath, commandId, parameters);
 52:                         break;
 53:                     case "fs_put":
 54:                         int chunkIndex = isObj && parameters.TryGetProperty("chunk_index", out var ci) ? ci.GetInt32() : 0;
 55:                         int totalChunks = isObj && parameters.TryGetProperty("total_chunks", out var tc) ? tc.GetInt32() : 1;
 56:                         string transferId = isObj && parameters.TryGetProperty("transfer_id", out var tid) ? tid.GetString() : commandId;
 57: 
 58:                         string base64Data = isObj && parameters.TryGetProperty("data_base64", out var b64) ? b64.GetString() : "";
 59:                         byte[] fileBytes = string.IsNullOrEmpty(base64Data) ? Array.Empty<byte>() : Convert.FromBase64String(base64Data);
 60: 
 61:                         await PutFileAsync(fullPath, relativePath, transferId, chunkIndex, totalChunks, fileBytes, commandId);
 62:                         break;
 63:                     case "fs_delete":
 64:                         DeleteFileOrDirectory(fullPath, relativePath, commandId);
 65:                         break;
 66:                     default:
 67:                         SendError(commandId, action, relativePath, $"Unknown file system action: {action}");
 68:                         break;
 69:                 }
 70:             }
 71:             catch (Exception ex)
 72:             {
 73:                 string path = parameters.TryGetProperty("path", out var p) ? p.GetString() : "/";
 74:                 SendError(commandId, action, path, $"File operation failed: {ex.Message}");
 75:             }
 76:         }
 77: 
 78:         private async Task PutFileAsync(string fullPath, string relativePath, string transferId, int chunkIndex, int totalChunks, byte[] fileBytes, string commandId)
 79:         {
 80:             var semaphore = _uploadLocks.GetOrAdd(transferId, _ => new SemaphoreSlim(1, 1));
 81:             await semaphore.WaitAsync();
 82:             bool isComplete = false;
 83:             ConcurrentDictionary<int, byte[]> completeChunks = null;
 84:             try
 85:             {
 86:                 var chunks = _pendingUploads.GetOrAdd(transferId, _ => new ConcurrentDictionary<int, byte[]>());
 87:                 chunks[chunkIndex] = fileBytes;
 88:                 if (chunks.Count == totalChunks)
 89:                 {
 90:                     isComplete = true;
 91:                     _pendingUploads.TryRemove(transferId, out completeChunks);
 92:                     _uploadLocks.TryRemove(transferId, out _);
 93:                 }
 94:             }
 95:             finally
 96:             {
 97:                 semaphore.Release();
 98:             }
 99: 
100:             if (isComplete && completeChunks != null)
101:             {
102:                 string directoryPath = Path.GetDirectoryName(fullPath);
103:                 if (!Directory.Exists(directoryPath)) Directory.CreateDirectory(directoryPath);
104: 
105:                 // Sắp xếp và ghi 1 lần
106:                 int totalLength = completeChunks.Values.Sum(c => c.Length);
107:                 byte[] fullData = new byte[totalLength];
108:                 int offset = 0;
109:                 for (int i = 0; i < totalChunks; i++)
110:                 {
111:                     if (completeChunks.TryGetValue(i, out var chunk))
112:                     {
113:                         Buffer.BlockCopy(chunk, 0, fullData, offset, chunk.Length);
114:                         offset += chunk.Length;
115:                     }
116:                 }
117: 
118:                 await File.WriteAllBytesAsync(fullPath, fullData);
119: 
120:                 string fileHash = ComputeFileSHA256(fullPath);
121:                 context.SendResponse(new
122:                 {
123:                     type = "fs_put_complete",
124:                     agent_id = context.AgentId,
125:                     command_id = commandId,
126:                     transfer_id = transferId,
127:                     path = relativePath,
128:                     success = true,
129:                     complete = true,
130:                     sha256 = fileHash,
131:                     message = "File saved successfully"
132:                 });
133:             }
134:             else if (!isComplete)
135:             {
136:                 context.SendResponse(new
137:                 {
138:                     type = "fs_put_result",
139:                     agent_id = context.AgentId,
140:                     command_id = commandId,
141:                     transfer_id = transferId,
142:                     path = relativePath,
143:                     chunk_index = chunkIndex,
144:                     success = true,
145:                     message = "Chunk received"
146:                 });
147:             }
148:         }
149: 
150:         private void ListDirectory(string fullPath, string relativePath, string commandId)
151:         {
152:             if (!Directory.Exists(fullPath))
153:             {
154:                 SendError(commandId, "fs_list", relativePath, "Directory does not exist.");
155:                 return;
156:             }
157: 
158:             DirectoryInfo dirInfo = new DirectoryInfo(fullPath);
159: 
160:             var directories = dirInfo.GetDirectories().Select(d => new
161:             {
162:                 name = d.Name,
163:                 type = "directory",
164:                 size = (long?)null,
165:                 modified_ms = new DateTimeOffset(d.LastWriteTimeUtc).ToUnixTimeMilliseconds()
166:             });
167: 
168:             var files = dirInfo.GetFiles().Select(f => new
169:             {
170:                 name = f.Name,
171:                 type = "file",
172:                 size = (long?)f.Length,
173:                 modified_ms = new DateTimeOffset(f.LastWriteTimeUtc).ToUnixTimeMilliseconds()
174:             });
175: 
176:             context.SendResponse(new
177:             {
178:                 type = "fs_list_result",
179:                 agent_id = context.AgentId,
180:                 command_id = commandId,
181:                 path = relativePath,
182:                 entries = directories.Concat(files).ToList()
183:             });
184:         }
185: 
186:         private async Task GetFileAsync(string fullPath, string relativePath, string commandId, JsonElement parameters)
187:         {
188:             if (!File.Exists(fullPath))
189:             {
190:                 SendError(commandId, "fs_get", relativePath, "File does not exist.");
191:                 return;
192:             }
193: 
194:             const int CHUNK_SIZE = 512 * 1024; // 512 KB mỗi chunk
195:             bool isObj = parameters.ValueKind == JsonValueKind.Object;
196:             string transferId = isObj && parameters.TryGetProperty("transfer_id", out var tid) ? tid.GetString() : commandId;
197: 
198:             string fileHash = ComputeFileSHA256(fullPath);
199: 
200:             using var stream = new FileStream(fullPath, FileMode.Open, FileAccess.Read, FileShare.Read, 4096, useAsync: true);
201:             long totalSize = stream.Length;
202:             int totalChunks = (int)Math.Ceiling((double)totalSize / CHUNK_SIZE);
203:             if (totalChunks == 0) totalChunks = 1;
204: 
205:             byte[] buffer = new byte[CHUNK_SIZE];
206:             int chunkIndex = 0;
207:             int bytesRead;
208: 
209:             while ((bytesRead = await stream.ReadAsync(buffer, 0, CHUNK_SIZE)) > 0)
210:             {
211:                 context.SendResponse(new
212:                 {
213:                     type = "fs_get_result",
214:                     agent_id = context.AgentId,
215:                     command_id = commandId,
216:                     transfer_id = transferId,
217:                     success = true,
218:                     path = relativePath,
219:                     total_size = totalSize,
220:                     chunk_index = chunkIndex,
221:                     total_chunks = totalChunks,
222:                     sha256 = (chunkIndex == totalChunks - 1) ? fileHash : null
223:                 });
224: 
225:                 if (bytesRead == CHUNK_SIZE)
226:                 {
227:                     context.SendBinaryFrame(buffer);
228:                 }
229:                 else
230:                 {
231:                     byte[] chunkData = new byte[bytesRead];
232:                     Buffer.BlockCopy(buffer, 0, chunkData, 0, bytesRead);
233:                     context.SendBinaryFrame(chunkData);
234:                 }
235: 
236:                 chunkIndex++;
237:             }
238:         }
239: 
240:         private void SendError(string commandId, string action, string path, string message)
241:         {
242:             context.SendResponse(new
243:             {
244:                 type = "fs_error",
245:                 agent_id = context.AgentId,
246:                 command_id = commandId,
247:                 operation = action,
248:                 path = path,
249:                 message = message
250:             });
251:         }
252:     
253:         private string ComputeSHA256(byte[] data)
254:         {
255:             using (SHA256 sha256 = SHA256.Create())
256:             {
257:                 byte[] hashBytes = sha256.ComputeHash(data);
258:                 return BitConverter.ToString(hashBytes).Replace("-", "").ToLowerInvariant();
259:             }
260:         }
261: 
262:         private string ComputeFileSHA256(string filePath)
263:         {
264:             using (SHA256 sha256 = SHA256.Create())
265:             using (FileStream stream = File.OpenRead(filePath))
266:             {
267:                 byte[] hashBytes = sha256.ComputeHash(stream);
268:                 return BitConverter.ToString(hashBytes).Replace("-", "").ToLowerInvariant();
269:             }
270:         }
271: 
272:         public override void OnDisconnected()
273:         {
274:             foreach (var kvp in _binaryWaiters)
275:             {
276:                 kvp.Value.TrySetCanceled();
277:             }
278:             _binaryWaiters.Clear();
279:             _pendingUploads.Clear();
280:             _uploadLocks.Clear();
281: 
282:             base.OnDisconnected();
283:         }
284: 
285:         private void DeleteFileOrDirectory(string fullPath, string relativePath, string commandId)
286:         {
287:             try
288:             {
289:                 if (File.Exists(fullPath))
290:                 {
291:                     File.Delete(fullPath);
292:                     context.SendResponse(new { type = "fs_action_result", agent_id = context.AgentId, command_id = commandId, path = relativePath, success = true, action = "delete" });
293:                 }
294:                 else if (Directory.Exists(fullPath))
295:                 {
296:                     Directory.Delete(fullPath, true);
297:                     context.SendResponse(new { type = "fs_action_result", agent_id = context.AgentId, command_id = commandId, path = relativePath, success = true, action = "delete" });
298:                 }
299:                 else
300:                 {
301:                     SendError(commandId, "fs_delete", relativePath, "Path does not exist.");
302:                 }
303:             }
304:             catch (Exception ex)
305:             {
306:                 SendError(commandId, "fs_delete", relativePath, ex.Message);
307:             }
308:         }
309:     }
310: }
