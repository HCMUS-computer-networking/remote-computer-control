  9: namespace AgentSystem.Forms
 10: {
 11:     public class TrayApp : ApplicationContext
 12:     {
 13:         private NotifyIcon trayIcon;
 14:         private ContextMenuStrip trayMenu;
 15:         private AgentClient agent;
 16:         
 17:         private ToolStripMenuItem autoStartMenuItem;
 18:         private const string RunKey = @"SOFTWARE\Microsoft\Windows\CurrentVersion\Run";
 19:         private const string AppName = "AgentSystem";
 20:         
 21:         private MainForm mainForm;
 22: 
 23:         public TrayApp(AgentClient agentClient)
 24:         {
 25:             this.agent = agentClient;
 26:             
 27:             mainForm = new MainForm(agent);
 28:             mainForm.Show();
 29: 
 30:             bool isAutoStart = CheckAutoStart();
 31:             autoStartMenuItem = new ToolStripMenuItem("Khởi động cùng Windows", null, ToggleAutoStart);
 32:             autoStartMenuItem.Checked = isAutoStart;
 33: 
 34:             // Context Menu
 35:             trayMenu = new ContextMenuStrip();
 36:             trayMenu.Items.Add("Bảng Điều Khiển (Dashboard)", null, ShowDashboard);
 37:             trayMenu.Items.Add("-");
 38:             trayMenu.Items.Add(autoStartMenuItem);
 39:             trayMenu.Items.Add("-");
 40:             trayMenu.Items.Add("Mở thư mục Log", null, OpenLogFolder);
 41:             trayMenu.Items.Add("-");
 42:             trayMenu.Items.Add("Thoát", null, Exit);
 43: 
 44:             // Khởi tạo System Tray Icon
 45:             trayIcon = new NotifyIcon()
 46:             {
 47:                 Text = "Remote Computer Control - Agent",
 48:                 Icon = SystemIcons.Shield, // Dùng biểu tượng khiên bảo mật mặc định
 49:                 ContextMenuStrip = trayMenu,
 50:                 Visible = true
 51:             };
 52:             
 53:             trayIcon.DoubleClick += ShowDashboard;
 54:         }
 55: 
 56:         private void ShowDashboard(object sender, EventArgs e)
 57:         {
 58:             if (mainForm.IsDisposed)
 59:             {
 60:                 mainForm = new MainForm(agent);
 61:             }
 62:             mainForm.Show();
 63:             mainForm.WindowState = FormWindowState.Normal;
 64:             mainForm.BringToFront();
 65:         }
 66: 
 67:         private bool Authenticate()
 68:         {
 69:             if (string.IsNullOrEmpty(ConfigManager.Current.TrayPassword)) return true;
 70: 
 71:             using (var form = new PasswordPromptForm())
 72:             {
 73:                 form.ShowDialog();
 74:                 return form.IsAuthenticated;
 75:             }
 76:         }
 77: 
 78:         private bool CheckAutoStart()
 79:         {
 80:             try
 81:             {
 82:                 using (RegistryKey key = Registry.CurrentUser.OpenSubKey(RunKey))
 83:                 {
 84:                     if (key != null)
 85:                     {
 86:                         var val = key.GetValue(AppName);
 87:                         return val != null && val.ToString() == Application.ExecutablePath;
 88:                     }
 89:                 }
 90:             }
 91:             catch { }
 92:             return false;
 93:         }
 94: 
 95:         private void ToggleAutoStart(object sender, EventArgs e)
 96:         {
 97:             if (!Authenticate()) return;
 98: 
 99:             try
100:             {
101:                 using (RegistryKey key = Registry.CurrentUser.OpenSubKey(RunKey, true))
102:                 {
103:                     if (autoStartMenuItem.Checked)
104:                     {
105:                         key.DeleteValue(AppName, false);
106:                         autoStartMenuItem.Checked = false;
107:                         Log.Information("[TrayApp] Đã TẮT khởi động cùng Windows.");
108:                     }
109:                     else
110:                     {
111:                         key.SetValue(AppName, Application.ExecutablePath);
112:                         autoStartMenuItem.Checked = true;
113:                         Log.Information("[TrayApp] Đã BẬT khởi động cùng Windows.");
114:                     }
115:                 }
116:             }
