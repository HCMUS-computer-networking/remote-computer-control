135:             {
136:                 try
137:                 {
138:                     byte[] plaintext = System.Text.Encoding.UTF8.GetBytes(json);
139:                     byte[] e2eeBytes = Crypto.EncryptAESGCM(plaintext);
140:                     string dataBase64 = Convert.ToBase64String(e2eeBytes);
141:                     
142:                     var wrapper = new
143:                     {
144:                         type = "e2ee_payload",
145:                         agent_id = AgentId,
146:                         seq = Crypto.GetNextSendSeq(),
147:                         data = dataBase64
148:                     };
149:                     string wrapperJson = JsonSerializer.Serialize(wrapper);
150:                     wsClient.SendText(wrapperJson);
151:                 }
152:                 catch (Exception ex)
153:                 {
154:                     Log.Error(ex, "[E2EE] Lỗi mã hóa SendResponse");
155:                 }
156:             }
157:             else
158:             {
159:                 wsClient.SendText(json);
