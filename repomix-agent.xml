<file path="agent/Managers/ConfigManager.cs">
  1: using System;
  2: using System.IO;
  3: using System.Linq;
  4: using System.Net.NetworkInformation;
  5: using System.Security.Cryptography;
  6: using System.Text;
  7: using System.Text.Json;
  8: using AgentSystem.Models;
  9: using Serilog;
 10: 
 11: namespace AgentSystem.Managers
 12: {
 13:     public static class ConfigManager
 14:     {
 15:         private static string GetConfigFilePath()
 16:         {
 17:             string baseDirConfig = Path.Combine(AppDomain.CurrentDomain.BaseDirectory, "config.json");
 18:             if (File.Exists(baseDirConfig)) return baseDirConfig;
 19:             
 20:             string cwdConfig = Path.Combine(Directory.GetCurrentDirectory(), "config.json");
 21:             if (File.Exists(cwdConfig)) return cwdConfig;
 22: 
 23:             return baseDirConfig;
 24:         }
 25: 
 26:         public static AppConfig Current { get; private set; }
 27: 
 28:         public static void Load()
 29:         {
 30:             string configPath = GetConfigFilePath();
 31:             try
 32:             {
 33:                 if (File.Exists(configPath))
 34:                 {
 35:                     string json = File.ReadAllText(configPath);
 36:                     Current = JsonSerializer.Deserialize<AppConfig>(json) ?? new AppConfig();
 37:                 }
 38:                 else
 39:                 {
 40:                     Current = new AppConfig();
 41:                 }
 42: 
 43:                 // NẾU AGENT_ID ĐANG ĐỂ TRỐNG HOẶC MẶC ĐỊNH -> TỰ ĐỘNG LẤY TÊN MÁY WINDOWS
 44:                 if (string.IsNullOrWhiteSpace(Current.AgentId) || Current.AgentId == "AUTO" || Current.AgentId == "PC-Lab-01")
 45:                 {
 46:                     Current.AgentId = GetAutoAgentId();
 47:                 }
 48: 
 49:                 // DPAPI Logic for E2EESharedSecret
 50:                 if (Current.E2EESharedSecretEncrypted != null && Current.E2EESharedSecretEncrypted.StartsWith("DPAPI:"))
 51:                 {
 52:                     try
 53:                     {
 54:                         byte[] encryptedBytes = Convert.FromBase64String(Current.E2EESharedSecretEncrypted.Substring(6));
 55:                         byte[] plainBytes = ProtectedData.Unprotect(encryptedBytes, null, DataProtectionScope.CurrentUser);
 56:                         Current.E2EESharedSecret = Encoding.UTF8.GetString(plainBytes);
 57:                     }
 58:                     catch (Exception ex)
 59:                     {
 60:                         Log.Error(ex, "Lỗi giải mã PIN DPAPI: {ErrorMessage}", ex.Message);
 61:                         Current.E2EESharedSecret = "default-pin-12345";
 62:                     }
 63:                 }
 64:                 else
 65:                 {
 66:                     // Plain text in JSON. Encrypt it for future.
 67:                     Current.E2EESharedSecret = Current.E2EESharedSecretEncrypted ?? "default-pin-12345";
 68:                     byte[] plainBytes = Encoding.UTF8.GetBytes(Current.E2EESharedSecret);
 69:                     byte[] encryptedBytes = ProtectedData.Protect(plainBytes, null, DataProtectionScope.CurrentUser);
 70:                     Current.E2EESharedSecretEncrypted = "DPAPI:" + Convert.ToBase64String(encryptedBytes);
 71:                 }
 72: 
 73:                 Save(); // Lưu lại cấu hình chuẩn
 74:                 Log.Information("[Config] Đã tải config thành công: AgentId={AgentId}, GatewayUrl={GatewayUrl}", Current.AgentId, Current.GatewayUrl);
 75:             }
 76:             catch (Exception ex)
 77:             {
 78:                 Log.Warning(ex, "Lỗi đọc config.json, dùng cấu hình mặc định: {ErrorMessage}", ex.Message);                Current = new AppConfig { AgentId = GetAutoAgentId() };
 79:             }
 80:         }
 81: 
 82:         /// <summary>
 83:         /// Tự động tạo Agent ID duy nhất dựa trên Tên máy Windows + 4 ký tự cuối MAC Address
 84:         /// </summary>
 85:         private static string GetAutoAgentId()
 86:         {
 87:             try
 88:             {
 89:                 // 1. Lấy tên máy Windows (ví dụ: LAB01-PC15)
 90:                 string machineName = Environment.MachineName;
 91: 
 92:                 // 2. Lấy địa chỉ MAC card mạng đầu tiên đang hoạt động (Để đảm bảo 100% không trùng)
 93:                 var macAddress = NetworkInterface.GetAllNetworkInterfaces()
 94:                     .Where(nic => nic.OperationalStatus == OperationalStatus.Up && nic.NetworkInterfaceType != NetworkInterfaceType.Loopback)
 95:                     .Select(nic => nic.GetPhysicalAddress().ToString())
 96:                     .FirstOrDefault();
 97: 
 98:                 string macSuffix = !string.IsNullOrEmpty(macAddress) && macAddress.Length >= 4 
 99:                     ? "-" + macAddress.Substring(macAddress.Length - 4) 
100:                     : "";
101: 
102:                 return $"{machineName}{macSuffix}"; // Kết quả dạng: LAB01-PC15-8A2F
103:             }
104:             catch
105:             {
106:                 // Fallback nếu không đọc được thông tin phần cứng
107:                 return $"AGENT-{Environment.MachineName}";
108:             }
109:         }
110: 
111:         public static void Save()
112:         {
113:             try
114:             {
115:                 var options = new JsonSerializerOptions { WriteIndented = true };
116:                 string json = JsonSerializer.Serialize(Current, options);
117:                 File.WriteAllText(GetConfigFilePath(), json);
118:             }
119:             catch (Exception ex)
120:             {
121:                 Log.Error(ex, "Lỗi khi lưu config.json: {ErrorMessage}", ex.Message);
122:             }
123:         }
124:     }
125: }
</file>

<file path="agent/Core/MessageDispatcher.cs">
 1: using System;
 2: using System.Text.Json;
 3: using AgentSystem.Models;
 4: using Serilog;
 5: 
 6: namespace AgentSystem.Core
 7: {
 8:     public class MessageDispatcher
 9:     {
10:         private AgentClient context;
11: 
12:         public MessageDispatcher(AgentClient context)
13:         {
14:             this.context = context;
15:         }
16: 
17:         public void Dispatch(string rawJson)
18:         {
19:             try
20:             {
21:                 // Cố gắng phân tích chuỗi JSON thành CommandPacket
22:                 var packet = JsonSerializer.Deserialize<CommandPacket>(rawJson);
23:                 if (packet != null)
24:                 {
25:                     if (packet.Type == "e2ee_payload")
26:                     {
27:                         if (!context.Crypto.IsE2EEReady)
28:                         {
29:                             Log.Warning("[E2EE] Nhận được e2ee_payload nhưng E2EE chưa sẵn sàng. Bỏ qua.");
30:                             return;
31:                         }
32: 
33:                         if (!context.Crypto.CheckAndUpdateRecvSeq(packet.Seq))
34:                         {
35:                             Log.Warning($"[E2EE] Lỗi Sequence (Replay Attack/Quá hạn), seq = {packet.Seq}. Bỏ qua.");
36:                             return;
37:                         }
38: 
39:                         try
40:                         {
41:                             byte[] e2eeBytes = Convert.FromBase64String(packet.Data);
42:                             byte[] plaintext = context.Crypto.DecryptAESGCM(e2eeBytes);
43:                             string innerJson = System.Text.Encoding.UTF8.GetString(plaintext);
44:                             
45:                             var innerPacket = JsonSerializer.Deserialize<CommandPacket>(innerJson);
46:                             if (innerPacket != null)
47:                             {
48:                                 context.RouteCommand(innerPacket);
49:                             }
50:                         }
51:                         catch (Exception ex)
52:                         {
53:                             Log.Error(ex, "[E2EE] Lỗi giải mã e2ee_payload.");
54:                         }
55:                     }
56:                     else
57:                     {
58:                         context.RouteCommand(packet);
59:                     }
60:                 }
61:             }
62:             catch (JsonException ex)
63:             {
64:                 // Bắt lỗi khi cấu trúc JSON bị sai (thiếu ngoặc, sai kiểu dữ liệu...)
65:                 Log.Error(ex, "[Dispatcher] Lỗi định dạng JSON từ Server: {Message}", ex.Message);
66:                 context.SendResponse(new
67:                 {
68:                     type = "ERROR",
69:                     agent_id = context.AgentId,
70:                     command_id = "unknown", // Vì không parse được JSON nên không lấy được command_id
71:                     message = "Malformed JSON received from Gateway."
72:                 });
73:             }
74:             catch (Exception ex)
75:             {
76:                 // Bắt mọi rủi ro ngoại lệ khác có thể xảy ra trong khối lệnh
77:                 Log.Error(ex, "[Dispatcher] Lỗi điều phối lệnh: {Message}", ex.Message);
78:                 context.SendResponse(new
79:                 {
80:                     type = "ERROR",
81:                     agent_id = context.AgentId,
82:                     command_id = "unknown",
83:                     message = $"Dispatcher error: {ex.Message}"
84:                 });
85:             }
86:         }
87:     }
88: }
