<file path="agent/Managers/LogCleanupJob.cs">
 1: using System;
 2: using System.IO;
 3: using System.Threading;
 4: using System.Threading.Tasks;
 5: using Serilog;
 6: 
 7: namespace AgentSystem.Managers
 8: {
 9:     public static class LogCleanupJob
10:     {
11:         public static void Start(int retentionDays)
12:         {
13:             if (retentionDays <= 0) return; // Không xóa nếu cấu hình <= 0
14: 
15:             Task.Run(async () =>
16:             {
17:                 using var timer = new PeriodicTimer(TimeSpan.FromHours(24)); // Chạy mỗi 24 giờ
18:                 
19:                 // Chạy lần đầu ngay lập tức
20:                 DoCleanup(retentionDays);
21: 
22:                 while (await timer.WaitForNextTickAsync())
23:                 {
24:                     DoCleanup(retentionDays);
25:                 }
26:             });
27:         }
28: 
29:         private static void DoCleanup(int retentionDays)
30:         {
31:             try
32:             {
33:                 string logDir = Path.Combine(AppDomain.CurrentDomain.BaseDirectory, "Logs");
34:                 if (!Directory.Exists(logDir)) return;
35: 
36:                 var files = Directory.GetFiles(logDir, "*.log");
37:                 DateTime cutoffDate = DateTime.Now.AddDays(-retentionDays);
38: 
39:                 int deletedCount = 0;
40:                 foreach (var file in files)
41:                 {
42:                     try
43:                     {
44:                         var fileInfo = new FileInfo(file);
45:                         if (fileInfo.LastWriteTime < cutoffDate)
46:                         {
47:                             fileInfo.Delete();
48:                             deletedCount++;
49:                         }
50:                     }
51:                     catch (IOException)
52:                     {
53:                         // File có thể đang được log ghi, bỏ qua
54:                     }
55:                 }
56: 
57:                 if (deletedCount > 0)
58:                 {
59:                     Log.Information("[Maintenance] Đã tự động dọn dẹp {Count} file log cũ hơn {Days} ngày.", deletedCount, retentionDays);
60:                 }
61:             }
62:             catch (Exception ex)
63:             {
64:                 Log.Warning(ex, "[Maintenance] Lỗi khi dọn dẹp file log cũ: {Message}", ex.Message);
65:             }
66:         }
67:     }
68: }
