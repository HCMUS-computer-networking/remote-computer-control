<file path="gateway/src/udp/fecWorker.js">
 1: const { parentPort } = require('worker_threads');
 2: 
 3: // Lắng nghe yêu cầu tính toán XOR từ Main Thread
 4: parentPort.on('message', (task) => {
 5:   try {
 6:     const { taskId, total, totalPayloadLength, chunks, parityData } = task;
 7:     const MAX_PAYLOAD_SIZE = 1300;
 8: 
 9:     let missingIndex = -1;
10:     for (let i = 0; i < total; i++) {
11:       if (!chunks[i]) {
12:         missingIndex = i;
13:         break;
14:       }
15:     }
16: 
17:     if (missingIndex === -1 || !parityData) {
18:       parentPort.postMessage({ taskId, success: false, error: 'Không tìm thấy chunk thiếu hoặc không có parity data' });
19:       return;
20:     }
21: 
22:     // Thực hiện tính toán XOR nặng trên Worker Thread (không làm nghẽn Event Loop chính)
23:     let recovered = Buffer.from(parityData);
24:     for (let i = 0; i < total; i++) {
25:       if (i !== missingIndex && chunks[i]) {
26:         const chunk = Buffer.from(chunks[i]); // Chuyển đổi an toàn
27:         for (let j = 0; j < chunk.length; j++) {
28:           recovered[j] ^= chunk[j];
29:         }
30:       }
31:     }
32: 
33:     // Xử lý padding của chunk cuối cùng
34:     if (missingIndex === total - 1 && totalPayloadLength > 0) {
35:       let lastChunkSize = totalPayloadLength % MAX_PAYLOAD_SIZE;
36:       if (lastChunkSize === 0) lastChunkSize = MAX_PAYLOAD_SIZE;
37:       recovered = recovered.subarray(0, lastChunkSize);
38:     }
39: 
40:     // Trả kết quả về Main Thread dưới dạng Transferable Objects (Zero-copy)
41:     parentPort.postMessage({ taskId, success: true, missingIndex, recovered: recovered.buffer }, [recovered.buffer]);
42:   } catch (err) {
43:     parentPort.postMessage({ taskId, success: false, error: err.message });
44:   }
45: });
</file>

<file path="gateway/src/utils/logger.js">
 1: // src/utils/logger.js
 2: // Winston logger — console (colorized) + file (logs/gateway.log).
 3: // Requirement D7: log mọi kết nối/ngắt/đăng ký + mọi message đi qua.
