<file path="gateway/src/db.js">
 1: // src/db.js
 2: // SQLite database connection and schema initialization using better-sqlite3.
 3: // Replaces in-memory Maps and static JSON files for users, agents, and refresh tokens.
 4: 
 5: const path = require('path');
 6: const fs = require('fs');
 7: const Database = require('better-sqlite3');
 8: const logger = require('./utils/logger');
 9: 
10: const dbPath = process.env.DB_PATH || path.resolve(__dirname, 'store', 'data.sqlite');
11: 
12: // Ensure directory exists
13: const dbDir = path.dirname(dbPath);
14: if (!fs.existsSync(dbDir)) {
15:   fs.mkdirSync(dbDir, { recursive: true });
16: }
17: 
18: const db = new Database(dbPath);
19: db.pragma('journal_mode = WAL');
20: 
21: // Initialize database tables on startup
22: function initSchema() {
23:   const schema = `
24:     CREATE TABLE IF NOT EXISTS users (
25:       id INTEGER PRIMARY KEY AUTOINCREMENT,
26:       username TEXT UNIQUE NOT NULL,
27:       password_hash TEXT NOT NULL,
28:       role TEXT DEFAULT 'admin'
29:     );
30: 
31:     CREATE TABLE IF NOT EXISTS agents (
32:       agent_id TEXT PRIMARY KEY,
33:       secret_hash TEXT NOT NULL,
34:       display_name TEXT,
35:       created_at INTEGER
36:     );
37: 
38:     CREATE TABLE IF NOT EXISTS refresh_tokens (
39:       jti TEXT PRIMARY KEY,
40:       user_id INTEGER NOT NULL,
41:       expires_at INTEGER NOT NULL,
42:       FOREIGN KEY(user_id) REFERENCES users(id) ON DELETE CASCADE
43:     );
44:   `;
45:   db.exec(schema);
46:   logger.info('[db] SQLite schema verified/initialized', { path: dbPath });
47: }
48: 
49: initSchema();
50: 
51: // ─── User Helper Queries ──────────────────────────────────────
52: const getUserByUsernameStmt = db.prepare('SELECT * FROM users WHERE username = ?');
53: const getUserByIdStmt = db.prepare('SELECT * FROM users WHERE id = ?');
54: const upsertUserStmt = db.prepare(`
55:   INSERT INTO users (username, password_hash, role)
56:   VALUES (?, ?, ?)
57:   ON CONFLICT(username) DO UPDATE SET
58:     password_hash = excluded.password_hash,
59:     role = excluded.role
60: `);
61: 
62: // ─── Agent Helper Queries ─────────────────────────────────────
63: const getAgentByIdStmt = db.prepare('SELECT * FROM agents WHERE agent_id = ?');
64: const getAllAgentsStmt = db.prepare('SELECT * FROM agents');
65: const upsertAgentStmt = db.prepare(`
66:   INSERT INTO agents (agent_id, secret_hash, display_name, created_at)
67:   VALUES (?, ?, ?, ?)
68:   ON CONFLICT(agent_id) DO UPDATE SET
69:     secret_hash = excluded.secret_hash,
70:     display_name = COALESCE(excluded.display_name, agents.display_name)
71: `);
72: 
73: // ─── Refresh Token Helper Queries ─────────────────────────────
74: const insertRefreshTokenStmt = db.prepare('INSERT OR REPLACE INTO refresh_tokens (jti, user_id, expires_at) VALUES (?, ?, ?)');
75: const getRefreshTokenStmt = db.prepare('SELECT * FROM refresh_tokens WHERE jti = ?');
76: const deleteRefreshTokenStmt = db.prepare('DELETE FROM refresh_tokens WHERE jti = ?');
77: const cleanExpiredTokensStmt = db.prepare('DELETE FROM refresh_tokens WHERE expires_at < ?');
78: 
79: const queries = {
80:   getUserByUsername: (username) => getUserByUsernameStmt.get(username),
81:   getUserById: (id) => getUserByIdStmt.get(id),
82:   upsertUser: (username, passwordHash, role = 'admin') => upsertUserStmt.run(username, passwordHash, role),
83: 
84:   getAgentById: (agentId) => getAgentByIdStmt.get(agentId),
85:   getAllAgents: () => getAllAgentsStmt.all(),
86:   upsertAgent: (agentId, secretHash, displayName = '', createdAt = Date.now()) => upsertAgentStmt.run(agentId, secretHash, displayName, createdAt),
87: 
88:   insertRefreshToken: (jti, userId, expiresAt) => insertRefreshTokenStmt.run(jti, userId, expiresAt),
89:   getRefreshToken: (jti) => getRefreshTokenStmt.get(jti),
90:   deleteRefreshToken: (jti) => deleteRefreshTokenStmt.run(jti),
91:   cleanExpiredTokens: (nowMs = Date.now()) => cleanExpiredTokensStmt.run(nowMs),
92: };
93: 
94: module.exports = {
95:   db,
96:   queries,
97:   initSchema,
98: };
</file>

