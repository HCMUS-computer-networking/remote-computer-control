131:     type: 'object',
132:     properties: {
133:       path: { type: 'string' },
134:       chunk_index: { type: 'integer', minimum: 0 },
135:       total_chunks: { type: 'integer', minimum: 1 },
136:       transfer_id: { type: 'string' },
137:       total_size: { type: 'integer', minimum: 0 },
138:       data_base64: { type: 'string' },
139:     },
