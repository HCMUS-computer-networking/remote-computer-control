<file path="scripts/dev-up.ps1">
 1: # dev-up.ps1 — launch Gateway (background) + Controller (foreground) in parallel.
 2: # Run from repo root: pwsh ./scripts/dev-up.ps1
 3: #
 4: # Gateway starts as a PowerShell background job (stdout/stderr streamed to logs/).
 5: # Controller runs in the current console so Ctrl+C stops it cleanly. On exit, the
 6: # Gateway job is stopped too.
 7: 
 8: $ErrorActionPreference = "Stop"
 9: 
10: $repo_root       = Split-Path -Parent $PSScriptRoot
11: $gateway_dir     = Join-Path $repo_root "gateway"
12: $controller_dir  = Join-Path $repo_root "controller"
13: $log_dir         = Join-Path $repo_root "logs"
14: 
15: New-Item -ItemType Directory -Force -Path $log_dir | Out-Null
16: 
17: Write-Host ""
18: Write-Host "==============================================" -ForegroundColor Cyan
19: Write-Host "  Remote Computer Control — dev-up"          -ForegroundColor Cyan
20: Write-Host "==============================================" -ForegroundColor Cyan
21: Write-Host "  Gateway    → http://localhost:8080"          -ForegroundColor Yellow
22: Write-Host "  Controller → http://localhost:5173"          -ForegroundColor Yellow
23: Write-Host "  Health     → http://localhost:8080/health"   -ForegroundColor Yellow
24: Write-Host "  Gateway log: $log_dir\gateway-dev.log"       -ForegroundColor DarkGray
25: Write-Host ""
26: 
27: # Ensure dependencies are installed (idempotent, skips if node_modules exists).
28: if (-not (Test-Path (Join-Path $gateway_dir "node_modules")))
29: {
30:     Write-Host "[dev-up] Installing gateway dependencies..." -ForegroundColor Green
31:     Push-Location $gateway_dir; npm install; Pop-Location
32: }
33: if (-not (Test-Path (Join-Path $controller_dir "node_modules")))
34: {
35:     Write-Host "[dev-up] Installing controller dependencies..." -ForegroundColor Green
36:     Push-Location $controller_dir; npm install; Pop-Location
37: }
38: 
39: # Launch gateway as background job. Redirects both streams to a rolling log.
40: Write-Host "[dev-up] Starting Gateway (background)..." -ForegroundColor Green
41: $gateway_job = Start-Job -Name "gateway-dev" -ScriptBlock {
42:     param($dir, $log)
43:     Set-Location $dir
44:     npm run dev *>&1 | Tee-Object -FilePath $log
45: } -ArgumentList $gateway_dir, (Join-Path $log_dir "gateway-dev.log")
46: 
47: # Give the gateway a moment to bind :8080 before controller opens its browser.
48: Start-Sleep -Seconds 2
49: 
50: try
51: {
52:     Write-Host "[dev-up] Starting Controller (foreground, Ctrl+C to stop both)..." -ForegroundColor Green
53:     Push-Location $controller_dir
54:     npm run dev
55:     Pop-Location
56: }
57: finally
58: {
59:     Write-Host ""
60:     Write-Host "[dev-up] Stopping Gateway job..." -ForegroundColor Yellow
61:     Stop-Job   -Job $gateway_job -ErrorAction SilentlyContinue
62:     Remove-Job -Job $gateway_job -ErrorAction SilentlyContinue
63:     Write-Host "[dev-up] Done."                    -ForegroundColor Yellow
64: }
</file>

<file path="gateway/src/middleware/auth.js">
 1: // src/middleware/auth.js
 2: // Authentication helpers for WebSocket handshake.
 3: // Note: Agent authentication now happens during the REGISTER message via bcrypt (agentStore.js), not at HTTP upgrade.
 4: // D8: Controller xác thực JWT ở query ?token=, fallback ?key=CONTROLLER_KEY.
 5: 
 6: const jwt = require('jsonwebtoken');
 7: const config = require('../config');
 8: const logger = require('../utils/logger');
 9: 
10: /**
11:  * Verify Controller connection auth from query params.
12:  * Tries JWT (?token=) first if JWT_SECRET is configured, then falls back to ?key=.
13:  * @param {URLSearchParams} query - Parsed query parameters from upgrade URL
14:  * @returns {{ ok: boolean, payload: object|null }} ok=true if auth passed; payload = decoded JWT or null
15:  */
16: function verifyControllerAuth(query) {
17:   const token = query.get('token');
18:   const key = query.get('key');
19: 
20:   // --- Try JWT first (if JWT_SECRET is configured) ---
21:   if (token && config.jwtSecret) {
22:     try {
23:       const payload = jwt.verify(token, config.jwtSecret);
24:       logger.info('[auth] Controller authenticated via JWT', {
25:         username: payload.username,
26:       });
27:       return { ok: true, payload };
28:     } catch (err) {
29:       logger.warn('[auth] Controller JWT verification FAILED', {
30:         error: err.message,
31:       });
32:       // Don't return false yet — fall through to key check
33:     }
34:   }
35: 
36:   // --- Fallback: shared key ---
37:   if (key) {
38:     if (key === config.controllerKey) {
39:       logger.info('[auth] Controller authenticated via shared key');
40:       return { ok: true, payload: null };
41:     }
42:     logger.warn('[auth] Controller connection REJECTED: invalid key');
43:     return { ok: false, payload: null };
44:   }
45: 
46:   // --- Neither token nor key provided ---
47:   logger.warn(
48:     '[auth] Controller connection REJECTED: no ?token= or ?key= provided'
49:   );
50:   return { ok: false, payload: null };
51: }
52: 
53: module.exports = { verifyControllerAuth };
</file>

<file path="gateway/src/store/heartbeat.js">
 1: // src/managers/heartbeat.js
 2: // Ping-Pong heartbeat mechanism for WebSocket connections.
 3: // Detects dead connections early by sending periodic pings and
 4: // terminating sockets that don't respond with a pong in time.
 5: 
 6: const config = require('../config');
 7: const logger = require('../utils/logger');
 8: 
 9: /**
10:  * Attach heartbeat monitoring to a WebSocket.
11:  * Sends a WS-level ping every PING_INTERVAL ms.
12:  * If no pong is received within PING_TIMEOUT ms, the socket is terminated.
13:  *
14:  * @param {WebSocket} ws - The WebSocket to monitor
15:  * @param {string} label - Identifier for logging (e.g. "agent:PC-Lab-01" or "controller:1")
16:  * @returns {{ clear: () => void }} Call clear() to stop heartbeat (e.g. on close)
17:  */
18: function attach(ws, label) {
19:   let isAlive = true;
20: 
21:   // When we receive a pong, mark as alive
22:   ws.on('pong', () => {
23:     isAlive = true;
24:   });
25: 
26:   const interval = setInterval(() => {
27:     if (!isAlive) {
28:       logger.warn('[heartbeat] No pong received, terminating', { label });
29:       ws.terminate();
30:       clearInterval(interval);
31:       return;
32:     }
33: 
34:     isAlive = false;
35: 
36:     // ── Check access token expiration (for JWT authenticated sessions) ──
37:     if (ws._gwJwtPayload && typeof ws._gwJwtPayload.exp === 'number') {
38:       const nowSeconds = Math.floor(Date.now() / 1000);
39:       if (nowSeconds >= ws._gwJwtPayload.exp) {
40:         logger.warn('[auth] Access token expired during active WebSocket session', { label, exp: ws._gwJwtPayload.exp });
41:         try {
42:           ws.send(JSON.stringify({ type: 'auth_expired' }));
43:         } catch (err) {
44:           // ignore send error on closing socket
45:         }
46:         ws.close(4001, 'auth_expired');
47:         clearInterval(interval);
48:         return;
49:       }
50:     }
51: 
52:     try {
53:       ws.ping();
54:     } catch (err) {
55:       logger.error('[heartbeat] Ping failed', {
56:         label,
57:         error: err.message,
58:       });
59:       ws.terminate();
60:       clearInterval(interval);
61:     }
62:   }, config.pingInterval);
63: 
64:   return {
65:     clear() {
66:       clearInterval(interval);
67:     },
68:   };
69: }
70: 
71: module.exports = { attach };
</file>

