145:     properties: { path: { type: 'string' } },
146:     required: ['path'],
147:     additionalProperties: false,
148:   },
149: 
150:   // Policy & Permissions
151:   policy_update: {
152:     type: 'object',
153:     properties: {
154:       app_whitelist: { type: 'array', items: { type: 'string' } },
155:       sandbox_path: { type: 'string' },
156:     },
157:     minProperties: 1,
158:     additionalProperties: false,
159:   },
160:   permission_request: emptyParamsSchema,
161:   permission_revoke: emptyParamsSchema,
162:   stop_module: emptyParamsSchema,
163: };
164: 
165: // Biên dịch sẵn các schema để tăng hiệu suất
166: const validators = {};
167: for (const [key, schema] of Object.entries(schemas)) {
168:   validators[key] = ajv.compile(schema);
169: }
170: 
171: /**
172:  * Validate params of a command
173:  * @param {string} commandKey - The module/action name (e.g. 'proc_kill')
174:  * @param {object} params - The params object to validate
175:  * @returns {object} { valid: boolean, errors: array, errorText: string }
176:  */
177: function validateParams(commandKey, params) {
178:   const validator = validators[commandKey];
179:   if (!validator) {
180:     return { valid: true, errors: null, errorText: null };
181:   }
182: 
183:   const data = params === undefined ? null : params;
184:   const valid = validator(data);
185: 
186:   return {
187:     valid,
188:     errors: validator.errors,
189:     errorText: valid ? null : ajv.errorsText(validator.errors)
190:   };
191: }
192: 
193: module.exports = {
194:   validateParams,
195: };
</file>

<file path="gateway/src/auth/login.js">
  1: // src/auth/login.js
  2: // REST POST /api/login — bcrypt verify + JWT sign (access 30m + refresh 7d in HttpOnly cookie).
  3: // REST POST /api/refresh — check refresh token JTI, issue new 30m access token and rotate refresh token.
  4: // REST POST /api/logout — revoke refresh token JTI in Map + clear cookie.
  5: 
  6: const express = require('express');
  7: const bcrypt = require('bcryptjs');
  8: const jwt = require('jsonwebtoken');
  9: const path = require('path');
 10: const { v4: uuidv4 } = require('uuid');
 11: 
 12: const config = require('../config');
 13: const logger = require('../utils/logger');
 14: const { queries } = require('../db');
 15: 
 16: const router = express.Router();
 17: 
 18: /**
 19:  * POST /api/login
 20:  * Body: { username: string, password: string }
 21:  * Response: { ok: boolean, token: string|null, message: string } (Refresh token set in HttpOnly Cookie)
 22:  */
 23: router.post('/login', async (req, res) => {
 24:   const { username, password } = req.body;
 25: 
 26:   // --- Validate input ---
 27:   if (!username || !password) {
 28:     logger.warn('[login] Login FAILED: missing username or password');
 29:     return res.status(400).json({
 30:       ok: false,
 31:       token: null,
 32:       message: 'Username and password are required',
 33:     });
 34:   }
 35: 
 36:   // --- Find user ---
 37:   const user = queries.getUserByUsername(username);                                                 // SQLite row: { id, username, password_hash, role }
 38:   if (!user) {
 39:     logger.warn('[login] Login FAILED: unknown username', { username });
 40:     return res.status(401).json({
 41:       ok: false,
 42:       token: null,
 43:       message: 'Sai tài khoản hoặc mật khẩu',
 44:     });
 45:   }
 46: 
 47:   // --- Verify password with bcrypt ---
 48:   try {
 49:     const match = await bcrypt.compare(password, user.password_hash);                               // Column name in SQLite schema is snake_case
 50:     if (!match) {
 51:       logger.warn('[login] Login FAILED: wrong password', { username });
 52:       return res.status(401).json({
 53:         ok: false,
 54:         token: null,
 55:         message: 'Sai tài khoản hoặc mật khẩu',
 56:       });
 57:     }
 58:   } catch (err) {
 59:     logger.error('[login] bcrypt error', { error: err.message });
 60:     return res.status(500).json({
 61:       ok: false,
 62:       token: null,
 63:       message: 'Internal server error',
 64:     });
 65:   }
 66: 
 67:   // --- Sign JWT ---
 68:   if (!config.jwtSecret) {
 69:     logger.warn('[login] JWT_SECRET not configured, cannot issue token');
 70:     return res.status(500).json({
 71:       ok: false,
 72:       token: null,
 73:       message: 'JWT is not configured on this server',
 74:     });
 75:   }
 76: 
 77:   const role = user.role || 'admin';
 78:   const payload = { username: user.username, role };
 79: 
 80:   // 1. Access token TTL 30 minutes, embedding role
 81:   const token = jwt.sign(payload, config.jwtSecret, { expiresIn: '30m' });
 82: 
 83:   // 2. Issue refresh token with 7-day TTL and save JTI to SQLite
 84:   const jti = uuidv4();
 85:   const refreshPayload = { username: user.username, jti };
 86:   const refreshToken = jwt.sign(refreshPayload, config.jwtSecret, { expiresIn: '7d' });
 87:   const expiresAt = Date.now() + 7 * 24 * 60 * 60 * 1000;
 88: 
 89:   queries.insertRefreshToken(jti, user.id, expiresAt);
 90:   queries.cleanExpiredTokens(Date.now());
 91: 
 92:   // 4. Set refresh token via HttpOnly Cookie (NOT in response body)
 93:   res.cookie('refreshToken', refreshToken, {
 94:     httpOnly: true,
 95:     secure: config.tlsEnabled, // Secure when WSS/TLS enabled
 96:     sameSite: 'Strict',
 97:     maxAge: 7 * 24 * 60 * 60 * 1000, // 7 days in milliseconds
 98:   });
 99: 
100:   logger.info('[login] Login SUCCESS & refresh token saved to SQLite', { username, role, jti });
101:   return res.json({
102:     ok: true,
103:     token,
104:     message: 'Đăng nhập thành công',
105:   });
106: });
107: 
108: /**
109:  * POST /api/refresh
110:  * Reads refreshToken from HttpOnly Cookie (or body fallback), verifies JTI in SQLite,
111:  * issues a new 30m access token with role, and rotates the refresh token in DB.
112:  */
113: router.post('/refresh', (req, res) => {
114:   const token = req.cookies?.refreshToken || req.body?.refreshToken;
115: 
116:   if (!token) {
117:     logger.warn('[refresh] FAILED: No refresh token provided');
118:     return res.status(401).json({
119:       ok: false,
120:       token: null,
121:       message: 'Refresh token required',
122:     });
123:   }
124: 
125:   if (!config.jwtSecret) {
126:     return res.status(500).json({ ok: false, token: null, message: 'JWT not configured' });
127:   }
128: 
129:   try {
130:     const decoded = jwt.verify(token, config.jwtSecret);
131:     const jti = decoded.jti;
132: 
133:     if (!jti) {
134:       return res.status(401).json({ ok: false, token: null, message: 'Invalid refresh token' });
135:     }
136: 
137:     // Verify JTI exists and has not expired in SQLite
138:     const tokenRecord = queries.getRefreshToken(jti);
139:     if (!tokenRecord || tokenRecord.expires_at < Date.now()) {
140:       logger.warn('[refresh] FAILED: Revoked or expired JTI in SQLite', { jti, username: decoded.username });
141:       if (tokenRecord) {
142:         queries.deleteRefreshToken(jti);
143:       }
144:       return res.status(401).json({
145:         ok: false,
146:         token: null,
147:         message: 'Invalid or expired refresh token',
148:       });
149:     }
150: 
151:     // Get latest user info from DB
152:     const user = queries.getUserById(tokenRecord.user_id) || queries.getUserByUsername(decoded.username);
153:     if (!user) {
154:       logger.warn('[refresh] FAILED: User associated with token no longer exists in DB');
155:       queries.deleteRefreshToken(jti);
156:       return res.status(401).json({ ok: false, token: null, message: 'User no longer exists' });
157:     }
158: 
159:     const role = user.role || 'admin';
160: 
161:     // Rotate refresh token: delete old JTI and generate a new one in SQLite
162:     queries.deleteRefreshToken(jti);
163:     const newJti = uuidv4();
164:     const newRefreshToken = jwt.sign({ username: user.username, jti: newJti }, config.jwtSecret, { expiresIn: '7d' });
165:     const newExpiresAt = Date.now() + 7 * 24 * 60 * 60 * 1000;
166:     queries.insertRefreshToken(newJti, user.id, newExpiresAt);
167: 
168:     res.cookie('refreshToken', newRefreshToken, {
169:       httpOnly: true,
170:       secure: config.tlsEnabled,
171:       sameSite: 'Strict',
172:       maxAge: 7 * 24 * 60 * 60 * 1000,
173:     });
174: 
175:     // Issue new 30-minute access token embedding role
176:     const newAccessToken = jwt.sign({ username: user.username, role }, config.jwtSecret, { expiresIn: '30m' });
177: 
178:     logger.info('[refresh] Token refreshed & rotated successfully via SQLite', { username: user.username, role, oldJti: jti, newJti });
179:     return res.json({
180:       ok: true,
181:       token: newAccessToken,
182:       message: 'Token refreshed successfully',
183:     });
184:   } catch (err) {
185:     logger.warn('[refresh] FAILED: Token verification failed', { error: err.message });
186:     return res.status(401).json({
187:       ok: false,
188:       token: null,
189:       message: 'Expired or invalid refresh token',
190:     });
191:   }
192: });
193: 
194: /**
195:  * POST /api/logout
196:  * Revokes refresh token JTI in Map and clears HttpOnly cookie.
197:  */
198: router.post('/logout', (req, res) => {
199:   const token = req.cookies?.refreshToken || req.body?.refreshToken;
200: 
201:   if (token && config.jwtSecret) {
202:     try {
203:       const decoded = jwt.decode(token);
204:       if (decoded && decoded.jti) {
205:         queries.deleteRefreshToken(decoded.jti);
206:         logger.info('[logout] Revoked refresh token JTI in SQLite', { jti: decoded.jti, username: decoded.username });
207:       }
208:     } catch (err) {
209:       logger.debug('[logout] Error decoding token during logout', { error: err.message });
210:     }
211:   }
212: 
213:   res.clearCookie('refreshToken', {
214:     httpOnly: true,
215:     secure: config.tlsEnabled,
216:     sameSite: 'Strict',
217:   });
218: 
219:   return res.json({
220:     ok: true,
221:     message: 'Đăng xuất thành công',
222:   });
223: });
224: 
225: module.exports = router;
</file>

<file path="gateway/src/socket/agentHandler.js">
  1: // src/socket/agentHandler.js
  2: // Handle Agent WebSocket connections.
  3: //
  4: // Protocol:
  5: //   Text REGISTER { agent_id, secret, hostname, ip, os }
  6: //     → verify secret (bcrypt) against agents.json
  7: //     → if invalid secret → close 1008 (Policy Violation)
  8: //     → if already online  → close 1008 "already_online"
  9: //     → if ok → store + broadcast agent_status online
 10: //   Binary  → forward raw Buffer to all controllers (broadcast).
 11: //   Text other → stamp agent_id → broadcast JSON to all controllers.
 12: //   Close      → removeByWs + broadcast agent_status offline.
 13: 
 14: const agentStore = require('../store/agentStore');
 15: const controllerStore = require('../store/controllerStore');
 16: const heartbeat = require('../store/heartbeat');
 17: const logger = require('../utils/logger');
 18: 
 19: /**
 20:  * Attach event handlers to an Agent WebSocket.
 21:  * @param {WebSocket} ws - The Agent WebSocket (already upgraded)
 22:  * @param {import('http').IncomingMessage} req - The original HTTP upgrade request
 23:  */
 24: function handleAgent(ws, req) {
 25:   const ip =
 26:     req.headers['x-forwarded-for'] || req.socket?.remoteAddress || 'unknown';
 27: 
 28:   // This will be set after REGISTER
 29:   let agentId = null;
 30: 
 31:   logger.info('[agent] New agent connection (awaiting REGISTER)', { ip });
 32: 
 33:   // Attach heartbeat
 34:   const hb = heartbeat.attach(ws, `agent:${ip}`);
 35: 
 36:   // ─── message ─────────────────────────────────────────────────
 37:   ws.on('message', async (data, isBinary) => {
 38:     // ── Binary frame → forward ONLY to subscribed Controllers ──────
 39:     if (isBinary) {
 40:       logger.debug('[agent] Binary frame relay to subscribers', {
 41:         agentId,
 42:         bytes: data.length,
 43:       });
 44:       if (agentId) {
 45:         controllerStore.broadcastToSubscribers(agentId, data, { binary: true });
 46:       } else {
 47:         logger.warn('[agent] Binary frame from unregistered agent, dropping');
 48:       }
 49:       return;
 50:     }
 51: 
 52:     // ── Text frame → parse JSON ──────────────────────────────
 53:     let msg;
 54:     try {
 55:       msg = JSON.parse(data.toString());
 56:     } catch (err) {
 57:       logger.warn('[agent] Invalid JSON from agent', {
 58:         agentId,
 59:         ip,
 60:         error: err.message,
 61:         preview: data.toString().substring(0, 200),
 62:       });
 63:       return;
 64:     }
 65: 
 66:     // ── REGISTER ─────────────────────────────────────────────
 67:     if (msg.type === 'REGISTER') {
 68:       const id = msg.agent_id;
 69:       const secret = msg.secret;
 70: 
 71:       if (!id || !secret) {
 72:         logger.warn('[agent] REGISTER missing agent_id or secret', { ip });
 73:         ws.close(1008, 'missing_credentials');
 74:         return;
 75:       }
 76: 
 77:       // Verify secret against bcrypt hash in agents.json
 78:       const valid = await agentStore.verifySecret(id, secret);
 79:       if (!valid) {
 80:         logger.warn('[agent] REGISTER failed — invalid secret', { agentId: id, ip });
 81:         ws.close(1008, 'invalid_secret');
 82:         return;
 83:       }
 84: 
 85:       // Try to register (will be rejected if already online)
 86:       const registered = agentStore.register(id, ws, {
 87:         hostname: msg.hostname || id,
 88:         ip: msg.ip || ip,
 89:         os: msg.os || 'unknown',
 90:       });
 91: 
 92:       if (!registered) {
 93:         logger.warn('[agent] REGISTER rejected — agent already online', { agentId: id, ip });
 94:         ws.close(1008, 'already_online');
 95:         return;
 96:       }
 97: 
 98:       agentId = id;
 99: 
100:       // Update heartbeat label now that we know the agentId
101:       hb.clear();
102:       const hb2 = heartbeat.attach(ws, `agent:${agentId}`);
103:       // Replace reference for cleanup on close
104:       ws._gwHeartbeat = hb2;
105: 
106:       logger.info('[agent] REGISTER', {
107:         agentId,
108:         hostname: msg.hostname,
109:         ip: msg.ip,
110:         os: msg.os,
111:       });
112: 
113:       // Broadcast agent_status online to all controllers
114:       const statusMsg = JSON.stringify({
115:         type: 'agent_status',
116:         agent_id: agentId,
117:         hostname: msg.hostname || agentId,
118:         ip: msg.ip || ip,
119:         os: msg.os || 'unknown',
120:         online: true,
121:       });
122:       controllerStore.broadcast(statusMsg);
123: 
124:       return;
125:     }
126: 
127:     // ── All other messages → stamp agent_id & route to initiator or subscribers ──
128:     if (!agentId) {
129:       logger.warn('[agent] Message from unregistered agent, dropping', {
130:         ip,
131:         type: msg.type,
132:       });
133:       return;
134:     }
135: 
136:     // CHÈN/GHI ĐÈ agent_id
137:     msg.agent_id = agentId;
138:     const outStr = JSON.stringify(msg);
139: 
140:     // 1. Streaming frames & Keylog → CHỈ forward tới các Controller trong tập subscribe
141:     if (msg.type === 'frame_meta' || msg.type === 'keylog' || msg.type === 'keylog_data' || msg.module === 'keylog') {
142:       logger.debug('[agent→controller] Stream/Keylog relay to subscribers', {
143:         agentId,
144:         type: msg.type,
145:       });
146:       controllerStore.broadcastToSubscribers(agentId, outStr);
147:       return;
148:     }
149: 
150:     // 1.5. E2EE payload — opaque envelope, command_id is encrypted inside.
151:     //      Cannot do command-initiator routing; broadcast to subscribers.
152:     //      The Controller decrypts and dispatches internally.
153:     if (msg.type === 'e2ee_payload') {
154:       logger.debug('[agent→controller] e2ee_payload relay to subscribers', {
155:         agentId,
156:         seq: msg.seq,
157:       });
158:       controllerStore.broadcastToSubscribers(agentId, outStr);
159:       return;
160:     }
161: 
162:     // 2. Response cho lệnh (có command_id khớp req_id Controller đã gửi) → gửi đúng Controller, KHÔNG broadcast
163:     const cmdId = msg.command_id || msg.req_id || msg.id;
164:     if (cmdId && typeof cmdId === 'string' && controllerStore.hasCommand(cmdId)) {
165:       logger.info('[agent→controller] Command response relay to initiator', {
166:         agentId,
167:         type: msg.type,
168:         commandId: cmdId,
169:       });
170:       controllerStore.sendToCommandInitiator(cmdId, outStr);
171:       return;
172:     }
173: 
174:     // 3. Các message khác (không khớp command_id và không phải stream/keylog) → forward tới subscribers
175:     if (msg.type === 'e2ee_ready') {
176:       logger.info('[agent→controller] e2ee_ready relay to all controllers', { agentId });
177:       controllerStore.broadcast(outStr);
178:       return;
179:     }
180: 
181:     logger.info('[agent→controller] General relay to subscribers', {
182:       agentId,
183:       type: msg.type,
184:     });
185:     controllerStore.broadcastToSubscribers(agentId, outStr);
186:   });
187: 
188:   // ─── close ───────────────────────────────────────────────────
189:   ws.on('close', (code, reason) => {
190:     // Clear heartbeat
191:     if (ws._gwHeartbeat) {
192:       ws._gwHeartbeat.clear();
193:     } else {
194:       hb.clear();
195:     }
196: 
197:     // Remove from store strictly by ws object (to avoid deleting new socket if reconnected quickly)
198:     const removedId = agentStore.removeByWs(ws);
199: 
200:     if (removedId) {
201:       logger.info('[agent] Disconnected', {
202:         agentId: removedId,
203:         code,
204:         reason: reason?.toString(),
205:       });
206: 
207:       // Broadcast agent_status offline to all controllers
208:       const statusMsg = JSON.stringify({
209:         type: 'agent_status',
210:         agent_id: removedId,
211:         online: false,
212:       });
213:       controllerStore.broadcast(statusMsg);
214:     } else {
215:       logger.info('[agent] Unregistered agent disconnected', { ip, code });
216:     }
217:   });
218: 
219:   // ─── error ───────────────────────────────────────────────────
220:   ws.on('error', (err) => {
221:     logger.error('[agent] WebSocket error', {
222:       agentId,
223:       ip,
224:       error: err.message,
225:     });
226:   });
227: }
228: 
229: module.exports = handleAgent;
</file>

<file path="gateway/src/store/agentStore.js">
  1: // src/store/agentStore.js
  2: // Registry of connected Agent WebSocket clients.
  3: // Key: agentId (string) → Value: { agentId, ws, hostname, ip, os, connectedAt }
  4: //
  5: // Credential verification: agents.json maps agent_id → secretHash (bcrypt).
  6: // Duplicate rejection: if agent_id is already online, NEW connection is refused.
  7: 
  8: const path = require('path');
  9: const bcrypt = require('bcryptjs');
 10: const logger = require('../utils/logger');
 11: const { queries } = require('../db');
 12: const config = require('../config');
 13: 
 14: /** @type {Map<string, {agentId: string, ws: WebSocket, hostname: string, ip: string, os: string, connectedAt: number}>} */
 15: const agents = new Map();
 16: 
 17: /**
 18:  * Verify an agent's secret against the stored bcrypt hash in SQLite database.
 19:  * @param {string} agentId
 20:  * @param {string} secret - Plaintext secret sent by the agent
 21:  * @returns {Promise<boolean>} true if valid
 22:  */
 23: async function verifySecret(agentId, secret) {
 24:   const agent = queries.getAgentById(agentId);
 25: 
 26:   // 1. Nếu Agent đã tồn tại trong DB, xác thực bằng hash bcrypt
 27:   if (agent && agent.secret_hash) {
 28:     return bcrypt.compare(secret, agent.secret_hash);
 29:   }
 30: 
 31:   // 2. Cơ chế Auto-Register cho Agent mới
 32:   // Nếu Agent chưa có trong DB nhưng secret gửi lên khớp với AGENT_KEY toàn cục
 33:   if (config.agentKey && secret === config.agentKey) {
 34:     try {
 35:       const salt = await bcrypt.genSalt(10);
 36:       const hash = await bcrypt.hash(secret, salt);
 37:       
 38:       // Tự động lưu trữ thông tin Agent vào SQLite với mã băm an toàn
 39:       queries.upsertAgent(agentId, hash, agentId, Date.now());
 40:       logger.info('[agentStore] Auto-registered new agent to DB', { agentId });
 41:       return true;
 42:     } catch (err) {
 43:       logger.error('[agentStore] Failed to auto-register agent', { error: err.message });
 44:       return false;
 45:     }
 46:   }
 47: 
 48:   // Từ chối nếu không tìm thấy trong DB và secret cũng không khớp global key
 49:   logger.warn('[agentStore] Unknown agent_id and secret does not match global key', { agentId });
 50:   return false;
 51: }
 52: 
 53: /**
 54:  * Register an agent after it sends the REGISTER message.
 55:  * If agent_id is already online → REJECT the new connection (return false).
 56:  *
 57:  * @param {string} agentId
 58:  * @param {WebSocket} ws
 59:  * @param {{ hostname: string, ip: string, os: string }} meta
 60:  * @returns {boolean} true if registered, false if rejected (already online)
 61:  */
 62: function register(agentId, ws, meta) {
 63:   // If an agent with the same id is already connected → REJECT the NEW socket
 64:   if (agents.has(agentId)) {
 65:     const existing = agents.get(agentId);
 66:     if (existing.ws.readyState === existing.ws.OPEN) {
 67:       logger.warn('[agentStore] Agent already online — rejecting NEW connection', {
 68:         agentId,
 69:       });
 70:       return false; // Caller must close the NEW socket
 71:     }
 72:     // Existing socket is not OPEN (stale entry) — clean it up and allow
 73:     agents.delete(agentId);
 74:     logger.info('[agentStore] Cleaned stale entry for agent', { agentId });
 75:   }
 76: 
 77:   agents.set(agentId, {
 78:     agentId,
 79:     ws,
 80:     hostname: meta.hostname || agentId,
 81:     ip: meta.ip || 'unknown',
 82:     os: meta.os || 'unknown',
 83:     connectedAt: Date.now(),
 84:   });
 85: 
 86:   logger.info('[agentStore] Agent registered', {
 87:     agentId,
 88:     hostname: meta.hostname,
 89:     ip: meta.ip,
 90:     os: meta.os,
 91:   });
 92: 
 93:   return true;
 94: }
 95: 
 96: /**
 97:  * Unregister an agent by its agentId.
 98:  * @param {string} agentId
 99:  * @returns {boolean} true if the agent was found and removed
100:  */
101: function unregister(agentId) {
102:   const removed = agents.delete(agentId);
103:   if (removed) {
104:     logger.info('[agentStore] Agent unregistered', { agentId });
105:   }
106:   return removed;
107: }
108: 
109: /**
110:  * Remove an agent by its WebSocket reference (used on 'close' event
111:  * when we only have the ws object, not the agentId).
112:  * @param {WebSocket} ws
113:  * @returns {string|null} the agentId that was removed, or null
114:  */
115: function removeByWs(ws) {
116:   for (const [agentId, entry] of agents) {
117:     if (entry.ws === ws) {
118:       agents.delete(agentId);
119:       logger.info('[agentStore] Agent removed by ws ref', { agentId });
120:       return agentId;
121:     }
122:   }
123:   return null;
124: }
125: 
126: /**
127:  * Lookup an agent entry by its WebSocket reference.
128:  * @param {WebSocket} ws
129:  * @returns {{ agentId: string, ws: WebSocket, hostname: string, ip: string, os: string, connectedAt: number }|null}
130:  */
131: function getByWs(ws) {
132:   for (const entry of agents.values()) {
133:     if (entry.ws === ws) {
134:       return entry;
135:     }
136:   }
137:   return null;
138: }
139: 
140: /**
141:  * Get the WebSocket for a specific agent.
142:  * @param {string} agentId
143:  * @returns {WebSocket|null}
144:  */
145: function getSocket(agentId) {
146:   const entry = agents.get(agentId);
147:   return entry ? entry.ws : null;
148: }
149: 
150: /**
151:  * Get a specific agent entry.
152:  * @param {string} agentId
153:  * @returns {{ agentId: string, ws: WebSocket, hostname: string, ip: string, os: string, connectedAt: number }|null}
154:  */
155: function get(agentId) {
156:   return agents.get(agentId) || null;
157: }
158: 
159: /**
160:  * Get all agents in the clean shape expected by Controller's agents_list.
161:  * Matches Controller Protocol.js normalizeAgent: { id, name, os, ip, online }
162:  * @returns {Array<{ id: string, name: string, os: string, ip: string, online: boolean }>}
163:  */
164: function getAll() {
165:   const list = [];
166:   for (const entry of agents.values()) {
167:     list.push({
168:       id: entry.agentId,
169:       name: entry.hostname, // name = hostname
170:       os: entry.os,
171:       ip: entry.ip,
172:       online: true, // Only connected agents are in the store
173:     });
174:   }
175:   return list;
176: }
177: 
178: /**
179:  * Get the number of connected agents.
180:  * @returns {number}
181:  */
182: function size() {
183:   return agents.size;
184: }
185: 
186: module.exports = {
187:   verifySecret,
188:   register,
189:   unregister,
190:   removeByWs,
191:   getByWs,
192:   getSocket,
193:   get,
194:   getAll,
195:   size,
196: };
</file>

<file path="gateway/src/udp/udpServer.js">
  1: const dgram = require('dgram');
  2: const logger = require('../utils/logger');
  3: const controllerStore = require('../store/controllerStore');
  4: const { Worker } = require('worker_threads');
  5: const path = require('path');
  6: const os = require('os');
  7: 
  8: const server = dgram.createSocket('udp4');
  9: const PORT = 9000;
 10: 
 11: // Frame buffer map
 12: // Key: `${agentId}_${moduleType}_${frameId}`
 13: // Value: { chunks: Array, receivedCount: number, timestamp: number, total: number, meta: object, recovering: boolean }
 14: // Cấu trúc: Map<streamKey, { expectedSeq: number, pending: Array<{seq, frame, fullBuffer}> }>
 15: const streamBuffers = new Map();
 16: 
 17: // frameBuffer is used to assemble chunks of a single frame
 18: const frameBuffer = new Map();
 19: 
 20: // Worker Pool State
 21: const numWorkers = Math.max(1, Math.min(os.cpus().length - 1, 4));
 22: const workers = [];
 23: let nextWorkerIndex = 0;
 24: const pendingTasks = new Map();
 25: 
 26: function initWorkerPool() {
 27:   for (let i = 0; i < numWorkers; i++) {
 28:     const worker = new Worker(path.resolve(__dirname, 'fecWorker.js'));
 29:     worker.on('message', (result) => {
 30:       const task = pendingTasks.get(result.taskId);
 31:       if (!task) return;
 32:       pendingTasks.delete(result.taskId);
 33:       if (task.timeoutId) clearTimeout(task.timeoutId);
 34: 
 35:       if (result.success) {
 36:         task.resolve(result);
 37:       } else {
 38:         task.reject(new Error(result.error));
 39:       }
 40:     });
 41:     worker.on('error', (err) => logger.error(`[FEC Worker ${i}] Error: ${err.message}`));
 42:     workers.push(worker);
 43:   }
 44: }
 45: 
 46: function recoverChunkAsync(frameKey, total, totalPayloadLength, chunks, parityData) {
 47:   return new Promise((resolve, reject) => {
 48:     // Timeout chống kẹt 40ms để drop frame cũ kịp thời
 49:     const timeoutId = setTimeout(() => {
 50:       pendingTasks.delete(frameKey);
 51:       reject(new Error('FEC calculation timed out (40ms)'));
 52:     }, 40);
 53: 
 54:     pendingTasks.set(frameKey, { resolve, reject, timeoutId });
 55: 
 56:     const worker = workers[nextWorkerIndex++ % workers.length];
 57:     worker.postMessage({ taskId: frameKey, total, totalPayloadLength, chunks, parityData });
 58:   });
 59: }
 60: 
 61: function finalizeFrame(frameKey, frame) {
 62:   try {
 63:     const fullBuffer = Buffer.concat(frame.chunks);
 64:     frame.meta.len = fullBuffer.length;
 65:     
 66:     const streamKey = `${frame.meta.agent_id}_${frame.meta.module}`;
 67:     let streamState = streamBuffers.get(streamKey);
 68:     if (!streamState) {
 69:         streamState = { expectedSeq: frame.meta.seq, pending: [] };
 70:         streamBuffers.set(streamKey, streamState);
 71:     }
 72:     
 73:     streamState.pending.push({ seq: frame.meta.seq, frame, fullBuffer });
 74:     streamState.pending.sort((a, b) => a.seq - b.seq);
 75:     
 76:     while (streamState.pending.length > 0) {
 77:         if (streamState.pending[0].seq <= streamState.expectedSeq || streamState.pending.length >= 8) {
 78:             const next = streamState.pending.shift();
 79:             streamState.expectedSeq = next.seq + 1;
 80:             
 81:             const metaString = JSON.stringify(next.frame.meta);
 82:             
 83:             if (controllerStore.hasCommand(next.frame.meta.command_id)) {
 84:               controllerStore.sendToCommandInitiator(next.frame.meta.command_id, metaString);
 85:               controllerStore.sendToCommandInitiator(next.frame.meta.command_id, next.fullBuffer);
 86:             } else {
 87:               controllerStore.broadcastToSubscribers(next.frame.meta.agent_id, metaString);
 88:               controllerStore.broadcastToSubscribers(next.frame.meta.agent_id, next.fullBuffer, { binary: true });
 89:             }
 90:         } else {
 91:             break;
 92:         }
 93:     }
 94:   } catch (err) {
 95:     logger.error(`[UDP] Error finalizing frame ${frameKey}: ${err.message}`);
 96:   } finally {
 97:     frameBuffer.delete(frameKey);
 98:   }
 99: }
100: 
101: server.on('error', (err) => {
102:   logger.error(`[UDP] Server error:\n${err.stack}`);
103:   server.close();
104: });
105: 
106: server.on('message', (msg, rinfo) => {
107:   // UDP Header Layout (24 bytes fixed + dynamic strings)
108:   // [0] : Chunk_Index
109:   // [1] : Total_Chunks
110:   // [2] : Module_Type (0: Screen, 1: Webcam)
111:   // [3] : Is_Keyframe (0: false, 1: true)
112:   // [4-5] : Frame_ID (ushort LE)
113:   // [6-13] : X, Y, Width, Height (ushort LE x 4)
114:   // [14-21] : Timestamp_MS (ulong LE / bigint)
115:   // [22] : AgentID_Length (L1)
116:   // [23] : CommandID_Length (L2)
117:   // [24 .. 24+L1-1] : AgentID
118:   // [24+L1 .. 24+L1+L2-1] : CommandID
119:   // [Remaining] : Payload
120: 
121:   if (msg.length < 24) return; // Invalid packet
122: 
123:   try {
124:     const chunkIndex = msg.readUInt8(0);
125:     const totalChunks = msg.readUInt8(1);
126:     const moduleTypeByte = msg.readUInt8(2);
127:     const isKeyframe = msg.readUInt8(3) === 1;
128:     const frameId = msg.readUInt16LE(4);
129:     const x = msg.readUInt16LE(6);
130:     const y = msg.readUInt16LE(8);
131:     const w = msg.readUInt16LE(10);
132:     const h = msg.readUInt16LE(12);
133:     const timestampMs = Number(msg.readBigUInt64LE(14));
134:     
135:     const l1 = msg.readUInt8(22);
136:     const l2 = msg.readUInt8(23);
137: 
138:     if (msg.length < 24 + l1 + l2) return; // Incomplete packet
139: 
140:     let offset = 24;
141:     const agentId = msg.toString('utf8', offset, offset + l1);
142:     offset += l1;
143:     const commandId = msg.toString('utf8', offset, offset + l2);
144:     offset += l2;
145: 
146:     const payload = msg.subarray(offset);
147:     const moduleName = moduleTypeByte === 1 ? 'webcam' : 'screen';
148: 
149:     const frameKey = `${agentId}_${moduleName}_${frameId}`;
150: 
151:     let frame = frameBuffer.get(frameKey);
152:     if (!frame) {
153:       frame = {
154:         chunks: new Array(totalChunks),
155:         receivedCount: 0,
156:         timestamp: Date.now(),
157:         total: totalChunks,
158:         meta: {
159:           type: "frame_meta",
160:           module: moduleName,
161:           agent_id: agentId,
162:           command_id: commandId,
163:           x, y, w, h,
164:           is_keyframe: isKeyframe,
165:           seq: frameId,
166:           timestamp_ms: timestampMs
167:         }
168:       };
169:       frameBuffer.set(frameKey, frame);
170:     }
171: 
172:     // FEC Logic (Chú ý 2: Tách biệt Parity Chunk)
173:     if (chunkIndex === totalChunks) {
174:       if (!frame.parityData && payload.length >= 4) {
175:         frame.totalPayloadLength = payload.readUInt32LE(0);
176:         frame.parityData = payload.subarray(4);
177:       }
178:     } else if (chunkIndex < totalChunks) {
179:       if (!frame.chunks[chunkIndex]) {
180:         frame.chunks[chunkIndex] = payload;
181:         frame.receivedCount++;
182:       }
183:     }
184: 
185:     // Kiểm tra đã nhận đủ, hoặc có thể khôi phục bằng FEC
186:     if (frame.receivedCount === frame.total) {
187:       finalizeFrame(frameKey, frame);
188:     } else if (frame.receivedCount === frame.total - 1 && frame.parityData && !frame.recovering) {
189:       frame.recovering = true; // Chặn các luồng xử lý trùng lặp
190:       
191:       recoverChunkAsync(frameKey, frame.total, frame.totalPayloadLength, frame.chunks, frame.parityData)
192:         .then((res) => {
193:              let finalFrame = frameBuffer.get(frameKey);
194:              if (!finalFrame) return; // Đã bị Garbage Collector xóa mất do timeout 100ms
195:              
196:              finalFrame.chunks[res.missingIndex] = Buffer.from(res.recovered);
197:              finalFrame.receivedCount++;
198:              
199:              finalizeFrame(frameKey, finalFrame);
200:         })
201:         .catch(err => {
202:              frameBuffer.delete(frameKey); // Xóa frame hỏng
203:         });
204:     }
205:   } catch (err) {
206:     logger.error(`[UDP] Packet parsing error: ${err.message}`);
207:   }
208: });
209: 
210: server.on('listening', () => {
211:   const address = server.address();
212:   logger.info(`[UDP] Server listening on ${address.address}:${address.port}`);
213: });
214: 
215: // Garbage collector for incomplete frames
216: let gcInterval;
217: 
218: function start(port = PORT) {
219:   initWorkerPool();
220:   server.bind(port);
221:   
222:   gcInterval = setInterval(() => {
223:     const now = Date.now();
224:     for (const [key, frame] of frameBuffer.entries()) {
225:       if (now - frame.timestamp > 100) { // 100ms timeout is plenty for local/fast UDP
226:         frameBuffer.delete(key);
227:       }
228:     }
229:   }, 100);
230: }
231: 
232: function shutdown() {
233:   if (gcInterval) clearInterval(gcInterval);
234:   for (const worker of workers) {
235:     worker.terminate();
236:   }
237:   try {
238:     server.close(() => {
239:       logger.info('[UDP] Server closed');
240:     });
241:   } catch (e) {}
242: }
243: 
244: module.exports = { start, shutdown };
</file>

<file path="gateway/src/server.js">
  1: // src/server.js
  2: // Phase 1: Security Hardening — HTTPS/WSS + CORS Whitelist + Rate Limiting.
  3: //
  4: // 1 HTTP/HTTPS server (Express for REST) + 1 ws.WebSocketServer ({ noServer: true }).
  5: // Upgrade event routes by pathname: /agent and /controller.
  6: // Automatically selects HTTPS/WSS when SSL_CERT_PATH and SSL_KEY_PATH are configured.
  7: 
  8: const http = require('http');
  9: const https = require('https');
 10: const fs = require('fs');
 11: const express = require('express');
 12: 
 13: const rateLimit = require('express-rate-limit');
 14: const { WebSocketServer } = require('ws');
 15: const { URL } = require('url');
 16: 
 17: const config = require('./config');
 18: const logger = require('./utils/logger');
 19: const { verifyControllerAuth } = require('./middleware/auth');
 20: const handleAgent = require('./socket/agentHandler');
 21: const handleController = require('./socket/controllerHandler');
 22: const udpServer = require('./udp/udpServer');
 23: 
 24: // ─── Express App ───────────────────────────────────────────────
 25: const cookieParser = require('cookie-parser');
 26: const app = express();
 27: app.use(express.json());
 28: app.use(cookieParser());
 29: 
 30: // ─── CORS Whitelist (Phase 1: Security Hardening) ──────────────
 31: // Hand-rolled middleware — reads ALLOWED_ORIGINS from config (comma-separated).
 32: // Preflight OPTIONS returns 403 if the origin is not in the whitelist.
 33: const allowedOriginsList = config.allowedOrigins
 34:   .split(',')
 35:   .map((o) => o.trim())
 36:   .filter(Boolean);
 37: 
 38: app.use((req, res, next) => {
 39:   const origin = req.headers.origin;
 40: 
 41:   if (origin && allowedOriginsList.includes(origin)) {
 42:     res.header('Access-Control-Allow-Origin', origin);
 43:     res.header('Access-Control-Allow-Headers', 'Content-Type, Authorization');
 44:     res.header('Access-Control-Allow-Methods', 'GET, POST, OPTIONS');
 45:     res.header('Access-Control-Allow-Credentials', 'true');
 46:   }
 47: 
 48:   // Preflight: respond immediately
 49:   if (req.method === 'OPTIONS') {
 50:     if (!origin || !allowedOriginsList.includes(origin)) {
 51:       logger.warn('[cors] Preflight BLOCKED — origin not in whitelist', { origin });
 52:       return res.status(403).json({ ok: false, message: 'CORS: origin not allowed' });
 53:     }
 54:     return res.sendStatus(204);
 55:   }
 56: 
 57:   next();
 58: });
 59: 
 60: logger.info('[security] CORS configured', {
 61:   allowedOrigins: allowedOriginsList,
 62: });
 63: 
 64: // ─── Rate Limiting — Login only (Phase 1: Security Hardening) ──
 65: // 10 requests per minute per IP on POST /api/login.
 66: // NOT applied globally — avoids blocking WS handshake or normal traffic.
 67: const loginLimiter = rateLimit({
 68:   windowMs: 60 * 1000, // 1 minute
 69:   max: 10,             // 10 attempts per window per IP
 70:   standardHeaders: true,
 71:   legacyHeaders: false,
 72:   message: {
 73:     ok: false,
 74:     token: null,
 75:     message: 'Too many login attempts. Please try again later.',
 76:   },
 77:   handler: (req, res, _next, options) => {
 78:     logger.warn('[rate-limit] Login brute-force protection triggered', {
 79:       ip: req.ip,
 80:       username: req.body?.username || 'unknown',
 81:     });
 82:     res.status(options.statusCode).json(options.message);
 83:   },
 84: });
 85: app.use('/api/login', loginLimiter);
 86: 
 87: logger.info('[security] Rate limiting configured', {
 88:   loginLimit: '10 attempts / 60s per IP',
 89: });
 90: 
 91: 
 92: 
 93: // ─── Health check ──────────────────────────────────────────────
 94: app.get('/', (_req, res) => {
 95:   res.json({ status: 'ok', uptime: process.uptime() });
 96: });
 97: app.get('/health', (_req, res) => {
 98:   res.json({ status: 'ok', uptime: process.uptime() });
 99: });
100: 
101: // GET /api/agents - Return all connected agents
102: const agentStore = require('./store/agentStore');
103: app.get('/api/agents', (_req, res) => {
104:   res.json({ agents: agentStore.getAll() });
105: });
106: 
107: // REST routes
108: const loginRouter = require('./auth/login');
109: app.use('/api', loginRouter);
110: 
111: // ─── HTTP / HTTPS Server (Phase 1: TLS Support) ───────────────
112: // TLS_ENABLED=true  → https.createServer (wss://)
113: // TLS_ENABLED=false → http.createServer  (ws://)  — dev mode
114: let server;
115: let protocol;
116: 
117: if (config.tlsEnabled) {
118:   try {
119:     const tlsOptions = {
120:       cert: fs.readFileSync(config.tlsCertPath),
121:       key: fs.readFileSync(config.tlsKeyPath),
122:     };
123:     server = https.createServer(tlsOptions, app);
124:     protocol = 'https';
125:     logger.info('[security] TLS enabled — running in HTTPS/WSS mode', {
126:       cert: config.tlsCertPath,
127:       key: config.tlsKeyPath,
128:     });
129:   } catch (err) {
130:     logger.error('[security] TLS_ENABLED=true but failed to load certificates — aborting', {
131:       error: err.message,
132:       certPath: config.tlsCertPath,
133:       keyPath: config.tlsKeyPath,
134:     });
135:     process.exit(1);
136:   }
137: } else {
138:   server = http.createServer(app);
139:   protocol = 'http';
140:   logger.warn('[security] TLS disabled — running in plain HTTP/WS mode (dev only)');
141: }
142: 
143: // ─── WebSocket Server (noServer mode) ──────────────────────────
144: const wss = new WebSocketServer({ noServer: true, maxPayload: 4 * 1024 * 1024 });
145: 
146: // ─── Upgrade Handler ───────────────────────────────────────────
147: // Parse URL → route by pathname → authenticate → handleUpgrade.
148: server.on('upgrade', (req, socket, head) => {
149:   // Parse the request URL (req.url is relative, e.g. "/agent?key=xxx")
150:   const baseUrl = `${protocol}://${req.headers.host || 'localhost'}`;
151:   let parsedUrl;
152:   try {
153:     parsedUrl = new URL(req.url, baseUrl);
154:   } catch {
155:     logger.warn('[upgrade] Failed to parse URL, destroying socket', {
156:       url: req.url,
157:     });
158:     socket.destroy();
159:     return;
160:   }
161: 
162:   const pathname = parsedUrl.pathname;
163:   const query = parsedUrl.searchParams;
164: 
165:   // ── /agent path ────────────────────────────────────────────
166:   // Authentication moves to REGISTER message handshake with { agent_id, secret }
167:   if (pathname === '/agent') {
168:     wss.handleUpgrade(req, socket, head, (ws) => {
169:       // Tag the socket so handlers can distinguish agent vs controller
170:       ws._gwRole = 'agent';
171:       ws._gwAuthTime = Date.now();
172:       wss.emit('connection', ws, req, 'agent');
173:     });
174:     return;
175:   }
176: 
177:   // ── /controller path ──────────────────────────────────────
178:   if (pathname === '/controller') {
179:     const authResult = verifyControllerAuth(query);
180:     if (!authResult.ok) {
181:       socket.write('HTTP/1.1 401 Unauthorized\r\n\r\n');
182:       socket.destroy();
183:       return;
184:     }
185: 
186:     wss.handleUpgrade(req, socket, head, (ws) => {
187:       ws._gwRole = 'controller';
188:       ws._gwAuthTime = Date.now();
189:       ws._gwJwtPayload = authResult.payload; // null if key-auth
190:       wss.emit('connection', ws, req, 'controller');
191:     });
192:     return;
193:   }
194: 
195:   // ── Unknown path ──────────────────────────────────────────
196:   logger.warn('[upgrade] Unknown path, destroying socket', { pathname });
197:   socket.write('HTTP/1.1 404 Not Found\r\n\r\n');
198:   socket.destroy();
199: });
200: 
201: // ─── WSS Connection Dispatcher ─────────────────────────────────
202: // Route to the appropriate handler based on role tag set during upgrade.
203: wss.on('connection', (ws, req, role) => {
204:   if (role === 'agent') {
205:     handleAgent(ws, req);
206:   } else if (role === 'controller') {
207:     handleController(ws, req);
208:   }
209: });
210: 
211: // ─── Start ─────────────────────────────────────────────────────
212: const wsProtocol = protocol === 'https' ? 'wss' : 'ws';
213: 
214: function start() {
215:   server.listen(config.port, () => {
216:     logger.info('═══════════════════════════════════════════════════');
217:     logger.info(`  Gateway Server started on port ${config.port}`);
218:     logger.info(`  Mode:       ${protocol.toUpperCase()} / ${wsProtocol.toUpperCase()}`);
219:     logger.info(`  Health:     ${protocol}://localhost:${config.port}/health`);
220:     logger.info(`  Agent:      ${wsProtocol}://localhost:${config.port}/agent`);
221:     logger.info(`  Controller: ${wsProtocol}://localhost:${config.port}/controller`);
222:     logger.info('═══════════════════════════════════════════════════');
223:   });
224:   udpServer.start(9000);
225: }
226: 
227: // ─── Graceful Shutdown ─────────────────────────────────────────
228: function shutdown(signal) {
229:   logger.info(`[server] ${signal} received — shutting down gracefully...`);
230: 
231:   // Close all WebSocket connections
232:   for (const client of wss.clients) {
233:     try {
234:       client.close(1001, 'Server shutting down');
235:     } catch {
236:       // ignore
237:     }
238:   }
239:   
240:   udpServer.shutdown();
241: 
242:   // Close WebSocket server
243:   wss.close(() => {
244:     logger.info('[server] WebSocket server closed');
245: 
246:     // Close HTTP/HTTPS server
247:     server.close(() => {
248:       logger.info('[server] HTTP/HTTPS server closed — goodbye');
249:       process.exit(0);
250:     });
251:   });
252: 
253:   // Force exit after 5s if graceful shutdown hangs
254:   setTimeout(() => {
255:     logger.warn('[server] Forced exit after timeout');
256:     process.exit(1);
257:   }, 5000);
258: }
259: 
260: process.on('SIGINT', () => shutdown('SIGINT'));
261: process.on('SIGTERM', () => shutdown('SIGTERM'));
262: 
263: module.exports = { app, httpServer: server, wss, start };
</file>

