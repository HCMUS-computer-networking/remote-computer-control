<file path="gateway/src/socket/controllerHandler.js">
  1: // src/socket/controllerHandler.js
  2: // Handle Controller WebSocket connections (raw-WS, already authenticated at handshake).
  3: //
  4: // Protocol:
  5: //   list_agents → respond directly from agentStore (KHÔNG xuống Agent).
  6: //   Other messages with target_agents → forward NGUYÊN message tới ws của từng agent.
  7: //   target_agents rỗng + policy_update → gửi cho TẤT CẢ agents.
  8: //   Close → remove from controllerStore.
  9: 
 10: const agentStore = require('../store/agentStore');
 11: const controllerStore = require('../store/controllerStore');
 12: const heartbeat = require('../store/heartbeat');
 13: const messageRouter = require('../router/messageRouter');
 14: const logger = require('../utils/logger');
 15: 
 16: /** Simple incrementing ID for logging */
 17: let controllerCounter = 0;
 18: 
 19: /**
 20:  * Attach event handlers to an authenticated Controller WebSocket.
 21:  * @param {WebSocket} ws - The Controller WebSocket (already upgraded & authenticated)
 22:  * @param {import('http').IncomingMessage} req - The original HTTP upgrade request
 23:  */
 24: function handleController(ws, req) {
 25:   const ip =
 26:     req.headers['x-forwarded-for'] || req.socket?.remoteAddress || 'unknown';
 27:   const controllerId = `ctrl-${++controllerCounter}`;
 28:   const issuer = ws._gwJwtPayload?.username || controllerId;
 29: 
 30:   // Add to controller store
 31:   controllerStore.add(ws);
 32: 
 33:   logger.info('[controller] Connected', { controllerId, ip, issuer });
 34: 
 35:   // Attach heartbeat
 36:   const hb = heartbeat.attach(ws, `controller:${controllerId}`);
 37: 
 38:   // ─── message ─────────────────────────────────────────────────
 39:   ws.on('message', (data, isBinary) => {
 40:     // Controllers should not send binary — ignore if they do
 41:     if (isBinary) {
 42:       logger.warn('[controller] Unexpected binary from controller, ignoring', {
 43:         controllerId,
 44:         bytes: data.length,
 45:       });
 46:       return;
 47:     }
 48: 
 49:     // ── Parse JSON ───────────────────────────────────────────
 50:     let msg;
 51:     try {
 52:       msg = JSON.parse(data.toString());
 53:     } catch (err) {
 54:       logger.warn('[controller] Invalid JSON', {
 55:         controllerId,
 56:         error: err.message,
 57:         preview: data.toString().substring(0, 200),
 58:       });
 59:       return;
 60:     }
 61: 
 62:     // ── list_agents → respond directly (không xuống Agent) ───
 63:     if (msg.type === 'list_agents') {
 64:       const agents = agentStore.getAll();
 65:       const response = JSON.stringify({
 66:         type: 'agents_list',
 67:         agents,
 68:       });
 69: 
 70:       logger.info('[controller] list_agents request', {
 71:         controllerId,
 72:         agentCount: agents.length,
 73:       });
 74: 
 75:       controllerStore.sendTo(ws, response);
 76:       return;
 77:     }
 78: 
 79:     // ── subscribe / unsubscribe → handle directly (không xuống Agent) ───
 80:     if (msg.type === 'subscribe') {
 81:       if (msg.agent_id && typeof msg.agent_id === 'string') {
 82:         controllerStore.subscribe(ws, msg.agent_id);
 83:         logger.info('[controller] Subscribed to agent', { controllerId, agentId: msg.agent_id });
 84:       } else {
 85:         logger.warn('[controller] subscribe missing agent_id', { controllerId });
 86:       }
 87:       return;
 88:     }
 89: 
 90:     if (msg.type === 'unsubscribe') {
 91:       if (msg.agent_id && typeof msg.agent_id === 'string') {
 92:         controllerStore.unsubscribe(ws, msg.agent_id);
 93:         logger.info('[controller] Unsubscribed from agent', { controllerId, agentId: msg.agent_id });
 94:       } else {
 95:         logger.warn('[controller] unsubscribe missing agent_id', { controllerId });
 96:       }
 97:       return;
 98:     }
 99: 
100:     // ── Whitelist of relay-able types ─────────────────────────────
101:     const RELAY_TYPES = new Set([
102:       'request',
103:       'power',
104:       'policy_update',
105:       'permission_request',
106:       'permission_revoke',
107:       'stop_module',
108:       'e2ee_init',
109:       'e2ee_payload',
110:     ]);
111: 
112:     if (!RELAY_TYPES.has(msg.type)) {
113:       logger.warn('[controller] Unknown controller message type, dropping', {
114:         controllerId,
115:         type: msg.type,
116:       });
117:       return;
118:     }
119: 
120:     // ── Relay to agent(s) ────────────────────────────────────────
121:     logger.info('[controller→agent] Relay', {
122:       controllerId,
123:       issuer,
124:       type: msg.type,
125:       module: msg.module,
126:       targetAgents: msg.target_agents,
127:     });
128: 
129:     messageRouter.routeToAgents(data.toString(), msg, issuer, ws);
130:   });
131: 
132:   // ─── close ───────────────────────────────────────────────────
133:   ws.on('close', (code, reason) => {
134:     hb.clear();
135:     controllerStore.remove(ws);
136: 
137:     logger.info('[controller] Disconnected', {
138:       controllerId,
139:       code,
140:       reason: reason?.toString(),
141:       ip,
142:     });
143:   });
144: 
145:   // ─── error ───────────────────────────────────────────────────
146:   ws.on('error', (err) => {
147:     logger.error('[controller] WebSocket error', {
148:       controllerId,
149:       ip,
150:       error: err.message,
151:     });
152:   });
153: }
154: 
155: module.exports = handleController;
</file>

<file path="gateway/src/router/messageRouter.js">
  1: // src/router/messageRouter.js
  2: // Route Controller messages to Agent(s) based on target_agents field.
  3: //
  4: // Protocol (D3 / Security Hardening / Envelope Validation):
  5: //   - Parse & validate JSON message (reject if invalid JSON — G7 prep).
  6: //   - Validate minimal TX envelope via Ajv schema (type, module/action, target_agents).
  7: //   - Whitelist allowed modules based on formatjson specifications.
  8: //   - If invalid -> ACK error to Controller, DO NOT forward.
  9: //   - Inject top-level `issuer` field (string username from Controller session).
 10: //   - Re-serialize JSON string and forward to agent(s).
 11: 
 12: const Ajv = require('ajv');
 13: const agentStore = require('../store/agentStore');
 14: const controllerStore = require('../store/controllerStore');
 15: const logger = require('../utils/logger');
 16: const { validateParams } = require('../validation/commandSchemas');
 17: 
 18: 
 19: const ajv = new Ajv({ allErrors: true });
 20: 
 21: // ─── Module Whitelist (from ../../docs/protocol/*.json + power/policy specs) ───
 22: const VALID_MODULES = [
 23:   'app_list',
 24:   'app_start',
 25:   'app_stop',
 26:   'proc_list',
 27:   'proc_kill',
 28:   'screenshot',
 29:   'screen_stream',
 30:   'screen_stream_stop',
 31:   'keylog_start',
 32:   'keylog_stop',
 33:   'fs_list',
 34:   'fs_get',
 35:   'fs_put',
 36:   'fs_delete',
 37:   'webcam_start',
 38:   'webcam_stop',
 39:   'sysinfo',
 40:   // Additional valid commands defined in ../../docs/protocol/ and RELAY_TYPES
 41:   'power_lock',
 42:   'power_restart',
 43:   'power_shutdown',
 44:   'power_sleep',
 45:   'policy_update',
 46:   'permission_request',
 47:   'permission_revoke',
 48:   'permissions_reset',
 49:   'stop_module',
 50:   'e2ee_init',
 51:   'e2ee_payload',
 52:   'input_mouse_move',
 53:   'input_mouse_click',
 54:   'input_key',
 55:   'input_type',
 56: ];
 57: 
 58: // ─── Minimal Envelope Schema ──────────────────────────────────────────
 59: // Required: type (string), target_agents (array of string), and at least module OR action.
 60: const envelopeSchema = {
 61:   type: 'object',
 62:   required: ['type', 'target_agents'],
 63:   anyOf: [
 64:     { required: ['module'] },
 65:     { required: ['action'] },
 66:     { required: ['feature'] },
 67:     { required: ['params'] },
 68:   ],
 69:   properties: {
 70:     type: { type: 'string' },
 71:     module: { type: 'string', enum: VALID_MODULES },
 72:     action: { type: 'string' },
 73:     target_agents: {
 74:       type: 'array',
 75:       items: { type: 'string' },
 76:     },
 77:   },
 78: };
 79: 
 80: const validateEnvelope = ajv.compile(envelopeSchema);
 81: 
 82: /**
 83:  * Route a Controller message to the appropriate Agent(s).
 84:  * Validates JSON and envelope schema, stamps top-level `issuer` field, re-serializes and sends.
 85:  *
 86:  * @param {string} rawMessage - The original JSON string from Controller
 87:  * @param {object|null} parsed - The already-parsed message object (to avoid double-parse if valid)
 88:  * @param {string} [issuer="admin"] - The username of the Controller issuing the message
 89:  * @param {WebSocket|null} [controllerWs=null] - Reference to Controller websocket to send ACK errors
 90:  * @returns {boolean} true if message was processed, false if rejected
 91:  */
 92: function routeToAgents(rawMessage, parsed, issuer = 'admin', controllerWs = null) {
 93:   // 3. Nếu message không phải JSON hợp lệ → reject, KHÔNG forward (chuẩn bị cho G7 input validation)
 94:   let msgObj = parsed;
 95:   if (!msgObj) {
 96:     try {
 97:       msgObj = JSON.parse(rawMessage);
 98:     } catch (err) {
 99:       logger.warn('[router] Rejected relay: invalid JSON', { error: err.message });
100:       if (controllerWs && controllerWs.readyState === controllerWs.OPEN) {
101:         controllerWs.send(JSON.stringify({ type: 'error_ack', error: 'Invalid JSON', details: err.message }));
102:       }
103:       return false;
104:     }
105:   }
106: 
107:   if (typeof msgObj !== 'object' || msgObj === null || Array.isArray(msgObj)) {
108:     logger.warn('[router] Rejected relay: JSON payload must be a valid object');
109:     if (controllerWs && controllerWs.readyState === controllerWs.OPEN) {
110:       controllerWs.send(JSON.stringify({ type: 'error_ack', error: 'Payload must be a JSON object' }));
111:     }
112:     return false;
113:   }
114: 
115:   // ── Validate envelope against minimal schema + module whitelist ─────
116:   let valid = true;
117:   if (msgObj.type !== 'e2ee_init' && msgObj.type !== 'e2ee_payload') {
118:     valid = validateEnvelope(msgObj);
119:   }
120:   
121:   if (!valid) {
122:     logger.warn('[router] Message failed envelope schema validation', {
123:       errors: validateEnvelope.errors,
124:       type: msgObj.type,
125:       module: msgObj.module,
126:     });
127:     if (controllerWs && controllerWs.readyState === controllerWs.OPEN) {
128:       controllerWs.send(
129:         JSON.stringify({
130:           type: 'error_ack',
131:           success: false,
132:           error: 'Envelope validation failed: invalid schema or module not whitelisted',
133:           details: validateEnvelope.errors,
134:           original_type: msgObj.type || 'unknown',
135:         })
136:       );
137:     }
138:     return false;
139:   }
140: 
141:   // ── Validate specific params deep schema ─────────────────────────────
142:   const commandKey = msgObj.action || msgObj.module || msgObj.type;
143:   if (commandKey) {
144:     const paramsValidResult = validateParams(commandKey, msgObj.params);
145:     if (!paramsValidResult.valid) {
146:       logger.warn('[router] Message failed deep params schema validation', {
147:         errorText: paramsValidResult.errorText,
148:         type: msgObj.type,
149:         commandKey,
150:       });
151:       if (controllerWs && controllerWs.readyState === controllerWs.OPEN) {
152:         controllerWs.send(
153:           JSON.stringify({
154:             type: 'ERROR',
155:             command_id: msgObj.command_id || null,
156:             message: `Input validation failed for params: ${paramsValidResult.errorText}`,
157:             details: paramsValidResult.errors
158:           })
159:         );
160:       }
161:       return false;
162:     }
163:   }
164: 
165:   // ── Role-based Access Control (RBAC) check ─────────────────────────
166:   // admin: allowed to send commands down to Agents
167:   // viewer: read-only (can only view agent list and receive streams via subscribe, cannot forward commands)
168:   const userRole = controllerWs ? (controllerWs._gwUserRole || controllerWs._gwJwtPayload?.role) : 'admin';
169:   if (userRole !== 'admin') {
170:     logger.warn('[router] Rejected relay: controller role "viewer" is read-only and cannot execute commands on agents', {
171:       issuer,
172:       role: userRole,
173:       type: msgObj?.type,
174:       module: msgObj?.module,
175:     });
176:     if (controllerWs && controllerWs.readyState === controllerWs.OPEN) {
177:       controllerWs.send(
178:         JSON.stringify({
179:           type: 'error_ack',
180:           success: false,
181:           error: 'Permission denied: role "viewer" is read-only and cannot execute commands on agents',
182:           code: 403,
183:         })
184:       );
185:     }
186:     return false;
187:   }
188: 
189:   // 1. Thêm field top-level `issuer` là string username (đơn giản — không dùng object)
190:   msgObj.issuer = String(issuer || 'admin');
191: 
192:   // Register command ID or req_id so responses from Agent can be routed directly back to this Controller
193:   const reqId = msgObj.command_id || msgObj.req_id || msgObj.id;
194:   if (reqId && typeof reqId === 'string' && controllerWs) {
195:     controllerStore.registerCommand(reqId, controllerWs);
196:   }
197: 
198:   // 2. Serialize lại trước khi gửi
199:   const forwardMessage = JSON.stringify(msgObj);
200: 
201:   const targetAgents = msgObj.target_agents;
202:   const msgType = msgObj.type || 'unknown';
203:   const msgModule = msgObj.module || '';
204: 
205:   // ── target_agents is a non-empty array → send to specific agents ──
206:   if (Array.isArray(targetAgents) && targetAgents.length > 0) {
207:     for (const agentId of targetAgents) {
208:       const agentWs = agentStore.getSocket(agentId);
209: 
210:       if (!agentWs || agentWs.readyState !== agentWs.OPEN) {
211:         logger.warn('[router] Target agent not found or not connected', {
212:           agentId,
213:           type: msgType,
214:           module: msgModule,
215:         });
216:         continue;
217:       }
218: 
219:       try {
220:         agentWs.send(forwardMessage);
221:         logger.debug('[router] Forwarded to agent', {
222:           agentId,
223:           issuer: msgObj.issuer,
224:           type: msgType,
225:           module: msgModule,
226:         });
227:       } catch (err) {
228:         logger.error('[router] Failed to send to agent', {
229:           agentId,
230:           error: err.message,
231:         });
232:       }
233:     }
234:     return true;
235:   }
236: 
237:   // ── target_agents empty/missing ──
238:   // Broadcast is ONLY allowed for policy_update (fleet-wide push semantics).
239:   // Every other command must name explicit targets to avoid accidental
240:   // fleet-wide power_shutdown / restart / sleep / keylog_start etc.
241:   if (msgType !== 'policy_update')
242:   {
243:     logger.warn('[router] Rejected relay: target_agents is required for non-broadcast commands', {
244:       issuer: msgObj.issuer,                                                                        //
245:       type: msgType,                                                                                //
246:       module: msgModule,                                                                            //
247:     });
248:     if (controllerWs && controllerWs.readyState === controllerWs.OPEN)
249:     {
250:       controllerWs.send(
251:         JSON.stringify({
252:           type: 'error_ack',
253:           success: false,
254:           error: 'target_agents is required for non-broadcast commands',
255:           original_type: msgType,
256:           command_id: msgObj.command_id || null,
257:           code: 400,
258:         })
259:       );
260:     }
261:     return false;
262:   }
263: 
264:   const allAgents = agentStore.getAll();
265: 
266:   if (allAgents.length === 0) {
267:     logger.warn('[router] No agents connected, cannot relay', {
268:       type: msgType,
269:       module: msgModule,
270:     });
271:     return true;
272:   }
273: 
274:   logger.info('[router] Broadcasting to all agents (empty target_agents)', {
275:     issuer: msgObj.issuer,
276:     type: msgType,
277:     module: msgModule,
278:     count: allAgents.length,
279:   });
280: 
281:   for (const agent of allAgents) {
282:     const agentWs = agentStore.getSocket(agent.id);
283:     if (agentWs && agentWs.readyState === agentWs.OPEN) {
284:       try {
285:         agentWs.send(forwardMessage);
286:       } catch (err) {
287:         logger.error('[router] Failed to broadcast to agent', {
288:           agentId: agent.id,
289:           error: err.message,
290:         });
291:       }
292:     }
293:   }
294: 
295:   return true;
296: }
297: 
298: module.exports = { routeToAgents, validateEnvelope, VALID_MODULES };
