 5: const winston = require('winston');
 6: const path = require('path');
 7: const config = require('../config');
 8: 
 9: const { combine, timestamp, printf, colorize, errors } = winston.format;
10: 
11: // Custom log format
12: const logFormat = printf(({ level, message, timestamp, ...meta }) => {
13:   const metaStr = Object.keys(meta).length ? ' ' + JSON.stringify(meta) : '';
14:   return `[${timestamp}] [${level}] ${message}${metaStr}`;
15: });
16: 
17: const logger = winston.createLogger({
18:   level: config.logLevel,
19:   format: combine(
20:     errors({ stack: true }),
21:     timestamp({ format: 'YYYY-MM-DD HH:mm:ss' })
22:   ),
23:   transports: [
24:     // Console — colorized for dev
25:     new winston.transports.Console({
26:       format: combine(colorize(), logFormat),
27:     }),
28: 
29:     // File — JSON structured for production / audit
30:     new winston.transports.File({
31:       filename: path.resolve(__dirname, '..', '..', 'logs', 'gateway.log'),
32:       format: combine(logFormat),
33:       maxsize: 10 * 1024 * 1024, // 10 MB
34:       maxFiles: 5,
35:     }),
36: 
37:     // Separate error log
38:     new winston.transports.File({
39:       filename: path.resolve(__dirname, '..', '..', 'logs', 'error.log'),
40:       level: 'error',
41:       format: combine(logFormat),
42:       maxsize: 5 * 1024 * 1024,
43:       maxFiles: 3,
44:     }),
45:   ],
46: });
47: 
48: module.exports = logger;
