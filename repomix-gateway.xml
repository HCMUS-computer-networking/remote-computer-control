<file path="gateway/src/store/controllerStore.js">
  1: // src/managers/controllerStore.js
  2: // Set of connected Controller WebSocket clients and their Agent subscriptions.
  3: // Provides add/remove/broadcast, subscribe/unsubscribe, and request matching for routing Agent responses.
  4: 
  5: const logger = require('../utils/logger');
  6: 
  7: /** @type {Set<WebSocket>} */
  8: const controllers = new Set();
  9: 
 10: /** @type {Map<WebSocket, Set<string>>} */
 11: const controllerSubscriptions = new Map();
 12: 
 13: /** @type {Map<string, WebSocket>} */
 14: const commandToController = new Map();
 15: 
 16: /**
 17:  * Add a Controller WebSocket to the set and initialize its subscription set.
 18:  * @param {WebSocket} ws
 19:  */
 20: function add(ws) {
 21:   controllers.add(ws);
 22:   controllerSubscriptions.set(ws, new Set());
 23:   logger.info('[controllerStore] Controller added', {
 24:     total: controllers.size,
 25:   });
 26: }
 27: 
 28: /**
 29:  * Remove a Controller WebSocket from the set, deleting its subscriptions and pending command mappings.
 30:  * @param {WebSocket} ws
 31:  */
 32: function remove(ws) {
 33:   controllers.delete(ws);
 34:   controllerSubscriptions.delete(ws);
 35: 
 36:   // Clean up command mappings associated with this controller
 37:   for (const [cmdId, controllerWs] of commandToController.entries()) {
 38:     if (controllerWs === ws) {
 39:       commandToController.delete(cmdId);
 40:     }
 41:   }
 42: 
 43:   logger.info('[controllerStore] Controller removed and subscriptions cleared', {
 44:     total: controllers.size,
 45:   });
 46: }
 47: 
 48: /**
 49:  * Subscribe a Controller to messages from a specific Agent.
 50:  * @param {WebSocket} ws
 51:  * @param {string} agentId
 52:  */
 53: function subscribe(ws, agentId) {
 54:   let subs = controllerSubscriptions.get(ws);
 55:   if (!subs) {
 56:     subs = new Set();
 57:     controllerSubscriptions.set(ws, subs);
 58:   }
 59:   subs.add(agentId);
 60:   logger.info('[controllerStore] Subscribed to agent', { agentId, totalSubs: subs.size });
 61: }
 62: 
 63: /**
 64:  * Unsubscribe a Controller from messages from a specific Agent.
 65:  * @param {WebSocket} ws
 66:  * @param {string} agentId
 67:  */
 68: function unsubscribe(ws, agentId) {
 69:   const subs = controllerSubscriptions.get(ws);
 70:   if (subs) {
 71:     subs.delete(agentId);
 72:     logger.info('[controllerStore] Unsubscribed from agent', { agentId, remainingSubs: subs.size });
 73:   }
 74: }
 75: 
 76: /**
 77:  * Check if a Controller is subscribed to a specific Agent.
 78:  * @param {WebSocket} ws
 79:  * @param {string} agentId
 80:  * @returns {boolean}
 81:  */
 82: function isSubscribed(ws, agentId) {
 83:   const subs = controllerSubscriptions.get(ws);
 84:   return subs ? subs.has(agentId) : false;
 85: }
 86: 
 87: /**
 88:  * Get all subscriptions for a specific Controller.
 89:  * @param {WebSocket} ws
 90:  * @returns {Set<string>|null}
 91:  */
 92: function getSubscriptions(ws) {
 93:   return controllerSubscriptions.get(ws) || null;
 94: }
 95: 
 96: /**
 97:  * Register a command ID (or req_id) issued by a Controller for later response matching.
 98:  * @param {string} commandId
 99:  * @param {WebSocket} ws
100:  */
101: function registerCommand(commandId, ws) {
102:   if (commandId && typeof commandId === 'string' && ws) {
103:     commandToController.set(commandId, ws);
104:   }
105: }
106: 
107: /**
108:  * Check if a command ID is recorded and mapped to an active Controller.
109:  * @param {string} commandId
110:  * @returns {boolean}
111:  */
112: function hasCommand(commandId) {
113:   const ws = commandToController.get(commandId);
114:   return ws && ws.readyState === ws.OPEN;
115: }
116: 
117: /**
118:  * Send data directly to the Controller that initiated a given command/req ID.
119:  * @param {string} commandId
120:  * @param {string|Buffer} data
121:  * @returns {boolean} true if sent successfully
122:  */
123: function sendToCommandInitiator(commandId, data) {
124:   const ws = commandToController.get(commandId);
125:   if (ws && ws.readyState === ws.OPEN) {
126:     try {
127:       ws.send(data);
128:       // Clean up the mapping after successful delivery to prevent unbounded growth.
129:       // UDP frame_meta reuses the same command_id across the stream, so we must
130:       // NOT delete here for frame routing. The caller (udpServer.js) uses
131:       // hasCommand() + sendToCommandInitiator() for each frame in a stream.
132:       // Text-based one-shot responses (app_list_result, power_result, etc.) are
133:       // safe to clean up. We keep the entry alive and rely on controller-disconnect
134:       // cleanup for stream commands. A periodic GC is added below for safety.
135:       return true;
136:     } catch (err) {
137:       logger.error('[controllerStore] sendToCommandInitiator error', { error: err.message });
138:     }
139:   }
140:   return false;
141: }
142: 
143: /**
144:  * Broadcast data (text or binary) ONLY to Controllers subscribed to the specified Agent.
145:  * @param {string} agentId
146:  * @param {string|Buffer} data
147:  * @param {{ binary?: boolean }} [options]
148:  * @returns {number} number of controllers sent to
149:  */
150: function broadcastToSubscribers(agentId, data, options = {}) {
151:   const isBinary = options.binary || false;
152:   let sentCount = 0;
153: 
154:   for (const [ws, subs] of controllerSubscriptions.entries()) {
155:     if (subs.has(agentId)) {
156:       try {
157:         if (ws.readyState === ws.OPEN) {
158:           ws.send(data, { binary: isBinary });
159:           sentCount++;
160:         }
161:       } catch (err) {
162:         logger.error('[controllerStore] broadcastToSubscribers send error', {
163:           error: err.message,
164:         });
165:       }
166:     }
167:   }
168:   return sentCount;
169: }
170: 
171: /**
172:  * Broadcast data (text or binary) to ALL connected Controllers.
173:  * Wraps each send in try-catch to avoid crash if one controller disconnected.
174:  * @param {string|Buffer} data - text string or binary buffer
175:  * @param {{ binary?: boolean }} [options] - pass { binary: true } for binary frames
176:  */
177: function broadcast(data, options = {}) {
178:   const isBinary = options.binary || false;
179: 
180:   for (const ws of controllers) {
181:     try {
182:       if (ws.readyState === ws.OPEN) {
183:         ws.send(data, { binary: isBinary });
184:       }
185:     } catch (err) {
186:       logger.error('[controllerStore] Broadcast send error', {
187:         error: err.message,
188:       });
189:     }
190:   }
191: }
192: 
193: /**
194:  * Send data to a single Controller WebSocket.
195:  * @param {WebSocket} ws
196:  * @param {string|Buffer} data
197:  */
198: function sendTo(ws, data) {
199:   try {
200:     if (ws.readyState === ws.OPEN) {
201:       ws.send(data);
202:     }
203:   } catch (err) {
204:     logger.error('[controllerStore] sendTo error', { error: err.message });
205:   }
206: }
207: 
208: /**
209:  * Get all connected Controller WebSockets.
210:  * @returns {Set<WebSocket>}
211:  */
212: function getAll() {
213:   return controllers;
214: }
215: 
216: /**
217:  * Get the number of connected controllers.
218:  * @returns {number}
219:  */
220: function size() {
221:   return controllers.size;
222: }
223: 
224: // Periodic GC: remove stale command entries whose Controller WebSocket is no
225: // longer open. This prevents unbounded growth from long-running sessions
226: // without removing entries for active streams.
227: const COMMAND_GC_INTERVAL_MS = 60_000; // every 60 seconds
228: setInterval(() => {
229:   let cleaned = 0;
230:   for (const [cmdId, ws] of commandToController.entries()) {
231:     if (!ws || ws.readyState !== ws.OPEN) {
232:       commandToController.delete(cmdId);
233:       cleaned++;
234:     }
235:   }
236:   if (cleaned > 0) {
237:     logger.debug('[controllerStore] GC cleaned stale command entries', { cleaned, remaining: commandToController.size });
238:   }
239: }, COMMAND_GC_INTERVAL_MS);
240: 
241: module.exports = {
242:   add,
243:   remove,
244:   subscribe,
245:   unsubscribe,
246:   isSubscribed,
247:   getSubscriptions,
248:   registerCommand,
249:   hasCommand,
250:   sendToCommandInitiator,
251:   broadcastToSubscribers,
252:   broadcast,
253:   sendTo,
254:   getAll,
255:   size,
256: };
</file>

