# Gateway Server Configuration
PORT=8080

# Authentication keys (change in production!)
AGENT_KEY=your-agent-key-here
CONTROLLER_KEY=your-controller-key-here
JWT_SECRET=your-jwt-secret-here

# Heartbeat (ms)
PING_INTERVAL=30000
PING_TIMEOUT=10000

# Logging
LOG_LEVEL=info

# ─── Phase 1: Security Hardening ────────────────────────────────

# TLS/SSL — Provide paths to certificate and private key to enable HTTPS/WSS.
# If omitted, server runs in plain HTTP/WS mode (development only).
# SSL_CERT_PATH=./certs/server.cert
# SSL_KEY_PATH=./certs/server.key

# CORS — Comma-separated list of allowed origins.
# Use '*' for development only. In production, specify exact origins:
# CORS_ORIGINS=http://localhost:3000,https://controller.yourdomain.com
CORS_ORIGINS=*

# Rate Limiting — General API limits (all /api/* routes).
# RATE_LIMIT_WINDOW_MS = time window in milliseconds (default: 900000 = 15 min)
# RATE_LIMIT_MAX_REQUESTS = max requests per window (default: 100)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Rate Limiting — Login brute-force protection (/api/login only, stricter).
# LOGIN_RATE_LIMIT_WINDOW_MS = time window in milliseconds (default: 900000 = 15 min)
# LOGIN_RATE_LIMIT_MAX_REQUESTS = max login attempts per window (default: 10)
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX_REQUESTS=10
